{%- comment -%}
  THE RAW HOUSE - TABBED BEST SELLERS & FEATURED PRODUCTS
  Tabbed collection showcase with AJAX Quick Add, Wishlist persistence, and secondary image hover swap.
{%- endcomment -%}

<div
  id="LuxuryTabbedProducts-{{ section.id }}"
  class="lux-tabbed-section"
  style="background: {{ section.settings.background_color }};"
  {{ section.shopify_attributes }}
>
  <div class="lux-tabbed-container">
    {% if section.settings.heading != blank %}
      <div class="lux-section-heading-wrap lux-reveal-fade-up">
        {% if section.settings.subheading != blank %}
          <span class="lux-section-subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 class="lux-section-heading">{{ section.settings.heading }}</h2>
        <div class="lux-section-divider"></div>
      </div>
    {% endif %}

    <!-- Tabs Nav -->
    <div class="lux-tabs-nav lux-reveal-fade-up">
      {% for block in section.blocks %}
        <button
          type="button"
          class="lux-tab-btn{% if forloop.first %} is-active{% endif %}"
          data-tab="tab-{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.tab_title }}
        </button>
      {% endfor %}
    </div>

    <!-- Tab Panes -->
    {% for block in section.blocks %}
      {% assign col = block.settings.collection %}
      <div
        class="lux-tab-pane{% if forloop.first %} is-active{% endif %} lux-stagger-parent lux-reveal-fade-up"
        data-tab="tab-{{ block.id }}"
      >
        {% if col != blank and col.products_count > 0 %}
          {% for product in col.products limit: section.settings.products_to_show %}
            <div class="lux-product-card lux-stagger-child">
              <div class="lux-product-media-wrap">
                <!-- Badges -->
                {% if product.compare_at_price > product.price %}
                  {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                  <span class="lux-product-badge lux-product-badge--sale">-{{ discount }}%</span>
                {% elsif forloop.index <= 2 %}
                  <span class="lux-product-badge lux-product-badge--new">NEW</span>
                {% endif %}

                <!-- Wishlist Button -->
                <button
                  type="button"
                  class="lux-product-wishlist-btn"
                  data-product-handle="{{ product.handle }}"
                  aria-label="Add to wishlist"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>

                <a href="{{ product.url }}" class="lux-product-link">
                  {% if product.featured_media != blank %}
                    {{
                      product.featured_media
                      | image_url: width: 800
                      | image_tag:
                        class: 'lux-product-img',
                        loading: 'eager',
                        alt: product.title
                    }}
                  {% elsif product.images.size > 0 %}
                    <img
                      src="{{ product.images[0] | image_url: width: 800 }}"
                      alt="{{ product.title | escape }}"
                      class="lux-product-img"
                      loading="eager"
                      width="600"
                      height="750"
                    >
                  {% else %}
                    <img
                      src="{{ 'maker-gallery-2.jpg' | asset_url }}"
                      alt="{{ product.title | escape }}"
                      class="lux-product-img"
                      loading="eager"
                      width="600"
                      height="750"
                    >
                  {% endif %}

                  {% if product.media[1] != blank %}
                    {{
                      product.media[1]
                      | image_url: width: 800
                      | image_tag:
                        class: 'lux-product-img lux-product-img--secondary',
                        loading: 'eager',
                        alt: product.title
                    }}
                  {% endif %}
                </a>

                <!-- Quick Add Action -->
                {% if product.available %}
                  <div class="lux-product-quick-add">
                    <button
                      type="button"
                      class="lux-quick-add-btn"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                      </svg>
                      Quick Add
                    </button>
                  </div>
                {% endif %}
              </div>

              <div class="lux-product-info">
                {% if product.vendor != blank %}
                  <span class="lux-product-vendor">{{ product.vendor }}</span>
                {% endif %}
                <a href="{{ product.url }}" class="lux-product-title">{{ product.title }}</a>
                <div class="lux-product-price-row">
                  <span class="lux-product-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="lux-product-compare-price">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Curated Editorial Fallback Cards -->
          {% for i in (1..4) %}
            {% assign price_val = i | times: 450 | plus: 680 %}
            <div class="lux-product-card lux-stagger-child">
              <div class="lux-product-media-wrap">
                {% if i == 1 %}
                  <span class="lux-product-badge lux-product-badge--new">NEW</span>
                {% elsif i == 2 %}
                  <span class="lux-product-badge lux-product-badge--sale">ORIGINAL</span>
                {% endif %}

                <button
                  type="button"
                  class="lux-product-wishlist-btn"
                  data-product-handle="curated-art-piece-{{ i }}"
                  aria-label="Add to wishlist"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>

                <a href="{{ routes.all_products_collection_url }}" class="lux-product-link">
                  {% case i %}
                    {% when 1 %}
                      <img
                        src="{{ 'art-painting-abstract-oil.jpg' | asset_url }}"
                        alt="The Gilded Horizon Textured Canvas"
                        class="lux-product-img"
                        loading="eager"
                        onerror="this.onerror=null;this.src='{{ 'new-arrival-1.jpg' | asset_url }}';"
                        width="600"
                        height="750"
                      >
                    {% when 2 %}
                      <img
                        src="{{ 'art-sculpture-rodin-thinker.jpg' | asset_url }}"
                        alt="The Thinker Hand-Cast Bronze Sculpture"
                        class="lux-product-img"
                        loading="eager"
                        onerror="this.onerror=null;this.src='{{ 'new-arrival-2.jpg' | asset_url }}';"
                        width="600"
                        height="750"
                      >
                    {% when 3 %}
                      <img
                        src="{{ 'art-sculpture-venus-milo.jpg' | asset_url }}"
                        alt="Venus de Milo Carved Alabaster Model"
                        class="lux-product-img"
                        loading="eager"
                        onerror="this.onerror=null;this.src='{{ 'new-arrival-3.jpg' | asset_url }}';"
                        width="600"
                        height="750"
                      >
                    {% when 4 %}
                      <img
                        src="{{ 'art-painting-great-wave.jpg' | asset_url }}"
                        alt="The Great Wave Archival Masterpiece Print"
                        class="lux-product-img"
                        loading="eager"
                        onerror="this.onerror=null;this.src='{{ 'new-arrival-4.jpg' | asset_url }}';"
                        width="600"
                        height="750"
                      >
                  {% endcase %}
                </a>

                <div class="lux-product-quick-add">
                  <a
                    href="{{ routes.all_products_collection_url }}"
                    class="lux-quick-add-btn"
                  >
                    Acquire Piece
                  </a>
                </div>
              </div>

              <div class="lux-product-info">
                <span class="lux-product-vendor">THE RAW HOUSE ATELIER</span>
                <a href="{{ routes.all_products_collection_url }}" class="lux-product-title">
                  {% case i %}
                    {% when 1 %}The Gilded Horizon Textured Canvas
                    {% when 2 %}The Thinker Hand-Cast Bronze Sculpture
                    {% when 3 %}Venus de Milo Carved Alabaster Model
                    {% when 4 %}The Great Wave Archival Masterpiece Print
                  {% endcase %}
                </a>
                <div class="lux-product-price-row">
                  <span class="lux-product-price">${{ price_val }}.00</span>
                  {% if i == 2 %}
                    <span class="lux-product-compare-price">${{ price_val | plus: 200 }}.00</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Luxury Tabbed Products",
  "tag": "section",
  "class": "section-luxury-tabbed",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CURATED MASTERPIECES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED CREATIONS"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f6f5f0"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Products To Show Per Tab",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Product Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "ALL PIECES"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Tabbed Products",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_title": "ALL ARTWORKS"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "ORIGINAL OIL PAINTINGS"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "SCULPTURES & ART MODELS"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "ARCHIVAL FINE PRINTS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
