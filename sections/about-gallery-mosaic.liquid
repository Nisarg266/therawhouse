{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'warm'
  case scheme
    when 'light'
      assign bg_color = '#ffffff'
      assign text_color = '#111111'
      assign muted_color = '#5f5b52'
      assign panel_color = '#f7f5ef'
      assign border_color = '#e6e0d3'
      assign accent_color = '#c5a880'
    when 'dark'
      assign bg_color = '#141313'
      assign text_color = '#ffffff'
      assign muted_color = '#c9c1b3'
      assign panel_color = '#1e1c19'
      assign border_color = 'rgba(255, 255, 255, 0.12)'
      assign accent_color = '#c5a880'
    when 'obsidian'
      assign bg_color = '#080807'
      assign text_color = '#ffffff'
      assign muted_color = '#cfc6b7'
      assign panel_color = '#12110f'
      assign border_color = 'rgba(197, 168, 128, 0.22)'
      assign accent_color = '#c5a880'
    else
      assign bg_color = '#f7f4ee'
      assign text_color = '#111111'
      assign muted_color = '#625d52'
      assign panel_color = '#fffdf8'
      assign border_color = '#e7dfd0'
      assign accent_color = '#c5a880'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_text_color != blank and section.settings.custom_text_color != 'rgba(0,0,0,0)'
    assign text_color = section.settings.custom_text_color
  endif
  if section.settings.custom_accent_color != blank and section.settings.custom_accent_color != 'rgba(0,0,0,0)'
    assign accent_color = section.settings.custom_accent_color
  endif
%}

<section
  id="AboutGallery-{{ section.id }}"
  class="about-gallery about-gallery--{{ scheme }}"
  style="
    --gallery-bg: {{ bg_color }};
    --gallery-color: {{ text_color }};
    --gallery-muted: {{ muted_color }};
    --gallery-panel: {{ panel_color }};
    --gallery-border: {{ border_color }};
    --gallery-accent: {{ accent_color }};
    --gallery-pt: {{ section.settings.padding_top | default: 64 }}px;
    --gallery-pb: {{ section.settings.padding_bottom | default: 68 }}px;
    --gallery-row: {{ section.settings.grid_row_height | default: 240 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="about-gallery__inner">
    <div class="about-gallery__header lux-reveal-fade-up">
      {% if section.settings.subheading != blank %}
        <span class="about-gallery__subheading">{{ section.settings.subheading }}</span>
      {% endif %}

      <div class="about-gallery__title-row">
        <h2 class="about-gallery__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.intro != blank %}
          <p class="about-gallery__intro">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    </div>

    <div class="about-gallery__stage lux-stagger-parent lux-reveal-fade-up">
      {% for block in section.blocks %}
        {% liquid
          assign item_class = ''
          if forloop.first
            assign item_class = ' about-gallery__item--featured'
          elsif forloop.index == 4
            assign item_class = ' about-gallery__item--wide'
          endif

          assign fallback_asset = block.settings.default_asset
          if fallback_asset == blank
            assign remainder = forloop.index | modulo: 6
            case remainder
              when 1
                assign fallback_asset = 'art-gallery-room-hotspots.jpg'
              when 2
                assign fallback_asset = 'maker-gallery-1.jpg'
              when 3
                assign fallback_asset = 'art-atelier-artist-studio.jpg'
              when 4
                assign fallback_asset = 'fine-print-2.jpg'
              when 5
                assign fallback_asset = 'maker-gallery-3.jpg'
              else
                assign fallback_asset = 'art-decor-ceramic-statue.jpg'
            endcase
          endif
        %}

        <article
          class="about-gallery__item lux-stagger-child{{ item_class }}"
          style="--item-delay: {{ forloop.index0 | times: 90 }}ms;"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.link != blank %}
            <a class="about-gallery__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | default: block.settings.kicker | escape }}"></a>
          {% endif %}

          <div class="about-gallery__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  class: 'about-gallery__image',
                  loading: 'lazy',
                  widths: '360, 540, 720, 920, 1200, 1400',
                  sizes: '(max-width: 749px) 82vw, (max-width: 989px) 44vw, 33vw',
                  alt: block.settings.title
              }}
            {% else %}
              <img
                src="{{ fallback_asset | asset_url }}"
                alt="{{ block.settings.title | default: 'The Raw House gallery detail' | escape }}"
                class="about-gallery__image"
                loading="lazy"
                width="900"
                height="1100"
              >
            {% endif %}
          </div>

          <div class="about-gallery__caption">
            {% if block.settings.kicker != blank %}
              <span class="about-gallery__kicker">{{ block.settings.kicker }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="about-gallery__item-title">{{ block.settings.title }}</h3>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.footer_note != blank %}
      <p class="about-gallery__note lux-reveal-fade-up">{{ section.settings.footer_note }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .about-gallery {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at 8% 12%, color-mix(in srgb, var(--gallery-accent) 16%, transparent), transparent 30%),
      linear-gradient(135deg, color-mix(in srgb, var(--gallery-bg) 92%, #ffffff), var(--gallery-bg));
    color: var(--gallery-color);
    padding: var(--gallery-pt) 0 var(--gallery-pb);
    isolation: isolate;
  }

  .about-gallery::before {
    content: "";
    position: absolute;
    inset: 22px;
    border: 1px solid color-mix(in srgb, var(--gallery-accent) 22%, transparent);
    opacity: 0.45;
    pointer-events: none;
    z-index: -1;
  }

  .about-gallery__inner {
    width: min(1320px, calc(100% - 40px));
    margin: 0 auto;
  }

  .about-gallery__header {
    display: grid;
    grid-template-columns: minmax(180px, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
    margin-bottom: clamp(28px, 4vw, 54px);
  }

  .about-gallery__subheading,
  .about-gallery__kicker {
    color: var(--gallery-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .about-gallery__subheading {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    align-self: start;
  }

  .about-gallery__subheading::before {
    content: "";
    width: 42px;
    height: 1px;
    background: currentColor;
  }

  .about-gallery__title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.62fr);
    gap: clamp(22px, 4vw, 54px);
    align-items: end;
  }

  .about-gallery__heading {
    margin: 0;
    max-width: 760px;
    color: var(--gallery-color);
    font-family: var(--font-heading-family, serif);
    font-size: clamp(30px, 4.6vw, 70px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .about-gallery__intro,
  .about-gallery__note {
    margin: 0;
    color: var(--gallery-muted);
    font-size: clamp(13px, 1.05vw, 15px);
    line-height: 1.75;
  }

  .about-gallery__stage {
    display: grid;
    grid-template-columns: 1.25fr 0.78fr 0.95fr 0.72fr;
    grid-auto-rows: var(--gallery-row);
    gap: clamp(12px, 1.5vw, 20px);
    align-items: stretch;
  }

  .about-gallery__item {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--gallery-border);
    background: var(--gallery-panel);
    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.12);
    transform: translateY(0);
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    animation: about-gallery-drift 9s ease-in-out infinite;
    animation-delay: var(--item-delay);
  }

  .about-gallery__item:nth-child(2n) {
    animation-direction: reverse;
  }

  .about-gallery__item--featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .about-gallery__item--wide {
    grid-column: span 2;
  }

  .about-gallery__item:hover {
    transform: translateY(-8px);
    border-color: color-mix(in srgb, var(--gallery-accent) 58%, var(--gallery-border));
    box-shadow: 0 34px 80px rgba(0, 0, 0, 0.22);
    z-index: 2;
  }

  .about-gallery__link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .about-gallery__media {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #ded8cc;
  }

  .about-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
    transform: scale(1.01);
    transition:
      transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
      filter 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-gallery__item:hover .about-gallery__image {
    filter: saturate(1.05) contrast(1.06);
    transform: scale(1.075);
  }

  .about-gallery__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 52%;
    padding: clamp(18px, 2.2vw, 30px);
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.24) 28%, rgba(0, 0, 0, 0.82) 100%);
    color: #ffffff;
    pointer-events: none;
  }

  .about-gallery__item-title {
    margin: 7px 0 0;
    max-width: 420px;
    color: #ffffff;
    font-family: var(--font-heading-family, serif);
    font-size: clamp(17px, 1.8vw, 28px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .about-gallery__item:not(.about-gallery__item--featured) .about-gallery__item-title {
    font-size: clamp(14px, 1.18vw, 20px);
  }

  .about-gallery__note {
    max-width: 650px;
    margin: clamp(24px, 3vw, 36px) 0 0 auto;
    padding-left: 28px;
    border-left: 1px solid color-mix(in srgb, var(--gallery-accent) 52%, transparent);
  }

  @keyframes about-gallery-drift {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .about-gallery__item {
      animation: none;
    }

    .about-gallery__item,
    .about-gallery__image {
      transition: none;
    }
  }

  @media screen and (max-width: 989px) {
    .about-gallery__header,
    .about-gallery__title-row {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .about-gallery__stage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(230px, auto);
    }

    .about-gallery__item--featured,
    .about-gallery__item--wide {
      grid-column: span 2;
    }
  }

  @media screen and (max-width: 749px) {
    .about-gallery {
      padding-top: calc(var(--gallery-pt) * 0.72);
      padding-bottom: calc(var(--gallery-pb) * 0.72);
    }

    .about-gallery::before {
      inset: 12px;
    }

    .about-gallery__inner {
      width: 100%;
      padding: 0 16px;
    }

    .about-gallery__heading {
      font-size: clamp(28px, 11vw, 42px);
    }

    .about-gallery__stage {
      display: flex;
      gap: 14px;
      margin: 0 -16px;
      padding: 2px 16px 18px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .about-gallery__stage::-webkit-scrollbar {
      display: none;
    }

    .about-gallery__item,
    .about-gallery__item--featured,
    .about-gallery__item--wide {
      flex: 0 0 82vw;
      min-height: 360px;
      scroll-snap-align: center;
    }

    .about-gallery__caption {
      padding: 22px;
    }

    .about-gallery__note {
      margin-left: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Animated Gallery",
  "tag": "section",
  "class": "section-about-animated-gallery",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "THE RAW HOUSE GALLERY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A living archive of craft, material and collected rooms"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "A glimpse into the textures, studios, objects and quiet interior moments that shape The Raw House point of view."
    },
    {
      "type": "textarea",
      "id": "footer_note",
      "label": "Footer note",
      "default": "Each frame can be edited from the theme editor: upload your own imagery, refine the captions, or link a frame to a collection, page, or product."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color scheme",
      "options": [
        { "value": "warm", "label": "Warm atelier" },
        { "value": "light", "label": "Light gallery" },
        { "value": "dark", "label": "Dark editorial" },
        { "value": "obsidian", "label": "Obsidian luxury" }
      ],
      "default": "warm"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom background color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom text color"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Custom accent color"
    },
    {
      "type": "range",
      "id": "grid_row_height",
      "min": 190,
      "max": 340,
      "step": 10,
      "unit": "px",
      "label": "Desktop row height",
      "default": 240
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 68
    }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Gallery item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Fallback asset filename",
          "default": "art-gallery-room-hotspots.jpg"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "MATERIAL STUDY"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Raw textures, hand-finished for the modern home"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Animated Gallery",
      "blocks": [
        {
          "type": "gallery_item",
          "settings": {
            "default_asset": "art-gallery-room-hotspots.jpg",
            "kicker": "GALLERY ROOM",
            "title": "Collected rooms layered with sculpture, furniture and art"
          }
        },
        {
          "type": "gallery_item",
          "settings": {
            "default_asset": "maker-gallery-1.jpg",
            "kicker": "ATELIER",
            "title": "A closer look at the maker's hand"
          }
        },
        {
          "type": "gallery_item",
          "settings": {
            "default_asset": "art-atelier-artist-studio.jpg",
            "kicker": "PROCESS",
            "title": "Objects shaped slowly, with attention to surface and scale"
          }
        },
        {
          "type": "gallery_item",
          "settings": {
            "default_asset": "fine-print-2.jpg",
            "kicker": "ART WALL",
            "title": "Limited prints and visual notes for layered interiors"
          }
        },
        {
          "type": "gallery_item",
          "settings": {
            "default_asset": "maker-gallery-3.jpg",
            "kicker": "DETAILS",
            "title": "Grain, patina and quiet imperfections left beautifully visible"
          }
        },
        {
          "type": "gallery_item",
          "settings": {
            "default_asset": "art-decor-ceramic-statue.jpg",
            "kicker": "OBJECTS",
            "title": "Sculptural accents chosen for presence and proportion"
          }
        }
      ]
    }
  ]
}
{% endschema %}
