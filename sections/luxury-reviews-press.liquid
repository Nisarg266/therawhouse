{%- comment -%}
  THE RAW HOUSE - CLIENT TESTIMONIALS & PRESS REVIEWS SLIDER
  Interactive luxury reviews carousel for desktop and phone with glass navigation arrows, touch swipe, and pagination.
{%- endcomment -%}

{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'warm'
  case scheme
    when 'light'
      assign bg_color = '#ffffff'
      assign heading_color = '#111111'
      assign card_bg = '#faf9f6'
      assign card_border = '#eae6dd'
    when 'dark'
      assign bg_color = '#141414'
      assign heading_color = '#ffffff'
      assign card_bg = '#1d1d1d'
      assign card_border = 'rgba(255, 255, 255, 0.12)'
    when 'obsidian'
      assign bg_color = '#0b0b0b'
      assign heading_color = '#ffffff'
      assign card_bg = 'rgba(255, 255, 255, 0.04)'
      assign card_border = 'rgba(197, 168, 128, 0.25)'
    else
      assign bg_color = '#f9f8f5'
      assign heading_color = '#111111'
      assign card_bg = '#ffffff'
      assign card_border = '#eae6de'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_heading_color != blank and section.settings.custom_heading_color != 'rgba(0,0,0,0)'
    assign heading_color = section.settings.custom_heading_color
  endif
%}

<div
  id="LuxuryReviews-{{ section.id }}"
  class="lux-reviews-section lux-reviews-scheme-{{ scheme }}"
  style="
    --reviews-bg: {{ bg_color }};
    --reviews-heading-color: {{ heading_color }};
    --reviews-card-bg: {{ card_bg }};
    --reviews-card-border: {{ card_border }};
    --reviews-pt: {{ section.settings.padding_top | default: 30 }}px;
    --reviews-pb: {{ section.settings.padding_bottom | default: 48 }}px;
    background: var(--reviews-bg);
    padding-top: var(--reviews-pt);
    padding-bottom: var(--reviews-pb);
  "
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 | times: 1000 }}"
  {{ section.shopify_attributes }}
>
  <div class="lux-reviews-container">
    {% if section.settings.heading != blank %}
      <div class="lux-section-heading-wrap lux-reveal-fade-up">
        {% if section.settings.subheading != blank %}
          <span class="lux-section-subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 class="lux-section-heading">{{ section.settings.heading }}</h2>
        <div class="lux-section-divider"></div>
      </div>
    {% endif %}

    <!-- Reviews Carousel Outer Container -->
    <div class="lux-reviews-carousel-outer lux-reveal-fade-up">
      <!-- Prev Button -->
      <button
        type="button"
        class="lux-reviews-nav-btn lux-reviews-nav-btn--prev"
        aria-label="Previous Review"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Viewport & Slider Track -->
      <div class="lux-reviews-viewport">
        <div class="lux-reviews-track">
          {% for block in section.blocks %}
            <div class="lux-review-slide" {{ block.shopify_attributes }}>
              <div class="lux-review-card">
                <div class="lux-review-stars">
                  {% for i in (1..5) %}
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {% endfor %}
                </div>

                <p class="lux-review-quote">"{{ block.settings.quote }}"</p>

                <div class="lux-review-author-wrap">
                  <div class="lux-review-author-avatar">
                    {{ block.settings.author_name | slice: 0, 1 }}
                  </div>
                  <div>
                    <h4 class="lux-review-author-name">{{ block.settings.author_name }}</h4>
                    <p class="lux-review-author-city">{{ block.settings.author_city }} • <span class="lux-review-verified">Verified Collector ✦</span></p>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Next Button -->
      <button
        type="button"
        class="lux-reviews-nav-btn lux-reviews-nav-btn--next"
        aria-label="Next Review"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Pagination Dots -->
    {% if section.blocks.size > 1 %}
      <div class="lux-reviews-pagination">
        {% for block in section.blocks %}
          <button
            type="button"
            class="lux-reviews-dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Press Strip -->
    {% if section.settings.show_press %}
      <div class="lux-press-strip lux-reveal-fade-up">
        <span class="lux-press-item">{{ section.settings.press_1 | default: 'ARTFORUM' }}</span>
        <span class="lux-press-item">{{ section.settings.press_2 | default: 'ARCHITECTURAL DIGEST' }}</span>
        <span class="lux-press-item">{{ section.settings.press_3 | default: 'VOGUE LIVING' }}</span>
        <span class="lux-press-item">{{ section.settings.press_4 | default: 'FRIEZE' }}</span>
        <span class="lux-press-item">{{ section.settings.press_5 | default: 'ART REVIEW' }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Luxury Reviews & Press",
  "tag": "section",
  "class": "section-luxury-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme & Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color Scheme Preset",
      "options": [
        { "value": "warm", "label": "Warm Atelier Ivory (#f9f8f5)" },
        { "value": "light", "label": "Light Clean (#ffffff)" },
        { "value": "dark", "label": "Contemporary Dark (#141414)" },
        { "value": "obsidian", "label": "Obsidian Gold (#0b0b0b)" }
      ],
      "default": "warm"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_heading_color",
      "label": "Custom Heading Color"
    },
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "THE COLLECTORS' PRAISE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TESTIMONIALS & CRITICAL ACCLAIM"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    },
    {
      "type": "header",
      "content": "Press Publications"
    },
    {
      "type": "checkbox",
      "id": "show_press",
      "label": "Show Press Publications",
      "default": true
    },
    {
      "type": "text",
      "id": "press_1",
      "label": "Press 1",
      "default": "ARTFORUM"
    },
    {
      "type": "text",
      "id": "press_2",
      "label": "Press 2",
      "default": "ARCHITECTURAL DIGEST"
    },
    {
      "type": "text",
      "id": "press_3",
      "label": "Press 3",
      "default": "VOGUE LIVING"
    },
    {
      "type": "text",
      "id": "press_4",
      "label": "Press 4",
      "default": "FRIEZE"
    },
    {
      "type": "text",
      "id": "press_5",
      "label": "Press 5",
      "default": "ART REVIEW"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Client Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The 6ft textured oil canvas and bronze sculpture arrived in custom white-glove museum crating. It completely transformed our penthouse into a living art gallery."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Client Name",
          "default": "Lady Victoria Hastings"
        },
        {
          "type": "text",
          "id": "author_city",
          "label": "Location / City",
          "default": "London, UK"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Reviews & Press",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "The 6ft textured oil canvas and bronze sculpture arrived in custom white-glove museum crating. It completely transformed our penthouse into a living art gallery.",
            "author_name": "Lady Victoria Hastings",
            "author_city": "London, UK"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "The Raw House is in a league of its own. The depth of pigments in their paintings and the raw weight of their hand-cast art models is authentic museum quality.",
            "author_name": "Harrison Vance",
            "author_city": "New York, NY"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Unrivaled curation of modern art paintings and sculptural masterpieces. Every visitor is mesmerized by the bronze statue in our gallery foyer.",
            "author_name": "Sophia Laurent",
            "author_city": "Paris, France"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Acquired two monumental abstract canvases for our private villa in Como. The archival certificate of provenance and custom timber frames are sublime.",
            "author_name": "Matteo Rossi",
            "author_city": "Milan, Italy"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "The sculptural models and carved marble art figures bring an aura of serene elegance that no mass furniture ever could.",
            "author_name": "Dr. Kenji Takahashi",
            "author_city": "Tokyo, Japan"
          }
        }
      ]
    }
  ]
}
{% endschema %}
