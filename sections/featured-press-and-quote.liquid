{%- comment -%}
  Renders "Featured In" press logos and the luxury quote stanza ("Nothing haunts us LIKE THE THINGS we didn't buy").
  Features advanced schema for press blocks, logo customization, typography, and layout spacing.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign heading = section.settings.heading | default: 'Featured In'
  assign show_heading_underline = section.settings.show_heading_underline
  assign max_width = section.settings.max_width | default: 1100
  assign padding_top = section.settings.padding_top | default: 56
  assign padding_bottom = section.settings.padding_bottom | default: 64

  assign show_quote = section.settings.show_quote
  assign quote_line_1 = section.settings.quote_line_1 | default: 'Nothing haunts us'
  assign quote_line_2 = section.settings.quote_line_2 | default: 'LIKE THE THINGS'
  assign quote_line_3 = section.settings.quote_line_3 | default: "we didn't buy"
  assign show_quote_dividers = section.settings.show_quote_dividers
%}

<div
  id="FeaturedPress-{{ section_id }}"
  class="featured-press section-{{ section_id }}"
  style="
    --fp-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --fp-heading-color: {{ section.settings.heading_color | default: '#1a1a1a' }};
    --fp-quote-color: {{ section.settings.quote_color | default: '#2a2a2a' }};
    --fp-line-color: {{ section.settings.divider_color | default: '#222222' }};
    --fp-max-width: {{ max_width }}px;
    --fp-logo-height: {{ section.settings.logo_height | default: 28 }}px;
    --fp-padding-top: {{ padding_top }}px;
    --fp-padding-bottom: {{ padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="featured-press__container">
    
    {%- comment -%} Section Heading {%- endcomment -%}
    {% if heading != blank %}
      <div class="featured-press__header">
        <h2 class="featured-press__heading">{{ heading }}</h2>
        {% if show_heading_underline %}
          <div class="featured-press__underline" aria-hidden="true"></div>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Press Logos List {%- endcomment -%}
    <div class="featured-press__logos">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="featured-press__logo-item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="featured-press__logo-link" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.title | escape }}">
            {% endif %}
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 400 | image_tag: class: 'featured-press__img', loading: 'lazy', alt: block.settings.title }}
              {% elsif block.settings.custom_svg != blank %}
                <div class="featured-press__svg-wrap">{{ block.settings.custom_svg }}</div>
              {% else %}
                <span class="featured-press__logo-text">{{ block.settings.title }}</span>
              {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Press Logos (Ideal Home, GoodHomes, AD, VOGUE, ELLE DECOR, FEMINA) -->
        <div class="featured-press__logo-item">
          <span class="featured-press__logo-text featured-press__logo-text--idealhome">Ideal Home</span>
        </div>
        <div class="featured-press__logo-item">
          <span class="featured-press__logo-text featured-press__logo-text--goodhomes">GoodHomes</span>
        </div>
        <div class="featured-press__logo-item">
          <span class="featured-press__logo-text featured-press__logo-text--ad">AD</span>
        </div>
        <div class="featured-press__logo-item">
          <span class="featured-press__logo-text featured-press__logo-text--vogue">VOGUE</span>
        </div>
        <div class="featured-press__logo-item">
          <span class="featured-press__logo-text featured-press__logo-text--elle">ELLE<br><small>DECOR</small></span>
        </div>
        <div class="featured-press__logo-item">
          <span class="featured-press__logo-text featured-press__logo-text--femina">FEMINA</span>
        </div>
      {% endif %}
    </div>

    {%- comment -%} Quote / Manifesto Stanza {%- endcomment -%}
    {% if show_quote %}
      <div class="featured-press__quote-wrapper">
        {% if show_quote_dividers %}
          <div class="featured-press__quote-divider" aria-hidden="true"></div>
        {% endif %}

        <blockquote class="featured-press__quote">
          {% if quote_line_1 != blank %}
            <span class="featured-press__quote-line featured-press__quote-line--italic">{{ quote_line_1 }}</span>
          {% endif %}
          {% if quote_line_2 != blank %}
            <span class="featured-press__quote-line featured-press__quote-line--caps">{{ quote_line_2 }}</span>
          {% endif %}
          {% if quote_line_3 != blank %}
            <span class="featured-press__quote-line featured-press__quote-line--italic">{{ quote_line_3 }}</span>
          {% endif %}
        </blockquote>

        {% if show_quote_dividers %}
          <div class="featured-press__quote-divider" aria-hidden="true"></div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .featured-press {
    background-color: var(--fp-bg, #ffffff);
    width: 100%;
    padding-block-start: var(--fp-padding-top, 56px);
    padding-block-end: var(--fp-padding-bottom, 64px);
    box-sizing: border-box;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .featured-press__container {
    max-width: var(--fp-max-width, 1100px);
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Header */
  .featured-press__header {
    text-align: center;
    margin-block-end: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .featured-press__heading {
    font-family: Georgia, 'Playfair Display', 'Times New Roman', serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    color: var(--fp-heading-color, #1a1a1a);
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .featured-press__underline {
    width: 36px;
    height: 1.5px;
    background-color: var(--fp-heading-color, #1a1a1a);
    margin-top: 6px;
  }

  /* Logos Row */
  .featured-press__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px 36px;
    width: 100%;
    margin-block-end: 24px;
  }

  @media screen and (min-width: 990px) {
    .featured-press__logos {
      justify-content: space-between;
      gap: 18px 28px;
    }
  }

  .featured-press__logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.88;
    transition: opacity 0.25s ease, transform 0.2s ease;
  }

  .featured-press__logo-item:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .featured-press__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  .featured-press__img {
    max-height: var(--fp-logo-height, 32px);
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
  }

  /* Built-in Brand Logo Typography Stylings */
  .featured-press__logo-text {
    font-family: serif;
    color: #111111;
    display: inline-block;
    letter-spacing: 0.02em;
    user-select: none;
  }

  .featured-press__logo-text--idealhome {
    font-family: 'Century Gothic', 'Trebuchet MS', sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .featured-press__logo-text--goodhomes {
    font-family: 'Georgia', serif;
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.02em;
  }

  .featured-press__logo-text--ad {
    font-family: 'Times New Roman', serif;
    font-weight: 700;
    font-size: 28px;
    letter-spacing: 0.08em;
  }

  .featured-press__logo-text--vogue {
    font-family: 'Didot', 'Bodoni MT', 'Cinzel', serif;
    font-weight: 400;
    font-size: 27px;
    letter-spacing: 0.16em;
  }

  .featured-press__logo-text--elle {
    font-family: 'Didot', 'Bodoni MT', serif;
    font-size: 21px;
    letter-spacing: 0.2em;
    line-height: 1;
    text-align: center;
  }

  .featured-press__logo-text--elle small {
    display: block;
    font-size: 9px;
    letter-spacing: 0.28em;
    font-family: sans-serif;
    margin-top: 2px;
  }

  .featured-press__logo-text--femina {
    font-family: 'Didot', 'Bodoni MT', serif;
    font-size: 23px;
    letter-spacing: 0.24em;
    font-weight: 500;
  }

  /* Quote Stanza */
  .featured-press__quote-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 0;
  }

  .featured-press__quote-divider {
    width: 36px;
    height: 1.5px;
    background-color: var(--fp-line-color, #222222);
    margin: 6px auto;
  }

  .featured-press__quote {
    margin: 4px 0;
    padding: 0;
    border: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .featured-press__quote-line {
    display: block;
    color: var(--fp-quote-color, #2a2a2a);
    text-align: center;
  }

  .featured-press__quote-line--italic {
    font-family: Georgia, 'Playfair Display', 'Times New Roman', serif;
    font-style: italic;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .featured-press__quote-line--caps {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin: 3px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured In & Quote",
  "tag": "section",
  "class": "section-featured-press-and-quote",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured In"
    },
    {
      "type": "checkbox",
      "id": "show_heading_underline",
      "label": "Show Heading Underline",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Quote / Manifesto"
    },
    {
      "type": "checkbox",
      "id": "show_quote",
      "label": "Show Quote Section",
      "default": true
    },
    {
      "type": "text",
      "id": "quote_line_1",
      "label": "Quote Line 1 (Italic)",
      "default": "Nothing haunts us"
    },
    {
      "type": "text",
      "id": "quote_line_2",
      "label": "Quote Line 2 (Uppercase)",
      "default": "LIKE THE THINGS"
    },
    {
      "type": "text",
      "id": "quote_line_3",
      "label": "Quote Line 3 (Italic)",
      "default": "we didn't buy"
    },
    {
      "type": "checkbox",
      "id": "show_quote_dividers",
      "label": "Show Quote Accent Dividers",
      "default": true
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote Text Color",
      "default": "#2a2a2a"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Accent Lines Color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 500,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Max Logo Height",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "press_logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Logo Name",
          "default": "Magazine"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Press Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured In & Quote",
      "settings": {
        "heading": "Featured In",
        "show_quote": true
      },
      "blocks": [
        {
          "type": "press_logo",
          "settings": {
            "title": "Ideal Home"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "title": "GoodHomes"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "title": "AD"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "title": "VOGUE"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "title": "ELLE DECOR"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "title": "FEMINA"
          }
        }
      ]
    }
  ]
}
{% endschema %}
