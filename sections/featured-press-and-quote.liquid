{%- comment -%}
  THE RAW HOUSE — PRESS & QUOTE (LUXP design system)
  Press logo blocks (uploaded logo image or styled text) above an optional
  editorial pull-quote. Fully configurable, completely static.

  @module featured-press-and-quote
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign logo_color = s.logo_color
  if logo_color == blank or logo_color == 'rgba(0,0,0,0)'
    assign logo_color = 'var(--luxp-fg)'
  endif
  assign quote_color = s.quote_color
  if quote_color == blank or quote_color == 'rgba(0,0,0,0)'
    assign quote_color = 'var(--luxp-heading-color)'
  endif
  assign divider_color = s.divider_color
  if divider_color == blank or divider_color == 'rgba(0,0,0,0)'
    assign divider_color = 'var(--luxp-fg)'
  endif
-%}

{%- capture luxp_colors -%}
  {%- render 'luxp-scheme',
    preset: s.color_preset,
    bg: s.color_bg,
    heading: s.color_heading,
    text: s.color_text,
    accent: s.color_accent,
    muted: s.color_muted,
    border: s.color_border
  -%}
{%- endcapture -%}

{%- capture luxp_typo -%}{%- render 'luxp-typo', s: s -%}{%- endcapture -%}

<div
  class="luxp-section luxp-press {% if s.container_mode == 'full' %}luxp-section--full{% endif %} {% if s.enable_animations %}luxp-anim{% endif %} {{ s.custom_class }}"
  style="
    {{ luxp_colors }}
    {{ luxp_typo }}
    --luxp-pt: {{ s.padding_top | default: 56 }}px;
    --luxp-pb: {{ s.padding_bottom | default: 28 }}px;
    --luxp-pt-m: {{ s.padding_top_m | default: 44 }}px;
    --luxp-pb-m: {{ s.padding_bottom_m | default: 24 }}px;
    --luxp-cw: {{ s.container_max | default: 1100 }}px;
    --luxp-px: {{ s.container_padding | default: 32 }}px;
    --luxp-px-m: {{ s.container_padding_m | default: 20 }}px;
    --luxp-header-gap: {{ s.header_gap | default: 10 }}px;
    --luxp-header-mb: {{ s.logos_margin_top | default: 24 }}px;
    --luxp-logos-gap: {{ s.logos_gap | default: 40 }}px;
    --luxp-logo-h: {{ s.logo_height | default: 28 }}px;
    --luxp-logo-opacity: {{ s.logo_opacity | times: 0.01 | default: 1 }};
    --luxp-logo-color: {{ logo_color }};
    --luxp-logo-ls: {{ s.logo_ls | default: '0.14em' }};
    --luxp-logo-weight: {{ s.logo_weight | default: 500 }};
    --luxp-quote-size: {{ s.quote_size | default: 34 }}px;
    --luxp-quote-size-m: {{ s.quote_size_m | default: 24 }}px;
    --luxp-quote-weight: {{ s.quote_weight | default: 400 }};
    {%- if s.quote_font == 'serif' -%}
    --luxp-quote-font: Georgia, 'Times New Roman', serif;
    {%- elsif s.quote_font == 'body' -%}
    --luxp-quote-font: var(--font-body--family);
    {%- else -%}
    --luxp-quote-font: var(--font-heading--family);
    {%- endif -%}
    ;--luxp-quote-lh: {{ s.quote_lh | default: 1.2 }};
    --luxp-quote-ls: {{ s.quote_ls | default: '0.02em' }};
    --luxp-quote-transform: {{ s.quote_transform | default: 'none' }};
    --luxp-quote-color: {{ quote_color }};
    --luxp-quote-divider-color: {{ divider_color }};
    --luxp-quote-gap: {{ s.quote_gap | default: 6 }}px;
  "
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  data-art-motion="off"
  {{ section.shopify_attributes }}
>
  <div class="luxp-container">
    {% if s.heading != blank %}
      <header class="luxp-header luxp-header--center">
        <h2 class="luxp-heading">{{ s.heading }}</h2>
        {% if s.show_ornament %}
          <div class="luxp-ornament" aria-hidden="true">
            <span class="luxp-ornament__line"></span>
            <span class="luxp-ornament__gem">&#9670;</span>
            <span class="luxp-ornament__line"></span>
          </div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="luxp-logos">
        {% for block in section.blocks %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="luxp-logo" {{ block.shopify_attributes }}>
          {% else %}
            <span class="luxp-logo" {{ block.shopify_attributes }}>
          {% endif %}
            {% if block.settings.logo != blank %}
              {{
                block.settings.logo
                | image_url: width: 360
                | image_tag:
                  alt: block.settings.title | default: 'Press logo',
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '120, 240, 360'
              }}
            {% elsif block.settings.title != blank %}
              <span class="luxp-logo__text">{{ block.settings.title }}</span>
            {% endif %}
          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if s.show_quote %}
      <div class="luxp-quote" style="margin-top: {{ s.quote_margin_top | default: 44 }}px;">
        {% if s.quote_line_1 != blank %}
          <p class="luxp-quote__line">{{ s.quote_line_1 }}</p>
        {% endif %}
        {% if s.show_quote_dividers and s.quote_line_1 != blank and s.quote_line_2 != blank %}
          <span class="luxp-quote__divider" aria-hidden="true"></span>
        {% endif %}
        {% if s.quote_line_2 != blank %}
          <p class="luxp-quote__line luxp-quote__line--em">{{ s.quote_line_2 }}</p>
        {% endif %}
        {% if s.show_quote_dividers and s.quote_line_2 != blank and s.quote_line_3 != blank %}
          <span class="luxp-quote__divider" aria-hidden="true"></span>
        {% endif %}
        {% if s.quote_line_3 != blank %}
          <p class="luxp-quote__line">{{ s.quote_line_3 }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* ---- Press & Quote redesign (scoped to .luxp-press) ---- */

  /* Heading: quiet letterspaced label */
  .luxp-press .luxp-heading {
    text-transform: uppercase !important;
    letter-spacing: 0.22em !important;
    margin-inline-end: -0.22em !important;
    font-weight: 500 !important;
    font-size: clamp(14px, 1.5vw, 19px) !important;
  }

  /* Logos: one elegant row on desktop, tidy grid on small screens */
  .luxp-press .luxp-logos {
    display: grid !important;
    grid-template-columns: repeat(6, auto) !important;
    justify-content: center !important;
    align-items: center !important;
    column-gap: clamp(18px, 3.4vw, 48px) !important;
    row-gap: 22px !important;
  }

  .luxp-press .luxp-logo {
    justify-self: center !important;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .luxp-press .luxp-logo:hover,
  .luxp-press .luxp-logo:focus-visible {
    opacity: 1;
  }

  .luxp-press .luxp-logo__text {
    font-size: clamp(13px, 1.2vw, 16px) !important;
    letter-spacing: 0.12em !important;
    font-weight: 500 !important;
    text-transform: uppercase !important;
  }

  /* Quote: editorial serif italic centerpiece */
  .luxp-press .luxp-quote__line {
    font-size: clamp(19px, 2vw, 26px) !important;
    letter-spacing: 0.01em !important;
  }

  .luxp-press .luxp-quote__line--em {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, 'Times New Roman', serif !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: clamp(26px, 3.4vw, 42px) !important;
    letter-spacing: 0.02em !important;
    line-height: 1.15 !important;
  }

  .luxp-press .luxp-quote__divider {
    height: 22px !important;
    opacity: 0.3 !important;
  }

  /* Tablet: 3x2 logo grid */
  @media screen and (max-width: 989px) {
    .luxp-press .luxp-logos {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      column-gap: 12px !important;
      row-gap: 24px !important;
    }
  }

  /* Phone: 2x3 logo grid */
  @media screen and (max-width: 520px) {
    .luxp-press .luxp-logos {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      row-gap: 20px !important;
    }

    .luxp-press .luxp-logo__text {
      font-size: 13px !important;
      letter-spacing: 0.1em !important;
    }

    .luxp-press .luxp-quote__line {
      font-size: 19px !important;
    }

    .luxp-press .luxp-quote__line--em {
      font-size: 27px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Press & Quote",
  "tag": "section",
  "class": "section-luxp-press",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured In" },
    { "type": "checkbox", "id": "show_ornament", "label": "Show ornament divider", "default": true },
    { "type": "range", "id": "logos_margin_top", "min": 8, "max": 64, "step": 2, "unit": "px", "label": "Space below heading", "default": 24 },
    { "type": "range", "id": "header_gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Heading element spacing", "default": 10 },

    { "type": "header", "content": "Press Logos" },
    { "type": "range", "id": "logo_height", "min": 16, "max": 56, "step": 2, "unit": "px", "label": "Logo height", "default": 28 },
    { "type": "range", "id": "logos_gap", "min": 12, "max": 72, "step": 2, "unit": "px", "label": "Gap between logos — desktop", "default": 40 },
    { "type": "range", "id": "logo_opacity", "min": 30, "max": 100, "step": 5, "unit": "%", "label": "Logo opacity", "default": 100 },
    { "type": "color", "id": "logo_color", "label": "Text logo color", "info": "Used when no logo image is uploaded. Blank uses the text color." },
    { "type": "select", "id": "logo_weight", "label": "Text logo weight", "options": [
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" },
      { "value": "700", "label": "Bold 700" }
    ], "default": "500" },
    { "type": "select", "id": "logo_ls", "label": "Text logo letter spacing", "options": [ { "value": "0.06em", "label": "0.06em" }, { "value": "0.1em", "label": "0.1em" }, { "value": "0.14em", "label": "0.14em" }, { "value": "0.18em", "label": "0.18em" }, { "value": "0.24em", "label": "0.24em" } ], "default": "0.14em" },

    { "type": "header", "content": "Quote" },
    { "type": "checkbox", "id": "show_quote", "label": "Show quote", "default": true },
    { "type": "text", "id": "quote_line_1", "label": "Line 1", "default": "Nothing haunts us" },
    { "type": "text", "id": "quote_line_2", "label": "Line 2 (emphasized)", "default": "LIKE THE THINGS" },
    { "type": "text", "id": "quote_line_3", "label": "Line 3", "default": "we didn't buy" },
    { "type": "checkbox", "id": "show_quote_dividers", "label": "Show dividers between lines", "default": true },
    { "type": "range", "id": "quote_margin_top", "min": 16, "max": 96, "step": 4, "unit": "px", "label": "Space above quote", "default": 44 },
    { "type": "range", "id": "quote_gap", "min": 0, "max": 20, "step": 1, "unit": "px", "label": "Gap between quote lines", "default": 6 },

    { "type": "header", "content": "Typography — Quote" },
    { "type": "select", "id": "quote_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
      { "value": "serif", "label": "Serif (Georgia)" }
    ], "default": "heading" },
    { "type": "range", "id": "quote_size", "min": 20, "max": 64, "step": 1, "unit": "px", "label": "Font size — desktop", "default": 34 },
    { "type": "range", "id": "quote_size_m", "min": 16, "max": 44, "step": 1, "unit": "px", "label": "Font size — mobile", "default": 24 },
    { "type": "select", "id": "quote_weight", "label": "Font weight", "options": [
      { "value": "300", "label": "Light 300" },
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" }
    ], "default": "400" },
    { "type": "range", "id": "quote_lh", "min": 1, "max": 1.8, "step": 0.1, "label": "Line height", "default": 1.2 },
    { "type": "select", "id": "quote_ls", "label": "Letter spacing", "options": [ { "value": "0em", "label": "None" }, { "value": "0.01em", "label": "0.01em" }, { "value": "0.02em", "label": "0.02em" }, { "value": "0.04em", "label": "0.04em" }, { "value": "0.08em", "label": "0.08em" } ], "default": "0.02em" },
    { "type": "select", "id": "quote_transform", "label": "Text transform", "options": [
      { "value": "none", "label": "None" },
      { "value": "uppercase", "label": "Uppercase" }
    ], "default": "none" },
    { "type": "color", "id": "quote_color", "label": "Quote color", "info": "Blank uses the heading color.", "default": "#2a2a2a" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#222222" },

    { "type": "header", "content": "Typography — Heading" },
    { "type": "select", "id": "heading_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
      { "value": "subheading", "label": "Theme subheading font" },
      { "value": "accent", "label": "Theme accent font" },
      { "value": "serif", "label": "Serif (Georgia)" }
    ], "default": "heading" },
    { "type": "range", "id": "heading_size", "min": 14, "max": 48, "step": 1, "unit": "px", "label": "Font size — desktop", "default": 22 },
    { "type": "range", "id": "heading_size_m", "min": 12, "max": 36, "step": 1, "unit": "px", "label": "Font size — mobile", "default": 19 },
    { "type": "select", "id": "heading_weight", "label": "Font weight", "options": [
      { "value": "300", "label": "Light 300" },
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" }
    ], "default": "400" },
    { "type": "range", "id": "heading_lh", "min": 1, "max": 1.8, "step": 0.1, "label": "Line height", "default": 1.2 },
    { "type": "select", "id": "heading_ls", "label": "Letter spacing", "options": [ { "value": "0em", "label": "None" }, { "value": "0.02em", "label": "0.02em" }, { "value": "0.04em", "label": "0.04em" }, { "value": "0.08em", "label": "0.08em" }, { "value": "0.12em", "label": "0.12em" } ], "default": "0.04em" },
    { "type": "select", "id": "heading_transform", "label": "Text transform", "options": [
      { "value": "none", "label": "None" },
      { "value": "uppercase", "label": "Uppercase" }
    ], "default": "none" },
    { "type": "range", "id": "heading_max_width", "min": 40, "max": 100, "step": 5, "unit": "%", "label": "Max width", "default": 100 },

    { "type": "header", "content": "Colors" },
    { "type": "select", "id": "color_preset", "label": "Color scheme preset", "options": [
      { "value": "light", "label": "Light Clean (White)" },
      { "value": "warm", "label": "Warm Atelier (Ivory)" },
      { "value": "dark", "label": "Dark Contemporary" },
      { "value": "obsidian", "label": "Obsidian Gold" }
    ], "default": "light" },
    { "type": "color", "id": "color_bg", "label": "Background color override", "default": "#ffffff" },
    { "type": "color", "id": "color_heading", "label": "Heading color override", "default": "#1a1a1a" },
    { "type": "color", "id": "color_text", "label": "Text color override", "default": "#4a4a4a" },
    { "type": "color", "id": "color_accent", "label": "Accent color override", "default": "#b08d57" },
    { "type": "color", "id": "color_muted", "label": "Muted text override" },
    { "type": "color", "id": "color_border", "label": "Border color override" },

    { "type": "header", "content": "Layout & Spacing" },
    { "type": "select", "id": "container_mode", "label": "Container mode", "options": [
      { "value": "fixed", "label": "Container (max width)" },
      { "value": "full", "label": "Full width" }
    ], "default": "fixed" },
    { "type": "range", "id": "container_max", "min": 640, "max": 1400, "step": 20, "unit": "px", "label": "Container max width", "default": 1100 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top — desktop", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom — desktop", "default": 28 },
    { "type": "range", "id": "padding_top_m", "min": 0, "max": 88, "step": 4, "unit": "px", "label": "Padding top — mobile", "default": 44 },
    { "type": "range", "id": "padding_bottom_m", "min": 0, "max": 88, "step": 4, "unit": "px", "label": "Padding bottom — mobile", "default": 24 },
    { "type": "range", "id": "container_padding", "min": 0, "max": 64, "step": 2, "unit": "px", "label": "Container side padding — desktop", "default": 32 },
    { "type": "range", "id": "container_padding_m", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Container side padding — mobile", "default": 20 },

    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable subtle motion", "info": "Off by default — the section renders completely static.", "default": false },

    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "blocks": [
    {
      "type": "press_logo",
      "name": "Press Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Transparent PNG/SVG-style images work best." },
        { "type": "text", "id": "title", "label": "Text fallback", "info": "Shown when no logo image is uploaded.", "default": "VOGUE" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional — makes the logo clickable." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press & Quote",
      "blocks": [
        { "type": "press_logo", "settings": { "title": "Ideal Home" } },
        { "type": "press_logo", "settings": { "title": "GoodHomes India" } },
        { "type": "press_logo", "settings": { "title": "AD" } },
        { "type": "press_logo", "settings": { "title": "VOGUE" } },
        { "type": "press_logo", "settings": { "title": "ELLE DECOR" } },
        { "type": "press_logo", "settings": { "title": "FEMINA" } }
      ]
    }
  ]
}
{% endschema %}
