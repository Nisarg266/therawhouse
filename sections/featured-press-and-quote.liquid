{%- comment -%}
  THE RAW HOUSE — PRESS & QUOTE (LUXP design system)
  Press logo blocks (uploaded logo image or styled text) above an optional
  editorial pull-quote. Fully configurable, completely static.

  @module featured-press-and-quote
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign logo_color = s.logo_color
  if logo_color == blank or logo_color == 'rgba(0,0,0,0)'
    assign logo_color = 'var(--luxp-fg)'
  endif
  assign quote_color = s.quote_color
  if quote_color == blank or quote_color == 'rgba(0,0,0,0)'
    assign quote_color = 'var(--luxp-heading-color)'
  endif
  assign divider_color = s.divider_color
  if divider_color == blank or divider_color == 'rgba(0,0,0,0)'
    assign divider_color = 'var(--luxp-fg)'
  endif
-%}

{%- capture luxp_colors -%}
  {%- render 'luxp-scheme',
    preset: s.color_preset,
    bg: s.color_bg,
    heading: s.color_heading,
    text: s.color_text,
    accent: s.color_accent,
    muted: s.color_muted,
    border: s.color_border
  -%}
{%- endcapture -%}

{%- capture luxp_typo -%}{%- render 'luxp-typo', s: s -%}{%- endcapture -%}

<div
  class="luxp-section luxp-press {% if s.container_mode == 'full' %}luxp-section--full{% endif %} {% if s.enable_animations %}luxp-anim{% endif %} {{ s.custom_class }}"
  style="
    {{ luxp_colors }}
    {{ luxp_typo }}
    --luxp-pt: {{ s.padding_top | default: 20 }}px;
    --luxp-pb: {{ s.padding_bottom | default: 16 }}px;
    --luxp-pt-m: {{ s.padding_top_m | default: 16 }}px;
    --luxp-pb-m: {{ s.padding_bottom_m | default: 14 }}px;
    --luxp-cw: {{ s.container_max | default: 1100 }}px;
    --luxp-px: {{ s.container_padding | default: 32 }}px;
    --luxp-px-m: {{ s.container_padding_m | default: 20 }}px;
    --luxp-header-gap: {{ s.header_gap | default: 6 }}px;
    --luxp-header-mb: {{ s.logos_margin_top | default: 10 }}px;
    --luxp-logos-gap: {{ s.logos_gap | default: 40 }}px;
    --luxp-logo-h: {{ s.logo_height | default: 28 }}px;
    --luxp-logo-opacity: {{ s.logo_opacity | times: 0.01 | default: 1 }};
    --luxp-logo-color: {{ logo_color }};
    --luxp-logo-ls: {{ s.logo_ls | default: '0.14em' }};
    --luxp-logo-weight: {{ s.logo_weight | default: 500 }};
    --luxp-quote-size: {{ s.quote_size | default: 34 }}px;
    --luxp-quote-size-m: {{ s.quote_size_m | default: 24 }}px;
    --luxp-quote-weight: {{ s.quote_weight | default: 400 }};
    {%- if s.quote_font == 'serif' -%}
    --luxp-quote-font: Georgia, 'Times New Roman', serif;
    {%- elsif s.quote_font == 'body' -%}
    --luxp-quote-font: var(--font-body--family);
    {%- else -%}
    --luxp-quote-font: var(--font-heading--family);
    {%- endif -%}
    ;--luxp-quote-lh: {{ s.quote_lh | default: 1.2 }};
    --luxp-quote-ls: {{ s.quote_ls | default: '0.02em' }};
    --luxp-quote-transform: {{ s.quote_transform | default: 'none' }};
    --luxp-quote-color: {{ quote_color }};
    --luxp-quote-divider-color: {{ divider_color }};
    --luxp-quote-gap: {{ s.quote_gap | default: 6 }}px;
  "
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  data-art-motion="off"
  {{ section.shopify_attributes }}
>
  <div class="luxp-container">
    {% if s.heading != blank %}
      <header class="luxp-header luxp-header--center">
        {% if s.eyebrow != blank %}
          <p class="luxp-eyebrow">{{ s.eyebrow | upcase }}</p>
        {% endif %}
        <h2 class="luxp-heading">{{ s.heading }}</h2>
        {% if s.show_ornament %}
          <div class="luxp-ornament" aria-hidden="true">
            <span class="luxp-ornament__line"></span>
            <span class="luxp-ornament__gem">&#9670;</span>
            <span class="luxp-ornament__line"></span>
          </div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {%- assign logo_cols = section.blocks.size | at_most: 6 -%}
      <div class="luxp-logos luxp-logos--count-{{ section.blocks.size }}" style="--luxp-logo-cols: {{ logo_cols }};">
        {% for block in section.blocks %}
          {%- assign logo_handle = block.settings.title | handleize -%}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="luxp-logo luxp-logo--{{ logo_handle }}" {{ block.shopify_attributes }}>
          {% else %}
            <span class="luxp-logo luxp-logo--{{ logo_handle }}" {{ block.shopify_attributes }}>
          {% endif %}
            {% if block.settings.logo != blank %}
              {{
                block.settings.logo
                | image_url: width: 360
                | image_tag:
                  alt: block.settings.title | default: 'Press logo',
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '120, 240, 360'
              }}
            {% elsif block.settings.title != blank %}
              <span class="luxp-logo__text luxp-logo__text--{{ logo_handle }}">{{ block.settings.title }}</span>
            {% endif %}
          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if s.show_quote %}
      <div class="luxp-press__bridge" aria-hidden="true">
        <span class="luxp-press__bridge-line"></span>
        <span class="luxp-press__bridge-gem">&#9670;</span>
        <span class="luxp-press__bridge-line"></span>
      </div>

      <div class="luxp-quote-plaque">
        <div class="luxp-quote">
          {% if s.quote_line_1 != blank %}
            <p class="luxp-quote__line luxp-quote__line--lead">{{ s.quote_line_1 }}</p>
          {% endif %}
          {% if s.show_quote_dividers and s.quote_line_1 != blank and s.quote_line_2 != blank %}
            <span class="luxp-quote__divider" aria-hidden="true"></span>
          {% endif %}
          {% if s.quote_line_2 != blank %}
            <p class="luxp-quote__line luxp-quote__line--em">{{ s.quote_line_2 }}</p>
          {% endif %}
          {% if s.show_quote_dividers and s.quote_line_2 != blank and s.quote_line_3 != blank %}
            <span class="luxp-quote__divider" aria-hidden="true"></span>
          {% endif %}
          {% if s.quote_line_3 != blank %}
            <p class="luxp-quote__line luxp-quote__line--tail">{{ s.quote_line_3 }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* ---- Ultra-Luxury Press & Editorial Quote System ---- */

  .luxp-press {
    position: relative;
  }

  /* Section Heading: Quiet, letterspaced prestige title */
  .luxp-press .luxp-heading {
    text-transform: uppercase !important;
    letter-spacing: clamp(0.22em, 0.32vw, 0.35em) !important;
    margin-inline-end: calc(-1 * clamp(0.22em, 0.32vw, 0.35em)) !important;
    font-weight: 500 !important;
    font-size: clamp(15px, 1.6vw, 20px) !important;
    color: var(--luxp-heading-color, #111111) !important;
    margin: 0 0 4px 0 !important;
    line-height: 1.2 !important;
    text-align: center !important;
  }

  /* Refined Top Ornament */
  .luxp-press .luxp-ornament {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    margin: 0 auto 10px !important;
    width: min(160px, 45vw) !important;
  }

  .luxp-press .luxp-ornament__line {
    height: 1px !important;
    flex: 1 !important;
    background: linear-gradient(90deg, transparent, var(--luxp-accent, #b08d57), transparent) !important;
    opacity: 0.65 !important;
  }

  .luxp-press .luxp-ornament__gem {
    color: var(--luxp-accent, #b08d57) !important;
    font-size: 7px !important;
    line-height: 1 !important;
    opacity: 0.8 !important;
  }

  /* Logos: Master Editorial Flex Row (Eliminates Collisions & Overlaps) */
  .luxp-press .luxp-logos {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 12px clamp(20px, 3.5vw, 48px) !important;
    max-width: 1080px !important;
    margin: 0 auto !important;
    padding-inline: 16px !important;
  }

  .luxp-press .luxp-logo {
    display: inline-flex !important;
    flex: 0 0 auto !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    min-height: 36px !important;
    padding: 6px 8px !important;
    border-radius: 3px !important;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1) !important;
    position: relative !important;
    opacity: 0.85;
  }

  .luxp-press .luxp-logo:hover,
  .luxp-press .luxp-logo:focus-visible {
    opacity: 1 !important;
    transform: translateY(-2px) !important;
  }

  .luxp-press .luxp-logo:hover .luxp-logo__text {
    color: var(--luxp-accent, #b08d57) !important;
  }

  .luxp-press .luxp-logo__text {
    font-family: var(--font-body--family, sans-serif);
    font-size: clamp(12px, 1.05vw, 14px) !important;
    letter-spacing: clamp(0.12em, 0.16vw, 0.18em) !important;
    font-weight: 500 !important;
    text-transform: uppercase !important;
    color: var(--luxp-logo-color, #2a2825) !important;
    white-space: nowrap !important;
    text-align: center !important;
    transition: color 0.3s ease !important;
  }

  /* Bespoke typography signatures for legendary publications */
  .luxp-press .luxp-logo__text--vogue {
    font-family: 'Didot', 'Bodoni MT', 'Cinzel', 'Playfair Display', Georgia, serif !important;
    font-weight: 700 !important;
    letter-spacing: 0.22em !important;
    font-size: clamp(13px, 1.15vw, 15.5px) !important;
  }

  .luxp-press .luxp-logo__text--ad {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif !important;
    font-weight: 700 !important;
    letter-spacing: 0.18em !important;
    font-size: clamp(14px, 1.2vw, 16.5px) !important;
  }

  .luxp-press .luxp-logo__text--elle-decor {
    font-family: 'Cinzel', 'Playfair Display', sans-serif !important;
    letter-spacing: 0.18em !important;
    font-weight: 500 !important;
  }

  .luxp-press .luxp-logo__text--goodhomes-india {
    letter-spacing: 0.1em !important;
    font-weight: 500 !important;
    font-size: clamp(11.5px, 0.95vw, 13.5px) !important;
  }

  .luxp-press .luxp-logo__text--ideal-home {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    letter-spacing: 0.16em !important;
    font-weight: 600 !important;
  }

  .luxp-press .luxp-logo__text--femina {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif !important;
    letter-spacing: 0.2em !important;
    font-weight: 500 !important;
  }

  .luxp-press .luxp-logo img {
    max-height: var(--luxp-logo-h, 28px) !important;
    width: auto !important;
    max-width: 100% !important;
    object-fit: contain !important;
    filter: grayscale(100%) !important;
    opacity: 0.8 !important;
    transition: all 0.3s ease !important;
  }

  .luxp-press .luxp-logo:hover img {
    filter: grayscale(0%) !important;
    opacity: 1 !important;
  }

  /* Editorial Bridge Divider */
  .luxp-press .luxp-press__bridge {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
    margin: 10px auto !important;
    max-width: 200px !important;
  }

  .luxp-press .luxp-press__bridge-line {
    flex: 1 !important;
    height: 1px !important;
    background: linear-gradient(90deg, transparent, rgba(176, 141, 87, 0.45), transparent) !important;
  }

  .luxp-press .luxp-press__bridge-gem {
    color: var(--luxp-accent, #b08d57) !important;
    font-size: 7px !important;
    line-height: 1 !important;
    opacity: 0.75 !important;
  }

  /* Quote Plaque & Vignette */
  .luxp-press .luxp-quote-plaque {
    max-width: 640px !important;
    margin: 0 auto !important;
    padding: 12px clamp(16px, 3vw, 36px) !important;
    background: rgba(253, 252, 250, 0.65) !important;
    border: 1px solid rgba(176, 141, 87, 0.2) !important;
    border-radius: 3px !important;
    position: relative !important;
    box-shadow: 0 4px 20px -6px rgba(0, 0, 0, 0.025) !important;
  }

  .luxp-press .luxp-quote-plaque::before {
    content: '' !important;
    position: absolute !important;
    inset: 3px !important;
    border: 1px solid rgba(176, 141, 87, 0.1) !important;
    pointer-events: none !important;
    border-radius: 2px !important;
  }

  .luxp-press .luxp-quote {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    max-width: 100% !important;
    margin: 0 auto !important;
  }

  .luxp-press .luxp-quote__line {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-style: italic !important;
    font-size: clamp(15px, 1.5vw, 19px) !important;
    font-weight: 400 !important;
    letter-spacing: 0.05em !important;
    color: #635f58 !important;
    margin: 0 !important;
    line-height: 1.15 !important;
  }

  .luxp-press .luxp-quote__line--lead {
    color: #5c5852 !important;
  }

  .luxp-press .luxp-quote__line--em {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, 'Times New Roman', serif !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(26px, 4.2vw, 44px) !important;
    letter-spacing: 0.07em !important;
    line-height: 1.05 !important;
    color: var(--luxp-heading-color, #141414) !important;
    margin: 2px 0 !important;
    text-transform: uppercase !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.03) !important;
  }

  .luxp-press .luxp-quote__line--tail {
    color: #5c5852 !important;
  }

  .luxp-press .luxp-quote__divider {
    display: block !important;
    margin: 4px auto !important;
    height: 10px !important;
    width: 1px !important;
    background: linear-gradient(180deg, transparent, var(--luxp-accent, #b08d57) 35%, var(--luxp-accent, #b08d57) 65%, transparent) !important;
    opacity: 0.75 !important;
  }

  /* Tablet Breakpoint: 641px - 989px */
  @media screen and (min-width: 641px) and (max-width: 989px) {
    .luxp-press .luxp-logos {
      display: flex !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      gap: 12px clamp(16px, 2.5vw, 28px) !important;
      max-width: 760px !important;
    }

    .luxp-press .luxp-quote-plaque {
      max-width: 580px !important;
      padding: 12px 18px !important;
    }

    .luxp-press .luxp-quote__line--em {
      font-size: clamp(26px, 4.5vw, 38px) !important;
    }
  }

  /* Mobile Breakpoint: <= 640px */
  @media screen and (max-width: 640px) {
    .luxp-press .luxp-logos {
      display: flex !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      gap: 10px clamp(12px, 3.2vw, 22px) !important;
      padding-inline: 12px !important;
      max-width: 100% !important;
    }

    .luxp-press .luxp-logo {
      min-height: 32px !important;
      padding: 4px 6px !important;
    }

    .luxp-press .luxp-logo__text {
      font-size: clamp(10.5px, 2.8vw, 12px) !important;
      letter-spacing: 0.12em !important;
      text-align: center !important;
    }

    .luxp-press .luxp-logo__text--goodhomes-india {
      font-size: clamp(9.5px, 2.5vw, 11px) !important;
      letter-spacing: 0.08em !important;
    }

    .luxp-press .luxp-press__bridge {
      margin: 8px auto !important;
      max-width: 160px !important;
    }

    .luxp-press .luxp-quote-plaque {
      max-width: 100% !important;
      padding: 10px 12px !important;
      margin-inline: 6px !important;
    }

    .luxp-press .luxp-quote-plaque::before {
      inset: 2px !important;
    }

    .luxp-press .luxp-quote__line {
      font-size: 14px !important;
      line-height: 1.15 !important;
    }

    .luxp-press .luxp-quote__line--em {
      font-size: clamp(24px, 6.8vw, 32px) !important;
      letter-spacing: 0.05em !important;
      margin: 1px 0 !important;
      line-height: 1.05 !important;
    }

    .luxp-press .luxp-quote__divider {
      height: 8px !important;
      margin: 3px auto !important;
    }
  }

  /* Small Mobile Breakpoint: <= 380px */
  @media screen and (max-width: 380px) {
    .luxp-press .luxp-logos {
      display: flex !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      gap: 8px 12px !important;
    }

    .luxp-press .luxp-logo__text {
      font-size: 10px !important;
      letter-spacing: 0.09em !important;
    }

    .luxp-press .luxp-logo__text--goodhomes-india {
      font-size: 9px !important;
      letter-spacing: 0.06em !important;
    }

    .luxp-press .luxp-quote__line--em {
      font-size: 26px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Press & Quote",
  "tag": "section",
  "class": "section-luxp-press",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (Optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured In" },
    { "type": "checkbox", "id": "show_ornament", "label": "Show ornament divider", "default": true },
    { "type": "range", "id": "logos_margin_top", "min": 8, "max": 64, "step": 2, "unit": "px", "label": "Space below heading", "default": 24 },
    { "type": "range", "id": "header_gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Heading element spacing", "default": 10 },

    { "type": "header", "content": "Press Logos" },
    { "type": "range", "id": "logo_height", "min": 16, "max": 56, "step": 2, "unit": "px", "label": "Logo height", "default": 28 },
    { "type": "range", "id": "logos_gap", "min": 12, "max": 72, "step": 2, "unit": "px", "label": "Gap between logos — desktop", "default": 40 },
    { "type": "range", "id": "logo_opacity", "min": 30, "max": 100, "step": 5, "unit": "%", "label": "Logo opacity", "default": 100 },
    { "type": "color", "id": "logo_color", "label": "Text logo color", "info": "Used when no logo image is uploaded. Blank uses the text color." },
    { "type": "select", "id": "logo_weight", "label": "Text logo weight", "options": [
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" },
      { "value": "700", "label": "Bold 700" }
    ], "default": "500" },
    { "type": "select", "id": "logo_ls", "label": "Text logo letter spacing", "options": [ { "value": "0.06em", "label": "0.06em" }, { "value": "0.1em", "label": "0.1em" }, { "value": "0.14em", "label": "0.14em" }, { "value": "0.18em", "label": "0.18em" }, { "value": "0.24em", "label": "0.24em" } ], "default": "0.14em" },

    { "type": "header", "content": "Quote" },
    { "type": "checkbox", "id": "show_quote", "label": "Show quote", "default": true },
    { "type": "text", "id": "quote_line_1", "label": "Line 1", "default": "Nothing haunts us" },
    { "type": "text", "id": "quote_line_2", "label": "Line 2 (emphasized)", "default": "LIKE THE THINGS" },
    { "type": "text", "id": "quote_line_3", "label": "Line 3", "default": "we didn't buy" },
    { "type": "checkbox", "id": "show_quote_dividers", "label": "Show dividers between lines", "default": true },
    { "type": "range", "id": "quote_margin_top", "min": 16, "max": 96, "step": 4, "unit": "px", "label": "Space above quote", "default": 44 },
    { "type": "range", "id": "quote_gap", "min": 0, "max": 20, "step": 1, "unit": "px", "label": "Gap between quote lines", "default": 6 },

    { "type": "header", "content": "Typography — Quote" },
    { "type": "select", "id": "quote_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
      { "value": "serif", "label": "Serif (Georgia)" }
    ], "default": "heading" },
    { "type": "range", "id": "quote_size", "min": 20, "max": 64, "step": 1, "unit": "px", "label": "Font size — desktop", "default": 34 },
    { "type": "range", "id": "quote_size_m", "min": 16, "max": 44, "step": 1, "unit": "px", "label": "Font size — mobile", "default": 24 },
    { "type": "select", "id": "quote_weight", "label": "Font weight", "options": [
      { "value": "300", "label": "Light 300" },
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" }
    ], "default": "400" },
    { "type": "range", "id": "quote_lh", "min": 1, "max": 1.8, "step": 0.1, "label": "Line height", "default": 1.2 },
    { "type": "select", "id": "quote_ls", "label": "Letter spacing", "options": [ { "value": "0em", "label": "None" }, { "value": "0.01em", "label": "0.01em" }, { "value": "0.02em", "label": "0.02em" }, { "value": "0.04em", "label": "0.04em" }, { "value": "0.08em", "label": "0.08em" } ], "default": "0.02em" },
    { "type": "select", "id": "quote_transform", "label": "Text transform", "options": [
      { "value": "none", "label": "None" },
      { "value": "uppercase", "label": "Uppercase" }
    ], "default": "none" },
    { "type": "color", "id": "quote_color", "label": "Quote color", "info": "Blank uses the heading color.", "default": "#2a2a2a" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#222222" },

    { "type": "header", "content": "Typography — Heading" },
    { "type": "select", "id": "heading_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
