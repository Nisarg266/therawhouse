{{ 'showcase-cities.css' | asset_url | stylesheet_tag }}
<script src="{{ 'showcase-cities.js' | asset_url }}" defer></script>

<section id="CityIntroSection-{{ section.id }}" class="city-intro" aria-labelledby="CityIntro-{{ section.id }}">
  <div class="city-showcase__container">
    <p class="city-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 id="CityIntro-{{ section.id }}" class="city-intro__heading">{{ section.settings.heading | escape }}</h1>
    <div class="city-intro__index" data-city-index hidden>
      <div role="tablist" aria-label="{{ section.settings.index_label | escape }}" data-city-tabs></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Showcase introduction",
  "tag": "section",
  "class": "section-city-intro",
  "settings": [
    { "type": "paragraph", "content": "Each City showcase section below becomes a tab. Only the selected city's description and gallery are displayed." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CITY CONNECTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Showcases" },
    { "type": "text", "id": "index_label", "label": "Accessible city tabs label", "default": "Cities" }
  ],
  "presets": [{ "name": "Showcase introduction" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
