{{ 'showcase-cities.css' | asset_url | stylesheet_tag }}
<script src="{{ 'showcase-cities.js' | asset_url }}" defer></script>

<section class="city-intro" aria-labelledby="CityIntro-{{ section.id }}">
  <div class="city-showcase__container">
    <p class="city-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <div class="city-intro__layout">
      <h1 id="CityIntro-{{ section.id }}" class="city-intro__heading">
        {{ section.settings.heading | escape }}
        <em>{{ section.settings.heading_second | escape }}</em>
      </h1>
      <div class="city-intro__aside">
        <div class="city-intro__text">{{ section.settings.description }}</div>
        <span class="city-intro__signature">{{ section.settings.signature | escape }}</span>
      </div>
    </div>
    <nav class="city-intro__index" aria-label="{{ section.settings.index_label | escape }}" data-city-index hidden>
      <span class="city-showcase__eyebrow">{{ section.settings.index_label | escape }}</span>
      <div data-city-links></div>
    </nav>
  </div>
</section>

{% schema %}
{
  "name": "Showcase introduction",
  "tag": "section",
  "class": "section-city-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE RAW HOUSE / SHOWCASES" },
    { "type": "text", "id": "heading", "label": "Heading first line", "default": "City" },
    { "type": "text", "id": "heading_second", "label": "Heading second line", "default": "Connects." },
    { "type": "richtext", "id": "description", "label": "Introduction", "default": "<p>Indian design, art and craft, brought together in a new city. A series of showcases, conversations and encounters by The Raw House.</p>" },
    { "type": "text", "id": "signature", "label": "Closing line", "default": "A new city. A shared appreciation." },
    { "type": "text", "id": "index_label", "label": "City navigation label", "default": "EXPLORE THE CHAPTERS" }
  ],
  "presets": [{ "name": "Showcase introduction" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
