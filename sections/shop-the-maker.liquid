{%- comment -%}
  Renders a luxury editorial "Shop The Maker" gallery section with top landscape + bottom 2-column layout and scroll animations.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign heading = section.settings.heading | default: 'SHOP THE MAKER'
  assign heading_link = section.settings.heading_link
  assign show_underline = section.settings.show_underline
  assign gap = section.settings.gap
  assign corner_radius = section.settings.corner_radius
  assign enable_hover_zoom = section.settings.enable_hover_zoom
  assign enable_scroll_animation = section.settings.enable_scroll_animation

  assign top_image = section.settings.top_image
  assign top_image_link = section.settings.top_image_link
  assign top_image_alt = section.settings.top_image_alt | default: heading

  assign bottom_left_image = section.settings.bottom_left_image
  assign bottom_left_link = section.settings.bottom_left_link
  assign bottom_left_alt = section.settings.bottom_left_alt | default: heading

  assign bottom_right_image = section.settings.bottom_right_image
  assign bottom_right_link = section.settings.bottom_right_link
  assign bottom_right_alt = section.settings.bottom_right_alt | default: heading
%}

<div
  id="ShopTheMaker-{{ section_id }}"
  class="shop-the-maker section-{{ section_id }}{% if enable_scroll_animation %} scroll-trigger-section{% endif %}"
  style="
    --stm-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --stm-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --stm-heading-size: {{ section.settings.heading_size }}px;
    --stm-heading-spacing: {{ section.settings.heading_letter_spacing }};
    --stm-heading-weight: {{ section.settings.heading_weight }};
    --stm-gap: {{ gap }}px;
    --stm-radius: {{ corner_radius }}px;
    --stm-max-width: {{ section.settings.max_width }}px;
    --stm-padding-top: {{ section.settings.padding_top }}px;
    --stm-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="shop-the-maker__container">
    
    {%- comment -%} Section Header Link / Title {%- endcomment -%}
    {% if heading != blank %}
      <div class="shop-the-maker__header-wrapper{% if enable_scroll_animation %} scroll-trigger-element{% endif %}">
        {% if heading_link != blank %}
          <a
            href="{{ heading_link }}"
            class="shop-the-maker__heading-link{% if show_underline %} shop-the-maker__heading-link--underline{% endif %}"
          >
            <span class="shop-the-maker__heading-text">{{ heading }}</span>
          </a>
        {% else %}
          <div class="shop-the-maker__heading-text-wrapper{% if show_underline %} shop-the-maker__heading-text-wrapper--underline{% endif %}">
            <span class="shop-the-maker__heading-text">{{ heading }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Editorial Gallery Grid {%- endcomment -%}
    <div class="shop-the-maker__grid">
      
      {%- comment -%} 1. Top Full Width Landscape Image {%- endcomment -%}
      <div class="shop-the-maker__item shop-the-maker__item--top{% if enable_scroll_animation %} scroll-trigger-element{% endif %}" style="--animation-delay: 0.1s;">
        {% if top_image_link != blank %}
          <a href="{{ top_image_link }}" class="shop-the-maker__link" aria-label="{{ top_image_alt }}">
        {% endif %}
          <div class="shop-the-maker__media-wrapper{% if enable_hover_zoom %} shop-the-maker__media--zoom{% endif %}">
            {% if top_image != blank %}
              <img
                src="{{ top_image | image_url: width: 2000 }}"
                alt="{{ top_image.alt | default: top_image_alt | escape }}"
                loading="lazy"
                class="shop-the-maker__img"
                width="1200"
                height="675"
              >
            {% else %}
              <img
                src="{{ 'maker-gallery-1.jpg' | asset_url }}"
                alt="{{ top_image_alt | escape }}"
                loading="lazy"
                class="shop-the-maker__img"
                width="1200"
                height="675"
              >
            {% endif %}
          </div>
        {% if top_image_link != blank %}
          </a>
        {% endif %}
      </div>

      {%- comment -%} 2. Bottom 2-Column Row {%- endcomment -%}
      <div class="shop-the-maker__bottom-row">
        
        <!-- Bottom Left -->
        <div class="shop-the-maker__item shop-the-maker__item--bottom-left{% if enable_scroll_animation %} scroll-trigger-element{% endif %}" style="--animation-delay: 0.2s;">
          {% if bottom_left_link != blank %}
            <a href="{{ bottom_left_link }}" class="shop-the-maker__link" aria-label="{{ bottom_left_alt }}">
          {% endif %}
            <div class="shop-the-maker__media-wrapper shop-the-maker__media-wrapper--square{% if enable_hover_zoom %} shop-the-maker__media--zoom{% endif %}">
              {% if bottom_left_image != blank %}
                <img
                  src="{{ bottom_left_image | image_url: width: 1200 }}"
                  alt="{{ bottom_left_image.alt | default: bottom_left_alt | escape }}"
                  loading="lazy"
                  class="shop-the-maker__img"
                  width="600"
                  height="600"
                >
              {% else %}
                <img
                  src="{{ 'maker-gallery-2.jpg' | asset_url }}"
                  alt="{{ bottom_left_alt | escape }}"
                  loading="lazy"
                  class="shop-the-maker__img"
                  width="600"
                  height="600"
                >
              {% endif %}
            </div>
          {% if bottom_left_link != blank %}
            </a>
          {% endif %}
        </div>

        <!-- Bottom Right -->
        <div class="shop-the-maker__item shop-the-maker__item--bottom-right{% if enable_scroll_animation %} scroll-trigger-element{% endif %}" style="--animation-delay: 0.3s;">
          {% if bottom_right_link != blank %}
            <a href="{{ bottom_right_link }}" class="shop-the-maker__link" aria-label="{{ bottom_right_alt }}">
          {% endif %}
            <div class="shop-the-maker__media-wrapper shop-the-maker__media-wrapper--square{% if enable_hover_zoom %} shop-the-maker__media--zoom{% endif %}">
              {% if bottom_right_image != blank %}
                <img
                  src="{{ bottom_right_image | image_url: width: 1200 }}"
                  alt="{{ bottom_right_image.alt | default: bottom_right_alt | escape }}"
                  loading="lazy"
                  class="shop-the-maker__img"
                  width="600"
                  height="600"
                >
              {% else %}
                <img
                  src="{{ 'maker-gallery-3.jpg' | asset_url }}"
                  alt="{{ bottom_right_alt | escape }}"
                  loading="lazy"
                  class="shop-the-maker__img"
                  width="600"
                  height="600"
                >
              {% endif %}
            </div>
          {% if bottom_right_link != blank %}
            </a>
          {% endif %}
        </div>

      </div>

    </div>

  </div>
</div>

{% stylesheet %}
  .shop-the-maker {
    background-color: var(--stm-bg, #ffffff);
    width: 100%;
    padding-block-start: var(--stm-padding-top, 48px);
    padding-block-end: var(--stm-padding-bottom, 64px);
    position: relative;
    box-sizing: border-box;
  }

  .shop-the-maker__container {
    max-width: var(--stm-max-width, 1100px);
    margin-inline: auto;
    padding-inline: var(--padding-md, 24px);
    box-sizing: border-box;

    @media screen and (min-width: 990px) {
      padding-inline: var(--padding-xl, 48px);
    }
  }

  .shop-the-maker__header-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-block-end: 28px;
    text-align: center;
  }

  .shop-the-maker__heading-link,
  .shop-the-maker__heading-text-wrapper {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--stm-heading-color, #111111);
    position: relative;
    padding-bottom: 5px;
  }

  .shop-the-maker__heading-text {
    font-size: var(--stm-heading-size, 13.5px);
    font-weight: var(--stm-heading-weight, 500);
    letter-spacing: var(--stm-heading-spacing, 0.3em);
    text-transform: uppercase;
    color: var(--stm-heading-color, #111111);
    line-height: 1.2;
    transition: opacity 0.2s ease;
  }

  .shop-the-maker__heading-link--underline::after,
  .shop-the-maker__heading-text-wrapper--underline::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--stm-heading-color, #111111);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-the-maker__heading-link:hover .shop-the-maker__heading-text {
    opacity: 0.75;
  }

  .shop-the-maker__grid {
    display: flex;
    flex-direction: column;
    gap: var(--stm-gap, 16px);
    width: 100%;
  }

  .shop-the-maker__bottom-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--stm-gap, 16px);
    width: 100%;

    @media screen and (max-width: 640px) {
      grid-template-columns: 1fr;
    }
  }

  .shop-the-maker__item {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: var(--stm-radius, 0px);
  }

  .shop-the-maker__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .shop-the-maker__media-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f7f7f7;
    border-radius: var(--stm-radius, 0px);
    aspect-ratio: 16 / 10;

    @media screen and (max-width: 749px) {
      aspect-ratio: 16 / 11;
    }
  }

  .shop-the-maker__media-wrapper--square {
    aspect-ratio: 1 / 1;

    @media screen and (max-width: 640px) {
      aspect-ratio: 4 / 3;
    }
  }

  .shop-the-maker__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-the-maker__media--zoom:hover .shop-the-maker__img {
    transform: scale(1.035);
  }

  /* Scroll Reveal Animation Classes */
  .scroll-trigger-element {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--animation-delay, 0s);
    will-change: opacity, transform;
  }

  .scroll-trigger-element.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
{% endstylesheet %}

<script>
  (function() {
    function initScrollReveal() {
      var elements = document.querySelectorAll('.scroll-trigger-element:not(.is-visible)');
      if (!elements.length) return;

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries, obs) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        }, {
          rootMargin: '0px 0px -40px 0px',
          threshold: 0.1
        });

        elements.forEach(function(el) {
          observer.observe(el);
        });
      } else {
        elements.forEach(function(el) {
          el.classList.add('is-visible');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollReveal);
    } else {
      initScrollReveal();
    }

    document.addEventListener('shopify:section:load', initScrollReveal);
    window.addEventListener('scroll', initScrollReveal, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Shop The Maker Gallery",
  "tag": "section",
  "class": "section-shop-the-maker",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "SHOP THE MAKER"
    },
    {
      "type": "url",
      "id": "heading_link",
      "label": "Heading Link URL"
    },
    {
      "type": "checkbox",
      "id": "show_underline",
      "label": "Show Heading Underline",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 11,
      "max": 24,
      "step": 0.5,
      "unit": "px",
      "default": 13.5
    },
    {
      "type": "select",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing",
      "options": [
        { "value": "0.1em", "label": "Subtle (0.1em)" },
        { "value": "0.2em", "label": "Medium (0.2em)" },
        { "value": "0.3em", "label": "Luxury Wide (0.3em)" },
        { "value": "0.42em", "label": "Ultra Wide (0.42em)" }
      ],
      "default": "0.3em"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Image 1: Top Landscape Image"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top Large Landscape Image"
    },
    {
      "type": "url",
      "id": "top_image_link",
      "label": "Top Image Link"
    },
    {
      "type": "text",
      "id": "top_image_alt",
      "label": "Top Image Alt Text",
      "default": "Luxury Bedroom by Eichholtz"
    },
    {
      "type": "header",
      "content": "Image 2: Bottom Left Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_left_image",
      "label": "Bottom Left Image"
    },
    {
      "type": "url",
      "id": "bottom_left_link",
      "label": "Bottom Left Image Link"
    },
    {
      "type": "text",
      "id": "bottom_left_alt",
      "label": "Bottom Left Image Alt Text",
      "default": "Luxury Living Room by Eichholtz"
    },
    {
      "type": "header",
      "content": "Image 3: Bottom Right Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_image",
      "label": "Bottom Right Image"
    },
    {
      "type": "url",
      "id": "bottom_right_link",
      "label": "Bottom Right Image Link"
    },
    {
      "type": "text",
      "id": "bottom_right_alt",
      "label": "Bottom Right Image Alt Text",
      "default": "Luxury Lounge and Coffee Tables by Eichholtz"
    },
    {
      "type": "header",
      "content": "Animation & Interactions"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_animation",
      "label": "Enable Scroll Reveal Animation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Enable Subtle Hover Zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap Between Images",
      "min": 4,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Image Corner Radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section Max Width",
      "min": 800,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Shop The Maker Gallery",
      "settings": {
        "heading": "SHOP THE MAKER",
        "show_underline": true,
        "gap": 16,
        "max_width": 1100,
        "padding_top": 48,
        "padding_bottom": 64,
        "enable_scroll_animation": true,
        "enable_hover_zoom": true
      }
    }
  ]
}
{% endschema %}
