{%- comment -%}
  THE RAW HOUSE - ADVANCED INFINITE LUXURY MARQUEE TICKER
  Continuous animated running ticker with dynamic statement blocks, custom links, speed controls, and color schemes.
{%- endcomment -%}

{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'dark'
  case scheme
    when 'obsidian'
      assign bg_color = '#0b0b0b'
      assign text_color = '#ffffff'
      assign accent_color = '#c5a880'
      assign border_color = 'rgba(197, 168, 128, 0.25)'
    when 'gold'
      assign bg_color = '#c5a880'
      assign text_color = '#111111'
      assign accent_color = '#ffffff'
      assign border_color = 'rgba(0, 0, 0, 0.1)'
    when 'light'
      assign bg_color = '#ffffff'
      assign text_color = '#111111'
      assign accent_color = '#c5a880'
      assign border_color = '#e8e4dc'
    when 'warm'
      assign bg_color = '#f7f6f2'
      assign text_color = '#111111'
      assign accent_color = '#c5a880'
      assign border_color = '#e3ded5'
    else
      assign bg_color = '#111111'
      assign text_color = '#ffffff'
      assign accent_color = '#c5a880'
      assign border_color = 'rgba(255, 255, 255, 0.08)'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_text_color != blank and section.settings.custom_text_color != 'rgba(0,0,0,0)'
    assign text_color = section.settings.custom_text_color
  endif
  if section.settings.custom_accent_color != blank and section.settings.custom_accent_color != 'rgba(0,0,0,0)'
    assign accent_color = section.settings.custom_accent_color
  endif
%}

<div
  id="LuxuryMarquee-{{ section.id }}"
  class="lux-marquee-section lux-marquee-scheme-{{ scheme }}"
  style="
    --marquee-bg: {{ bg_color }};
    --marquee-color: {{ text_color }};
    --marquee-accent: {{ accent_color }};
    --marquee-border: {{ border_color }};
    --marquee-duration: {{ section.settings.speed | default: 35 }}s;
    --marquee-font-size: {{ section.settings.font_size | default: 11.5 }}px;
    --marquee-pt: {{ section.settings.padding_vertical | default: 12 }}px;
    background: var(--marquee-bg);
    color: var(--marquee-color);
    padding-top: var(--marquee-pt);
    padding-bottom: var(--marquee-pt);
    border-top: 1px solid var(--marquee-border);
    border-bottom: 1px solid var(--marquee-border);
  "
  {{ section.shopify_attributes }}
>
  <div class="lux-marquee-track" style="animation-duration: var(--marquee-duration);">
    {% for i in (1..3) %}
      <div class="lux-marquee-item" style="font-size: var(--marquee-font-size);" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="lux-marquee-link" style="color: inherit; text-decoration: none;">
                {{ block.settings.text }}
              </a>
            {% else %}
              <span>{{ block.settings.text }}</span>
            {% endif %}
            <span class="lux-marquee-diamond" style="color: var(--marquee-accent);">{{ block.settings.separator | default: '✦' }}</span>
          {% endfor %}
        {% else %}
          <!-- Default Fallback Statements -->
          <span>{{ section.settings.text_1 | default: 'CONTEMPORARY FINE ART GALLERY & SCULPTURAL ATELIER' }}</span>
          <span class="lux-marquee-diamond" style="color: var(--marquee-accent);">✦</span>
          <span>{{ section.settings.text_2 | default: 'MUSEUM-GRADE ORIGINAL OIL PAINTINGS & 3D ART MODELS' }}</span>
          <span class="lux-marquee-diamond" style="color: var(--marquee-accent);">✦</span>
          <span>{{ section.settings.text_3 | default: 'COMPLIMENTARY WHITE-GLOVE FINE ART DELIVERY & CRATING' }}</span>
          <span class="lux-marquee-diamond" style="color: var(--marquee-accent);">✦</span>
          <span>{{ section.settings.text_4 | default: 'AUTHENTIC BRONZE, CARVED MARBLE & TEXTURED GOLD LEAF' }}</span>
          <span class="lux-marquee-diamond" style="color: var(--marquee-accent);">✦</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Luxury Marquee Ticker",
  "tag": "section",
  "class": "section-luxury-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme & Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color Scheme Preset",
      "options": [
        { "value": "dark", "label": "Classic Dark (#111111)" },
        { "value": "obsidian", "label": "Obsidian Gold (#0b0b0b)" },
        { "value": "gold", "label": "Metallic Gold Accent" },
        { "value": "light", "label": "Light Clean (#ffffff)" },
        { "value": "warm", "label": "Warm Atelier (#f7f6f2)" }
      ],
      "default": "dark"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Text Color"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Custom Diamond Accent Color"
    },
    {
      "type": "header",
      "content": "Ticker Settings"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "s",
      "label": "Animation Duration (Speed)",
      "default": 35
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 9,
      "max": 16,
      "step": 0.5,
      "unit": "px",
      "label": "Text Size",
      "default": 11.5
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "Ticker Statement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Statement Text",
          "default": "CONTEMPORARY FINE ART GALLERY & SCULPTURAL ATELIER"
        },
        {
          "type": "text",
          "id": "separator",
          "label": "Separator Symbol",
          "default": "✦"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Marquee Ticker",
      "blocks": [
        {
          "type": "statement",
          "settings": {
            "text": "CONTEMPORARY FINE ART GALLERY & SCULPTURAL ATELIER"
          }
        },
        {
          "type": "statement",
          "settings": {
            "text": "MUSEUM-GRADE ORIGINAL OIL PAINTINGS & 3D ART MODELS"
          }
        },
        {
          "type": "statement",
          "settings": {
            "text": "COMPLIMENTARY WHITE-GLOVE FINE ART DELIVERY & CRATING"
          }
        },
        {
          "type": "statement",
          "settings": {
            "text": "AUTHENTIC BRONZE, CARVED MARBLE & TEXTURED GOLD LEAF"
          }
        }
      ]
    }
  ]
}
{% endschema %}
