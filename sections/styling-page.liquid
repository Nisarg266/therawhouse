<div class="styling-gallery">
  <header class="styling-gallery__caption">
    <h1 id="StylingTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    <p class="styling-gallery__subtitle">{{ section.settings.subtitle | escape }}</p>
    <div class="styling-gallery__intro">{{ section.settings.intro }}</div>
  </header>
  {% if section.blocks.size > 0 %}
    <styling-carousel class="styling-carousel" role="region" aria-label="{{ 'accessibility.slideshow' | t }}">
      <div class="styling-carousel__track" id="StylingTrack-{{ section.id }}" tabindex="0" aria-labelledby="StylingTitle-{{ section.id }}">
        {% for block in section.blocks %}
          {% liquid
            assign image_loading = 'lazy'
            assign image_priority = 'auto'
            if forloop.first
              assign image_loading = 'eager'
              assign image_priority = 'high'
            endif
          %}
          <figure class="styling-carousel__slide" role="group" aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: forloop.length }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 2000 | image_tag: widths: '480, 750, 1100, 1500, 2000', sizes: '(min-width: 1600px) 1200px, (min-width: 750px) 78vw, 88vw', alt: block.settings.image_alt, loading: image_loading, fetchpriority: image_priority }}
            {% elsif block.settings.fallback_image != blank %}
              <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="{{ block.settings.fallback_width }}" height="{{ block.settings.fallback_height }}" loading="{{ image_loading }}" fetchpriority="{{ image_priority }}" decoding="async">
            {% endif %}
          </figure>
        {% endfor %}
      </div>
      {% if section.blocks.size > 1 %}
        <div class="styling-carousel__controls" hidden>
          <div class="styling-carousel__dots">
            {% for block in section.blocks %}
              <button type="button" class="styling-carousel__dot" data-slide="{{ forloop.index0 }}" aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: forloop.length }}" aria-controls="StylingTrack-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>
            {% endfor %}
          </div>
          <div class="styling-carousel__arrows">
            <button type="button" data-direction="-1" aria-label="{{ 'accessibility.slideshow_previous' | t }}" aria-controls="StylingTrack-{{ section.id }}" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.3"/></svg></button>
            <button type="button" data-direction="1" aria-label="{{ 'accessibility.slideshow_next' | t }}" aria-controls="StylingTrack-{{ section.id }}"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.3"/></svg></button>
          </div>
        </div>
      {% endif %}
    </styling-carousel>
  {% endif %}
</div>

{% stylesheet %}
  .styling-gallery { padding: clamp(48px, 7vw, 100px) 0 clamp(48px, 6vw, 88px); background: #faf9f6; color: #26231f; }
  .styling-gallery__caption { max-width: 850px; margin: 0 auto clamp(36px, 5vw, 64px); padding: 0 24px; text-align: center; }
  .styling-gallery__caption h1 { margin: 0; font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(34px, 4.2vw, 58px); line-height: 1.15; letter-spacing: -0.025em; text-wrap: balance; }
  .styling-gallery__subtitle { margin: 20px 0 24px; font-family: var(--font-heading--family); font-size: clamp(21px, 2.2vw, 28px); font-style: italic; line-height: 1.35; }
  .styling-gallery__intro { max-width: 740px; margin: 0 auto; font-size: clamp(14px, 1.15vw, 16px); line-height: 1.85; color: #625b52; text-wrap: pretty; }
  .styling-gallery__intro p { margin: 0; }
  .styling-carousel { display: block; max-width: 1600px; margin: 0 auto; padding-inline: clamp(16px, 4vw, 64px); }
  .styling-carousel__track { position: relative; display: flex; gap: clamp(12px, 1.5vw, 24px); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; direction: ltr; }
  .styling-carousel__track::-webkit-scrollbar { display: none; }
  .styling-carousel__slide { flex: 0 0 78%; margin: 0; aspect-ratio: 4 / 3; scroll-snap-align: start; background: #eeeae3; }
  .styling-carousel__slide img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .styling-carousel__controls { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-top: 24px; }
  .styling-carousel__controls[hidden] { display: none; }
  .styling-carousel__dots, .styling-carousel__arrows { display: flex; align-items: center; }
  .styling-carousel__arrows { gap: 10px; }
  .styling-carousel button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: #000; cursor: pointer; transition: background-color 220ms cubic-bezier(0.22, 1, 0.36, 1), color 220ms cubic-bezier(0.22, 1, 0.36, 1), border-color 220ms cubic-bezier(0.22, 1, 0.36, 1), transform 220ms cubic-bezier(0.22, 1, 0.36, 1); }
  .styling-carousel__dot span { width: 6px; height: 6px; border-radius: 50%; background: #000; opacity: 0.3; }
  .styling-carousel__dot[aria-current="true"] span { width: 24px; border-radius: 4px; opacity: 1; }
  .styling-carousel__arrows button { border: 1px solid #000; border-radius: 50%; }
  .styling-carousel__arrows svg { width: 22px; height: 22px; }
  .styling-carousel button:disabled { opacity: 0.3; cursor: default; }
  .styling-carousel button:focus-visible, .styling-carousel__track:focus-visible { outline: 2px solid #000; outline-offset: 3px; }
  .styling-carousel button:active:enabled { transform: translateY(0) scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .styling-carousel button:hover:enabled { transform: translateY(-2px); }
    .styling-carousel__arrows button:hover:enabled { background: #000; color: #fff; }
  }
  @media (max-width: 749px) {
    .styling-gallery__caption { padding-inline: 22px; }
    .styling-carousel__slide { flex-basis: 88%; aspect-ratio: 3 / 4; }
    .styling-carousel__controls { gap: 8px; margin-top: 16px; }
    .styling-carousel__dot { max-width: 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .styling-carousel button { transition: none; transform: none !important; }
    .styling-carousel__track { scroll-behavior: auto !important; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('styling-carousel')) {
    customElements.define('styling-carousel', class extends HTMLElement {
      connectedCallback() {
        this.controller?.abort();
        this.observer?.disconnect();
        this.controller = new AbortController();
        const options = { signal: this.controller.signal };
        this.track = this.querySelector('.styling-carousel__track');
        this.slides = [...this.querySelectorAll('.styling-carousel__slide')];
        this.dots = [...this.querySelectorAll('[data-slide]')];
        this.previous = this.querySelector('[data-direction="-1"]');
        this.next = this.querySelector('[data-direction="1"]');
        this.index = 0;
        this.querySelector('.styling-carousel__controls')?.removeAttribute('hidden');
        this.addEventListener('click', (event) => {
          const button = event.target.closest('button');
          if (!button || !this.contains(button)) return;
          if (button.dataset.slide !== undefined) this.go(Number(button.dataset.slide));
          if (button.dataset.direction) this.go(this.index + Number(button.dataset.direction));
        }, options);
        this.track.addEventListener('keydown', (event) => {
          if (event.target !== this.track) return;
          const destinations = { ArrowLeft: this.index - 1, ArrowRight: this.index + 1, Home: 0, End: this.slides.length - 1 };
          if (destinations[event.key] === undefined) return;
          event.preventDefault();
          this.go(destinations[event.key]);
        }, options);
        this.track.addEventListener('scroll', () => {
          cancelAnimationFrame(this.frame);
          this.frame = requestAnimationFrame(() => this.update());
        }, { ...options, passive: true });
        this.observer = new ResizeObserver(() => this.update());
        this.observer.observe(this.track);
        this.addEventListener('shopify:block:select', (event) => {
          const slide = event.target.closest('.styling-carousel__slide');
          if (slide) this.go(this.slides.indexOf(slide), true);
        }, options);
        this.update();
      }
      position(index) {
        return Math.min(this.slides[index].offsetLeft, this.track.scrollWidth - this.track.clientWidth);
      }
      go(index, instant = false) {
        const target = Math.max(0, Math.min(index, this.slides.length - 1));
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.track.scrollTo({ left: this.position(target), behavior: instant || reduced ? 'instant' : 'smooth' });
      }
      update() {
        let distance = Infinity;
        this.slides.forEach((slide, index) => {
          const current = Math.abs(this.position(index) - this.track.scrollLeft);
          if (current < distance) { distance = current; this.index = index; }
        });
        this.dots.forEach((dot, index) => {
          if (index === this.index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        if (this.previous) this.previous.disabled = this.index === 0;
        if (this.next) this.next.disabled = this.index === this.slides.length - 1;
      }
      disconnectedCallback() {
        this.controller?.abort();
        this.observer?.disconnect();
        cancelAnimationFrame(this.frame);
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Styling caption & gallery", "tag": "section", "class": "styling-editorial-section", "limit": 1,
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Raw House Styling" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Spaces with a point of view." },
    { "type": "richtext", "id": "intro", "label": "Caption", "default": "<p>We bring together architecture, collectible design, art and objects to create spaces that feel personal, layered and distinctive. Guided by an understanding of proportion, material and form, our styling goes beyond decoration to create thoughtful compositions that reflect the people who inhabit them.</p>" }
  ],
  "max_blocks": 12,
  "blocks": [{ "type": "image", "name": "Gallery image", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback_image", "label": "Existing theme image", "options": [
      { "value": "hero-art-gallery-1.jpg", "label": "Art and objects" },
      { "value": "maker-gallery-1.jpg", "label": "Rug and bedroom" },
      { "value": "maker-gallery-2.jpg", "label": "Gathering space" },
      { "value": "maker-gallery-3.jpg", "label": "Collected interior" }
    ], "default": "hero-art-gallery-1.jpg" },
    { "type": "text", "id": "image_alt", "label": "Image description" },
    { "type": "number", "id": "fallback_width", "label": "Theme image width", "default": 1024 },
    { "type": "number", "id": "fallback_height", "label": "Theme image height", "default": 1024 }
  ] }],
  "presets": [{ "name": "Styling caption & gallery", "blocks": [{ "type": "image" }] }]
}
{% endschema %}
