{%- comment -%}
  THE RAW HOUSE - EDITORIAL CATALOG COLLAGE GALLERY
  Full-width luxury editorial collage section with:
  - Initial 6-item asymmetrical collage (matching reference Image 2)
  - Text-only "VIEW MORE" / "VIEW LESS" interactive button
  - Revealed 6-item distinct asymmetrical collage (custom complementary layout)
  - 100% Shopify Schema support for image pickers, links, headings, colors
  - Fully responsive on desktop and mobile
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign full_width = section.settings.full_width
  assign total_blocks = section.blocks.size

  assign fb_imgs = 'art-painting-gold-canvas.jpg~~art-painting-abstract-oil.jpg~~fine-print-1.jpg~~art-gallery-room-hotspots.jpg~~art-painting-expressionist.jpg~~fine-print-2.jpg~~art-painting-starry-night.jpg~~art-painting-pearl.jpg~~art-decor-ceramic-statue.jpg~~art-painting-water-lilies.jpg~~art-sculpture-rodin-thinker.jpg~~art-sculpture-venus-milo.jpg' | split: '~~'

  if section.settings.open_links_new_tab
    assign link_target = ' target="_blank" rel="noopener noreferrer"'
  else
    assign link_target = ''
  endif
%}

<div
  id="CatalogGallery-{{ section_id }}"
  class="lpc-section section-{{ section_id }}"
  style="
    --lpc-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --lpc-card-bg: {{ section.settings.card_bg_color | default: '#f7f6f2' }};
    --lpc-heading-color: {{ section.settings.heading_color | default: '#1a1a1a' }};
    --lpc-text-color: {{ section.settings.text_color | default: '#4a4a4a' }};
    --lpc-accent: {{ section.settings.accent_color | default: '#b08d57' }};
    --lpc-gap: {{ section.settings.gap | default: 16 }}px;
    --lpc-max-width: {{ section.settings.max_width | default: 1440 }}px;
    --lpc-pt: {{ section.settings.padding_top | default: 48 }}px;
    --lpc-pb: {{ section.settings.padding_bottom | default: 64 }}px;
    --lpc-hs: {{ section.settings.heading_size | default: 20 }}px;
    --lpc-ls: {{ section.settings.heading_letter_spacing | default: '0.35em' }};
    --lpc-underline-w: {{ section.settings.underline_width | default: 44 }}px;
    --lpc-radius: {{ section.settings.card_radius | default: 0 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="lpc-container{% if full_width %} lpc-container--full{% else %} lpc-container--boxed{% endif %}">

    {%- comment -%} Header {%- endcomment -%}
    <div class="lpc-header">
      {% if section.settings.subheading != blank %}
        <span class="lpc-subheading">{{ section.settings.subheading }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="lpc-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.show_underline %}
        <div class="lpc-underline" aria-hidden="true"></div>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="lpc-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {%- comment -%}
      ==========================================================================
      GROUP 1: INITIAL 6-CARD ASYMMETRICAL EDITORIAL COLLAGE
      Matches Reference Image 2:
      - Left Column:  Top Split Row (Card 1 & 2) + Bottom Wide Card (Card 3)
      - Right Column: Top Tall Card (Card 4)     + Bottom Split Row (Card 5 & 6)
      ==========================================================================
    {%- endcomment -%}
    <div class="lpc-collage-group lpc-collage-group--primary" id="LpcGroup1-{{ section_id }}">
      <div class="lpc-collage-grid">

        {%- comment -%} Left Column (Cards 1, 2, 3) {%- endcomment -%}
        <div class="lpc-collage-column lpc-collage-column--left">
          <!-- Top Split Row: Cards 1 & 2 -->
          <div class="lpc-row-split">
            {%- assign b1 = section.blocks[0] -%}
            {%- assign b1_img = b1.settings.image -%}
            {%- assign b1_link = b1.settings.link | default: '/collections/all' -%}
            {%- assign b1_alt = b1.settings.alt | default: 'Catalog artwork 1' -%}
            <a href="{{ b1_link }}" class="lpc-card lpc-card--split" {{ link_target }} aria-label="{{ b1_alt | escape }}" {% if b1 %}{{ b1.shopify_attributes }}{% endif %}>
              <div class="lpc-card__media{% if section.settings.enable_hover_zoom %} lpc-card__media--zoom{% endif %}">
                {% if b1_img != blank %}
                  {{ b1_img | image_url: width: 1000 | image_tag: class: 'lpc-card__img', loading: 'lazy', alt: b1_alt }}
                {% else %}
                  <img src="{{ fb_imgs[0] | asset_url }}" alt="{{ b1_alt | escape }}" class="lpc-card__img" loading="eager" width="600" height="700">
                {% endif %}
                {% if b1.settings.show_view_icon %}
                  <span class="lpc-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 12h16M14 6l6 6-6 6"/></svg></span>
                {% endif %}
