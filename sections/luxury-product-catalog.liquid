{%- comment -%}
  THE RAW HOUSE — CATALOG GRID (LUXP design system)
  Modular catalog cover blocks with desktop/mobile images, badges and links
  in a uniform, fully configurable grid. Optional "view more / view less"
  expansion (instant toggle, no animation).

  @module luxury-product-catalog
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign ratio_css = '3 / 4'
  if s.image_ratio == '1/1'
    assign ratio_css = '1 / 1'
  elsif s.image_ratio == '4/5'
    assign ratio_css = '4 / 5'
  elsif s.image_ratio == '4/3'
    assign ratio_css = '4 / 3'
  elsif s.image_ratio == '16/10'
    assign ratio_css = '16 / 10'
  endif

  assign card_bg = s.card_bg
  if card_bg == blank or card_bg == 'rgba(0,0,0,0)'
    assign card_bg = 'transparent'
  endif
  assign card_border = s.card_border_color
  if card_border == blank or card_border == 'rgba(0,0,0,0)'
    assign card_border = 'var(--luxp-border)'
  endif

  assign initial = s.initial_items | default: 6
  assign header_track = 'center'
  if s.header_align == 'left'
    assign header_track = 'flex-start'
  endif
-%}

{%- capture luxp_colors -%}
  {%- render 'luxp-scheme',
    preset: s.color_preset,
    bg: s.color_bg,
    heading: s.color_heading,
    text: s.color_text,
    accent: s.color_accent,
    muted: s.color_muted,
    border: s.color_border,
    btn_bg: s.btn_bg,
    btn_text: s.btn_text,
    btn_border: s.btn_border,
    btn_bg_hover: s.btn_bg_hover,
    btn_text_hover: s.btn_text_hover
  -%}
{%- endcapture -%}

{%- capture luxp_typo -%}{%- render 'luxp-typo', s: s -%}{%- endcapture -%}

<div
  class="luxp-section luxp-catalog {% if s.container_mode == 'full' %}luxp-section--full{% endif %} {% if s.enable_animations %}luxp-anim{% endif %} {% if s.layout_style == 'grid' %}luxp-catalog--grid{% else %}luxp-catalog--collage{% endif %} {{ s.custom_class }}"
  style="
    {{ luxp_colors }}
    {{ luxp_typo }}
    --luxp-pt: {{ s.padding_top | default: 48 }}px;
    --luxp-pb: {{ s.padding_bottom | default: 64 }}px;
    --luxp-pt-m: {{ s.padding_top_m | default: 40 }}px;
    --luxp-pb-m: {{ s.padding_bottom_m | default: 48 }}px;
    --luxp-cw: {{ s.container_max | default: 1400 }}px;
    --luxp-px: {{ s.container_padding | default: 32 }}px;
    --luxp-px-m: {{ s.container_padding_m | default: 16 }}px;
    --luxp-header-track: {{ header_track }};
    --luxp-header-align: {{ s.header_align | default: 'center' }};
    --luxp-header-gap: {{ s.header_gap | default: 10 }}px;
    --luxp-header-mb: {{ s.header_mb | default: 30 }}px;
    --luxp-tile-h: {{ s.collage_tile_height | default: 380 }}px;
    --luxp-tile-h-t: {{ s.collage_tile_height_tablet | default: 280 }}px;
    --luxp-cols: {{ s.columns | default: 6 }};
    --luxp-cols-t: {{ s.columns_tablet | default: 4 }};
    --luxp-cols-m: {{ s.columns_mobile | default: 2 }};
    --luxp-cgap: {{ s.col_gap | default: 16 }}px;
    --luxp-rgap: {{ s.row_gap | default: 16 }}px;
    --luxp-cgap-m: {{ s.col_gap_m | default: 12 }}px;
    --luxp-rgap-m: {{ s.row_gap_m | default: 12 }}px;
    --luxp-media-ratio: {{ ratio_css }};
    --luxp-media-fit: {{ s.image_fit | default: 'cover' }};
    --luxp-media-radius: {{ s.card_radius | default: 0 }}px;
    --luxp-media-bg: {% if s.card_bg != blank and s.card_bg != 'rgba(0,0,0,0)' %}{{ s.card_bg }}{% else %}#f7f6f2{% endif %};
    --luxp-card-bg: {{ card_bg }};
    --luxp-card-border: {{ card_border }};
    --luxp-card-bw: {{ s.card_border_width | default: 0 }}px;
    --luxp-card-radius: {{ s.card_radius | default: 0 }}px;
    --luxp-card-shadow: {% if s.card_shadow == 'subtle' %}0 2px 12px rgba(0,0,0,0.06){% elsif s.card_shadow == 'medium' %}0 8px 28px rgba(0,0,0,0.12){% else %}none{% endif %};
    --luxp-pill-bg: var(--luxp-accent);
    --luxp-pill-fg: #ffffff;
    --luxp-footer-mt: {{ s.footer_mt | default: 28 }}px;
  "
  data-luxp-collapsible
  data-luxp-expanded="false"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  data-art-motion="off"
  {{ section.shopify_attributes }}
>
  <div class="luxp-container">
    {% if s.eyebrow != blank or s.heading != blank or s.intro != blank or s.show_ornament %}
      <header class="luxp-header luxp-header--{{ s.header_align | default: 'center' }}">
        {% if s.eyebrow != blank %}
          <p class="luxp-eyebrow">{{ s.eyebrow }}</p>
        {% endif %}
        {% if s.heading != blank %}
          <h2 class="luxp-heading">{{ s.heading }}</h2>
        {% endif %}
        {% if s.show_ornament %}
          <div class="luxp-ornament" aria-hidden="true">
            <span class="luxp-ornament__line"></span>
            <span class="luxp-ornament__gem">&#9670;</span>
            <span class="luxp-ornament__line"></span>
          </div>
        {% endif %}
        {% if s.intro != blank %}
          <div class="luxp-body luxp-header__intro">{{ s.intro }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="luxp-grid luxp-catalog__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign cover_alt = block.settings.alt | default: 'Catalog cover'
          assign cover_link = block.settings.link | default: routes.all_products_collection_url
        -%}
        <a
          href="{{ cover_link }}"
          class="luxp-card luxp-catalog__card {% if forloop.index > initial %}luxp-toggle-hidden{% endif %}"
          {% if s.open_links_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          aria-label="{{ cover_alt | escape }}"
          {{ block.shopify_attributes }}
        >
          <div class="luxp-media luxp-catalog__media">
            {% if block.settings.badge != blank %}
              <span
                class="luxp-colcard__pill luxp-pill"
                style="{% if block.settings.badge_bg != blank %}background: {{ block.settings.badge_bg }} !important;{% endif %}{% if block.settings.badge_color != blank %}color: {{ block.settings.badge_color }} !important;{% endif %}"
              >
                {{- block.settings.badge -}}
              </span>
            {% endif %}
            {% render 'luxp-image',
              image: block.settings.image,
              image_mobile: block.settings.image_mobile,
              alt: cover_alt,
              class: 'luxp-catalog__img',
              loading: 'lazy',
              sizes: '(min-width: 1024px) 33vw, (min-width: 750px) 50vw, 100vw',
              fallback: block.settings.default_asset
            %}
            {% if block.settings.title != blank or block.settings.subtitle != blank %}
              <div class="luxp-catalog__caption">
                {% if block.settings.title != blank %}<span class="luxp-catalog__caption-title">{{ block.settings.title }}</span>{% endif %}
                {% if block.settings.subtitle != blank %}<span class="luxp-catalog__caption-sub">{{ block.settings.subtitle }}</span>{% endif %}
              </div>
            {% endif %}
            {% if block.settings.show_view_icon %}
              <span class="luxp-catalog__icon" aria-hidden="true">
                {% if block.settings.icon_type == 'eye' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                {% elsif block.settings.icon_type == 'download' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
                    <path d="M7 17L17 7M17 7H7M17 7V17"/>
                  </svg>
                {% endif %}
              </span>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>

    {% if s.enable_view_more and section.blocks.size > initial %}
      <div class="luxp-footer">
        <button
          type="button"
          class="luxp-btn {% if s.btn_style == 'outline' %}luxp-btn--outline{% endif %} luxp-toggle-btn"
          data-luxp-toggle
          data-luxp-more="{{ s.view_more_text | default: 'VIEW MORE' }}"
          data-luxp-less="{{ s.view_less_text | default: 'VIEW LESS' }}"
          aria-expanded="false"
        >
          {{ s.view_more_text | default: 'VIEW MORE' }}
        </button>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .luxp-catalog {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .luxp-catalog .luxp-container {
    width: 100%;
    box-sizing: border-box;
  }

  /* ---------------- Collage Layout ---------------- */
  .luxp-catalog--collage .luxp-catalog__grid {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important;
    grid-auto-flow: row dense !important;
    grid-auto-rows: var(--luxp-tile-h, 240px) !important;
    column-gap: var(--luxp-cgap, 16px) !important;
    row-gap: var(--luxp-rgap, 16px) !important;
    width: 100% !important;
  }

  .luxp-catalog--collage .luxp-catalog__card {
    position: relative;
    display: flex !important;
    flex-direction: column;
    height: 100% !important;
    width: 100% !important;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--luxp-card-radius, 0);
    box-sizing: border-box;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  /* Hidden items (initially items 7+) */
  .luxp-catalog:not([data-luxp-expanded='true']) .luxp-catalog__card.luxp-toggle-hidden,
  .luxp-catalog[data-luxp-expanded='false'] .luxp-catalog__card.luxp-toggle-hidden {
    display: none !important;
  }

  /* Expanded items (when View More is clicked inline) */
  .luxp-catalog[data-luxp-expanded='true'] .luxp-catalog__card.luxp-toggle-hidden,
  [data-luxp-collapsible][data-luxp-expanded='true'].luxp-catalog .luxp-catalog__card.luxp-toggle-hidden,
  [data-luxp-collapsible][data-luxp-expanded='true'] .luxp-catalog__card.luxp-toggle-hidden {
    display: flex !important;
  }

  .luxp-catalog--collage .luxp-catalog__media {
    position: relative;
    width: 100%;
    height: 100% !important;
    aspect-ratio: auto !important;
    overflow: hidden;
    border-radius: var(--luxp-card-radius, 0);
  }

  .luxp-catalog--collage .luxp-catalog__media img,
  .luxp-catalog--collage .luxp-catalog__media picture {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .luxp-catalog__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  .luxp-catalog__card:hover .luxp-catalog__img {
    transform: scale(1.05);
  }

  .luxp-catalog__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding: 32px 14px 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.68) 0%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 3px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }

  .luxp-catalog__card:hover .luxp-catalog__caption,
  .luxp-catalog__card:focus-within .luxp-catalog__caption {
    opacity: 1;
    transform: translateY(0);
  }

  .luxp-catalog__caption-title {
    font-family: var(--font-body--family, sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    line-height: 1.2;
  }

  .luxp-catalog__caption-sub {
    font-family: var(--font-body--family, sans-serif);
    font-size: 11px;
    color: #d8c29d;
    letter-spacing: 0.04em;
  }

  /* Subtle transparent arrow icon */
  .luxp-catalog__icon {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: transparent !important;
    background: transparent !important;
    border: 1px solid rgba(255, 255, 255, 0.75) !important;
    color: #ffffff !important;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.25s ease, border-color 0.25s ease;
    z-index: 3;
    pointer-events: none;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
  }

  .luxp-catalog__card:hover .luxp-catalog__icon,
  .luxp-catalog__card:focus-visible .luxp-catalog__icon {
    opacity: 1;
    transform: translateY(0);
    background-color: rgba(255, 255, 255, 0.18) !important;
    border-color: #ffffff !important;
  }

  /* ---------------- Desktop Collage Grid Spanning (min-width: 990px) ---------------- */
  @media screen and (min-width: 990px) {
    /* Batch 1: First 6 items (Always visible) */
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 1) {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 2) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 3) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 4) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 5) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 6) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }

    /* Batch 2: Next 6 items (Revealed on View More) */
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 7) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 8) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 9) {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 10) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 11) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 12) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
  }

  /* ---------------- Tablet Collage Grid Spanning (750px to 989px) ---------------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .luxp-catalog--collage .luxp-catalog__grid {
      grid-template-columns: repeat(4, 1fr) !important;
      grid-auto-rows: var(--luxp-tile-h-t, 190px) !important;
      column-gap: var(--luxp-cgap-m, 12px) !important;
      row-gap: var(--luxp-rgap-m, 12px) !important;
    }

    /* Batch 1: Items 1 to 6 */
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 1) {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 2) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 3) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 4) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 5) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 6) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }

    /* Batch 2: Items 7 to 12 */
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 7) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 8) {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 9) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 10) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 11) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .luxp-catalog--collage .luxp-catalog__card:nth-child(12n + 12) {
      grid-column: span 2 !important;
      grid-row: span 1 !important;
    }
  }

  /* ---------------- Mobile: Clean 2-column Grid (<= 749px) ---------------- */
  @media screen and (max-width: 749px) {
    .luxp-catalog--collage .luxp-catalog__grid {
      grid-template-columns: repeat(var(--luxp-cols-m, 2), minmax(0, 1fr)) !important;
      grid-auto-rows: auto !important;
      column-gap: var(--luxp-cgap-m, 12px) !important;
      row-gap: var(--luxp-rgap-m, 12px) !important;
    }

    .luxp-catalog--collage .luxp-catalog__card {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
      height: auto !important;
    }

    .luxp-catalog--collage .luxp-catalog__media {
      aspect-ratio: var(--luxp-media-ratio, 3 / 4) !important;
      height: auto !important;
    }

    .luxp-catalog__icon {
      width: 28px !important;
      height: 28px !important;
      right: 8px !important;
      bottom: 8px !important;
      opacity: 1 !important;
      transform: translateY(0) !important;
    }

    .luxp-catalog__icon svg {
      width: 12px !important;
      height: 12px !important;
    }
  }

  /* ---------------- Footer & Inline Toggle Button ---------------- */
  .luxp-catalog .luxp-footer {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    margin-top: var(--luxp-footer-mt, 32px) !important;
    width: 100% !important;
    text-align: center !important;
  }

  .luxp-catalog .luxp-toggle-btn {
    margin-top: 0 !important;
    cursor: pointer !important;
    user-select: none !important;
    transition: all 0.3s ease !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Catalog Gallery",
  "tag": "section",
  "class": "section-luxp-catalog",
  "max_blocks": 24,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / subheading", "default": "the" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "C A T A L O G" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Browse our catalogs — tap any cover to open.</p>" },
    { "type": "checkbox", "id": "show_ornament", "label": "Show ornament divider", "default": true },
    { "type": "select", "id": "header_align", "label": "Header alignment", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" }
    ], "default": "center" },
    { "type": "range", "id": "header_mb", "min": 8, "max": 72, "step": 2, "unit": "px", "label": "Space below header — desktop", "default": 30 },
    { "type": "range", "id": "header_gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Header element spacing", "default": 10 },
    { "type": "checkbox", "id": "open_links_new_tab", "label": "Open catalog links in a new tab", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout_style", "label": "Layout style", "options": [
      { "value": "collage", "label": "Collage (Asymmetrical Mixed Sizes)" },
      { "value": "grid", "label": "Uniform Grid" }
    ], "default": "collage" },
    { "type": "range", "id": "collage_tile_height", "min": 160, "max": 600, "step": 10, "unit": "px", "label": "Collage row height — desktop", "default": 380 },
    { "type": "range", "id": "collage_tile_height_tablet", "min": 130, "max": 450, "step": 10, "unit": "px", "label": "Collage row height — tablet", "default": 280 },
    { "type": "select", "id": "container_mode", "label": "Container mode", "options": [
      { "value": "fixed", "label": "Container (max width)" },
      { "value": "full", "label": "Full width" }
    ], "default": "full" },
    { "type": "range", "id": "container_max", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Container max width", "default": 1400 },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns — desktop (Uniform Grid)", "default": 6 },
    { "type": "range", "id": "columns_tablet", "min": 2, "max": 5, "step": 1, "label": "Columns — tablet", "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns — mobile", "options": [
      { "value": "1", "label": "1 column" },
      { "value": "2", "label": "2 columns" }
    ], "default": "2" },
