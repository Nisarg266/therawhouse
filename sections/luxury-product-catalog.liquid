<script>
  (function() {
    function initLpcToggle() {
      var btn = document.getElementById('LpcToggle-{{ section_id }}');
      var group2 = document.getElementById('LpcGroup2-{{ section_id }}');
      if (!btn || !group2) return;

      var textMore = btn.getAttribute('data-text-more') || 'VIEW MORE';
      var textLess = btn.getAttribute('data-text-less') || 'VIEW LESS';
      var labelSpan = btn.querySelector('.lpc-view-more-label');

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          // Collapse
          group2.classList.remove('is-expanded');
          group2.classList.add('is-collapsed');
          group2.setAttribute('aria-hidden', 'true');
          btn.setAttribute('aria-expanded', 'false');
          btn.classList.remove('is-active');
          if (labelSpan) labelSpan.textContent = textMore;

          // Smoothly keep user in comfortable view of group 1
          var group1 = document.getElementById('LpcGroup1-{{ section_id }}');
          if (group1) {
            var rect = group1.getBoundingClientRect();
            if (rect.bottom < 150) {
              group1.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        } else {
          // Expand
          group2.classList.remove('is-collapsed');
          group2.classList.add('is-expanded');
          group2.setAttribute('aria-hidden', 'false');
          btn.setAttribute('aria-expanded', 'true');
          btn.classList.add('is-active');
          if (labelSpan) labelSpan.textContent = textLess;
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLpcToggle);
    } else {
      initLpcToggle();
    }
  })();
</script>

{% stylesheet %}
  .lpc-section {
    background-color: var(--lpc-bg, #ffffff);
    width: 100%;
    padding-block-start: var(--lpc-pt, 48px);
    padding-block-end: var(--lpc-pb, 64px);
    position: relative;
    box-sizing: border-box;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .lpc-container {
    width: 100%;
    box-sizing: border-box;
    margin-inline: auto;
  }

  .lpc-container--full {
    padding-inline: clamp(14px, 2.5vw, 36px);
    max-width: 100% !important;
  }

  .lpc-container--boxed {
    max-width: var(--lpc-max-width, 1440px) !important;
    padding-inline: clamp(16px, 3vw, 40px) !important;
  }

  .lpc-header {
    text-align: center;
    margin-block-end: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .lpc-subheading {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif !important;
    font-style: italic !important;
    font-size: 22px !important;
    color: var(--lpc-heading-color, #1a1a1a) !important;
    margin-bottom: 2px !important;
    letter-spacing: 0.02em !important;
    opacity: 0.9 !important;
    line-height: 1.1 !important;
  }

  .lpc-heading {
    font-size: var(--lpc-hs, 20px) !important;
    letter-spacing: var(--lpc-ls, 0.35em) !important;
    font-weight: 500 !important;
    text-transform: uppercase !important;
    color: var(--lpc-heading-color, #1a1a1a) !important;
    margin: 0 !important;
    line-height: 1.2 !important;
  }

  .lpc-underline {
    width: var(--lpc-underline-w, 44px);
    height: 1.5px;
    background-color: var(--lpc-heading-color, #111111);
    margin-top: 8px;
  }

  .lpc-description {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--lpc-text-color, #4a4a4a);
    max-width: min(540px, 92%);
    margin: 8px 0 0 0;
    letter-spacing: 0.015em;
  }

  /* Collage Master Grid: 2 Columns on Desktop with Equal Height Ratio */
  .lpc-collage-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: var(--lpc-gap, 16px) !important;
    width: 100% !important;
    align-items: stretch !important;
  }

  .lpc-collage-column {
    display: flex !important;
    flex-direction: column !important;
    gap: var(--lpc-gap, 16px) !important;
    width: 100% !important;
  }

  .lpc-row-split {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: var(--lpc-gap, 16px) !important;
    width: 100% !important;
  }

  /* Individual Card Architecture */
  .lpc-card {
    position: relative !important;
    overflow: hidden !important;
    border-radius: var(--lpc-radius, 0px) !important;
    background-color: var(--lpc-card-bg, #f7f6f2) !important;
    width: 100% !important;
    display: block !important;
    text-decoration: none !important;
    color: inherit !important;
  }

  .lpc-card--split {
    aspect-ratio: 1 / 1.18 !important;
  }

  .lpc-card--wide {
    aspect-ratio: 1.34 / 1 !important;
  }

  .lpc-card--tall {
    aspect-ratio: 1.34 / 1 !important;
  }

  .lpc-card__media {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    display: block !important;
  }

  .lpc-card__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .lpc-card__media--zoom:hover .lpc-card__img,
  .lpc-card:hover .lpc-card__img {
    transform: scale(1.04) !important;
  }

  .lpc-card__icon {
    position: absolute;
    bottom: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111111;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lpc-card__icon svg {
    width: 16px;
    height: 16px;
  }

  .lpc-card:hover .lpc-card__icon {
    opacity: 1;
    transform: translateY(0);
  }

  /* Group 2 Revealed State & Smooth Transitions */
  .lpc-group--revealed {
    margin-top: var(--lpc-gap, 16px);
    overflow: hidden;
    transition: max-height 0.75s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.55s ease, margin-top 0.4s ease;
  }

  .lpc-group--revealed.is-collapsed {
    max-height: 0 !important;
    opacity: 0 !important;
    margin-top: 0 !important;
    pointer-events: none !important;
    visibility: hidden;
  }

  .lpc-group--revealed.is-expanded {
    max-height: 4000px !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    visibility: visible;
  }

  /* Minimalist Luxury Text-Only View More Button */
  .lpc-actions {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    margin-top: 32px !important;
    width: 100% !important;
  }

  .lpc-view-more-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 9px !important;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    padding: 10px 20px !important;
    cursor: pointer !important;
    color: var(--lpc-heading-color, #111111) !important;
    font-family: var(--font-body--family, "Inter", sans-serif) !important;
    font-size: 0.8rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.28em !important;
    text-transform: uppercase !important;
    position: relative !important;
    text-decoration: none !important;
    transition: color 0.25s ease, transform 0.2s ease !important;
  }

  .lpc-view-more-btn::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 20px;
    right: 20px;
    height: 1px;
    background-color: currentColor;
    opacity: 0.4;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .lpc-view-more-btn:hover {
    color: var(--lpc-accent, #b08d57) !important;
    transform: translateY(-1px);
  }

  .lpc-view-more-btn:hover::after {
    opacity: 1;
    transform: scaleX(1.06);
  }

  .lpc-view-more-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lpc-view-more-btn.is-active .lpc-view-more-icon {
    transform: rotate(180deg);
  }

  /* Responsive Mobile Adaptations */
  @media screen and (max-width: 749px) {
    .lpc-section {
      padding-block-start: 32px !important;
      padding-block-end: 44px !important;
    }

    .lpc-container--full,
    .lpc-container--boxed {
      padding-inline: 12px !important;
    }

    .lpc-header {
      margin-block-end: 20px !important;
    }

    .lpc-collage-grid {
      grid-template-columns: 1fr !important;
      gap: 12px !important;
    }

    .lpc-collage-column {
      gap: 12px !important;
    }

    .lpc-row-split {
      gap: 12px !important;
    }

    .lpc-card--split {
      aspect-ratio: 1 / 1.14 !important;
    }

    .lpc-card--wide {
      aspect-ratio: 1.35 / 1 !important;
    }

    .lpc-card--tall {
      aspect-ratio: 1.25 / 1 !important;
    }

    .lpc-actions {
      margin-top: 22px !important;
    }

    .lpc-view-more-btn {
      font-size: 0.74rem !important;
      letter-spacing: 0.22em !important;
      padding: 8px 12px !important;
    }
  }
{% endstylesheet %}

