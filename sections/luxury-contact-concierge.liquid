{%- comment -%}
  THE RAW HOUSE — BESPOKE MINIMAL LUXURY CONTACT & CONCIERGE
  Clean, refined, airy, and professional experience for mobile and desktop.
{%- endcomment -%}

{% liquid
  assign preset = section.settings.color_preset | default: 'warm_editorial'
  case preset
    when 'obsidian_luxury'
      assign bg_color = '#0e0d0b'
      assign card_bg = '#161412'
      assign card_border = 'rgba(255, 255, 255, 0.08)'
      assign card_border_hover = 'rgba(223, 186, 126, 0.4)'
      assign text_color = '#eae6df'
      assign heading_color = '#ffffff'
      assign muted_color = '#9a9488'
      assign accent_color = '#dfba7e'
      assign input_bg = '#12110f'
      assign input_border = 'rgba(255, 255, 255, 0.12)'
    when 'pure_white'
      assign bg_color = '#ffffff'
      assign card_bg = '#faf9f7'
      assign card_border = '#eeeae3'
      assign card_border_hover = '#c5a880'
      assign text_color = '#222222'
      assign heading_color = '#111111'
      assign muted_color = '#6b665f'
      assign accent_color = '#c5a880'
      assign input_bg = '#ffffff'
      assign input_border = '#ded9cf'
    else
      comment
        Default: warm_editorial (ultra-clean alabaster luxury)
      endcomment
      assign bg_color = '#faf9f6'
      assign card_bg = '#ffffff'
      assign card_border = '#ede9e2'
      assign card_border_hover = '#c5a880'
      assign text_color = '#282521'
      assign heading_color = '#12110f'
      assign muted_color = '#767067'
      assign accent_color = '#c5a880'
      assign input_bg = '#faf9f6'
      assign input_border = '#e2ded5'
  endcase

  if section.settings.custom_bg != blank and section.settings.custom_bg != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg
  endif
  if section.settings.custom_text != blank and section.settings.custom_text != 'rgba(0,0,0,0)'
    assign text_color = section.settings.custom_text
  endif
  if section.settings.custom_accent != blank and section.settings.custom_accent != 'rgba(0,0,0,0)'
    assign accent_color = section.settings.custom_accent
  endif
%}

<section
  id="LuxuryContact-{{ section.id }}"
  class="lux-contact-section"
  style="
    --lc-bg: {{ bg_color }};
    --lc-card-bg: {{ card_bg }};
    --lc-card-border: {{ card_border }};
    --lc-card-border-hover: {{ card_border_hover }};
    --lc-text: {{ text_color }};
    --lc-heading: {{ heading_color }};
    --lc-muted: {{ muted_color }};
    --lc-accent: {{ accent_color }};
    --lc-input-bg: {{ input_bg }};
    --lc-input-border: {{ input_border }};
    --lc-pt: {{ section.settings.padding_top | default: 56 }}px;
    --lc-pb: {{ section.settings.padding_bottom | default: 72 }}px;
    --lc-pt-m: {{ section.settings.mobile_padding_top | default: 32 }}px;
    --lc-pb-m: {{ section.settings.mobile_padding_bottom | default: 44 }}px;
  "
>
  <div class="lux-contact__container">

    {%- comment -%} ================= 1. REFINED LUXURY HERO ================= {%- endcomment -%}
    <div class="lux-contact__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="lux-contact__eyebrow-wrap">
          <span class="lux-contact__eyebrow">{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}

      <h1 class="lux-contact__heading">
        {{ section.settings.heading | default: 'Connect with The Atelier' }}
      </h1>

      <div class="lux-contact__divider" aria-hidden="true">
        <span class="lux-contact__divider-line"></span>
        <span class="lux-contact__divider-gem">◆</span>
        <span class="lux-contact__divider-line"></span>
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="lux-contact__subheading">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} ================= 2. CLEAN DIRECT CONTACT TILES ================= {%- endcomment -%}
    <div class="lux-contact__action-tiles">
      {%- if section.settings.whatsapp_number != blank -%}
        <a
          href="https://wa.me/{{ section.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' }}?text={{ section.settings.whatsapp_message | default: 'Hello The Raw House, I would like to inquire about a curated piece.' | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          class="lux-contact__tile lux-contact__tile--whatsapp"
        >
          <div class="lux-contact__tile-icon lux-contact__tile-icon--wa">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div class="lux-contact__tile-content">
            <span class="lux-contact__tile-label">WhatsApp Concierge</span>
            <span class="lux-contact__tile-value">Chat with Art Advisory</span>
          </div>
          <span class="lux-contact__tile-arrow">→</span>
        </a>
      {%- endif -%}

      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | replace: ' ', '' }}" class="lux-contact__tile">
          <div class="lux-contact__tile-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="lux-contact__tile-content">
            <span class="lux-contact__tile-label">Call Concierge</span>
            <span class="lux-contact__tile-value">{{ section.settings.phone }}</span>
          </div>
          <span class="lux-contact__tile-arrow">→</span>
        </a>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <a href="mailto:{{ section.settings.email }}" class="lux-contact__tile">
          <div class="lux-contact__tile-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="lux-contact__tile-content">
            <span class="lux-contact__tile-label">Curatorial Email</span>
            <span class="lux-contact__tile-value">{{ section.settings.email }}</span>
          </div>
          <span class="lux-contact__tile-arrow">→</span>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} ================= 3. CLEAN & FOCUSED INQUIRY FORM ================= {%- endcomment -%}
    <div class="lux-contact__form-wrapper">
      <div class="lux-contact__form-box">
        <div class="lux-contact__form-intro">
          <h2 class="lux-contact__form-heading">Send a Private Inquiry</h2>
          <p class="lux-contact__form-sub">Our curation desk responds within 4 business hours.</p>
        </div>

        {%- form 'contact', id: 'ContactForm', class: 'lux-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="lux-form__success" role="status" tabindex="-1" autofocus>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <div>
                <strong>Inquiry Sent with Distinction</strong>
                <p>Thank you for reaching out. A dedicated curator will contact you shortly.</p>
              </div>
            </div>
          {%- elsif form.errors -%}
            <div class="lux-form__error" role="alert" tabindex="-1" autofocus>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              <div>
                <strong>Please check your information</strong>
                <p>{{ form.errors | default_errors }}</p>
              </div>
            </div>
          {%- endif -%}

          <div class="lux-form__grid">
            <div class="lux-form__field">
              <label for="ContactForm-name" class="lux-form__label">Your Name <span class="lux-form__req">*</span></label>
              <input
                type="text"
                id="ContactForm-name"
                name="contact[name]"
                class="lux-form__input"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Full Name"
                autocomplete="name"
                required
              >
            </div>

            <div class="lux-form__field">
              <label for="ContactForm-email" class="lux-form__label">Email Address <span class="lux-form__req">*</span></label>
              <input
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                class="lux-form__input"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="email@example.com"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                required
              >
            </div>

            <div class="lux-form__field">
              <label for="ContactForm-phone" class="lux-form__label">Phone / WhatsApp</label>
              <input
                type="tel"
                id="ContactForm-phone"
                name="contact[phone]"
                class="lux-form__input"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="+91 Phone number"
                autocomplete="tel"
              >
            </div>

            <div class="lux-form__field">
              <label for="ContactForm-inquiry-type" class="lux-form__label">Nature of Inquiry</label>
              <div class="lux-form__select-wrap">
                <select id="ContactForm-inquiry-type" name="contact[Inquiry Type]" class="lux-form__select">
                  <option value="General Inquiry" selected>General Atelier Inquiry</option>
                  <option value="Private Art Acquisition">Art & Painting Acquisition</option>
                  <option value="Bespoke Furniture">Bespoke Furniture Commission</option>
                  <option value="Trade & Interior Designer">Architect & Trade Program</option>
                  <option value="Private Viewing">Private Studio Appointment</option>
                </select>
                <svg class="lux-form__select-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </div>
            </div>
          </div>

          <div class="lux-form__field">
            <label for="ContactForm-body" class="lux-form__label">Your Message <span class="lux-form__req">*</span></label>
            <textarea
              id="ContactForm-body"
              name="contact[body]"
              rows="4"
              class="lux-form__textarea"
              placeholder="Tell us about the pieces, project dimensions, or services you require..."
              required
            >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
          </div>

          <div class="lux-form__submit-row">
            <button type="submit" class="lux-form__btn">
              <span>Send Inquiry</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>

            <span class="lux-form__security-note">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              Strict Confidentiality Guaranteed
            </span>
          </div>
        {%- endform -%}
      </div>
    </div>

    {%- comment -%} ================= 4. COMPACT ATELIER & STUDIO INFO STRIP ================= {%- endcomment -%}
    <div class="lux-contact__info-strip">
      <div class="lux-contact__info-item">
        <span class="lux-contact__info-title">Atelier Studio</span>
        <p class="lux-contact__info-text">{{ section.settings.address | default: 'The Raw House Atelier, Luxury Quarter, India' | newline_to_br }}</p>
      </div>

      <div class="lux-contact__info-item">
        <span class="lux-contact__info-title">Visiting Hours</span>
        <p class="lux-contact__info-text">{{ section.settings.hours | default: 'Mon – Sat: 10:00 AM – 7:00 PM IST (Sun by appointment)' }}</p>
      </div>

      <div class="lux-contact__info-item">
        <span class="lux-contact__info-title">Trade Program</span>
        <p class="lux-contact__info-text">Architect & designer privileges via <a href="mailto:{{ section.settings.trade_email | default: 'trade@therawhouse.com' }}">{{ section.settings.trade_email | default: 'trade@therawhouse.com' }}</a></p>
      </div>
    </div>

    {%- comment -%} ================= 5. STREAMLINED FAQ (OPTIONAL) ================= {%- endcomment -%}
    {%- if section.settings.show_faq -%}
      <div class="lux-contact__faq-wrap">
        <h3 class="lux-contact__faq-title">Curatorial Inquiries</h3>
        <div class="lux-contact__faq-list">
          <details class="lux-contact__faq-item">
            <summary class="lux-contact__faq-summary">
              <span>How does bespoke art & custom commissioning work?</span>
              <span class="lux-contact__faq-icon">+</span>
            </summary>
            <div class="lux-contact__faq-body">
              <p>We review your space, dimensions, and preferred materials to prepare tailored concept dossiers and samples. Once confirmed, master artisans craft your piece with periodic updates.</p>
            </div>
          </details>

          <details class="lux-contact__faq-item">
            <summary class="lux-contact__faq-summary">
              <span>What are the qualifications for the Trade Program?</span>
              <span class="lux-contact__faq-icon">+</span>
            </summary>
            <div class="lux-contact__faq-body">
              <p>Licensed architects, interior designers, and hospitality procurers receive exclusive trade tiers, 3D CAD files, and dedicated concierge managers.</p>
            </div>
          </details>

          <details class="lux-contact__faq-item">
            <summary class="lux-contact__faq-summary">
              <span>How does White-Glove delivery and installation work?</span>
              <span class="lux-contact__faq-icon">+</span>
            </summary>
            <div class="lux-contact__faq-body">
              <p>All items are secured in museum-grade wooden crating and delivered via insured luxury transit with scheduled white-glove uncrating and placement.</p>
            </div>
          </details>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ============================================================
     THE RAW HOUSE — CLEAN MINIMAL LUXURY CONTACT STYLES
     ============================================================ */

  .lux-contact-section {
    background-color: var(--lc-bg);
    color: var(--lc-text);
    padding-top: var(--lc-pt);
    padding-bottom: var(--lc-pb);
    font-family: var(--font-body--family, "Inter", -apple-system, sans-serif);
    transition: background-color 0.3s ease;
    overflow-x: clip;
  }

  @media screen and (max-width: 768px) {
    .lux-contact-section {
      padding-top: var(--lc-pt-m);
      padding-bottom: var(--lc-pb-m);
    }
  }

  .lux-contact__container {
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(16px, 3.5vw, 32px);
    padding-right: clamp(16px, 3.5vw, 32px);
    box-sizing: border-box;
  }

  /* Header */
  .lux-contact__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(24px, 4vw, 42px);
  }

  .lux-contact__eyebrow-wrap {
    margin-bottom: 8px;
  }

  .lux-contact__eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--lc-accent);
  }

  .lux-contact__heading {
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.03em;
    color: var(--lc-heading);
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .lux-contact__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 10px auto 14px;
    max-width: 140px;
  }

  .lux-contact__divider-line {
    flex: 1;
    height: 1px;
    background: var(--lc-accent);
    opacity: 0.4;
  }

  .lux-contact__divider-gem {
    color: var(--lc-accent);
    font-size: 8px;
  }

  .lux-contact__subheading {
    font-size: clamp(13.5px, 1.2vw, 15px);
    font-weight: 400;
    line-height: 1.65;
    color: var(--lc-muted);
    margin: 0;
  }

  /* Action Tiles (Clean 3-Item Direct Contact Bar) */
  .lux-contact__action-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }

  @media screen and (max-width: 768px) {
    .lux-contact__action-tiles {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .lux-contact__tile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: var(--lc-card-bg);
    border: 1px solid var(--lc-card-border);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .lux-contact__tile:hover {
    border-color: var(--lc-card-border-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
  }

  .lux-contact__tile-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--lc-bg);
    color: var(--lc-accent);
    flex-shrink: 0;
  }

  .lux-contact__tile-icon--wa {
    background: rgba(37, 211, 102, 0.12);
    color: #25d366;
  }

  .lux-contact__tile-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .lux-contact__tile-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lc-muted);
    margin-bottom: 2px;
  }

  .lux-contact__tile-value {
    font-size: 13px;
    font-weight: 600;
    color: var(--lc-heading);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lux-contact__tile-arrow {
    color: var(--lc-accent);
    font-size: 14px;
    transition: transform 0.2s ease;
  }

  .lux-contact__tile:hover .lux-contact__tile-arrow {
    transform: translateX(3px);
  }

  /* Form Wrapper & Box */
  .lux-contact__form-wrapper {
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .lux-contact__form-box {
    background: var(--lc-card-bg);
    border: 1px solid var(--lc-card-border);
    padding: clamp(22px, 3.5vw, 36px);
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .lux-contact__form-intro {
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--lc-card-border);
  }

  .lux-contact__form-heading {
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 400;
    line-height: 1.25;
    color: var(--lc-heading);
    margin: 0 0 4px;
    text-transform: uppercase;
  }

  .lux-contact__form-sub {
    font-size: 12.5px;
    color: var(--lc-muted);
    margin: 0;
  }

  /* Form Controls */
  .lux-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .lux-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  @media screen and (max-width: 600px) {
    .lux-form__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  .lux-form__field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .lux-form__label {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lc-heading);
  }

  .lux-form__req {
    color: var(--lc-accent);
  }

  .lux-form__input,
  .lux-form__select,
  .lux-form__textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 13.5px;
    color: var(--lc-heading);
    background: var(--lc-input-bg);
    border: 1px solid var(--lc-input-border);
    border-radius: 3px;
    padding: 10px 12px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .lux-form__input:focus,
  .lux-form__select:focus,
  .lux-form__textarea:focus {
    border-color: var(--lc-accent);
    background: var(--lc-card-bg);
  }

  .lux-form__input::placeholder,
  .lux-form__textarea::placeholder {
    color: var(--lc-muted);
    opacity: 0.6;
  }

  .lux-form__select-wrap {
    position: relative;
    width: 100%;
  }

  .lux-form__select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 32px;
    cursor: pointer;
  }

  .lux-form__select-arrow {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--lc-muted);
  }

  .lux-form__textarea {
    resize: vertical;
    min-height: 95px;
    line-height: 1.5;
  }

  /* Submit row */
  .lux-form__submit-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .lux-form__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 28px;
    background: var(--lc-accent);
    color: #111111;
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .lux-form__btn:hover {
    background: #d4b88e;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(197, 168, 128, 0.3);
  }

  .lux-form__security-note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--lc-muted);
  }

  .lux-form__security-note svg {
    color: var(--lc-accent);
  }

  @media screen and (max-width: 600px) {
    .lux-form__submit-row {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .lux-form__btn {
      width: 100%;
    }
    .lux-form__security-note {
      justify-content: center;
    }
  }

  /* Alerts */
  .lux-form__success,
  .lux-form__error {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 3px;
    font-size: 12.5px;
    line-height: 1.4;
    margin-bottom: 14px;
  }

  .lux-form__success {
    background: rgba(46, 125, 50, 0.08);
    border: 1px solid rgba(46, 125, 50, 0.25);
    color: #1b4d20;
  }

  .lux-form__error {
    background: rgba(211, 47, 47, 0.08);
    border: 1px solid rgba(211, 47, 47, 0.25);
    color: #5f1515;
  }

  /* Info Strip (Atelier Studio, Hours, Trade) */
  .lux-contact__info-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 22px 0;
    border-top: 1px solid var(--lc-card-border);
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  @media screen and (max-width: 768px) {
    .lux-contact__info-strip {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 18px 0;
    }
  }

  .lux-contact__info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .lux-contact__info-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lc-accent);
  }

  .lux-contact__info-text {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--lc-muted);
    margin: 0;
  }

  .lux-contact__info-text a {
    color: var(--lc-heading);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* FAQ Accordion (Clean & Minimal) */
  .lux-contact__faq-wrap {
    max-width: 720px;
    margin: 0 auto;
  }

  .lux-contact__faq-title {
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 400;
    color: var(--lc-heading);
    text-align: center;
    margin: 0 0 16px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .lux-contact__faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .lux-contact__faq-item {
    background: var(--lc-card-bg);
    border: 1px solid var(--lc-card-border);
    border-radius: 3px;
    overflow: hidden;
  }

  .lux-contact__faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 16px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--lc-heading);
  }

  .lux-contact__faq-summary::-webkit-details-marker {
    display: none;
  }

  .lux-contact__faq-icon {
    font-size: 16px;
    color: var(--lc-accent);
    transition: transform 0.2s ease;
  }

  .lux-contact__faq-item[open] .lux-contact__faq-icon {
    transform: rotate(45deg);
  }

  .lux-contact__faq-body {
    padding: 0 16px 14px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--lc-muted);
  }

  .lux-contact__faq-body p {
    margin: 0;
  }
</style>

