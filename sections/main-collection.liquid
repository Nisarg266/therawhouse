

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 24 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            {% if product.featured_media != blank or product.featured_image != blank %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  closest.product: product,
                  product_view_context: 'collection'
                %}
              </li>
            {% endif %}
          {% endfor %}
        {% endcapture %}

        {% capture collection_enquiry_modals %}
          {% for product in collection.products %}
            {% if product.featured_media != blank or product.featured_image != blank %}
              {% assign collection_enquiry_modal_id = 'CollectionProductEnquiry-' | append: section.id | append: '-' | append: product.id %}
              {% render 'product-enquiry-drawer',
                product: product,
                variant: product.selected_or_first_available_variant,
                drawer_id: collection_enquiry_modal_id,
                mode: 'modal',
                simple: true
              %}
            {% endif %}
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
        {{ collection_enquiry_modals }}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% stylesheet %}
  collection-component .product-grid__card.product-grid__card {
    /* Override the legacy equal-height card flex rule. */
    display: grid !important;
    /* Force the single column to fill the card width so short product titles
       cannot shrink the track and produce undersized image boxes. */
    grid-template-columns: minmax(0, 100%);
    grid-template-rows: auto 1fr auto;
    gap: 8px;
    align-items: start;
  }

  collection-component [ref='productTitleLink'] {
    display: block;
    min-width: 0;
    width: 100%;
    margin-top: 8px;
  }

  collection-component [ref='productTitleLink'] .text-block,
  collection-component .product-grid__card product-price {
    width: 100%;
    max-width: none;
    margin: 0 !important;
    padding: 0;
    text-align: left;
    font: 400 14px/1.5 var(--font-body--family, sans-serif) !important;
    letter-spacing: 0;
    text-transform: none;
  }

  collection-component [ref='productTitleLink'] .text-block {
    display: block !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
    -webkit-line-clamp: unset !important;
  }

  collection-component [ref='productTitleLink'] p { margin: 0; overflow-wrap: anywhere; }
  collection-component .product-grid__card product-price { align-self: end; font-weight: 500 !important; }
  collection-component .product-grid__card [ref='priceContainer'] { font: inherit; display: flex; flex-wrap: wrap; gap: 4px 8px; }

  collection-component .product-grid__item,
  collection-component product-card,
  collection-component .product-card,
  collection-component .product-card__content,
  collection-component .product-grid__card,
  collection-component .product-grid__card > *,
  collection-component .group-block,
  collection-component .group-block-content,
  collection-component .card-gallery,
  collection-component .product-card-gallery,
  collection-component .product-media,
  collection-component .product-media *,
  collection-component .product-media-container,
  collection-component .product-card-gallery__no-image,
  collection-component img {
    border-radius: 0 !important;
    box-shadow: none !important;
    filter: none !important;
    -webkit-filter: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  collection-component .product-grid__item {
    overflow: visible !important;
    border: 0 !important;
    background: transparent !important;
  }

  collection-component .product-card__content,
  collection-component .product-grid__card {
    background: transparent !important;
    border: 0 !important;
  }

  collection-component .product-grid__card.product-grid__card {
    gap: 0 !important;
  }

  collection-component .card-gallery,
  collection-component .product-card-gallery,
  collection-component .product-media,
  collection-component .product-media-container,
  collection-component .product-card-gallery__no-image {
    background: #f3ede4 !important;
    aspect-ratio: 4 / 5 !important;
  }

  collection-component .product-media img,
  collection-component .product-card__image,
  collection-component .product-media__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
  }

  collection-component [ref='productTitleLink'] {
    margin-top: 0 !important;
    padding: 24px 18px 0 !important;
    text-align: center !important;
    justify-self: center !important;
    align-self: center !important;
  }

  collection-component [ref='productTitleLink'] .text-block,
  collection-component [ref='productTitleLink'] .text-block *,
  collection-component [ref='productTitleLink'] p,
  collection-component .product-grid__card product-price {
    text-align: center !important;
    justify-content: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  collection-component [ref='productTitleLink'] .text-block {
    font-family: var(--font-heading--family, serif) !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    line-height: 1.35 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: #1f1712 !important;
  }

  collection-component .product-grid__card product-price {
    padding: 10px 18px 24px !important;
    font-family: var(--font-heading--family, serif) !important;
    font-size: 15px !important;
    font-weight: 400 !important;
    letter-spacing: 0.04em !important;
    color: #2f261f !important;
  }

  collection-component .product-grid__card [ref='priceContainer'] {
    justify-content: center !important;
  }

  collection-component .product-badges {
    top: 16px !important;
    left: 16px !important;
    right: auto !important;
  }

  collection-component .product-badges__badge {
    background: #f7f2ea !important;
    color: #1f1712 !important;
    border: 0 !important;
    padding: 8px 14px !important;
    font: 500 11px/1 var(--font-body--family, sans-serif) !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
  }

  collection-component .product-media,
  collection-component .product-media img,
  collection-component .product-card__image,
  collection-component .product-media__image {
    image-rendering: auto;
    transform: none !important;
  }

  collection-component .product-card:hover,
  collection-component product-card:hover,
  collection-component .product-card:hover .card-gallery,
  collection-component .product-card:hover .product-card__content,
  collection-component .product-card:hover .product-card__image,
  collection-component .product-card:hover .product-media__image {
    transform: none !important;
    filter: none !important;
    box-shadow: none !important;
  }

  @media (max-width: 749px) {
    collection-component [ref='productTitleLink'] .text-block,
    collection-component .product-grid__card product-price { font-size: 12px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
