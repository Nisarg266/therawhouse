{%- comment -%}
  Renders the Studio Atelier & Private Viewing details with dynamic repeatable cards.
  Allows configuring studio address, visiting hours, and private appointments with dedicated block controls.
{%- endcomment -%}

<div
  id="StudioDetails-{{ section.id }}"
  class="studio-details-section"
  style="
    --sd-bg: {{ section.settings.background_color | default: '#faf9f6' }};
    --sd-card-bg: {{ section.settings.card_background | default: '#ffffff' }};
    --sd-card-border: {{ section.settings.card_border_color | default: '#ede8e0' }};
    --sd-card-radius: {{ section.settings.card_radius | default: 4 }}px;
    --sd-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --sd-text-color: {{ section.settings.text_color | default: '#555046' }};
    --sd-icon-color: {{ section.settings.icon_color | default: '#111111' }};
    --sd-btn-color: {{ section.settings.link_color | default: '#111111' }};
    --sd-heading-size: {{ section.settings.heading_size | default: 32 }}px;
    --sd-heading-size-m: {{ section.settings.heading_size_m | default: 24 }}px;
    --sd-pt: {{ section.settings.padding_top | default: 0 }}px;
    --sd-pb: {{ section.settings.padding_bottom | default: 60 }}px;
    --sd-pt-m: {{ section.settings.padding_top_m | default: 0 }}px;
    --sd-pb-m: {{ section.settings.padding_bottom_m | default: 40 }}px;
    --sd-max-w: {{ section.settings.max_width | default: 1040 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="studio-details__container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="studio-details__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="studio-details__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="studio-details__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="studio-details__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="studio-details__grid studio-details__grid--cols-{{ section.settings.columns_desktop }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign custom_bg = block.settings.custom_bg
          assign custom_border = block.settings.custom_border
          assign custom_icon = block.settings.custom_icon_color
        -%}
        <div
          class="studio-card studio-card--{{ block.id }}"
          style="
            {% if custom_bg != blank %}background-color: {{ custom_bg }} !important;{% endif %}
            {% if custom_border != blank %}border-color: {{ custom_border }} !important;{% endif %}
          "
          {{ block.shopify_attributes }}
        >
          <div
            class="studio-card__icon-wrap"
            style="{% if custom_icon != blank %}color: {{ custom_icon }} !important;{% endif %}"
          >
            {%- case block.settings.icon -%}
              {%- when 'map_pin' -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              {%- when 'clock' -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              {%- when 'calendar' -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              {%- when 'building' -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                  <line x1="9" y1="22" x2="9" y2="2"></line>
                  <line x1="15" y1="22" x2="15" y2="2"></line>
                  <line x1="4" y1="6" x2="20" y2="6"></line>
                  <line x1="4" y1="10" x2="20" y2="10"></line>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            {%- endcase -%}
          </div>

          <div class="studio-card__content">
            <h3 class="studio-card__title">{{ block.settings.title }}</h3>
            <div class="studio-card__text">
              {{ block.settings.text }}
            </div>

            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a
                href="{{ block.settings.button_link }}"
                class="studio-card__btn"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                <span>{{ block.settings.button_label }}</span>
                <span class="studio-card__btn-arrow">→</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .studio-details-section {
    width: 100%;
    background-color: var(--sd-bg);
    padding-top: var(--sd-pt);
    padding-bottom: var(--sd-pb);
    box-sizing: border-box;
  }

  .studio-details__container {
    max-width: var(--sd-max-w);
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 40px);
    padding-right: clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .studio-details__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .studio-details__eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8c8273;
    margin-bottom: 8px;
  }

  .studio-details__heading {
    font-size: var(--sd-heading-size);
    font-weight: 400;
    color: var(--sd-heading-color);
    margin: 0 0 10px 0;
    font-family: var(--font-heading--family, serif);
  }

  .studio-details__subheading {
    font-size: 15px;
    color: var(--sd-text-color);
    margin: 0;
    line-height: 1.6;
  }

  .studio-details__grid {
    display: grid;
    gap: 20px;
  }

  .studio-details__grid--cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .studio-details__grid--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .studio-card {
    background-color: var(--sd-card-bg);
    border: 1px solid var(--sd-card-border);
    border-radius: var(--sd-card-radius);
    padding: clamp(24px, 3.5vw, 36px);
    display: flex;
    gap: 20px;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .studio-card:hover {
    transform: translateY(-2px);
    border-color: #111111;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
  }

  .studio-card__icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #f7f5f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sd-icon-color);
    flex-shrink: 0;
  }

  .studio-card__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .studio-card__title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sd-heading-color);
    margin: 0 0 8px 0;
  }

  .studio-card__text {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--sd-text-color);
    margin-bottom: 16px;
    white-space: pre-line;
  }

  .studio-card__btn {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sd-btn-color);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .studio-card__btn:hover {
    color: #c5a059;
  }

  .studio-card__btn-arrow {
    transition: transform 0.2s ease;
  }

  .studio-card__btn:hover .studio-card__btn-arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .studio-details-section {
      padding-top: var(--sd-pt-m);
      padding-bottom: var(--sd-pb-m);
    }
    .studio-details__heading {
      font-size: var(--sd-heading-size-m);
    }
    .studio-details__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .studio-card {
      padding: 20px 18px;
      gap: 14px;
    }
    .studio-card__icon-wrap {
      width: 40px;
      height: 40px;
    }
  }
</style>

{% schema %}
{
  "name": "Studio & Viewing Details",
  "tag": "section",
  "class": "section-studio-details",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Section eyebrow",
      "default": "PHYSICAL PROVENANCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Studio Atelier & Private Viewings"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Experience our curated pieces in person or arrange a private consultation with our curatorial board."
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#faf9f6"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#ede8e0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#555046"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link & button color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Typography & Spacing"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "min": 18,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading font size (Mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card border radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Container maximum width",
      "default": 1040
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "detail_card",
      "name": "Location / Info Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Card Icon",
          "options": [
            { "value": "map_pin", "label": "Map Pin / Location" },
            { "value": "clock", "label": "Clock / Timings" },
            { "value": "calendar", "label": "Calendar / Appointments" },
            { "value": "building", "label": "Building / Gallery" },
            { "value": "shield", "label": "Shield / Security" },
            { "value": "star", "label": "Star / Gem" }
          ],
          "default": "map_pin"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "THE RAW HOUSE ATELIER"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Card text / details",
          "default": "The Raw House Studio & Gallery\nLuxury Design Quarter, India\nPrivate viewing by appointment."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Action link label",
          "default": "Get Directions"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Action link URL"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": true
        },
        {
          "type": "header",
          "content": "Custom Card Colors (Optional)"
        },
        {
          "type": "color",
          "id": "custom_bg",
          "label": "Custom card background"
        },
        {
          "type": "color",
          "id": "custom_border",
          "label": "Custom card border"
        },
        {
          "type": "color",
          "id": "custom_icon_color",
          "label": "Custom icon color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio & Viewing Details",
      "blocks": [
        {
          "type": "detail_card",
          "settings": {
            "icon": "map_pin",
            "title": "THE ATELIER STUDIO",
            "text": "The Raw House Gallery & Atelier\nStudio 12, Luxury Design Quarter\nIndia",
            "button_label": "Schedule Private Visit",
            "button_link": "https://wa.me/918003011110"
          }
        },
        {
          "type": "detail_card",
          "settings": {
            "icon": "clock",
            "title": "VISITING HOURS",
            "text": "Monday – Saturday: 10:00 AM – 7:00 PM IST\nSunday: Exclusively by private appointment\nVirtual viewing available via video concierge.",
            "button_label": "Chat with Curator",
            "button_link": "https://wa.me/918003011110"
          }
        }
      ]
    }
  ]
}
{% endschema %}
