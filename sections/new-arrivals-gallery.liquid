<script>
  (function() {
    const section = document.getElementById('NewArrivalsGallery-{{ section_id }}');
    if (!section) return;

    /* Slider logic */
    const slider = section.querySelector('[data-nag-slider]');
    if (slider) {
      const track = slider.querySelector('[data-nag-track]');
      const prevBtn = slider.querySelector('[data-nag-prev]');
      const nextBtn = slider.querySelector('[data-nag-next]');
      const dotsContainer = slider.querySelector('[data-nag-dots]');

      if (track) {
        const slides = track.querySelectorAll('.new-arrivals-slider__slide');

        if (dotsContainer && slides.length > 1) {
          dotsContainer.innerHTML = '';
          slides.forEach(function(_, idx) {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'new-arrivals-slider__dot' + (idx === 0 ? ' is-active' : '');
            dot.setAttribute('aria-label', 'Go to arrival ' + (idx + 1));
            dot.addEventListener('click', function() {
              slides[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            });
            dotsContainer.appendChild(dot);
          });
        }

        const updateControls = function() {
          const scrollLeft = track.scrollLeft;
          const maxScroll = track.scrollWidth - track.clientWidth - 6;
          if (prevBtn) prevBtn.disabled = scrollLeft <= 4;
          if (nextBtn) nextBtn.disabled = scrollLeft >= maxScroll;

          if (dotsContainer) {
            const dots = dotsContainer.querySelectorAll('.new-arrivals-slider__dot');
            const cardWidth = slides[0] ? slides[0].offsetWidth : 300;
            const activeIdx = Math.round(scrollLeft / (cardWidth + 22));
            dots.forEach(function(dot, i) {
              dot.classList.toggle('is-active', i === Math.min(activeIdx, dots.length - 1));
            });
          }
        };

        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            const cardWidth = slides[0] ? slides[0].offsetWidth + 22 : 320;
            track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            const cardWidth = slides[0] ? slides[0].offsetWidth + 22 : 320;
            track.scrollBy({ left: cardWidth, behavior: 'smooth' });
          });
        }

        track.addEventListener('scroll', updateControls, { passive: true });
        setTimeout(updateControls, 100);
      }
    }

    /* Scroll-reveal for grid layout */
    const grid = section.querySelector('.new-arrivals-gallery__grid');
    if (grid) {
      section.classList.add('nag-js');
      const cards = section.querySelectorAll('.new-arrivals-gallery__card');
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver(function(entries, observer) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        cards.forEach(function(card) { revealObserver.observe(card); });
      } else {
        cards.forEach(function(card) { card.classList.add('is-revealed'); });
      }
    }
  })();
</script>

