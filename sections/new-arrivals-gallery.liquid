{%- comment -%}
  Renders the editorial "NEW ARRIVALS" 6-card asymmetrical masonry gallery.
  Dual mode:
  - If dynamic blocks ("arrival_card") are added, renders blocks with advanced settings (images, titles, designers, badges, prices, links).
  - If no blocks exist, smoothly falls back to section-level settings for full backwards compatibility.
  Wide luxury layout:
  Left Column: 2 Top Squares + 1 Bottom Wide Landscape
  Right Column: 1 Top Feature + 2 Bottom Squares
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign subheading = section.settings.subheading | default: 'THE'
  assign heading = section.settings.heading | default: 'NEW ARRIVALS'
  assign show_underline = section.settings.show_underline
  assign gap = section.settings.gap | default: 22
  assign corner_radius = section.settings.corner_radius | default: 0
  assign enable_hover_zoom = section.settings.enable_hover_zoom
  assign full_width = section.settings.full_width
  assign show_caption = section.settings.show_caption_on_hover
  assign layout_style = section.settings.layout_style | default: 'slider'

  if section.blocks.size > 0
    assign card_1_block = section.blocks[0]
    assign card_1_img = card_1_block.settings.image
    assign card_1_img_m = card_1_block.settings.image_mobile
    assign card_1_link = card_1_block.settings.link
    assign card_1_alt = card_1_block.settings.alt | default: 'New Arrival Item 1'
    assign card_1_sub = card_1_block.settings.designer
    assign card_1_price = card_1_block.settings.price
    assign card_1_badge = card_1_block.settings.badge
    assign card_1_badge_bg = card_1_block.settings.badge_bg | default: '#111111'
    assign card_1_badge_color = card_1_block.settings.badge_color | default: '#ffffff'

    assign card_2_block = section.blocks[1]
    assign card_2_img = card_2_block.settings.image
    assign card_2_img_m = card_2_block.settings.image_mobile
    assign card_2_link = card_2_block.settings.link
    assign card_2_alt = card_2_block.settings.alt | default: 'New Arrival Item 2'
    assign card_2_sub = card_2_block.settings.designer
    assign card_2_price = card_2_block.settings.price
    assign card_2_badge = card_2_block.settings.badge
    assign card_2_badge_bg = card_2_block.settings.badge_bg | default: '#111111'
    assign card_2_badge_color = card_2_block.settings.badge_color | default: '#ffffff'

    assign card_3_block = section.blocks[2]
    assign card_3_img = card_3_block.settings.image
    assign card_3_img_m = card_3_block.settings.image_mobile
    assign card_3_link = card_3_block.settings.link
    assign card_3_alt = card_3_block.settings.alt | default: 'New Arrival Item 3'
    assign card_3_sub = card_3_block.settings.designer
    assign card_3_price = card_3_block.settings.price
    assign card_3_badge = card_3_block.settings.badge
    assign card_3_badge_bg = card_3_block.settings.badge_bg | default: '#111111'
    assign card_3_badge_color = card_3_block.settings.badge_color | default: '#ffffff'

    assign card_4_block = section.blocks[3]
    assign card_4_img = card_4_block.settings.image
    assign card_4_img_m = card_4_block.settings.image_mobile
    assign card_4_link = card_4_block.settings.link
    assign card_4_alt = card_4_block.settings.alt | default: 'New Arrival Item 4'
    assign card_4_sub = card_4_block.settings.designer
    assign card_4_price = card_4_block.settings.price
    assign card_4_badge = card_4_block.settings.badge
    assign card_4_badge_bg = card_4_block.settings.badge_bg | default: '#111111'
    assign card_4_badge_color = card_4_block.settings.badge_color | default: '#ffffff'

    assign card_5_block = section.blocks[4]
    assign card_5_img = card_5_block.settings.image
    assign card_5_img_m = card_5_block.settings.image_mobile
    assign card_5_link = card_5_block.settings.link
    assign card_5_alt = card_5_block.settings.alt | default: 'New Arrival Item 5'
    assign card_5_sub = card_5_block.settings.designer
    assign card_5_price = card_5_block.settings.price
    assign card_5_badge = card_5_block.settings.badge
    assign card_5_badge_bg = card_5_block.settings.badge_bg | default: '#111111'
    assign card_5_badge_color = card_5_block.settings.badge_color | default: '#ffffff'

    assign card_6_block = section.blocks[5]
    assign card_6_img = card_6_block.settings.image
    assign card_6_img_m = card_6_block.settings.image_mobile
    assign card_6_link = card_6_block.settings.link
    assign card_6_alt = card_6_block.settings.alt | default: 'New Arrival Item 6'
    assign card_6_sub = card_6_block.settings.designer
    assign card_6_price = card_6_block.settings.price
    assign card_6_badge = card_6_block.settings.badge
    assign card_6_badge_bg = card_6_block.settings.badge_bg | default: '#111111'
    assign card_6_badge_color = card_6_block.settings.badge_color | default: '#ffffff'
  else
    assign card_1_link = routes.all_products_collection_url
    assign card_1_alt = 'New Arrival Item 1'

    assign card_2_link = routes.all_products_collection_url
    assign card_2_alt = 'New Arrival Item 2'

    assign card_3_link = routes.all_products_collection_url
    assign card_3_alt = 'New Arrival Item 3'

    assign card_4_link = routes.all_products_collection_url
    assign card_4_alt = 'New Arrival Item 4'

    assign card_5_link = routes.all_products_collection_url
    assign card_5_alt = 'New Arrival Item 5'

    assign card_6_link = routes.all_products_collection_url
    assign card_6_alt = 'New Arrival Item 6'
  endif
%}

<div
  id="NewArrivalsGallery-{{ section_id }}"
  class="new-arrivals-gallery section-{{ section_id }}{% if full_width %} new-arrivals-gallery--full{% endif %} new-arrivals-gallery--{{ layout_style }}"
  style="
    --nag-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --nag-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --nag-heading-size: {{ section.settings.heading_size | default: 24 }}px;
    --nag-heading-size-m: {{ section.settings.heading_size_m | default: 18 }}px;
    --nag-card-title-size: {{ section.settings.card_title_size | default: 16.5 }}px;
    --nag-card-title-size-m: {{ section.settings.card_title_size_m | default: 14.5 }}px;
    --nag-card-designer-size: {{ section.settings.card_designer_size | default: 11.5 }}px;
    --nag-card-price-size: {{ section.settings.card_price_size | default: 14.5 }}px;
    --nag-subheading-size: {{ section.settings.subheading_size | default: 26 }}px;
    --nag-subheading-size-m: {{ section.settings.subheading_size_m | default: 22 }}px;
    --nag-heading-spacing: {{ section.settings.heading_letter_spacing | default: '0.4em' }};
    --nag-underline-width: {{ section.settings.underline_width | default: 48 }}px;
    --nag-underline-height: {{ section.settings.underline_height | default: 1 }}px;
    --nag-underline-color: {{ section.settings.underline_color | default: '#b08d57' }};
    --nag-accent: {{ section.settings.accent_color | default: '#b08d57' }};
    --nag-gap: {{ gap }}px;
    --nag-radius: {{ corner_radius }}px;
    --nag-max-width: {{ section.settings.max_width | default: 1360 }}px;
    --nag-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --nag-padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --nag-padding-top-m: {{ section.settings.padding_top_m | default: 40 }}px;
    --nag-padding-bottom-m: {{ section.settings.padding_bottom_m | default: 44 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="new-arrivals-gallery__container">

    {%- comment -%} Header Title with Script Subheading & Underline {%- endcomment -%}
    <div class="new-arrivals-gallery__header">
      {% if subheading != blank %}
        <span class="new-arrivals-gallery__subheading">{{ subheading | upcase }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2 class="new-arrivals-gallery__heading">{{ heading }}</h2>
      {% endif %}
      {% if show_underline %}
        <div class="luxp-ornament new-arrivals-gallery__ornament" aria-hidden="true">
          <span class="luxp-ornament__line"></span>
          <span class="luxp-ornament__gem">&#9670;</span>
          <span class="luxp-ornament__line"></span>
        </div>
      {% endif %}
    </div>

    {% if layout_style == 'slider' %}
      {%- comment -%} ================= CARD SLIDER ================= {%- endcomment -%}
      <div class="new-arrivals-slider" data-nag-slider>
        <button type="button" class="new-arrivals-slider__arrow new-arrivals-slider__arrow--prev" aria-label="Previous arrivals" data-nag-prev>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="new-arrivals-slider__arrow new-arrivals-slider__arrow--next" aria-label="Next arrivals" data-nag-next>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <div class="new-arrivals-slider__viewport" data-nag-viewport>
          <div class="new-arrivals-slider__track" data-nag-track>
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% assign card_link = block.settings.link | default: routes.all_products_collection_url %}
                {% assign card_title = block.settings.alt | default: 'Curated Object' %}
                {% assign card_sub = block.settings.designer %}
                {% assign card_price = block.settings.price %}
                {% assign card_badge = block.settings.badge %}
                {% assign card_badge_bg = block.settings.badge_bg | default: '#111111' %}
                {% assign card_badge_color = block.settings.badge_color | default: '#ffffff' %}

                <div class="new-arrivals-slider__slide" {{ block.shopify_attributes }}>
                  <div class="new-arrivals-card">
                    {% if card_badge != blank %}
                      <span class="new-arrivals-card__badge" style="background-color: {{ card_badge_bg }}; color: {{ card_badge_color }};">{{ card_badge }}</span>
                    {% endif %}
                    {% if card_link != blank %}<a href="{{ card_link }}" class="new-arrivals-card__link" aria-label="{{ card_title | escape }}">{% endif %}
                      <div class="new-arrivals-card__media{% if enable_hover_zoom %} new-arrivals-card__media--zoom{% endif %}">
                        {% if block.settings.image != blank %}
                          {% if block.settings.image_mobile != blank %}
                            <picture>
                              <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 700 }}">
                              {{ block.settings.image | image_url: width: 900 | image_tag: class: 'new-arrivals-card__img', loading: 'lazy', alt: card_title }}
                            </picture>
                          {% else %}
                            {{ block.settings.image | image_url: width: 900 | image_tag: class: 'new-arrivals-card__img', loading: 'lazy', alt: card_title }}
                          {% endif %}
                        {% else %}
                          {% assign fallback_idx = forloop.index0 | modulo: 6 | plus: 1 %}
                          {% assign fallback_name = 'new-arrival-' | append: fallback_idx | append: '.jpg' %}
                          <img src="{{ fallback_name | asset_url }}" alt="{{ card_title }}" class="new-arrivals-card__img" loading="lazy" width="600" height="750">
                        {% endif %}
                      </div>
                    {% if card_link != blank %}</a>{% endif %}

                    <div class="new-arrivals-card__info">
                      {% if card_sub != blank %}
                        <span class="new-arrivals-card__designer">{{ card_sub }}</span>
                      {% endif %}
                      <h3 class="new-arrivals-card__title">
                        {% if card_link != blank %}<a href="{{ card_link }}">{{ card_title }}</a>{% else %}{{ card_title }}{% endif %}
                      </h3>
                      {% if card_price != blank %}
                        <div class="new-arrivals-card__price">{{ card_price }}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              {% for i in (1..6) %}
                {% assign fallback_name = 'new-arrival-' | append: i | append: '.jpg' %}
                <div class="new-arrivals-slider__slide">
                  <div class="new-arrivals-card">
                    <a href="{{ routes.all_products_collection_url }}" class="new-arrivals-card__link">
                      <div class="new-arrivals-card__media{% if enable_hover_zoom %} new-arrivals-card__media--zoom{% endif %}">
                        <img src="{{ fallback_name | asset_url }}" alt="New Arrival {{ i }}" class="new-arrivals-card__img" loading="lazy" width="600" height="750">
                      </div>
                    </a>
                    <div class="new-arrivals-card__info">
                      <span class="new-arrivals-card__designer">The Edit</span>
                      <h3 class="new-arrivals-card__title">New Arrival Item {{ i }}</h3>
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>

        <div class="new-arrivals-slider__dots" data-nag-dots aria-hidden="true"></div>
      </div>
    {% else %}
      {%- comment -%} 6-Item Masonry Grid {%- endcomment -%}
      <div class="new-arrivals-gallery__grid">

      {%- comment -%} LEFT COLUMN: 2 Top Split Cards + 1 Bottom Large Card {%- endcomment -%}
      <div class="new-arrivals-gallery__column new-arrivals-gallery__column--left">

        <!-- Top Split Row (Card 1 & Card 2) -->
        <div class="new-arrivals-gallery__row-split">

          <!-- Card 1 -->
          <div class="new-arrivals-gallery__card new-arrivals-gallery__card--split" style="--nag-index: 0;" {% if card_1_block %}{{ card_1_block.shopify_attributes }}{% endif %}>
            {% if card_1_badge != blank %}
              <span class="new-arrivals-gallery__badge" style="background-color: {{ card_1_badge_bg }}; color: {{ card_1_badge_color }};">{{ card_1_badge }}</span>
            {% endif %}
            {% if card_1_link != blank %}<a href="{{ card_1_link }}" class="new-arrivals-gallery__card-link" aria-label="{{ card_1_alt }}">{% endif %}
              <div class="new-arrivals-gallery__media{% if enable_hover_zoom %} new-arrivals-gallery__media--zoom{% endif %}{% if show_caption %} new-arrivals-gallery__media--caption{% endif %}">
                {% if card_1_img != blank %}
                  {% if card_1_img_m != blank %}
                    <picture>
                      <source media="(max-width: 749px)" srcset="{{ card_1_img_m | image_url: width: 800 }}">
                      {{ card_1_img | image_url: width: 1400 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_1_alt }}
                    </picture>
                  {% else %}
                    {{ card_1_img | image_url: width: 1400 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_1_alt }}
                  {% endif %}
                {% else %}
                  <img src="{{ 'new-arrival-1.jpg' | asset_url }}" alt="{{ card_1_alt }}" class="new-arrivals-gallery__img" loading="eager" width="600" height="700">
                {% endif %}
                {% if show_caption %}
                  <div class="new-arrivals-gallery__caption">
                    <span class="new-arrivals-gallery__caption-title">{{ card_1_alt }}</span>
                    {% if card_1_sub != blank %}<span class="new-arrivals-gallery__caption-sub">{{ card_1_sub }}</span>{% endif %}
                    {% if card_1_price != blank %}<span class="new-arrivals-gallery__caption-price">{{ card_1_price }}</span>{% endif %}
                  </div>
                {% endif %}
              </div>
            {% if card_1_link != blank %}</a>{% endif %}
          </div>

          <!-- Card 2 -->
          <div class="new-arrivals-gallery__card new-arrivals-gallery__card--split" style="--nag-index: 1;" {% if card_2_block %}{{ card_2_block.shopify_attributes }}{% endif %}>
            {% if card_2_badge != blank %}
              <span class="new-arrivals-gallery__badge" style="background-color: {{ card_2_badge_bg }}; color: {{ card_2_badge_color }};">{{ card_2_badge }}</span>
            {% endif %}
            {% if card_2_link != blank %}<a href="{{ card_2_link }}" class="new-arrivals-gallery__card-link" aria-label="{{ card_2_alt }}">{% endif %}
              <div class="new-arrivals-gallery__media{% if enable_hover_zoom %} new-arrivals-gallery__media--zoom{% endif %}{% if show_caption %} new-arrivals-gallery__media--caption{% endif %}">
                {% if card_2_img != blank %}
                  {% if card_2_img_m != blank %}
                    <picture>
                      <source media="(max-width: 749px)" srcset="{{ card_2_img_m | image_url: width: 800 }}">
                      {{ card_2_img | image_url: width: 1400 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_2_alt }}
                    </picture>
                  {% else %}
                    {{ card_2_img | image_url: width: 1400 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_2_alt }}
                  {% endif %}
                {% else %}
                  <img src="{{ 'new-arrival-2.jpg' | asset_url }}" alt="{{ card_2_alt }}" class="new-arrivals-gallery__img" loading="eager" width="600" height="700">
                {% endif %}
                {% if show_caption %}
                  <div class="new-arrivals-gallery__caption">
                    <span class="new-arrivals-gallery__caption-title">{{ card_2_alt }}</span>
                    {% if card_2_sub != blank %}<span class="new-arrivals-gallery__caption-sub">{{ card_2_sub }}</span>{% endif %}
                    {% if card_2_price != blank %}<span class="new-arrivals-gallery__caption-price">{{ card_2_price }}</span>{% endif %}
                  </div>
                {% endif %}
              </div>
            {% if card_2_link != blank %}</a>{% endif %}
          </div>

        </div>

        <!-- Bottom Wide Card 3 -->
        <div class="new-arrivals-gallery__card new-arrivals-gallery__card--wide" style="--nag-index: 2;" {% if card_3_block %}{{ card_3_block.shopify_attributes }}{% endif %}>
          {% if card_3_badge != blank %}
            <span class="new-arrivals-gallery__badge" style="background-color: {{ card_3_badge_bg }}; color: {{ card_3_badge_color }};">{{ card_3_badge }}</span>
          {% endif %}
          {% if card_3_link != blank %}<a href="{{ card_3_link }}" class="new-arrivals-gallery__card-link" aria-label="{{ card_3_alt }}">{% endif %}
            <div class="new-arrivals-gallery__media{% if enable_hover_zoom %} new-arrivals-gallery__media--zoom{% endif %}{% if show_caption %} new-arrivals-gallery__media--caption{% endif %}">
              {% if card_3_img != blank %}
                {% if card_3_img_m != blank %}
                  <picture>
                    <source media="(max-width: 749px)" srcset="{{ card_3_img_m | image_url: width: 1200 }}">
                    {{ card_3_img | image_url: width: 2000 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_3_alt }}
                  </picture>
                {% else %}
                  {{ card_3_img | image_url: width: 2000 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_3_alt }}
                {% endif %}
              {% else %}
                <img src="{{ 'new-arrival-3.jpg' | asset_url }}" alt="{{ card_3_alt }}" class="new-arrivals-gallery__img" loading="eager" width="1200" height="910">
              {% endif %}
              {% if show_caption %}
                <div class="new-arrivals-gallery__caption">
                  <span class="new-arrivals-gallery__caption-title">{{ card_3_alt }}</span>
                  {% if card_3_sub != blank %}<span class="new-arrivals-gallery__caption-sub">{{ card_3_sub }}</span>{% endif %}
                  {% if card_3_price != blank %}<span class="new-arrivals-gallery__caption-price">{{ card_3_price }}</span>{% endif %}
                </div>
              {% endif %}
            </div>
          {% if card_3_link != blank %}</a>{% endif %}
        </div>

      </div>

      {%- comment -%} RIGHT COLUMN: 1 Top Feature Card + 2 Bottom Split Cards {%- endcomment -%}
      <div class="new-arrivals-gallery__column new-arrivals-gallery__column--right">

        <!-- Top Feature Card 4 -->
        <div class="new-arrivals-gallery__card new-arrivals-gallery__card--tall" style="--nag-index: 3;" {% if card_4_block %}{{ card_4_block.shopify_attributes }}{% endif %}>
          {% if card_4_badge != blank %}
            <span class="new-arrivals-gallery__badge" style="background-color: {{ card_4_badge_bg }}; color: {{ card_4_badge_color }};">{{ card_4_badge }}</span>
          {% endif %}
          {% if card_4_link != blank %}<a href="{{ card_4_link }}" class="new-arrivals-gallery__card-link" aria-label="{{ card_4_alt }}">{% endif %}
            <div class="new-arrivals-gallery__media{% if enable_hover_zoom %} new-arrivals-gallery__media--zoom{% endif %}{% if show_caption %} new-arrivals-gallery__media--caption{% endif %}">
              {% if card_4_img != blank %}
                {% if card_4_img_m != blank %}
                  <picture>
                    <source media="(max-width: 749px)" srcset="{{ card_4_img_m | image_url: width: 1200 }}">
                    {{ card_4_img | image_url: width: 2000 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_4_alt }}
                  </picture>
                {% else %}
                  {{ card_4_img | image_url: width: 2000 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_4_alt }}
                {% endif %}
              {% else %}
                <img src="{{ 'new-arrival-4.jpg' | asset_url }}" alt="{{ card_4_alt }}" class="new-arrivals-gallery__img" loading="eager" width="1200" height="910">
              {% endif %}
              {% if show_caption %}
                <div class="new-arrivals-gallery__caption">
                  <span class="new-arrivals-gallery__caption-title">{{ card_4_alt }}</span>
                  {% if card_4_sub != blank %}<span class="new-arrivals-gallery__caption-sub">{{ card_4_sub }}</span>{% endif %}
                  {% if card_4_price != blank %}<span class="new-arrivals-gallery__caption-price">{{ card_4_price }}</span>{% endif %}
                </div>
              {% endif %}
            </div>
          {% if card_4_link != blank %}</a>{% endif %}
        </div>

        <!-- Bottom Split Row (Card 5 & Card 6) -->
        <div class="new-arrivals-gallery__row-split">

          <!-- Card 5 -->
          <div class="new-arrivals-gallery__card new-arrivals-gallery__card--split" style="--nag-index: 4;" {% if card_5_block %}{{ card_5_block.shopify_attributes }}{% endif %}>
            {% if card_5_badge != blank %}
              <span class="new-arrivals-gallery__badge" style="background-color: {{ card_5_badge_bg }}; color: {{ card_5_badge_color }};">{{ card_5_badge }}</span>
            {% endif %}
            {% if card_5_link != blank %}<a href="{{ card_5_link }}" class="new-arrivals-gallery__card-link" aria-label="{{ card_5_alt }}">{% endif %}
              <div class="new-arrivals-gallery__media{% if enable_hover_zoom %} new-arrivals-gallery__media--zoom{% endif %}{% if show_caption %} new-arrivals-gallery__media--caption{% endif %}">
                {% if card_5_img != blank %}
                  {% if card_5_img_m != blank %}
                    <picture>
                      <source media="(max-width: 749px)" srcset="{{ card_5_img_m | image_url: width: 800 }}">
                      {{ card_5_img | image_url: width: 1400 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_5_alt }}
                    </picture>
                  {% else %}
                    {{ card_5_img | image_url: width: 1400 | image_tag: class: 'new-arrivals-gallery__img', loading: 'lazy', alt: card_5_alt }}
                  {% endif %}
                {% else %}
                  <img src="{{ 'new-arrival-5.jpg' | asset_url }}" alt="{{ card_5_alt }}" class="new-arrivals-gallery__img" loading="eager" width="600" height="700">
                {% endif %}
                {% if show_caption %}
                  <div class="new-arrivals-gallery__caption">
                    <span class="new-arrivals-gallery__caption-title">{{ card_5_alt }}</span>
                    {% if card_5_sub != blank %}<span class="new-arrivals-gallery__caption-sub">{{ card_5_sub }}</span>{% endif %}
