      height: 100% !important;
      border-radius: 0 !important;
    }

    .new-arrivals-gallery__img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
    }

    /* no hover on touch: captions stay desktop-only */
    .new-arrivals-gallery__caption {
      display: none !important;
    }
  }
{% endstylesheet %}

