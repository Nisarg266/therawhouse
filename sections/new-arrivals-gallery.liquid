{%- comment -%}
  Renders the editorial "NEW ARRIVALS" 6-card asymmetrical masonry gallery.
  Dual mode:
  - If dynamic blocks ("arrival_card") are added, renders blocks with advanced settings (images, titles, designers, badges, prices, links).
  - If no blocks exist, smoothly falls back to section-level settings for full backwards compatibility.
  Wide luxury layout:
  Left Column: 2 Top Squares + 1 Bottom Wide Landscape
  Right Column: 1 Top Feature + 2 Bottom Squares
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign subheading = section.settings.subheading | default: 'the'
  assign heading = section.settings.heading | default: 'NEW ARRIVALS'
  assign show_underline = section.settings.show_underline
  assign gap = section.settings.gap | default: 18
  assign corner_radius = section.settings.corner_radius | default: 0
  assign enable_hover_zoom = section.settings.enable_hover_zoom
  assign full_width = section.settings.full_width
  assign show_caption = section.settings.show_caption_on_hover

  if section.blocks.size > 0
    assign card_1_block = section.blocks[0]
    assign card_1_img = card_1_block.settings.image
    assign card_1_img_m = card_1_block.settings.image_mobile
    assign card_1_link = card_1_block.settings.link
    assign card_1_alt = card_1_block.settings.alt | default: 'New Arrival Item 1'
    assign card_1_sub = card_1_block.settings.designer
    assign card_1_price = card_1_block.settings.price
    assign card_1_badge = card_1_block.settings.badge
    assign card_1_badge_bg = card_1_block.settings.badge_bg | default: '#111111'
    assign card_1_badge_color = card_1_block.settings.badge_color | default: '#ffffff'

    assign card_2_block = section.blocks[1]
    assign card_2_img = card_2_block.settings.image
    assign card_2_img_m = card_2_block.settings.image_mobile
    assign card_2_link = card_2_block.settings.link
    assign card_2_alt = card_2_block.settings.alt | default: 'New Arrival Item 2'
    assign card_2_sub = card_2_block.settings.designer
    assign card_2_price = card_2_block.settings.price
    assign card_2_badge = card_2_block.settings.badge
    assign card_2_badge_bg = card_2_block.settings.badge_bg | default: '#111111'
    assign card_2_badge_color = card_2_block.settings.badge_color | default: '#ffffff'

    assign card_3_block = section.blocks[2]
    assign card_3_img = card_3_block.settings.image
    assign card_3_img_m = card_3_block.settings.image_mobile
    assign card_3_link = card_3_block.settings.link
    assign card_3_alt = card_3_block.settings.alt | default: 'New Arrival Item 3'
    assign card_3_sub = card_3_block.settings.designer
    assign card_3_price = card_3_block.settings.price
    assign card_3_badge = card_3_block.settings.badge
    assign card_3_badge_bg = card_3_block.settings.badge_bg | default: '#111111'
    assign card_3_badge_color = card_3_block.settings.badge_color | default: '#ffffff'

    assign card_4_block = section.blocks[3]
    assign card_4_img = card_4_block.settings.image
    assign card_4_img_m = card_4_block.settings.image_mobile
    assign card_4_link = card_4_block.settings.link
    assign card_4_alt = card_4_block.settings.alt | default: 'New Arrival Item 4'
    assign card_4_sub = card_4_block.settings.designer
    assign card_4_price = card_4_block.settings.price
    assign card_4_badge = card_4_block.settings.badge
    assign card_4_badge_bg = card_4_block.settings.badge_bg | default: '#111111'
    assign card_4_badge_color = card_4_block.settings.badge_color | default: '#ffffff'

    assign card_5_block = section.blocks[4]
    assign card_5_img = card_5_block.settings.image
    assign card_5_img_m = card_5_block.settings.image_mobile
    assign card_5_link = card_5_block.settings.link
    assign card_5_alt = card_5_block.settings.alt | default: 'New Arrival Item 5'
    assign card_5_sub = card_5_block.settings.designer
    assign card_5_price = card_5_block.settings.price
    assign card_5_badge = card_5_block.settings.badge
    assign card_5_badge_bg = card_5_block.settings.badge_bg | default: '#111111'
    assign card_5_badge_color = card_5_block.settings.badge_color | default: '#ffffff'

    assign card_6_block = section.blocks[5]
    assign card_6_img = card_6_block.settings.image
    assign card_6_img_m = card_6_block.settings.image_mobile
    assign card_6_link = card_6_block.settings.link
    assign card_6_alt = card_6_block.settings.alt | default: 'New Arrival Item 6'
    assign card_6_sub = card_6_block.settings.designer
    assign card_6_price = card_6_block.settings.price
    assign card_6_badge = card_6_block.settings.badge
    assign card_6_badge_bg = card_6_block.settings.badge_bg | default: '#111111'
    assign card_6_badge_color = card_6_block.settings.badge_color | default: '#ffffff'
  else
    assign card_1_link = routes.all_products_collection_url
    assign card_1_alt = 'New Arrival Item 1'

    assign card_2_link = routes.all_products_collection_url
    assign card_2_alt = 'New Arrival Item 2'

    assign card_3_link = routes.all_products_collection_url
    assign card_3_alt = 'New Arrival Item 3'

