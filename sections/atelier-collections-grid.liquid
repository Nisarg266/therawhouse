{%- liquid
  assign section_id = 'AtelierCollectionsGrid-' | append: section.id
  assign bg_color = section.settings.background_color | default: '#f8f7f3'
  assign text_color = section.settings.text_color | default: '#111111'
  assign muted_color = section.settings.muted_color | default: '#786f64'
  assign accent_color = section.settings.accent_color | default: '#b38b4d'
-%}

<section
  id="{{ section_id }}"
  class="atelier-collections-grid"
  style="
    --acg-bg: {{ bg_color }};
    --acg-text: {{ text_color }};
    --acg-muted: {{ muted_color }};
    --acg-accent: {{ accent_color }};
    --acg-columns: {{ section.settings.desktop_columns }};
    --acg-mobile-columns: {{ section.settings.mobile_columns }};
    --acg-gap-x: {{ section.settings.column_gap }}px;
    --acg-gap-y: {{ section.settings.row_gap }}px;
    --acg-pt: {{ section.settings.padding_top }}px;
    --acg-pb: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="atelier-collections-grid__inner">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="atelier-collections-grid__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | escape }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ section.settings.breadcrumb_current | escape }}</span>
      </nav>
    {%- endif -%}

    <header class="atelier-collections-grid__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="atelier-collections-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="atelier-collections-grid__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="atelier-collections-grid__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div class="atelier-collections-grid__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_collection = block.settings.collection
          assign card_title = block.settings.title
          assign card_link = block.settings.link
          assign card_image = block.settings.image
          assign card_count = block.settings.piece_count
          assign card_cta = block.settings.cta_label | default: section.settings.cta_label

          if card_title == blank and card_collection != blank
            assign card_title = card_collection.title
          elsif card_title == blank
            assign card_title = 'Collection'
          endif

          if card_link == blank and card_collection != blank
            assign card_link = card_collection.url
          endif

          if card_count == blank and card_collection != blank
            assign product_count = card_collection.products_count
            if product_count == 1
              assign card_count = '1 piece'
            elsif product_count > 1
              assign card_count = product_count | append: ' pieces'
            endif
          endif

          if card_image == blank and card_collection.image != blank
            assign card_image = card_collection.image
          elsif card_image == blank and card_collection.featured_image != blank
            assign card_image = card_collection.featured_image
          elsif card_image == blank and card_collection.products_count > 0 and card_collection.products.first.featured_image != blank
            assign card_image = card_collection.products.first.featured_image
          endif

          if forloop.index < 10
            assign computed_index = forloop.index | prepend: '0'
          else
            assign computed_index = forloop.index
          endif

          assign index_label = block.settings.index_label | default: computed_index

          if forloop.index <= 3
            assign image_loading = 'eager'
          else
            assign image_loading = 'lazy'
          endif
        -%}

        <article class="atelier-collections-grid__card" {{ block.shopify_attributes }}>
          <a
            class="atelier-collections-grid__link"
            href="{% if card_link != blank %}{{ card_link }}{% else %}#{% endif %}"
            aria-label="{{ card_title | escape }}"
          >
            <div class="atelier-collections-grid__media atelier-collections-grid__media--{{ section.settings.image_ratio }}">
              {%- if section.settings.show_index -%}
                <span class="atelier-collections-grid__index">N&deg; {{ index_label }}</span>
              {%- endif -%}

              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'atelier-collections-grid__image',
                    loading: image_loading,
                    widths: '320, 480, 640, 800, 900',
                    sizes: '(min-width: 990px) 30vw, (min-width: 650px) 45vw, 92vw',
                    alt: card_title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'atelier-collections-grid__placeholder' }}
              {%- endif -%}
            </div>

            <div class="atelier-collections-grid__body">
              <span class="atelier-collections-grid__rule" aria-hidden="true"></span>
              <h3 class="atelier-collections-grid__title">{{ card_title | escape }}</h3>

              {%- if section.settings.show_piece_count and card_count != blank -%}
                <p class="atelier-collections-grid__count">{{ card_count | escape }}</p>
              {%- endif -%}

              {%- if card_cta != blank -%}
                <span class="atelier-collections-grid__cta">
                  {{ card_cta | escape }}
                  <span aria-hidden="true">&rarr;</span>
                </span>
              {%- endif -%}
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .atelier-collections-grid {
    width: 100%;
    background: var(--acg-bg);
    color: var(--acg-text);
    padding: var(--acg-pt) 0 var(--acg-pb);
    box-sizing: border-box;
  }

  .atelier-collections-grid__inner {
    width: min(100%, 1120px);
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
  }

  .atelier-collections-grid__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 22px;
    color: var(--acg-muted);
    font: 600 10px/1.2 var(--font-body--family, sans-serif);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .atelier-collections-grid__breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .atelier-collections-grid__breadcrumbs a:hover {
    color: var(--acg-accent);
  }

  .atelier-collections-grid__header {
    max-width: 540px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .atelier-collections-grid__eyebrow {
    margin: 0 0 9px;
    color: var(--acg-accent);
    font: 600 10px/1.2 var(--font-body--family, sans-serif);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .atelier-collections-grid__heading {
    margin: 0;
    color: var(--acg-text);
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .atelier-collections-grid__intro {
    max-width: 470px;
    margin: 21px auto 0;
    color: var(--acg-muted);
    font: 400 12px/1.75 var(--font-body--family, sans-serif);
    letter-spacing: 0.02em;
  }

  .atelier-collections-grid__intro p {
    margin: 0;
  }

  .atelier-collections-grid__items {
    display: grid;
    grid-template-columns: repeat(var(--acg-columns), minmax(0, 1fr));
    column-gap: var(--acg-gap-x);
    row-gap: var(--acg-gap-y);
  }

  .atelier-collections-grid__card {
    min-width: 0;
  }

  .atelier-collections-grid__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .atelier-collections-grid__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #eee9df;
  }

  .atelier-collections-grid__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .atelier-collections-grid__media--square {
    aspect-ratio: 1 / 1;
  }

  .atelier-collections-grid__media--landscape {
    aspect-ratio: 5 / 4;
  }

  .atelier-collections-grid__image,
  .atelier-collections-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .atelier-collections-grid__image {
    object-fit: cover;
    transform: scale(1);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .atelier-collections-grid__placeholder {
    object-fit: cover;
    background: #e9e1d4;
    fill: rgba(20, 17, 14, 0.22);
  }

  .atelier-collections-grid__link:hover .atelier-collections-grid__image {
    transform: scale(1.035);
  }

  .atelier-collections-grid__index {
    position: absolute;
    top: 13px;
    left: 13px;
    z-index: 2;
    color: #ffffff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
    font: italic 600 11px/1 Georgia, serif;
    letter-spacing: 0.04em;
  }

  .atelier-collections-grid__body {
    padding-top: 16px;
  }

  .atelier-collections-grid__rule {
    display: block;
    width: 27px;
    height: 1px;
    margin-bottom: 10px;
    background: var(--acg-accent);
  }

  .atelier-collections-grid__title {
    margin: 0;
    color: var(--acg-text);
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .atelier-collections-grid__count {
    margin: 5px 0 0;
    color: var(--acg-muted);
    font: 600 10px/1.3 var(--font-body--family, sans-serif);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .atelier-collections-grid__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 10px;
    color: var(--acg-accent);
    font: 600 10px/1.3 var(--font-body--family, sans-serif);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .atelier-collections-grid__link:hover .atelier-collections-grid__cta {
    color: var(--acg-text);
    transform: translateX(2px);
  }

  @media screen and (max-width: 989px) {
    .atelier-collections-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 649px) {
    .atelier-collections-grid__inner {
      padding: 0 20px;
    }

    .atelier-collections-grid__breadcrumbs {
      margin-bottom: 20px;
      font-size: 9px;
    }

    .atelier-collections-grid__header {
      margin-bottom: 32px;
    }

    .atelier-collections-grid__items {
      grid-template-columns: repeat(var(--acg-mobile-columns), minmax(0, 1fr));
      column-gap: 14px;
      row-gap: 34px;
    }

    .atelier-collections-grid__body {
      padding-top: 12px;
    }

    .atelier-collections-grid__title {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Atelier collections grid",
  "tag": "section",
  "class": "section-atelier-collections-grid",
  "max_blocks": 24,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Home breadcrumb",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current",
      "label": "Current breadcrumb",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Raw House Atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Collections"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Each collection is a curated exhibition - original canvases, sculptural forms, and decorative objects assembled with singular intention.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Default card link label",
      "default": "Discover"
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "Show card numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_piece_count",
      "label": "Show piece count",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f8f7f3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#786f64"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b38b4d"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "piece_count",
          "label": "Piece count override",
          "info": "Leave blank to use the selected collection product count."
        },
        {
          "type": "text",
          "id": "index_label",
          "label": "Number override",
          "info": "Example: 01. Leave blank for automatic numbering."
        },
        {
          "type": "text",
