{%- comment -%}
  Renders "THE FINE PRINTS" curated 3-product art & design showcase section.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign subheading = section.settings.subheading | default: 'the'
  assign heading = section.settings.heading | default: 'F I N E   P R I N T S'
  assign show_underline = section.settings.show_underline
  assign max_width = section.settings.max_width | default: 1080
  assign gap = section.settings.gap | default: 28
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 60
  assign view_all_text = section.settings.view_all_text | default: 'VIEW ALL'
  assign view_all_link = section.settings.view_all_link | default: '/collections/all'
  assign enable_hover_zoom = section.settings.enable_hover_zoom

  assign card_1_title = section.settings.card_1_title | default: 'Radha and Krishna'
  assign card_1_vendor = section.settings.card_1_vendor | default: 'By Mahaveer Swami'
  assign card_1_price = section.settings.card_1_price | default: '₹3,900.00'
  assign card_1_badge = section.settings.card_1_badge | default: 'OPTIONS AVAILABLE'
  assign card_1_img = section.settings.card_1_image
  assign card_1_link = section.settings.card_1_link | default: '/collections/all'

  assign card_2_title = section.settings.card_2_title | default: 'Pink Flower Deep Plate - Bitossi'
  assign card_2_vendor = section.settings.card_2_vendor | default: 'By Mon Dimora'
  assign card_2_price = section.settings.card_2_price | default: '₹5,900.00'
  assign card_2_badge = section.settings.card_2_badge | default: ''
  assign card_2_img = section.settings.card_2_image
  assign card_2_link = section.settings.card_2_link | default: '/collections/all'

  assign card_3_title = section.settings.card_3_title | default: 'The Blueroom Hand Printed Wallpaper'
  assign card_3_vendor = section.settings.card_3_vendor | default: 'By Oldhand Designs'
  assign card_3_price = section.settings.card_3_price | default: '₹13,000.00'
  assign card_3_badge_1 = section.settings.card_3_badge_1 | default: 'OPTIONS AVAILABLE'
  assign card_3_badge_2 = section.settings.card_3_badge_2 | default: 'CUSTOMIZABLE'
  assign card_3_img = section.settings.card_3_image
  assign card_3_link = section.settings.card_3_link | default: '/collections/all'
%}

<div
  id="FinePrints-{{ section_id }}"
  class="fine-prints-showcase section-{{ section_id }}"
  style="
    --fps-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --fps-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --fps-max-width: {{ max_width }}px;
    --fps-gap: {{ gap }}px;
    --fps-padding-top: {{ padding_top }}px;
    --fps-padding-bottom: {{ padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="fine-prints-showcase__container">
    
    {%- comment -%} Header Title with Script Subheading & Underline {%- endcomment -%}
    <div class="fine-prints-showcase__header">
      {% if subheading != blank %}
        <span class="fine-prints-showcase__subheading">{{ subheading }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2 class="fine-prints-showcase__heading">{{ heading }}</h2>
      {% endif %}
      {% if show_underline %}
        <div class="fine-prints-showcase__underline" aria-hidden="true"></div>
      {% endif %}
    </div>

    {%- comment -%} 3-Product Cards Grid {%- endcomment -%}
    <div class="fine-prints-showcase__grid">
      
      <!-- Card 1 -->
      <article class="fine-prints-showcase__card">
        <div class="fine-prints-showcase__media-wrap{% if enable_hover_zoom %} fine-prints-showcase__media--zoom{% endif %}">
          <a href="{{ card_1_link }}" class="fine-prints-showcase__media-link" aria-label="{{ card_1_title | escape }}">
            {% if card_1_img != blank %}
              {{ card_1_img | image_url: width: 800 | image_tag: class: 'fine-prints-showcase__img', loading: 'lazy', alt: card_1_title }}
            {% else %}
              <img src="{{ 'fine-print-1.jpg' | asset_url }}" alt="{{ card_1_title | escape }}" class="fine-prints-showcase__img" loading="eager" width="600" height="600">
            {% endif %}
          </a>
        </div>

        <div class="fine-prints-showcase__info">
          <div class="fine-prints-showcase__row-top">
            <h3 class="fine-prints-showcase__product-title">
              <a href="{{ card_1_link }}">{{ card_1_title }}</a>
            </h3>
            <span class="fine-prints-showcase__price">{{ card_1_price }}</span>
          </div>

          {% if card_1_vendor != blank %}
            <div class="fine-prints-showcase__vendor">{{ card_1_vendor }}</div>
          {% endif %}

          {% if card_1_badge != blank %}
            <div class="fine-prints-showcase__badges">
              <span class="fine-prints-showcase__badge fine-prints-showcase__badge--outline">{{ card_1_badge }}</span>
            </div>
          {% endif %}
        </div>
      </article>

      <!-- Card 2 -->
      <article class="fine-prints-showcase__card">
        <div class="fine-prints-showcase__media-wrap{% if enable_hover_zoom %} fine-prints-showcase__media--zoom{% endif %}">
          <a href="{{ card_2_link }}" class="fine-prints-showcase__media-link" aria-label="{{ card_2_title | escape }}">
            {% if card_2_img != blank %}
              {{ card_2_img | image_url: width: 800 | image_tag: class: 'fine-prints-showcase__img', loading: 'lazy', alt: card_2_title }}
            {% else %}
              <img src="{{ 'fine-print-2.jpg' | asset_url }}" alt="{{ card_2_title | escape }}" class="fine-prints-showcase__img" loading="eager" width="600" height="600">
            {% endif %}
          </a>
        </div>

        <div class="fine-prints-showcase__info">
          <div class="fine-prints-showcase__row-top">
            <h3 class="fine-prints-showcase__product-title">
              <a href="{{ card_2_link }}">{{ card_2_title }}</a>
            </h3>
            <span class="fine-prints-showcase__price">{{ card_2_price }}</span>
          </div>

          {% if card_2_vendor != blank %}
            <div class="fine-prints-showcase__vendor">{{ card_2_vendor }}</div>
          {% endif %}

          {% if card_2_badge != blank %}
            <div class="fine-prints-showcase__badges">
              <span class="fine-prints-showcase__badge fine-prints-showcase__badge--outline">{{ card_2_badge }}</span>
            </div>
          {% endif %}
        </div>
      </article>

      <!-- Card 3 -->
      <article class="fine-prints-showcase__card">
        <div class="fine-prints-showcase__media-wrap{% if enable_hover_zoom %} fine-prints-showcase__media--zoom{% endif %}">
          <a href="{{ card_3_link }}" class="fine-prints-showcase__media-link" aria-label="{{ card_3_title | escape }}">
            {% if card_3_img != blank %}
              {{ card_3_img | image_url: width: 800 | image_tag: class: 'fine-prints-showcase__img', loading: 'lazy', alt: card_3_title }}
            {% else %}
              <img src="{{ 'fine-print-3.jpg' | asset_url }}" alt="{{ card_3_title | escape }}" class="fine-prints-showcase__img" loading="eager" width="600" height="600">
            {% endif %}
          </a>
        </div>

        <div class="fine-prints-showcase__info">
          <div class="fine-prints-showcase__row-top">
            <h3 class="fine-prints-showcase__product-title">
              <a href="{{ card_3_link }}">{{ card_3_title }}</a>
            </h3>
            <span class="fine-prints-showcase__price">{{ card_3_price }}</span>
          </div>

          {% if card_3_vendor != blank %}
            <div class="fine-prints-showcase__vendor">{{ card_3_vendor }}</div>
          {% endif %}

          <div class="fine-prints-showcase__badges">
            {% if card_3_badge_1 != blank %}
              <span class="fine-prints-showcase__badge fine-prints-showcase__badge--outline">{{ card_3_badge_1 }}</span>
            {% endif %}
            {% if card_3_badge_2 != blank %}
              <span class="fine-prints-showcase__badge fine-prints-showcase__badge--solid">{{ card_3_badge_2 }}</span>
            {% endif %}
          </div>
        </div>
      </article>

    </div>

    {%- comment -%} Footer View All Link {%- endcomment -%}
    {% if view_all_text != blank %}
      <div class="fine-prints-showcase__footer">
        <a href="{{ view_all_link }}" class="fine-prints-showcase__view-all">
          {{ view_all_text }}
        </a>
      </div>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .fine-prints-showcase {
    background-color: var(--fps-bg, #ffffff);
    width: 100%;
    padding-block-start: var(--fps-padding-top, 24px);
    padding-block-end: var(--fps-padding-bottom, 20px);
    box-sizing: border-box;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .fine-prints-showcase__container {
    max-width: var(--fps-max-width, 1080px);
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  .fine-prints-showcase__header {
    text-align: center;
    margin-block-end: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .fine-prints-showcase__subheading {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 15px;
    color: var(--fps-heading-color, #111111);
    margin-bottom: 3px;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  .fine-prints-showcase__heading {
    font-size: 19px;
    letter-spacing: 0.32em;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--fps-heading-color, #111111);
    margin: 0;
    line-height: 1.2;
  }

  .fine-prints-showcase__underline {
    width: 36px;
    height: 1.5px;
    background-color: var(--fps-heading-color, #111111);
    margin-top: 10px;
  }

  .fine-prints-showcase__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--fps-gap, 28px);
    width: 100%;
  }

  @media screen and (min-width: 640px) {
    .fine-prints-showcase__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .fine-prints-showcase__card {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .fine-prints-showcase__media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f7f7f7;
    margin-bottom: 12px;
  }

  .fine-prints-showcase__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fine-prints-showcase__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fine-prints-showcase__media--zoom:hover .fine-prints-showcase__img {
    transform: scale(1.04);
  }

  .fine-prints-showcase__info {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .fine-prints-showcase__row-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 3px;
  }

  .fine-prints-showcase__product-title {
    font-size: 11.5px;
    font-weight: 500;
    color: #111111;
    margin: 0;
    line-height: 1.35;
    flex: 1;
  }

  .fine-prints-showcase__product-title a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .fine-prints-showcase__product-title a:hover {
    opacity: 0.75;
  }

  .fine-prints-showcase__price {
    font-size: 11px;
    font-weight: 500;
    color: #333333;
    white-space: nowrap;
  }

  .fine-prints-showcase__vendor {
    font-size: 10.5px;
    color: #888888;
    margin-bottom: 8px;
  }

  .fine-prints-showcase__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
    margin-top: 2px;
  }

  .fine-prints-showcase__badge {
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 3px 6px;
    text-transform: uppercase;
    line-height: 1;
    display: inline-block;
  }

  .fine-prints-showcase__badge--outline {
    border: 1px solid #d4d4d4;
    color: #666666;
    background-color: transparent;
  }

  .fine-prints-showcase__badge--solid {
    background-color: #111111;
    color: #ffffff;
    border: 1px solid #111111;
  }

  .fine-prints-showcase__footer {
    text-align: center;
    margin-top: 20px;
  }

  .fine-prints-showcase__view-all {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }

  .fine-prints-showcase__view-all:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

