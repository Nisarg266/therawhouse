      width: min(100%, 720px);
      margin: 0 auto;
    }

    .trh-events__viewport {
      min-height: clamp(300px, 60vw, 470px);
    }

    .trh-events__body {
      align-items: center;
      text-align: center;
    }

    .trh-events__location {
      justify-content: center;
    }

    .trh-events__text {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .trh-events {
      padding: var(--events-pt-m, 40px) 0 var(--events-pb-m, 44px);
    }

    .trh-events__container {
      padding: 0 var(--events-px-m, 16px);
    }

    .trh-events__header,
    .trh-events__header--left {
      max-width: none;
      text-align: center;
      align-items: center;
      margin-bottom: 36px;
    }

    .trh-events__heading {
      font-size: var(--events-heading-size-m, 86px);
      line-height: 0.86;
    }

    .trh-events__heading span,
    .trh-events__heading em {
      display: block;
      margin-left: 0;
    }

    .trh-events__card {
      gap: 34px;
    }

    .trh-events__gallery {
      width: 100%;
    }

    .trh-events__viewport {
      min-height: clamp(300px, 88vw, 450px);
    }

    .trh-events__media {
      width: min(66%, 330px);
    }

    .trh-events__media.is-prev {
      transform: translateX(-98%) translateY(9%) scale(0.82);
    }

    .trh-events__media.is-next {
      transform: translateX(-2%) translateY(9%) scale(0.82);
    }

    .trh-events__slider-controls {
      justify-content: center;
      padding-left: 0;
    }

    .trh-events__counter,
    .trh-events__counter-line {
      display: none;
    }

    .trh-events__media figcaption {
      left: 14px;
      top: 16px;
      font-size: var(--events-image-label-size-m, 10px);
      letter-spacing: 0.28em;
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }

    .trh-events__eyebrow {
      font-size: var(--events-eyebrow-size-m, 10px);
    }

    .trh-events__intro {
      font-size: var(--events-intro-size-m, 15px);
    }

    .trh-events__badge {
      font-size: var(--events-badge-size-m, 10px);
    }

    .trh-events__meta {
      font-size: var(--events-date-size-m, 10px);
    }

    .trh-events__title {
      font-size: var(--events-title-size-m, 72px);
    }

    .trh-events__location {
      font-size: var(--events-location-size-m, 12px);
      letter-spacing: 0.26em;
    }

    .trh-events__text {
      font-size: var(--events-description-size-m, 15px);
    }

    .trh-events__location span {
      width: 34px;
    }

    .trh-events__cta {
      width: 100%;
