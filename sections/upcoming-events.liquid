{% javascript %}
  (() => {
    const initEventSliders = (root = document) => {
      root.querySelectorAll('[data-trh-events-slider]').forEach((slider) => {
        if (slider.dataset.trhReady === 'true') return;
        slider.dataset.trhReady = 'true';

        const track = slider.querySelector('[data-trh-events-track]');
        const prev = slider.querySelector('[data-trh-events-prev]');
        const next = slider.querySelector('[data-trh-events-next]');
        const current = slider.querySelector('[data-trh-events-current]');
        const dots = Array.from(slider.querySelectorAll('[data-trh-events-dot]'));
        const slides = Array.from(track?.querySelectorAll('.trh-events__media') || []);
        if (!track) return;

        let index = 0;

        const wrap = (value) => (value + slides.length) % slides.length;
        const format = (value) => String(value + 1).padStart(2, '0');

        const render = () => {
          if (!slides.length) return;
          const prevIndex = wrap(index - 1);
          const nextIndex = wrap(index + 1);

          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle('is-active', slideIndex === index);
            slide.classList.toggle('is-prev', slideIndex === prevIndex);
            slide.classList.toggle('is-next', slideIndex === nextIndex);
            slide.classList.toggle('is-hidden', slideIndex !== index && slideIndex !== prevIndex && slideIndex !== nextIndex);
          });

          dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === index));
          if (current) current.textContent = format(index);
        };

        prev?.addEventListener('click', () => {
          index = wrap(index - 1);
          render();
        });
        next?.addEventListener('click', () => {
          index = wrap(index + 1);
          render();
        });
        dots.forEach((dot, dotIndex) => dot.addEventListener('click', () => {
          index = dotIndex;
          render();
        }));
        render();
      });
    };

    initEventSliders();
    document.addEventListener('shopify:section:load', (event) => initEventSliders(event.target));
  })();
{% endjavascript %}

