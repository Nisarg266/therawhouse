{%- comment -%}
  THE RAW HOUSE - EDITORIAL JOURNAL & ARTICLES
  Magazine editorial layout with reading time badges, author tags, and interactive hover transitions.
{%- endcomment -%}

{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'light'
  case scheme
    when 'warm'
      assign bg_color = '#f9f8f5'
      assign heading_color = '#111111'
      assign card_bg = '#ffffff'
    when 'dark'
      assign bg_color = '#141414'
      assign heading_color = '#ffffff'
      assign card_bg = '#1e1e1e'
    when 'obsidian'
      assign bg_color = '#0b0b0b'
      assign heading_color = '#ffffff'
      assign card_bg = 'rgba(255, 255, 255, 0.04)'
    else
      assign bg_color = '#ffffff'
      assign heading_color = '#111111'
      assign card_bg = '#faf9f6'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_heading_color != blank and section.settings.custom_heading_color != 'rgba(0,0,0,0)'
    assign heading_color = section.settings.custom_heading_color
  endif
%}

<div
  id="LuxuryJournal-{{ section.id }}"
  class="lux-journal-section lux-journal-scheme-{{ scheme }}"
  style="
    --journal-bg: {{ bg_color }};
    --journal-heading-color: {{ heading_color }};
    --journal-card-bg: {{ card_bg }};
    --journal-pt: {{ section.settings.padding_top | default: 30 }}px;
    --journal-pb: {{ section.settings.padding_bottom | default: 48 }}px;
    background: var(--journal-bg);
    padding-top: var(--journal-pt);
    padding-bottom: var(--journal-pb);
  "
  {{ section.shopify_attributes }}
>
  <div class="lux-journal-container">
    {% if section.settings.heading != blank %}
      <div class="lux-section-heading-wrap lux-reveal-fade-up">
        {% if section.settings.subheading != blank %}
          <span class="lux-section-subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 class="lux-section-heading">{{ section.settings.heading }}</h2>
        <div class="lux-section-divider"></div>
      </div>
    {% endif %}

    <div class="lux-journal-grid lux-stagger-parent lux-reveal-fade-up">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: '/blogs/news' }}"
          class="lux-journal-card lux-stagger-child"
          {{ block.shopify_attributes }}
        >
          <div class="lux-journal-media-wrap">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  class: 'lux-journal-img',
                  loading: 'eager',
                  alt: block.settings.title
              }}
            {% elsif block.settings.default_asset != blank %}
              <img
                src="{{ block.settings.default_asset | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                class="lux-journal-img"
                loading="eager"
                onerror="this.onerror=null;this.src='{{ 'fine-print-1.jpg' | asset_url }}';"
                width="600"
                height="400"
              >
            {% else %}
              <img
                src="{{ 'fine-print-1.jpg' | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                class="lux-journal-img"
                loading="eager"
                width="600"
                height="400"
              >
            {% endif %}
          </div>

          <div class="lux-journal-meta">
            <span>{{ block.settings.category }}</span>
            <span>•</span>
            <span>{{ block.settings.read_time }}</span>
          </div>

          <h3 class="lux-journal-title">{{ block.settings.title }}</h3>
          <p class="lux-journal-excerpt">{{ block.settings.excerpt }}</p>

          <span class="lux-journal-link">
            Read Journal
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Editorial Journal",
  "tag": "section",
  "class": "section-luxury-journal",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme & Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color Scheme Preset",
      "options": [
        { "value": "light", "label": "Light Clean (#ffffff)" },
        { "value": "warm", "label": "Warm Atelier Ivory (#f9f8f5)" },
        { "value": "dark", "label": "Contemporary Dark (#141414)" },
        { "value": "obsidian", "label": "Obsidian Gold (#0b0b0b)" }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_heading_color",
      "label": "Custom Heading Color"
    },
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "JOURNAL & ESSAYS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STORIES & INSPIRATIONS"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "article_card",
      "name": "Journal Article",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Article Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Default Asset Fallback"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category Tag",
          "default": "INTERIORS"
        },
        {
          "type": "text",
          "id": "read_time",
          "label": "Reading Time",
          "default": "4 MIN READ"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article Title",
          "default": "The Art of Curating Organic Textures"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "How layering limestone, unlacquered brass, and reclaimed teak creates warmth in contemporary living spaces."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Editorial Journal",
      "blocks": [
        {
          "type": "article_card",
          "settings": {
            "default_asset": "art-painting-starry-night.jpg",
            "category": "ART COLLECTING",
            "read_time": "5 MIN READ",
            "title": "The Collector's Guide: Investing in Contemporary Oil on Canvas",
            "excerpt": "Understanding mineral pigment quality, archival linen substrates, and the rising valuation of textured mixed-media masterworks."
          }
        },
        {
          "type": "article_card",
          "settings": {
            "default_asset": "art-sculpture-rodin-thinker.jpg",
            "category": "SCULPTURAL ART",
            "read_time": "6 MIN READ",
            "title": "Living with Sculpture: Placing 3D Art Models & Bronze Figures",
            "excerpt": "How architectural interior curators integrate three-dimensional art sculptures to create striking focal points in modern rooms."
          }
        },
        {
          "type": "article_card",
          "settings": {
            "default_asset": "art-painting-water-lilies.jpg",
            "category": "GALLERY CURATION",
            "read_time": "4 MIN READ",
            "title": "The Art of Archival Care: Lighting, Framing & Canvas Preservation",
            "excerpt": "Preserving museum-grade oil paintings and delicate bronze patinas with optimal ambient lighting and temperature control."
          }
        }
      ]
    }
  ]
}
{% endschema %}
