{%- comment -%}
  THE RAW HOUSE - EDITORIAL LUXURY COLLECTION HERO BANNER
  Matches high-end art gallery aesthetic with rich background image, Ken Burns slow zoom animation,
  multi-layered vignette overlay, frosted glassmorphism card, cursive pre-title, tracked serif heading,
  glowing gold underline, crystal-clear typography, and live masterpieces count badge.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign subheading = section.settings.subheading | default: 'the'
  assign heading = section.settings.heading
  if heading == blank
    assign heading = collection.title | default: 'Curated Collection'
  endif
  assign show_underline = section.settings.show_underline
  assign show_count = section.settings.show_count
  assign description = collection.description
  if description == blank and section.settings.fallback_description != blank
    assign description = section.settings.fallback_description
  endif
  assign max_width = section.settings.max_width | default: 840
  assign bg_color = section.settings.background_color | default: '#111111'
  assign heading_color = section.settings.heading_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#c5a880'

  assign bg_image = section.settings.background_image
  assign use_asset_fallback = false
  if bg_image == blank
    assign use_asset_fallback = true
  endif
  assign min_height = section.settings.min_height | default: 380
  assign overlay_opacity = section.settings.overlay_opacity | default: 58 | divided_by: 100.0
%}

<div
  id="CollectionHero-{{ section_id }}"
  class="collection-hero-editorial section-{{ section_id }}"
  style="
    --che-bg: {{ bg_color }};
    --che-heading-color: {{ heading_color }};
    --che-accent-color: {{ accent_color }};
    --che-max-width: {{ max_width }}px;
    --che-min-height: {{ min_height }}px;
    --che-pt: {{ section.settings.padding_top | default: 56 }}px;
    --che-pb: {{ section.settings.padding_bottom | default: 52 }}px;
    --che-overlay-opacity: {{ overlay_opacity }};
  "
  {{ section.shopify_attributes }}
>
  <!-- Background Image with Ken Burns animation -->
  <div class="collection-hero-editorial__bg-wrap" aria-hidden="true">
    {% if bg_image != blank %}
      {{
        bg_image
        | image_url: width: 2400
        | image_tag:
          class: 'collection-hero-editorial__bg-img',
          loading: 'eager',
          alt: heading
      }}
    {% elsif use_asset_fallback %}
      <img
        src="{{ 'hero-art-furniture-1.jpg' | asset_url }}"
        alt="{{ heading }}"
        class="collection-hero-editorial__bg-img"
        loading="eager"
        width="1920"
        height="900"
      >
    {% endif %}
    <!-- Multi-layered luxury vignette overlay -->
    <div class="collection-hero-editorial__overlay"></div>
  </div>

  <!-- Foreground Content Container with ambient glass card -->
  <div class="collection-hero-editorial__container">
    <div class="collection-hero-editorial__glass-card">
      <!-- Breadcrumbs -->
      {% if section.settings.show_breadcrumbs != false %}
        <nav class="collection-hero-editorial__breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}" class="collection-hero-editorial__crumb">Home</a>
          <span class="collection-hero-editorial__crumb-sep" aria-hidden="true">/</span>
          <a href="{{ routes.collections_url }}" class="collection-hero-editorial__crumb">Collections</a>
          <span class="collection-hero-editorial__crumb-sep" aria-hidden="true">/</span>
          <span class="collection-hero-editorial__crumb collection-hero-editorial__crumb--current" aria-current="page">{{ heading }}</span>
        </nav>
      {% endif %}

      <!-- Breadcrumb / Pre-title -->
      {% if subheading != blank %}
        <span class="collection-hero-editorial__subheading">{{ subheading }}</span>
      {% endif %}

      <!-- Main Spaced Serif Heading -->
      <h1 class="collection-hero-editorial__heading">
        {{ heading }}
      </h1>

      <!-- Gold / Dark Luxury Underline -->
      {% if show_underline %}
        <div class="collection-hero-editorial__underline" aria-hidden="true"></div>
      {% endif %}

      <!-- Editorial Description -->
      {% if description != blank %}
        <div class="collection-hero-editorial__desc">
          {{ description }}
        </div>
      {% endif %}

      <!-- Live Masterpieces Count Pill -->
      {% if show_count %}
        <div class="collection-hero-editorial__badge-wrap">
          <span class="collection-hero-editorial__badge">
            <span class="collection-hero-editorial__badge-dot"></span>
            {% if collection.products_count == 1 %}
              1 MASTERPIECE CURATED
            {% else %}
              {{ collection.products_count | default: 0 }} MASTERPIECES CURATED
            {% endif %}
          </span>
        </div>
      {% endif %}
    </div>

    <!-- Collection Navigation Chips -->
    {% if section.settings.show_collection_nav != false %}
      <nav class="collection-hero-editorial__collnav" aria-label="Collection navigation">
        <div class="collection-hero-editorial__collnav-track">
          {% assign nav_count = 0 %}
          {% for nav_col in collections %}
            {% if nav_col.handle != collection.handle and nav_count < 8 %}
              {% assign nav_count = nav_count | plus: 1 %}
              <a href="{{ nav_col.url }}" class="collection-hero-editorial__chip">
                {{ nav_col.title }}
              </a>
            {% endif %}
          {% endfor %}
          <a href="{{ routes.collections_url }}" class="collection-hero-editorial__chip collection-hero-editorial__chip--all">
            All Collections
          </a>
        </div>
      </nav>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .collection-hero-editorial {
    position: relative;
    width: 100%;
    min-height: var(--che-min-height, 380px);
    padding-block-start: var(--che-pt, 56px);
    padding-block-end: var(--che-pb, 52px);
    background-color: #111111;
    overflow: hidden;
    display: flex !important;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .collection-hero-editorial__bg-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .collection-hero-editorial__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.02);
    animation: luxKenBurns 22s cubic-bezier(0.25, 1, 0.5, 1) infinite alternate;
  }

  @keyframes luxKenBurns {
    0% {
      transform: scale(1.02) translate(0, 0);
    }
    100% {
      transform: scale(1.08) translate(-1%, -1%);
    }
  }

  .collection-hero-editorial__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(15, 15, 15, calc(var(--che-overlay-opacity, 0.58) - 0.14)) 0%,
      rgba(8, 8, 8, calc(var(--che-overlay-opacity, 0.58) + 0.20)) 100%
    );
    mix-blend-mode: multiply;
  }

  .collection-hero-editorial__overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.40) 0%,
      rgba(0, 0, 0, 0.18) 50%,
      rgba(0, 0, 0, 0.52) 100%
    );
  }

  .collection-hero-editorial__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--che-max-width, 880px);
    margin-inline: auto;
    padding-inline: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    box-sizing: border-box;
  }

  /* --- Breadcrumbs --- */
  .collection-hero-editorial__breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 12px;
    animation: luxFadeIn 0.8s ease-out 0.1s both;
  }

  .collection-hero-editorial__crumb {
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  a.collection-hero-editorial__crumb:hover {
    color: var(--che-accent-color, #c5a880);
  }

  .collection-hero-editorial__crumb--current {
    color: #ffffff;
  }

  .collection-hero-editorial__crumb-sep {
    color: var(--che-accent-color, #c5a880);
    opacity: 0.7;
    font-size: 9px;
  }

  /* --- Collection Navigation Chips --- */
  .collection-hero-editorial__collnav {
    width: 100%;
    max-width: 100%;
    animation: luxFadeIn 0.8s ease-out 0.8s both;
  }

  .collection-hero-editorial__collnav-track {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 2px 8px;
    margin-inline: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .collection-hero-editorial__collnav-track::-webkit-scrollbar {
    display: none;
  }

  .collection-hero-editorial__chip {
    flex-shrink: 0;
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 7px 15px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .collection-hero-editorial__chip:hover {
    border-color: var(--che-accent-color, #c5a880);
    color: #ffffff;
    background: rgba(255, 255, 255, 0.14);
    transform: translateY(-1px);
  }

  .collection-hero-editorial__chip--all {
    border-style: dashed;
    color: var(--che-accent-color, #c5a880);
  }

  .collection-hero-editorial__chip--all:hover {
    border-style: solid;
    border-color: var(--che-accent-color, #c5a880);
    color: #ffffff;
  }

  .collection-hero-editorial__glass-card {
    width: 100%;
    max-width: 820px;
    background: rgba(18, 18, 18, 0.42);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.32), 0 0 0 1px rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    padding: clamp(28px, 4.5vw, 44px) clamp(20px, 4vw, 48px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: luxCardEntrance 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes luxCardEntrance {
    0% {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .collection-hero-editorial__subheading {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-style: italic !important;
    font-size: clamp(22px, 2.5vw, 28px) !important;
    color: #f0e6d6 !important;
    margin-bottom: 4px !important;
    letter-spacing: 0.04em !important;
    opacity: 0.95 !important;
    line-height: 1.1 !important;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
    animation: luxFadeIn 0.8s ease-out 0.2s both;
  }

  .collection-hero-editorial__heading {
    font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(24px, 4.2vw, 42px) !important;
    letter-spacing: 0.26em !important;
    font-weight: 500 !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin: 0 !important;
    line-height: 1.25 !important;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
    animation: luxFadeIn 0.8s ease-out 0.35s both;
  }

  .collection-hero-editorial__underline {
    width: 48px !important;
    height: 1.5px !important;
    background: linear-gradient(90deg, transparent, #c5a880 30%, #e2ceb1 50%, #c5a880 70%, transparent) !important;
    margin: 14px auto 18px !important;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    box-shadow: 0 0 10px rgba(197, 168, 128, 0.6) !important;
  }

  .collection-hero-editorial:hover .collection-hero-editorial__underline {
    width: 84px !important;
  }

  .collection-hero-editorial__desc {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: clamp(13px, 1.4vw, 14.5px) !important;
    line-height: 1.75 !important;
    color: rgba(255, 255, 255, 0.94) !important;
    max-width: 640px !important;
    margin: 0 auto 20px !important;
    letter-spacing: 0.02em !important;
    font-weight: 300 !important;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
    animation: luxFadeIn 0.8s ease-out 0.5s both;
  }

  .collection-hero-editorial__badge-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    animation: luxFadeIn 0.8s ease-out 0.65s both;
  }

  .collection-hero-editorial__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 18px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 9999px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
  }

  .collection-hero-editorial__badge:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .collection-hero-editorial__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #c5a880;
    box-shadow: 0 0 8px #c5a880;
    display: inline-block;
    animation: luxPulseGold 2s infinite ease-in-out;
  }

  @keyframes luxPulseGold {
    0% {
      box-shadow: 0 0 0 0 rgba(197, 168, 128, 0.6);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(197, 168, 128, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(197, 168, 128, 0);
    }
  }

  @keyframes luxFadeIn {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 768px) {
    .collection-hero-editorial {
      min-height: 320px !important;
      padding-block-start: clamp(24px, 6vw, 36px) !important;
      padding-block-end: clamp(24px, 6vw, 36px) !important;
    }

    .collection-hero-editorial__glass-card {
      padding: 24px 16px !important;
      border-radius: 4px !important;
    }

    .collection-hero-editorial__subheading {
      font-size: 20px !important;
    }

    .collection-hero-editorial__heading {
      font-size: clamp(20px, 6vw, 28px) !important;
      letter-spacing: 0.18em !important;
    }

    .collection-hero-editorial__underline {
      width: 36px !important;
      margin: 10px auto 14px !important;
    }

    .collection-hero-editorial__desc {
      font-size: 12.5px !important;
      line-height: 1.6 !important;
      margin-bottom: 16px !important;
    }

    .collection-hero-editorial__badge {
      font-size: 9.5px !important;
      padding: 6px 14px !important;
      letter-spacing: 0.16em !important;
    }

    .collection-hero-editorial__breadcrumbs {
      font-size: 9px;
      gap: 7px;
      margin-bottom: 10px;
    }

    .collection-hero-editorial__collnav-track {
      justify-content: flex-start;
      gap: 7px;
    }

    .collection-hero-editorial__chip {
      font-size: 9px;
      padding: 7px 13px;
      letter-spacing: 0.12em;
    }
  }

  /* ==========================================================================
     NATIVE COLLECTION PAGE POLISH LAYER
     Refines the Horizon product grid, facets, count and badges.
     Loaded only on the collection template (hero section dependency).
     All native Liquid/JS functionality remains untouched.
     ========================================================================== */

  /* --- Facets bar: filter & sort labels --- */
  .facets-block-wrapper .facets__label,
  .sorting-filter .facets__label {
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
  }

  .facets-block-wrapper .facets__summary {
    gap: 8px;
  }

  /* --- Product count --- */
  .products-count-wrapper span[role='status'],
  .products-count-wrapper span {
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: var(--che-accent-color, #b38b4d) !important;
  }

  /* --- Product cards: media zoom + title affordance --- */
  .main-collection-grid .product-card .product-media__image {
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .main-collection-grid .product-card:hover .product-media__image {
    transform: scale(1.04) !important;
  }

  .main-collection-grid .product-card .rte p[role='heading'] {
    transition: color 0.25s ease;
  }

  @media (hover: hover) {
    .main-collection-grid .product-card:hover .rte p[role='heading'] {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
      text-decoration-color: rgba(179, 139, 77, 0.55);
    }
  }

  /* --- Badges: sale & sold out --- */
  .main-collection-grid .product-badges__badge {
    font-family: 'Inter', -apple-system, sans-serif !important;
    font-size: 9.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    border-radius: 3px !important;
  }

  .main-collection-grid .product-badges__badge.color-custom-badge-sale {
    background: #c5a880 !important;
    color: #141414 !important;
    border: 1px solid rgba(179, 139, 77, 0.45);
  }

  .main-collection-grid .product-badges__badge.color-custom-badge-sold-out {
    background: rgba(17, 17, 17, 0.72) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .main-collection-grid .product-card .product-media__image {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Hero Banner",
  "tag": "section",
  "class": "section-collection-hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Hero Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 10,
      "max": 90,
      "step": 2,
      "unit": "%",
      "label": "Dark Vignette Overlay Opacity",
      "default": 58
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 280,
      "max": 650,
      "step": 10,
      "unit": "px",
      "label": "Minimum Banner Height",
      "default": 380
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "info": "Home / Collections / Collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_nav",
      "label": "Show Collection Navigation Chips",
      "info": "Quick links to other collections under the hero card.",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Cursive Pre-title",
      "default": "the"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Custom Heading (Leave blank for Collection Title)"
    },
    {
      "type": "checkbox",
      "id": "show_underline",
      "label": "Show Gold Underline",
      "default": true
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback Description if collection description is empty",
      "default": "A curated edit of museum-grade artifacts, contemporary canvas art, and timeless furniture pieces designed for a life artfully lived."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show Masterpieces Count Badge",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold Accent Color",
      "default": "#c5a880"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content Max Width",
      "default": 840
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Collection Hero Banner"
    }
  ]
}
{% endschema %}
