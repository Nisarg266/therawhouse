{%- comment -%}
  Renders a luxury Brand Story / Bio section with logo mark, subtitle, and rich narrative.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign logo_image = section.settings.logo_image
  assign logo_width = section.settings.logo_width
  assign show_monogram_svg = section.settings.show_monogram_svg
  assign title = section.settings.title
  assign story_text = section.settings.story_text
  assign alignment = section.settings.text_alignment
%}

<div
  id="BrandStory-{{ section_id }}"
  class="brand-story section-{{ section_id }}"
  style="
    --bs-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --bs-color: {{ section.settings.text_color | default: '#333333' }};
    --bs-title-color: {{ section.settings.title_color | default: '#111111' }};
    --bs-title-size: {{ section.settings.title_size }}px;
    --bs-title-spacing: {{ section.settings.title_letter_spacing }};
    --bs-title-weight: {{ section.settings.title_weight }};
    --bs-text-size: {{ section.settings.text_size }}px;
    --bs-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --bs-line-height: {{ section.settings.line_height }};
    --bs-max-width: {{ section.settings.max_width }}px;
    --bs-content-max-width: {{ section.settings.content_max_width }}px;
    --bs-padding-top: {{ section.settings.padding_top }}px;
    --bs-padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.show_bottom_border %}
      --bs-border-bottom: 1px solid {{ section.settings.bottom_border_color | default: '#eaeaea' }};
    {% else %}
      --bs-border-bottom: none;
    {% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="brand-story__container">
    <div class="brand-story__content text-{{ alignment }}">
      
      {%- comment -%} Brand Logo Mark / Monogram {%- endcomment -%}
      {% if logo_image != blank %}
        <div class="brand-story__logo-wrapper scroll-trigger-element" style="--animation-delay: 0.1s;">
          <img
            src="{{ logo_image | image_url: width: 300 }}"
            alt="{{ logo_image.alt | default: title | default: shop.name | escape }}"
            width="{{ logo_width }}"
            height="auto"
            loading="lazy"
            class="brand-story__logo-img"
            style="max-width: {{ logo_width }}px;"
          >
        </div>
      {% elsif show_monogram_svg %}
        <div class="brand-story__monogram-wrapper scroll-trigger-element" aria-hidden="true" style="--animation-delay: 0.1s;">
          {% if section.settings.custom_svg != blank %}
            {{ section.settings.custom_svg }}
          {% else %}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 54 36"
              fill="none"
              class="brand-story__monogram-svg"
              style="width: {{ logo_width }}px; height: auto;"
            >
              <rect x="1.5" y="1.5" width="51" height="33" stroke="currentColor" stroke-width="3" fill="none"/>
              <!-- Left backward E -->
              <path d="M24.5 7H14.5V29H24.5M14.5 18H22.5" stroke="currentColor" stroke-width="3" stroke-linecap="square"/>
              <!-- Right E -->
              <path d="M29.5 7H39.5V29H29.5M31.5 18H39.5" stroke="currentColor" stroke-width="3" stroke-linecap="square"/>
            </svg>
          {% endif %}
        </div>
      {% endif %}

      {%- comment -%} Brand Title / Monogram Subtext {%- endcomment -%}
      {% if title != blank %}
        <{{ section.settings.title_tag }} class="brand-story__title scroll-trigger-element" style="--animation-delay: 0.2s;">
          {{- title -}}
        </{{ section.settings.title_tag }}>
      {% endif %}

      {%- comment -%} Main Narrative / Story Text {%- endcomment -%}
      {% if story_text != blank %}
        <div class="brand-story__text-body rte scroll-trigger-element" style="--animation-delay: 0.3s;">
          {{ story_text }}
        </div>
      {% endif %}

      {%- comment -%} Optional CTA Button {%- endcomment -%}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <div class="brand-story__button-wrapper scroll-trigger-element" style="--animation-delay: 0.4s;">
          <a
            href="{{ section.settings.button_link }}"
            class="button brand-story__button {{ section.settings.button_style }}"
          >
            {{- section.settings.button_label -}}
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</div>

{% stylesheet %}
  .brand-story {
    background-color: var(--bs-bg, #ffffff);
    border-bottom: var(--bs-border-bottom, none);
    width: 100%;
    padding-block-start: var(--bs-padding-top, 60px);
    padding-block-end: var(--bs-padding-bottom, 60px);
    position: relative;
    box-sizing: border-box;
  }

  .brand-story__container {
    max-width: var(--bs-max-width, 1260px);
    margin-inline: auto;
    padding-inline: var(--padding-md, 24px);
    box-sizing: border-box;

    @media screen and (min-width: 990px) {
      padding-inline: var(--padding-xl, 48px);
    }
  }

  .brand-story__content {
    max-width: var(--bs-content-max-width, 820px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;

    &.text-left {
      align-items: flex-start;
      text-align: left;
      margin-inline: 0;
    }

    &.text-center {
      align-items: center;
      text-align: center;
      margin-inline: auto;
    }

    &.text-right {
      align-items: flex-end;
      text-align: right;
      margin-inline-start: auto;
      margin-inline-end: 0;
    }
  }

  .brand-story__logo-wrapper,
  .brand-story__monogram-wrapper {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    margin-block-end: 14px;
    color: var(--bs-title-color, #111111);
  }

  .brand-story__logo-img {
    height: auto;
    display: block;
    object-fit: contain;
  }

  .brand-story__monogram-svg {
    display: block;
    color: var(--bs-title-color, #111111);
  }

  .brand-story__title {
    margin: 0 0 24px 0;
    color: var(--bs-title-color, #111111);
    font-size: var(--bs-title-size, 16px);
    font-weight: var(--bs-title-weight, 500);
    letter-spacing: var(--bs-title-spacing, 0.32em);
    text-transform: uppercase;
    line-height: 1.3;
    font-family: inherit;
  }

  .brand-story__text-body {
    color: var(--bs-color, #333333);
    font-size: var(--bs-text-size, 14.5px);
    line-height: var(--bs-line-height, 1.8);
    font-weight: 400;
    margin: 0;

    @media screen and (max-width: 749px) {
      font-size: var(--bs-text-size-mobile, 13.5px);
      line-height: 1.7;
    }

    p {
      margin: 0 0 1em 0;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  .brand-story__button-wrapper {
    margin-block-start: 28px;
  }

  .brand-story__button {
    display: inline-block;
    padding: 12px 28px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    transition: all 0.25s ease;
  }

  /* Scroll Reveal Animation Classes */
  .brand-story .scroll-trigger-element {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--animation-delay, 0s);
    will-change: opacity, transform;
  }

  .brand-story .scroll-trigger-element.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Story / Bio",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Brand Logo & Monogram"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Custom Brand Logo Image"
    },
    {
      "type": "checkbox",
      "id": "show_monogram_svg",
      "label": "Show Monogram Icon (If no image uploaded)",
      "default": true
    },
    {
      "type": "html",
      "id": "custom_svg",
      "label": "Custom SVG Icon Code (Optional)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo / Monogram Width",
      "min": 30,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "header",
      "content": "Brand Subtitle / Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Brand Title",
      "default": "EICHHOLTZ"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Title HTML Tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "div", "label": "div" }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "title_letter_spacing",
      "label": "Title Letter Spacing",
      "options": [
        { "value": "0.1em", "label": "Subtle (0.1em)" },
        { "value": "0.2em", "label": "Medium (0.2em)" },
        { "value": "0.32em", "label": "Luxury Wide (0.32em)" },
        { "value": "0.45em", "label": "Ultra Wide (0.45em)" }
      ],
      "default": "0.32em"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Font Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title & Monogram Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Story Narrative Text"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Brand Story / Description",
      "default": "<p>Over the years, Eichholtz has grown into one of the world's most well-known and reputable brands of luxury design furniture, lighting and accessories. With a portfolio that spans nearly 4000 designs, launching up to 600 new products as part of two full collections each year, the brand offers a subtly modern take on classic typologies that ensures each product is unique and aspirational. The extraordinary breadth of their collections with a rich palette of materials and finishes works perfectly in a multitude of residential and commercial settings across the globe.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Desktop Text Size",
      "min": 12,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 14.5
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Mobile Text Size",
      "min": 11,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 13.5
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Text Line Height",
      "options": [
        { "value": "1.5", "label": "Compact (1.5)" },
        { "value": "1.7", "label": "Standard (1.7)" },
        { "value": "1.82", "label": "Luxury Relaxed (1.82)" },
        { "value": "2.0", "label": "Open (2.0)" }
      ],
      "default": "1.82"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Optional Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "button--primary", "label": "Primary" },
        { "value": "button--secondary", "label": "Secondary" },
        { "value": "button--outline", "label": "Outline" }
      ],
      "default": "button--primary"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Paragraph Max Width",
      "min": 500,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "default": 820
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section Max Width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1260
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show Bottom Border Line",
      "default": false
    },
    {
      "type": "color",
      "id": "bottom_border_color",
      "label": "Bottom Border Color",
      "default": "#eaeaea"
    }
  ],
  "presets": [
    {
      "name": "Brand Story / Bio",
      "settings": {
        "title": "EICHHOLTZ",
        "show_monogram_svg": true,
        "logo_width": 54,
        "text_alignment": "center",
        "content_max_width": 820,
        "padding_top": 56,
        "padding_bottom": 64
      }
    }
  ]
}
{% endschema %}
