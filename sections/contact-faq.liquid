{%- comment -%}
  Renders the Curatorial & Collector FAQ Accordion with dynamic repeatable FAQ item blocks.
  Allows adding, removing, and reordering questions with granular typography, divider, and spacing controls.
{%- endcomment -%}

<div
  id="ContactFaq-{{ section.id }}"
  class="contact-faq-section"
  style="
    --cfaq-bg: {{ section.settings.background_color | default: '#faf9f6' }};
    --cfaq-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --cfaq-q-color: {{ section.settings.question_color | default: '#111111' }};
    --cfaq-a-color: {{ section.settings.answer_color | default: '#555046' }};
    --cfaq-divider: {{ section.settings.divider_color | default: '#ede8e0' }};
    --cfaq-accent: {{ section.settings.accent_color | default: '#c5a059' }};
    --cfaq-heading-size: {{ section.settings.heading_size | default: 32 }}px;
    --cfaq-heading-size-m: {{ section.settings.heading_size_m | default: 24 }}px;
    --cfaq-q-size: {{ section.settings.question_size | default: 16 }}px;
    --cfaq-a-size: {{ section.settings.answer_size | default: 14.5 }}px;
    --cfaq-pt: {{ section.settings.padding_top | default: 20 }}px;
    --cfaq-pb: {{ section.settings.padding_bottom | default: 72 }}px;
    --cfaq-pt-m: {{ section.settings.padding_top_m | default: 16 }}px;
    --cfaq-pb-m: {{ section.settings.padding_bottom_m | default: 48 }}px;
    --cfaq-max-w: {{ section.settings.max_width | default: 860 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="contact-faq__container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="contact-faq__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="contact-faq__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="contact-faq__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="contact-faq__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="contact-faq__list">
      {%- for block in section.blocks -%}
        <details
          class="contact-faq__item contact-faq__item--{{ block.id }}"
          {% if block.settings.open_by_default %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="contact-faq__summary">
            <span class="contact-faq__question">{{ block.settings.question }}</span>
            <span class="contact-faq__icon" aria-hidden="true">
              <svg class="contact-faq__icon-plus" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <svg class="contact-faq__icon-minus" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="contact-faq__answer">
            <div class="contact-faq__answer-content">
              {{ block.settings.answer }}
            </div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .contact-faq-section {
    width: 100%;
    background-color: var(--cfaq-bg);
    padding-top: var(--cfaq-pt);
    padding-bottom: var(--cfaq-pb);
    box-sizing: border-box;
  }

  .contact-faq__container {
    max-width: var(--cfaq-max-w);
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 40px);
    padding-right: clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .contact-faq__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .contact-faq__eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8c8273;
    margin-bottom: 8px;
  }

  .contact-faq__heading {
    font-size: var(--cfaq-heading-size);
    font-weight: 400;
    color: var(--cfaq-heading-color);
    margin: 0 0 8px 0;
    font-family: var(--font-heading--family, serif);
  }

  .contact-faq__subheading {
    font-size: 14.5px;
    color: var(--cfaq-a-color);
    margin: 0;
    line-height: 1.6;
  }

  .contact-faq__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--cfaq-divider);
  }

  .contact-faq__item {
    border-bottom: 1px solid var(--cfaq-divider);
    transition: background-color 0.2s ease;
  }

  .contact-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.2s ease;
  }

  .contact-faq__summary::-webkit-details-marker {
    display: none;
  }

  .contact-faq__question {
    font-size: var(--cfaq-q-size);
    font-weight: 500;
    color: var(--cfaq-q-color);
    padding-right: 16px;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .contact-faq__summary:hover .contact-faq__question {
    color: var(--cfaq-accent);
  }

  .contact-faq__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--cfaq-accent);
    border-radius: 50%;
    background: #f7f5f0;
    transition: transform 0.25s ease, background-color 0.2s ease;
  }

  .contact-faq__summary:hover .contact-faq__icon {
    background: #ede8df;
  }

  .contact-faq__icon-minus {
    display: none;
  }

  .contact-faq__item[open] .contact-faq__icon-plus {
    display: none;
  }

  .contact-faq__item[open] .contact-faq__icon-minus {
    display: block;
  }

  .contact-faq__answer {
    padding-bottom: 24px;
  }

  .contact-faq__answer-content {
    font-size: var(--cfaq-a-size);
    line-height: 1.7;
    color: var(--cfaq-a-color);
  }

  .contact-faq__answer-content p {
    margin: 0 0 12px 0;
  }

  .contact-faq__answer-content p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .contact-faq-section {
      padding-top: var(--cfaq-pt-m);
      padding-bottom: var(--cfaq-pb-m);
    }
    .contact-faq__heading {
      font-size: var(--cfaq-heading-size-m);
    }
    .contact-faq__summary {
      padding: 16px 0;
    }
    .contact-faq__question {
      font-size: calc(var(--cfaq-q-size) - 1.5px);
    }
  }
</style>

{% schema %}
{
  "name": "Curatorial FAQ Accordion",
  "tag": "section",
  "class": "section-contact-faq",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Section eyebrow",
      "default": "CURATORIAL INSIGHTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Frequently Asked Inquiries"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Answers to our collectors' most frequent questions regarding acquisitions, white-glove transit, and bespoke commissions."
    },
    {
      "type": "header",
      "content": "Color Palette"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#faf9f6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer text color",
      "default": "#555046"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider line color",
      "default": "#ede8e0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accordion icon & accent color",
      "default": "#c5a059"
    },
    {
      "type": "header",
      "content": "Typography & Spacing"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "min": 18,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading font size (Mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "question_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Question font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "answer_size",
      "min": 12,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "label": "Answer font size",
      "default": 14.5
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "label": "Container maximum width",
      "default": 860
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does the private acquisition & viewing process work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Every acquisition begins with a personal conversation. You can contact our curation desk via WhatsApp, telephone, or our private inquiry form. We provide bespoke valuations, high-resolution condition reports, and private viewing appointments.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open accordion by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curatorial FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How does the private acquisition & viewing process work?",
            "answer": "<p>Every acquisition begins with a personal conversation. You can contact our curation desk via WhatsApp, telephone, or our private inquiry form. We provide bespoke valuations, high-resolution condition reports, and private viewing appointments.</p>",
            "open_by_default": true
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I commission custom dimensions or artisanal finishes?",
            "answer": "<p>Yes. Many of our architectural and sculptural pieces can be customized in collaboration with our master artisans. We accommodate custom dimensions, seasoned natural woods, marble selections, and bespoke metal finishes.</p>",
            "open_by_default": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is included with insured White Glove transit?",
            "answer": "<p>Our white-glove transit service includes custom protective crating, comprehensive door-to-door transit insurance, scheduled appointment delivery, and inside room-of-choice placement across India and international destinations.</p>",
            "open_by_default": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
