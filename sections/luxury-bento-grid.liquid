{%- comment -%}
  THE RAW HOUSE - ADVANCED ASYMMETRICAL BENTO GRID SHOWCASE
  Modern Bento Box layout for new arrivals & collections with dynamic card blocks, advanced color schemes, and spacing controls.
{%- endcomment -%}

{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'light'
  case scheme
    when 'warm'
      assign bg_color = '#f9f8f5'
      assign text_color = '#111111'
      assign heading_color = '#111111'
      assign badge_bg = '#c5a880'
      assign badge_color = '#111111'
    when 'dark'
      assign bg_color = '#141414'
      assign text_color = '#ffffff'
      assign heading_color = '#ffffff'
      assign badge_bg = 'rgba(255, 255, 255, 0.15)'
      assign badge_color = '#ffffff'
    when 'obsidian'
      assign bg_color = '#0b0b0b'
      assign text_color = '#ffffff'
      assign heading_color = '#ffffff'
      assign badge_bg = '#c5a880'
      assign badge_color = '#000000'
    else
      assign bg_color = '#ffffff'
      assign text_color = '#111111'
      assign heading_color = '#111111'
      assign badge_bg = '#111111'
      assign badge_color = '#ffffff'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_heading_color != blank and section.settings.custom_heading_color != 'rgba(0,0,0,0)'
    assign heading_color = section.settings.custom_heading_color
  endif
%}

<div
  id="LuxuryBento-{{ section.id }}"
  class="lux-bento-section lux-bento-scheme-{{ scheme }}"
  style="
    --bento-bg: {{ bg_color }};
    --bento-heading-color: {{ heading_color }};
    --bento-badge-bg: {{ badge_bg }};
    --bento-badge-color: {{ badge_color }};
    --bento-pt: {{ section.settings.padding_top | default: 28 }}px;
    --bento-pb: {{ section.settings.padding_bottom | default: 46 }}px;
    background: var(--bento-bg);
    padding-top: var(--bento-pt);
    padding-bottom: var(--bento-pb);
  "
  {{ section.shopify_attributes }}
>
  <div class="lux-bento-container">
    {% if section.settings.heading != blank %}
      <div class="lux-section-heading-wrap lux-reveal-fade-up">
        {% if section.settings.subheading != blank %}
          <span class="lux-section-subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 class="lux-section-heading" style="color: var(--bento-heading-color);">{{ section.settings.heading }}</h2>
        <div class="lux-section-divider"></div>
      </div>
    {% endif %}

    <div class="lux-bento-grid lux-stagger-parent lux-reveal-fade-up">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="lux-bento-card lux-bento-card--{{ block.settings.card_size }} lux-stagger-child"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag:
                class: 'lux-bento-img',
                loading: 'eager',
                alt: block.settings.title
            }}
          {% elsif block.settings.default_asset != blank %}
            <img
              src="{{ block.settings.default_asset | asset_url }}"
              alt="{{ block.settings.title | escape }}"
              class="lux-bento-img"
              loading="eager"
              onerror="this.onerror=null;this.src='{{ 'maker-gallery-2.jpg' | asset_url }}';"
              width="800"
              height="600"
            >
          {% else %}
            <img
              src="{{ 'maker-gallery-2.jpg' | asset_url }}"
              alt="{{ block.settings.title | escape }}"
              class="lux-bento-img"
              loading="eager"
              width="800"
              height="600"
            >
          {% endif %}

          <div class="lux-bento-overlay">
            {% if block.settings.badge != blank %}
              <span class="lux-bento-badge" style="background: var(--bento-badge-bg); color: var(--bento-badge-color);">{{ block.settings.badge }}</span>
            {% endif %}

            <h3 class="lux-bento-title">{{ block.settings.title }}</h3>
            {% if block.settings.subtitle != blank %}
              <p class="lux-bento-subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}

            <span class="lux-bento-cta">
              {{ block.settings.cta_text | default: 'EXPLORE EDIT' }}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Bento Grid",
  "tag": "section",
  "class": "section-luxury-bento",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme & Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color Scheme Preset",
      "options": [
        { "value": "light", "label": "Light Clean (#ffffff)" },
        { "value": "warm", "label": "Warm Atelier Ivory (#f9f8f5)" },
        { "value": "dark", "label": "Contemporary Dark (#141414)" },
        { "value": "obsidian", "label": "Obsidian Gold (#0b0b0b)" }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_heading_color",
      "label": "Custom Heading Color"
    },
    {
      "type": "header",
      "content": "Heading & Subheading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "THE COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS & EDITS"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 46
    }
  ],
  "blocks": [
    {
      "type": "bento_card",
      "name": "Bento Grid Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Artwork Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Default Asset Fallback"
        },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card Layout Size",
          "options": [
            { "value": "large", "label": "Large (Double Width & Height)" },
            { "value": "medium", "label": "Medium (Double Height / Portrait)" },
            { "value": "wide", "label": "Wide (Double Width / Landscape)" },
            { "value": "small", "label": "Standard (Square)" }
          ],
          "default": "medium"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Tag",
          "default": "NEW RELEASE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Monolithic Oil Compositions"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card Subtitle",
          "default": "Mineral pigment glazes on Belgian linen"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button / CTA Text",
          "default": "EXPLORE EDIT"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Bento Grid",
      "blocks": [
        {
          "type": "bento_card",
          "settings": {
            "card_size": "large",
            "badge": "MUSEUM MASTERPIECE",
            "title": "Starry Night Over The Rhône",
            "subtitle": "Large-format oil impasto with textured mineral blues",
            "default_asset": "art-painting-starry-night.jpg"
          }
        },
        {
          "type": "bento_card",
          "settings": {
            "card_size": "medium",
            "badge": "FOUNDRY CAST",
            "title": "Lost-Wax Bronze Figures",
            "subtitle": "Hand-chiseled sculptural patina",
            "default_asset": "art-sculpture-bronze-figure.jpg"
          }
        },
        {
          "type": "bento_card",
          "settings": {
            "card_size": "small",
            "badge": "LIMITED EDITION",
            "title": "Architectural 3D Models",
            "subtitle": "Solid cast resins & marble",
            "default_asset": "art-sculpture-marble-bust.jpg"
          }
        },
        {
          "type": "bento_card",
          "settings": {
            "card_size": "wide",
            "badge": "ARCHIVAL COMMISSIONS",
            "title": "Bespoke Grand Canvases",
            "subtitle": "Tailored scales for private residences",
            "default_asset": "art-painting-gold-canvas.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
