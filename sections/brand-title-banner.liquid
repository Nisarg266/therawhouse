      "default": false
    },
    {
      "type": "color",
      "id": "bottom_border_color",
      "label": "Bottom Border Color",
      "default": "#eaeaea"
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb_item",
      "name": "Custom Breadcrumb Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand / Title Banner",
      "settings": {
        "show_breadcrumbs": true,
        "home_label": "Home",
        "parent_label": "Makers",
        "heading": "EICHHOLTZ",
        "heading_alignment": "center",
        "heading_size": 28,
        "heading_letter_spacing": "0.26em",
        "heading_font_weight": "600",
        "padding_top": 14,
