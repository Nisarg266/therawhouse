{%- comment -%}
  Renders a luxury breadcrumb and title banner section matching Image 2 reference.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign show_breadcrumbs = section.settings.show_breadcrumbs
  assign home_label = section.settings.home_label | default: 'Home'
  assign parent_label = section.settings.parent_label
  assign parent_url = section.settings.parent_url
  assign title_text = section.settings.heading
  if title_text == blank
    if template.name == 'collection'
      assign title_text = collection.title
    elsif template.name == 'page'
      assign title_text = page.title
    elsif template.name == 'product'
      assign title_text = product.title
    else
      assign title_text = 'EICHHOLTZ'
    endif
  endif
  assign current_label = section.settings.current_label | default: title_text
  assign separator = section.settings.breadcrumb_separator | default: '>'
%}

<div
  id="BrandTitleBanner-{{ section_id }}"
  class="brand-title-banner section-{{ section_id }}"
  style="
    --btb-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --btb-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --btb-heading-size: {{ section.settings.heading_size }}px;
    --btb-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --btb-heading-spacing: {{ section.settings.heading_letter_spacing }};
    --btb-heading-weight: {{ section.settings.heading_font_weight }};
    --btb-heading-case: {{ section.settings.heading_case }};
    --btb-breadcrumb-size: {{ section.settings.breadcrumb_font_size }}px;
    --btb-breadcrumb-color: {{ section.settings.breadcrumb_color | default: '#666666' }};
    --btb-breadcrumb-active-color: {{ section.settings.breadcrumb_active_color | default: '#111111' }};
    --btb-max-width: {{ section.settings.max_width }}px;
    --btb-padding-top: {{ section.settings.padding_top }}px;
    --btb-padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.show_bottom_border %}
      --btb-border-bottom: 1px solid {{ section.settings.bottom_border_color | default: '#eaeaea' }};
    {% else %}
      --btb-border-bottom: none;
    {% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="brand-title-banner__container">
    {% if show_breadcrumbs %}
      <nav
        class="brand-title-banner__breadcrumbs"
        aria-label="Breadcrumbs"
      >
        <ol class="brand-title-banner__breadcrumb-list list-unstyled" role="list">
          <li class="brand-title-banner__breadcrumb-item">
            <a href="{{ routes.root_url }}" class="brand-title-banner__breadcrumb-link">
              {{- home_label -}}
            </a>
          </li>

          {% if parent_label != blank %}
            <li class="brand-title-banner__breadcrumb-separator" aria-hidden="true">
              {{- separator -}}
            </li>
            <li class="brand-title-banner__breadcrumb-item">
              {% if parent_url != blank %}
                <a href="{{ parent_url }}" class="brand-title-banner__breadcrumb-link">
                  {{- parent_label -}}
                </a>
              {% else %}
                <span class="brand-title-banner__breadcrumb-link">
                  {{- parent_label -}}
                </span>
              {% endif %}
            </li>
          {% endif %}

          {% for block in section.blocks %}
            {% if block.type == 'breadcrumb_item' and block.settings.label != blank %}
              <li class="brand-title-banner__breadcrumb-separator" aria-hidden="true">
                {{- separator -}}
              </li>
              <li class="brand-title-banner__breadcrumb-item" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="brand-title-banner__breadcrumb-link">
                    {{- block.settings.label -}}
                  </a>
                {% else %}
                  <span class="brand-title-banner__breadcrumb-link">
                    {{- block.settings.label -}}
                  </span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}

          <li class="brand-title-banner__breadcrumb-separator" aria-hidden="true">
            {{- separator -}}
          </li>
          <li class="brand-title-banner__breadcrumb-item brand-title-banner__breadcrumb-item--current" aria-current="page">
            <span>{{- current_label -}}</span>
          </li>
        </ol>
      </nav>
    {% endif %}

    <div class="brand-title-banner__heading-wrapper text-{{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="brand-title-banner__heading">
        {{- title_text -}}
      </{{ section.settings.heading_tag }}>

      {% if section.settings.subheading != blank %}
        <div
          class="brand-title-banner__subheading rte"
          style="
            --btb-subheading-size: {{ section.settings.subheading_font_size }}px;
            --btb-subheading-color: {{ section.settings.subheading_color | default: '#555555' }};
            --btb-subheading-max-width: {{ section.settings.subheading_max_width }}px;
          "
        >
          {{ section.settings.subheading }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .brand-title-banner {
    background-color: var(--btb-bg, #ffffff);
    border-bottom: var(--btb-border-bottom, none);
    width: 100%;
    padding-block-start: var(--btb-padding-top, 14px);
    padding-block-end: var(--btb-padding-bottom, 16px);
    position: relative;
    box-sizing: border-box;
  }

  .brand-title-banner__container {
    max-width: var(--btb-max-width, 1260px);
    margin-inline: auto;
    padding-inline: var(--padding-md, 24px);
    box-sizing: border-box;

    @media screen and (min-width: 990px) {
      padding-inline: var(--padding-xl, 48px);
    }
  }

  .brand-title-banner__breadcrumbs {
    margin-block-end: 8px;
    font-size: var(--btb-breadcrumb-size, 12px);
    color: var(--btb-breadcrumb-color, #666666);
    line-height: 1.4;
  }

  .brand-title-banner__breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-title-banner__breadcrumb-item {
    display: inline-flex;
    align-items: center;
  }

  .brand-title-banner__breadcrumb-link {
    color: var(--btb-breadcrumb-color, #666666);
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: var(--btb-breadcrumb-active-color, #111111);
      text-decoration: underline;
    }
  }

  .brand-title-banner__breadcrumb-separator {
    color: var(--btb-breadcrumb-color, #888888);
    user-select: none;
    font-size: calc(var(--btb-breadcrumb-size, 12px) - 1px);
    opacity: 0.8;
  }

  .brand-title-banner__breadcrumb-item--current {
    color: var(--btb-breadcrumb-active-color, #111111);
    font-weight: 500;
  }

  .brand-title-banner__heading-wrapper {
    width: 100%;
    margin-block-start: 4px;

    &.text-center {
      text-align: center;
    }
    &.text-left {
      text-align: left;
    }
    &.text-right {
      text-align: right;
    }
  }

  .brand-title-banner__heading {
    margin: 0;
    color: var(--btb-heading-color, #111111);
    font-size: var(--btb-heading-size, 28px);
    font-weight: var(--btb-heading-weight, 600);
    letter-spacing: var(--btb-heading-spacing, 0.26em);
    text-transform: var(--btb-heading-case, uppercase);
    line-height: 1.25;
    font-family: inherit;

    @media screen and (max-width: 749px) {
      font-size: var(--btb-heading-size-mobile, 20px);
      letter-spacing: calc(var(--btb-heading-spacing, 0.26em) * 0.8);
    }
  }

  .brand-title-banner__subheading {
    margin-block-start: 12px;
    margin-inline: auto;
    font-size: var(--btb-subheading-size, 14px);
    color: var(--btb-subheading-color, #555555);
    max-width: var(--btb-subheading-max-width, 700px);
    line-height: 1.6;

    .text-left & {
      margin-inline: 0;
    }
    .text-right & {
      margin-inline-start: auto;
      margin-inline-end: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand / Title Banner",
  "tag": "section",
  "class": "section-brand-title-banner",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs Settings"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home Label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "parent_label",
      "label": "Parent Category / Label",
      "default": "Makers",
      "info": "e.g. Makers, Collections, Brands"
    },
    {
      "type": "url",
      "id": "parent_url",
      "label": "Parent Link URL"
    },
    {
      "type": "text",
      "id": "current_label",
      "label": "Current Page Label (Optional)",
      "info": "Leave blank to use Heading / Page Title"
    },
    {
      "type": "select",
      "id": "breadcrumb_separator",
      "label": "Separator Style",
      "options": [
        {
          "value": ">",
          "label": "> (Chevron)"
        },
        {
          "value": "/",
          "label": "/ (Slash)"
        },
        {
          "value": "·",
          "label": "· (Dot)"
        },
        {
          "value": "—",
          "label": "— (Dash)"
        }
      ],
      "default": ">"
    },
    {
      "type": "range",
      "id": "breadcrumb_font_size",
      "label": "Breadcrumb Font Size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "breadcrumb_color",
      "label": "Breadcrumb Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "breadcrumb_active_color",
      "label": "Current Item Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Title & Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "EICHHOLTZ",
      "info": "Leave blank to use Page / Collection Title"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag (SEO)",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "div",
          "label": "div"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop Heading Size",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile Heading Size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "heading_letter_spacing",
      "label": "Letter Spacing (Tracking)",
      "options": [
        {
          "value": "0em",
          "label": "Normal (0)"
        },
        {
          "value": "0.1em",
          "label": "Subtle (0.1em)"
        },
        {
          "value": "0.18em",
          "label": "Medium (0.18em)"
        },
        {
          "value": "0.26em",
          "label": "Luxury Wide (0.26em)"
        },
        {
          "value": "0.36em",
          "label": "Ultra Wide (0.36em)"
        }
      ],
      "default": "0.26em"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Regular (400)"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semi-Bold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Text Case",
      "options": [
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "none",
          "label": "Normal (as typed)"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
