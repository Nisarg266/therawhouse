{%- comment -%}
  THE RAW HOUSE — ICON FEATURE CARDS / TRUST ASSURANCES (LUXP design system)
  Fully customizable icon cards: per-card icon (built-in or uploaded image),
  optional card image with separate mobile source, badge, link, per-card
  style overrides and visibility. Ships completely static.

  @module luxury-assurance-icons
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign ratio_css = '1 / 1'
  if s.image_ratio == '4/5'
    assign ratio_css = '4 / 5'
  elsif s.image_ratio == '3/4'
    assign ratio_css = '3 / 4'
  elsif s.image_ratio == '4/3'
    assign ratio_css = '4 / 3'
  elsif s.image_ratio == '16/10'
    assign ratio_css = '16 / 10'
  endif
  assign ratio_m_css = ratio_css
  if s.image_ratio_m == '4/5'
    assign ratio_m_css = '4 / 5'
  elsif s.image_ratio_m == '3/4'
    assign ratio_m_css = '3 / 4'
  elsif s.image_ratio_m == '4/3'
    assign ratio_m_css = '4 / 3'
  elsif s.image_ratio_m == '16/10'
    assign ratio_m_css = '16 / 10'
  endif

  assign shadow_css = 'none'
  if s.card_shadow == 'subtle'
    assign shadow_css = '0 2px 12px rgba(0, 0, 0, 0.06)'
  elsif s.card_shadow == 'medium'
    assign shadow_css = '0 8px 28px rgba(0, 0, 0, 0.12)'
  endif

  assign card_bg = s.card_bg
  if card_bg == blank or card_bg == 'rgba(0,0,0,0)'
    assign card_bg = 'transparent'
  endif
  assign card_border = s.card_border_color
  if card_border == blank or card_border == 'rgba(0,0,0,0)'
    assign card_border = 'var(--luxp-border)'
  endif
  assign icon_color = s.icon_color
  if icon_color == blank or icon_color == 'rgba(0,0,0,0)'
    assign icon_color = 'var(--luxp-accent)'
  endif
  assign icon_bg = s.icon_bg
  if icon_bg == blank
    assign icon_bg = 'transparent'
  endif
  assign fcard_title_color = s.fcard_title_color
  if fcard_title_color == blank or fcard_title_color == 'rgba(0,0,0,0)'
    assign fcard_title_color = 'var(--luxp-fg)'
  endif
  assign fcard_text_color = s.fcard_text_color
  if fcard_text_color == blank or fcard_text_color == 'rgba(0,0,0,0)'
    assign fcard_text_color = 'var(--luxp-muted)'
  endif

  assign icon_radius = '999px'
  if s.icon_shape == 'square'
    assign icon_radius = '4px'
  endif

  assign header_track = 'center'
  if s.header_align == 'left'
    assign header_track = 'flex-start'
  endif
-%}

{%- capture luxp_colors -%}
  {%- render 'luxp-scheme',
    preset: s.color_preset,
    bg: s.color_bg,
    heading: s.color_heading,
    text: s.color_text,
    accent: s.color_accent,
    muted: s.color_muted,
    border: s.color_border
  -%}
{%- endcapture -%}

{%- capture luxp_typo -%}{%- render 'luxp-typo', s: s -%}{%- endcapture -%}

<div
  class="luxp-section luxp-assurance {% if s.container_mode == 'full' %}luxp-section--full{% endif %} {% if s.enable_animations %}luxp-anim{% endif %} {% if s.enable_animations and s.card_hover == 'lift' %}luxp-hover-lift{% endif %} {% if s.enable_animations and s.card_hover == 'border' %}luxp-hover-border{% endif %} {{ s.custom_class }}"
  style="
    {{ luxp_colors }}
    {{ luxp_typo }}
    --luxp-pt: {{ s.padding_top | default: 32 }}px;
    --luxp-pb: {{ s.padding_bottom | default: 32 }}px;
    --luxp-pt-m: {{ s.padding_top_m | default: 28 }}px;
    --luxp-pb-m: {{ s.padding_bottom_m | default: 28 }}px;
    --luxp-cw: {{ s.container_max | default: 1240 }}px;
    --luxp-px: {{ s.container_padding | default: 32 }}px;
    --luxp-px-m: {{ s.container_padding_m | default: 18 }}px;
    --luxp-header-track: {{ header_track }};
    --luxp-header-align: {{ s.header_align | default: 'center' }};
    --luxp-header-gap: {{ s.header_gap | default: 10 }}px;
    --luxp-header-mb: {{ s.header_mb | default: 28 }}px;
    --luxp-cols: {{ s.columns | default: 4 }};
    --luxp-cols-t: {{ s.columns_tablet | default: 2 }};
    --luxp-cols-m: {{ s.columns_mobile | default: 2 }};
    --luxp-cgap: {{ s.col_gap | default: 20 }}px;
    --luxp-rgap: {{ s.row_gap | default: 20 }}px;
    --luxp-cgap-m: {{ s.col_gap_m | default: 12 }}px;
    --luxp-rgap-m: {{ s.row_gap_m | default: 12 }}px;
    --luxp-fcard-bg: {{ card_bg }};
    --luxp-fcard-border: {{ card_border }};
    --luxp-fcard-bw: {{ s.card_border_width | default: 0 }}px;
    --luxp-fcard-radius: {{ s.card_radius | default: 4 }}px;
    --luxp-fcard-shadow: {{ shadow_css }};
    --luxp-fcard-py: {{ s.card_padding_y | default: 22 }}px;
    --luxp-fcard-px: {{ s.card_padding_x | default: 18 }}px;
    --luxp-feature-gap: {{ s.card_gap | default: 12 }}px;
    --luxp-fcard-title-size: {{ s.cardtitle_size | default: 12 }}px;
    --luxp-fcard-title-color: {{ fcard_title_color }};
    --luxp-fcard-text-size: {{ s.cardtext_size | default: 12.5 }}px;
    --luxp-fcard-text-color: {{ fcard_text_color }};
    --luxp-icon-size: {{ s.icon_size | default: 24 }}px;
    --luxp-icon-pad: {{ s.icon_padding | default: 11 }}px;
    --luxp-icon-bg: {{ icon_bg }};
    --luxp-icon-fg: {{ icon_color }};
    --luxp-icon-radius: {{ icon_radius }};
    --luxp-icon-bw: {{ s.icon_border_width | default: 0 }}px;
    --luxp-icon-border: var(--luxp-border);
    --luxp-media-ratio: {{ ratio_css }};
    --luxp-media-ratio-m: {{ ratio_m_css }};
    --luxp-media-fit: cover;
    --luxp-media-radius: 0px;
    --luxp-pill-bg: var(--luxp-accent);
    --luxp-pill-fg: #ffffff;
  "
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  data-art-motion="off"
  {{ section.shopify_attributes }}
>
  <div class="luxp-container">
    {% if s.eyebrow != blank or s.heading != blank or s.intro != blank %}
      <header class="luxp-header luxp-header--{{ s.header_align | default: 'center' }}">
        {% if s.eyebrow != blank %}
          <p class="luxp-eyebrow">{{ s.eyebrow }}</p>
        {% endif %}
        {% if s.heading != blank %}
          <h2 class="luxp-heading">{{ s.heading }}</h2>
        {% endif %}
        {% if s.intro != blank %}
          <div class="luxp-body luxp-header__intro">{{ s.intro }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="luxp-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign b_align = block.settings.align
          if b_align == blank or b_align == 'inherit'
            assign b_align = s.card_align | default: 'center'
          endif

          assign b_bg = block.settings.card_bg
          if b_bg == blank or b_bg == 'rgba(0,0,0,0)'
            assign b_bg = 'inherit'
          endif
          assign b_border = block.settings.card_border_color
          if b_border == blank or b_border == 'rgba(0,0,0,0)'
            assign b_border = 'inherit'
          endif
          assign b_radius = block.settings.card_radius
          if b_radius == blank
            assign b_radius = 'inherit'
          endif
          assign b_bw = block.settings.card_border_width
          if b_bw == blank
            assign b_bw = 'inherit'
          endif

          assign icon_pos = block.settings.icon_position
          if icon_pos == blank or icon_pos == 'inherit'
            assign icon_pos = s.icon_position | default: 'top'
          endif

          assign card_tag = 'div'
          if block.settings.link != blank
            assign card_tag = 'a'
          endif
        -%}
        <div
          class="luxp-assurance__cell {% unless block.settings.show_desktop %}luxp-hide-desktop{% endunless %} {% unless block.settings.show_mobile %}luxp-hide-mobile{% endunless %}"
          {{ block.shopify_attributes }}
        >
          <{{ card_tag }}
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
            class="luxp-feature {% if icon_pos == 'left' %}luxp-feature--left{% endif %}"
            style="--luxp-fcard-bg: {{ b_bg }}; --luxp-fcard-border: {{ b_border }}; --luxp-fcard-bw: {{ b_bw }}px; --luxp-fcard-radius: {{ b_radius }}px; --luxp-feature-align: {{ b_align }}; --luxp-feature-track: {% if b_align == 'center' %}center{% else %}flex-start{% endif %};"
          >
            {% if block.settings.image != blank or block.settings.default_asset != blank %}
              <div class="luxp-media luxp-assurance__imgwrap">
                {% if block.settings.badge != blank %}
                  <span class="luxp-colcard__pill luxp-pill">{{ block.settings.badge }}</span>
                {% endif %}
                {% render 'luxp-image',
                  image: block.settings.image,
                  image_mobile: block.settings.image_mobile,
                  alt: block.settings.title,
                  class: 'luxp-assurance__img',
                  loading: 'lazy',
                  sizes: '(min-width: 1024px) 25vw, 50vw',
                  fallback: block.settings.default_asset
                %}
              </div>
            {% endif %}

            <div class="luxp-feature__content">
              {% if block.settings.icon_image != blank %}
                <span class="luxp-icon {% if s.icon_shape != 'none' %}luxp-icon--chip{% endif %}">
                  {{
                    block.settings.icon_image
                    | image_url: width: 96
                    | image_tag:
                      alt: block.settings.title,
                      loading: 'lazy',
                      decoding: 'async',
                      widths: '48, 96'
                  }}
                </span>
              {% elsif block.settings.icon != 'none' %}
                <span class="luxp-icon {% if s.icon_shape != 'none' %}luxp-icon--chip{% endif %}">
                  {% render 'luxp-icon', icon: block.settings.icon %}
                </span>
              {% endif %}

              {% if block.settings.badge != blank and block.settings.image == blank and block.settings.default_asset == blank %}
                <span class="luxp-pill">{{ block.settings.badge }}</span>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="luxp-feature__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="luxp-feature__text">{{ block.settings.text }}</p>
              {% endif %}
              {% if block.settings.cta_label != blank %}
                <span class="luxp-card__cta">
                  <span>{{ block.settings.cta_label }}</span>
                  {% render 'luxp-icon', icon: 'arrow', class: 'luxp-btn__arrow' %}
                </span>
              {% endif %}
            </div>
          </{{ card_tag }}>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon Feature Cards",
  "tag": "section",
  "class": "section-luxury-assurance",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / subheading", "default": "THE ATELIER PROMISE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Acquire with Complete Confidence" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "select", "id": "header_align", "label": "Header alignment", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" }
    ], "default": "center" },
    { "type": "range", "id": "header_mb", "min": 8, "max": 64, "step": 2, "unit": "px", "label": "Space below header — desktop", "default": 28 },
    { "type": "range", "id": "header_gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Header element spacing", "default": 10 },

    { "type": "header", "content": "Layout — Grid" },
    { "type": "select", "id": "container_mode", "label": "Container mode", "options": [
      { "value": "fixed", "label": "Container (max width)" },
      { "value": "full", "label": "Full width" }
    ], "default": "fixed" },
    { "type": "range", "id": "container_max", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Container max width", "default": 1240 },
    { "type": "range", "id": "columns", "min": 1, "max": 5, "step": 1, "label": "Columns — desktop", "default": 4 },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 4, "step": 1, "label": "Columns — tablet", "default": 2 },
    { "type": "select", "id": "columns_mobile", "label": "Columns — mobile", "options": [ { "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" } ], "default": "2" },
    { "type": "range", "id": "col_gap", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Column gap — desktop", "default": 20 },
    { "type": "range", "id": "row_gap", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Row gap — desktop", "default": 20 },
    { "type": "range", "id": "col_gap_m", "min": 4, "max": 32, "step": 2, "unit": "px", "label": "Column gap — mobile", "default": 12 },
    { "type": "range", "id": "row_gap_m", "min": 4, "max": 32, "step": 2, "unit": "px", "label": "Row gap — mobile", "default": 12 },

    { "type": "header", "content": "Cards" },
    { "type": "color", "id": "card_bg", "label": "Card background", "info": "Blank = transparent." },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "info": "Blank uses the scheme border." },
    { "type": "range", "id": "card_border_width", "min": 0, "max": 3, "step": 1, "unit": "px", "label": "Card border width", "default": 1 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "Card corner radius", "default": 4 },
    { "type": "select", "id": "card_shadow", "label": "Card shadow", "options": [
      { "value": "none", "label": "None" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "medium", "label": "Medium" }
    ], "default": "none" },
    { "type": "select", "id": "card_align", "label": "Card alignment (default)", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" }
    ], "default": "center" },
    { "type": "range", "id": "card_padding_y", "min": 0, "max": 48, "step": 2, "unit": "px", "label": "Card padding — vertical", "default": 22 },
    { "type": "range", "id": "card_padding_x", "min": 0, "max": 48, "step": 2, "unit": "px", "label": "Card padding — horizontal", "default": 18 },
    { "type": "range", "id": "card_gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Icon to text spacing", "default": 12 },
    { "type": "select", "id": "image_ratio", "label": "Card image ratio — desktop", "info": "Applies when a card image is uploaded.", "options": [
      { "value": "1/1", "label": "Square 1:1" },
      { "value": "4/5", "label": "Portrait 4:5" },
      { "value": "3/4", "label": "Portrait 3:4" },
      { "value": "4/3", "label": "Landscape 4:3" },
      { "value": "16/10", "label": "Wide 16:10" }
    ], "default": "4/3" },
    { "type": "select", "id": "image_ratio_m", "label": "Card image ratio — mobile", "options": [
      { "value": "1/1", "label": "Square 1:1" },
      { "value": "4/5", "label": "Portrait 4:5" },
      { "value": "3/4", "label": "Portrait 3:4" },
      { "value": "4/3", "label": "Landscape 4:3" },
      { "value": "16/10", "label": "Wide 16:10" }
    ], "default": "4/3" },

    { "type": "header", "content": "Icons" },
    { "type": "select", "id": "icon_position", "label": "Icon position (default)", "options": [
      { "value": "top", "label": "Above text" },
      { "value": "left", "label": "Left of text" }
    ], "default": "top" },
    { "type": "range", "id": "icon_size", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Icon size", "default": 24 },
    { "type": "select", "id": "icon_shape", "label": "Icon background shape", "options": [
      { "value": "none", "label": "None (icon only)" },
      { "value": "circle", "label": "Circle" },
      { "value": "square", "label": "Rounded square" }
    ], "default": "none" },
    { "type": "range", "id": "icon_padding", "min": 4, "max": 20, "step": 2, "unit": "px", "label": "Icon chip padding", "default": 10 },
    { "type": "color", "id": "icon_color", "label": "Icon color", "info": "Blank uses the accent color." },
    { "type": "color", "id": "icon_bg", "label": "Icon chip background" },
    { "type": "select", "id": "icon_border_width", "label": "Icon border width", "options": [ { "value": "0", "label": "None" }, { "value": "1", "label": "1px" }, { "value": "2", "label": "2px" } ], "default": "0" },

    { "type": "header", "content": "Typography — Cards" },
    { "type": "range", "id": "cardtitle_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Card title size", "default": 12 },
    { "type": "color", "id": "fcard_title_color", "label": "Card title color", "info": "Blank uses the text color." },
    { "type": "range", "id": "cardtext_size", "min": 10, "max": 18, "step": 0.5, "unit": "px", "label": "Card text size", "default": 12.5 },
    { "type": "color", "id": "fcard_text_color", "label": "Card text color", "info": "Blank uses the muted color." },

    { "type": "header", "content": "Typography — Eyebrow" },
    { "type": "select", "id": "eyebrow_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
      { "value": "subheading", "label": "Theme subheading font" },
      { "value": "accent", "label": "Theme accent font" },
      { "value": "serif", "label": "Serif (Georgia)" }
    ], "default": "body" },
    { "type": "range", "id": "eyebrow_size", "min": 9, "max": 16, "step": 1, "unit": "px", "label": "Font size — desktop", "default": 11 },
    { "type": "range", "id": "eyebrow_size_m", "min": 9, "max": 16, "step": 1, "unit": "px", "label": "Font size — mobile", "default": 10 },
    { "type": "select", "id": "eyebrow_weight", "label": "Font weight", "options": [
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" },
      { "value": "700", "label": "Bold 700" }
    ], "default": "600" },
    { "type": "select", "id": "eyebrow_ls", "label": "Letter spacing", "options": [ { "value": "0em", "label": "None" }, { "value": "0.01em", "label": "0.01em" }, { "value": "0.02em", "label": "0.02em" }, { "value": "0.03em", "label": "0.03em" }, { "value": "0.04em", "label": "0.04em" }, { "value": "0.05em", "label": "0.05em" }, { "value": "0.06em", "label": "0.06em" }, { "value": "0.08em", "label": "0.08em" }, { "value": "0.1em", "label": "0.1em" }, { "value": "0.12em", "label": "0.12em" }, { "value": "0.14em", "label": "0.14em" }, { "value": "0.16em", "label": "0.16em" }, { "value": "0.18em", "label": "0.18em" }, { "value": "0.2em", "label": "0.2em" }, { "value": "0.22em", "label": "0.22em" }, { "value": "0.26em", "label": "0.26em" }, { "value": "0.3em", "label": "0.3em" }, { "value": "0.35em", "label": "0.35em" }, { "value": "0.4em", "label": "0.4em" } ], "default": "0.22em" },
    { "type": "select", "id": "eyebrow_transform", "label": "Text transform", "options": [
      { "value": "uppercase", "label": "Uppercase" },
      { "value": "none", "label": "None" }
    ], "default": "uppercase" },

    { "type": "header", "content": "Typography — Heading" },
    { "type": "select", "id": "heading_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
      { "value": "subheading", "label": "Theme subheading font" },
      { "value": "accent", "label": "Theme accent font" },
      { "value": "serif", "label": "Serif (Georgia)" }
    ], "default": "heading" },
    { "type": "range", "id": "heading_size", "min": 18, "max": 64, "step": 1, "unit": "px", "label": "Font size — desktop", "default": 26 },
    { "type": "range", "id": "heading_size_m", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Font size — mobile", "default": 21 },
    { "type": "select", "id": "heading_weight", "label": "Font weight", "options": [
      { "value": "300", "label": "Light 300" },
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" }
    ], "default": "400" },
    { "type": "range", "id": "heading_lh", "min": 1, "max": 1.8, "step": 0.1, "label": "Line height", "default": 1.3 },
    { "type": "select", "id": "heading_ls", "label": "Letter spacing", "options": [ { "value": "0em", "label": "None" }, { "value": "0.01em", "label": "0.01em" }, { "value": "0.02em", "label": "0.02em" }, { "value": "0.03em", "label": "0.03em" }, { "value": "0.04em", "label": "0.04em" }, { "value": "0.05em", "label": "0.05em" }, { "value": "0.06em", "label": "0.06em" }, { "value": "0.08em", "label": "0.08em" }, { "value": "0.1em", "label": "0.1em" }, { "value": "0.12em", "label": "0.12em" }, { "value": "0.14em", "label": "0.14em" }, { "value": "0.16em", "label": "0.16em" }, { "value": "0.18em", "label": "0.18em" }, { "value": "0.2em", "label": "0.2em" }, { "value": "0.22em", "label": "0.22em" }, { "value": "0.26em", "label": "0.26em" }, { "value": "0.3em", "label": "0.3em" }, { "value": "0.35em", "label": "0.35em" }, { "value": "0.4em", "label": "0.4em" } ], "default": "0.06em" },
    { "type": "select", "id": "heading_transform", "label": "Text transform", "options": [
      { "value": "uppercase", "label": "Uppercase" },
      { "value": "none", "label": "None" },
      { "value": "capitalize", "label": "Capitalize" }
    ], "default": "none" },
    { "type": "range", "id": "heading_max_width", "min": 40, "max": 100, "step": 5, "unit": "%", "label": "Max width", "default": 100 },

    { "type": "header", "content": "Typography — Intro / Body" },
    { "type": "select", "id": "body_font", "label": "Font family", "options": [
