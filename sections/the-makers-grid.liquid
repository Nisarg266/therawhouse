{%- comment -%}
  Renders "THE MAKERS" 4-column artisan & designer portrait showcase section.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign subheading = section.settings.subheading | default: 'the'
  assign heading = section.settings.heading | default: 'M A K E R S'
  assign show_underline = section.settings.show_underline
  assign max_width = section.settings.max_width | default: 1080
  assign gap = section.settings.gap | default: 24
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 64
  assign view_all_text = section.settings.view_all_text | default: 'VIEW OUR MAKERS'
  assign view_all_link = section.settings.view_all_link | default: '/collections/all'
  assign enable_hover_zoom = section.settings.enable_hover_zoom

  assign maker_1_name = section.settings.maker_1_name | default: 'Duffy London'
  assign maker_1_subtitle = section.settings.maker_1_subtitle | default: 'Fun With Design'
  assign maker_1_img = section.settings.maker_1_image
  assign maker_1_link = section.settings.maker_1_link | default: '/collections/all'

  assign maker_2_name = section.settings.maker_2_name | default: 'Nishita'
  assign maker_2_subtitle = section.settings.maker_2_subtitle | default: 'Nishita Thakurdas'
  assign maker_2_img = section.settings.maker_2_image
  assign maker_2_link = section.settings.maker_2_link | default: '/collections/all'

  assign maker_3_name = section.settings.maker_3_name | default: 'Paul Matter'
  assign maker_3_subtitle = section.settings.maker_3_subtitle | default: 'Nikhil Paul'
  assign maker_3_img = section.settings.maker_3_image
  assign maker_3_link = section.settings.maker_3_link | default: '/collections/all'

  assign maker_4_name = section.settings.maker_4_name | default: 'Jay Strongwater'
  assign maker_4_subtitle = section.settings.maker_4_subtitle | default: 'Hand Enameled Jewels for Home'
  assign maker_4_img = section.settings.maker_4_image
  assign maker_4_link = section.settings.maker_4_link | default: '/collections/all'
%}

<div
  id="TheMakers-{{ section_id }}"
  class="the-makers-grid section-{{ section_id }}"
  style="
    --tmg-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --tmg-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --tmg-max-width: {{ max_width }}px;
    --tmg-gap: {{ gap }}px;
    --tmg-padding-top: {{ padding_top }}px;
    --tmg-padding-bottom: {{ padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="the-makers-grid__container">
    
    {%- comment -%} Header Title with Script Subheading & Underline {%- endcomment -%}
    <div class="the-makers-grid__header">
      {% if subheading != blank %}
        <span class="the-makers-grid__subheading">{{ subheading }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2 class="the-makers-grid__heading">{{ heading }}</h2>
      {% endif %}
      {% if show_underline %}
        <div class="the-makers-grid__underline" aria-hidden="true"></div>
      {% endif %}
    </div>

    {%- comment -%} 4-Column Portrait Grid {%- endcomment -%}
    <div class="the-makers-grid__grid" data-editorial-track>
      
      <!-- Maker 1 -->
      <article class="the-makers-grid__card" data-editorial-card>
        <div class="the-makers-grid__media-wrap{% if enable_hover_zoom %} the-makers-grid__media--zoom{% endif %}">
          <a href="{{ maker_1_link }}" class="the-makers-grid__media-link" aria-label="{{ maker_1_name | escape }}">
            {% if maker_1_img != blank %}
              {{ maker_1_img | image_url: width: 600 | image_tag: class: 'the-makers-grid__img', loading: 'lazy', alt: maker_1_name }}
            {% else %}
              <img src="{{ 'maker-portrait-1.jpg' | asset_url }}" alt="{{ maker_1_name | escape }}" class="the-makers-grid__img" loading="eager" width="450" height="580">
            {% endif %}
          </a>
        </div>

        <div class="the-makers-grid__info">
          <h3 class="the-makers-grid__name">
            <a href="{{ maker_1_link }}">{{ maker_1_name }}</a>
          </h3>
          {% if maker_1_subtitle != blank %}
            <p class="the-makers-grid__subtitle">{{ maker_1_subtitle }}</p>
          {% endif %}
        </div>
      </article>

      <!-- Maker 2 -->
      <article class="the-makers-grid__card" data-editorial-card>
        <div class="the-makers-grid__media-wrap{% if enable_hover_zoom %} the-makers-grid__media--zoom{% endif %}">
          <a href="{{ maker_2_link }}" class="the-makers-grid__media-link" aria-label="{{ maker_2_name | escape }}">
            {% if maker_2_img != blank %}
              {{ maker_2_img | image_url: width: 600 | image_tag: class: 'the-makers-grid__img', loading: 'lazy', alt: maker_2_name }}
            {% else %}
              <img src="{{ 'maker-portrait-2.jpg' | asset_url }}" alt="{{ maker_2_name | escape }}" class="the-makers-grid__img" loading="eager" width="450" height="580">
            {% endif %}
          </a>
        </div>

        <div class="the-makers-grid__info">
          <h3 class="the-makers-grid__name">
            <a href="{{ maker_2_link }}">{{ maker_2_name }}</a>
          </h3>
          {% if maker_2_subtitle != blank %}
            <p class="the-makers-grid__subtitle">{{ maker_2_subtitle }}</p>
          {% endif %}
        </div>
      </article>

      <!-- Maker 3 -->
      <article class="the-makers-grid__card" data-editorial-card>
        <div class="the-makers-grid__media-wrap{% if enable_hover_zoom %} the-makers-grid__media--zoom{% endif %}">
          <a href="{{ maker_3_link }}" class="the-makers-grid__media-link" aria-label="{{ maker_3_name | escape }}">
            {% if maker_3_img != blank %}
              {{ maker_3_img | image_url: width: 600 | image_tag: class: 'the-makers-grid__img', loading: 'lazy', alt: maker_3_name }}
            {% else %}
              <img src="{{ 'maker-portrait-3.jpg' | asset_url }}" alt="{{ maker_3_name | escape }}" class="the-makers-grid__img" loading="eager" width="450" height="580">
            {% endif %}
          </a>
        </div>

        <div class="the-makers-grid__info">
          <h3 class="the-makers-grid__name">
            <a href="{{ maker_3_link }}">{{ maker_3_name }}</a>
          </h3>
          {% if maker_3_subtitle != blank %}
            <p class="the-makers-grid__subtitle">{{ maker_3_subtitle }}</p>
          {% endif %}
        </div>
      </article>

      <!-- Maker 4 -->
      <article class="the-makers-grid__card" data-editorial-card>
        <div class="the-makers-grid__media-wrap{% if enable_hover_zoom %} the-makers-grid__media--zoom{% endif %}">
          <a href="{{ maker_4_link }}" class="the-makers-grid__media-link" aria-label="{{ maker_4_name | escape }}">
            {% if maker_4_img != blank %}
              {{ maker_4_img | image_url: width: 600 | image_tag: class: 'the-makers-grid__img', loading: 'lazy', alt: maker_4_name }}
            {% else %}
              <img src="{{ 'maker-portrait-4.jpg' | asset_url }}" alt="{{ maker_4_name | escape }}" class="the-makers-grid__img" loading="eager" width="450" height="580">
            {% endif %}
          </a>
        </div>

        <div class="the-makers-grid__info">
          <h3 class="the-makers-grid__name">
            <a href="{{ maker_4_link }}">{{ maker_4_name }}</a>
          </h3>
          {% if maker_4_subtitle != blank %}
            <p class="the-makers-grid__subtitle">{{ maker_4_subtitle }}</p>
          {% endif %}
        </div>
      </article>

    </div>

    <!-- Mobile Slider Dots Indicator -->
    <div class="the-makers-grid__mobile-dots" id="TmgDots-{{ section_id }}">
      <button type="button" class="the-makers-grid__dot is-active" data-editorial-dot data-index="0" aria-label="Show item 1" aria-current="true"></button>
      <button type="button" class="the-makers-grid__dot" data-editorial-dot data-index="1" aria-label="Show item 2" aria-current="false"></button>
      <button type="button" class="the-makers-grid__dot" data-editorial-dot data-index="2" aria-label="Show item 3" aria-current="false"></button>
      <button type="button" class="the-makers-grid__dot" data-editorial-dot data-index="3" aria-label="Show item 4" aria-current="false"></button>
    </div>

    {%- comment -%} Footer View Our Makers Link {%- endcomment -%}
    {% if view_all_text != blank %}
      <div class="the-makers-grid__footer">
        <a href="{{ view_all_link }}" class="the-makers-grid__view-all art-button art-button--secondary">
          {{ view_all_text }}
        </a>
      </div>
    {% endif %}

  </div>
</div>



{% stylesheet %}
  .the-makers-grid {
    background-color: var(--tmg-bg, #ffffff);
    width: 100%;
    padding-block-start: var(--tmg-padding-top, 24px);
    padding-block-end: var(--tmg-padding-bottom, 20px);
    box-sizing: border-box;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .the-makers-grid__container {
    max-width: var(--tmg-max-width, 1080px);
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  .the-makers-grid__header {
    text-align: center;
    margin-block-end: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .the-makers-grid__subheading {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif !important;
    font-style: italic !important;
    font-size: 22px !important;
    color: var(--tmg-heading-color, #111111) !important;
    margin-bottom: 2px !important;
    letter-spacing: 0.02em !important;
    opacity: 0.9 !important;
    line-height: 1.1 !important;
  }

  .the-makers-grid__heading {
    font-size: 18px !important;
    letter-spacing: 0.32em !important;
    font-weight: 500 !important;
    text-transform: uppercase !important;
    color: var(--tmg-heading-color, #111111) !important;
    margin: 0 !important;
    line-height: 1.2 !important;
  }

  .the-makers-grid__underline {
    width: 36px !important;
    height: 1.5px !important;
    background-color: var(--tmg-heading-color, #111111) !important;
    margin-top: 8px !important;
  }

  .the-makers-grid__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--tmg-gap, 24px);
    width: 100%;
  }

  .the-makers-grid__mobile-dots {
    display: none;
  }

  .the-makers-grid__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .the-makers-grid__media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.28;
    overflow: hidden;
    background-color: #f7f7f7;
    margin-bottom: 14px;
  }

  .the-makers-grid__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .the-makers-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(100%);
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .the-makers-grid__media--zoom:hover .the-makers-grid__img {
    transform: scale(1.04);
    filter: grayscale(85%);
  }

  .the-makers-grid__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .the-makers-grid__name {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #111111;
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .the-makers-grid__name a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .the-makers-grid__name a:hover {
    opacity: 0.75;
  }

  .the-makers-grid__subtitle {
    font-size: 10.5px;
    color: #777777;
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
  }

  .the-makers-grid__footer {
    text-align: center;
    margin-top: 20px;
  }

  .the-makers-grid__view-all {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }

  .the-makers-grid__view-all:hover {
    opacity: 0.7;
  }

  /* Mobile Responsive Touch Slider & Spacing Normalization */
  @media screen and (max-width: 767px) {
    .the-makers-grid {
      padding-block-start: clamp(24px, 5vw, 32px) !important;
      padding-block-end: clamp(26px, 5vw, 34px) !important;
    }

    .the-makers-grid__container {
      padding-inline: 18px !important;
      overflow: hidden !important;
    }

    .the-makers-grid__header {
      margin-block-end: 18px !important;
    }

    .the-makers-grid__grid {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      gap: 14px !important;
      padding-inline: 18px !important;
      margin-inline: -18px !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }

    .the-makers-grid__grid::-webkit-scrollbar {
      display: none !important;
    }

    .the-makers-grid__card {
      flex: 0 0 62% !important;
      max-width: 240px !important;
      scroll-snap-align: start !important;
      scroll-snap-stop: always !important;
    }

    .the-makers-grid__media-wrap {
      aspect-ratio: 1 / 1.28 !important;
      margin-bottom: 10px !important;
    }

    .the-makers-grid__mobile-dots {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 6px !important;
      margin-top: 14px !important;
      margin-bottom: 18px !important;
    }

    .the-makers-grid__dot {
      box-sizing: content-box !important;
      padding: 10px 5px !important;
      border: 0 !important;
      background-clip: content-box !important;
      flex-shrink: 0;
      width: 6px !important;
      height: 6px !important;
      border-radius: 50% !important;
      background-color: #d8d8d8 !important;
      cursor: pointer !important;
      transition: all 0.28s ease !important;
    }

    .the-makers-grid__dot.is-active {
      width: 22px !important;
      border-radius: 4px !important;
      background-color: var(--tmg-heading-color, #111111) !important;
    }

    .the-makers-grid__footer {
      margin-top: 10px !important;
    }
  }
{% endstylesheet %}

