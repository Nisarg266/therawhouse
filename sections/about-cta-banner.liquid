<div
  class="about-cta about-cta--{{ section.id }}"
  style="
    --cta-pt: {{ section.settings.padding_top }}px;
    --cta-pb: {{ section.settings.padding_bottom }}px;
    --cta-bg: {{ section.settings.bg_color }};
    --cta-text: {{ section.settings.text_color }};
    --cta-accent: {{ section.settings.accent_color }};
  "
>
  {%- if section.settings.background_image != blank -%}
    <div class="about-cta__bg-wrap">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: 
        class: 'about-cta__bg-img', 
        loading: 'lazy', 
        widths: '600,1000,1400,2000',
        alt: section.settings.heading | escape 
      }}
      <div class="about-cta__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    </div>
  {%- else -%}
    <div class="about-cta__bg-wrap">
      <img
        src="{{ 'maker-gallery-3.jpg' | asset_url }}"
        alt="The House of Things Curation"
        class="about-cta__bg-img"
        loading="lazy"
        width="1920"
        height="800"
      >
      <div class="about-cta__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    </div>
  {%- endif -%}

  <div class="about-cta__container">
    <div class="about-cta__content" data-about-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <div class="about-cta__eyebrow-wrap">
          <span class="about-cta__eyebrow-line"></span>
          <span class="about-cta__eyebrow">{{ section.settings.eyebrow }}</span>
          <span class="about-cta__eyebrow-line"></span>
        </div>
      {%- endif -%}

      <h2 class="about-cta__heading">
        {{ section.settings.heading }}
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="about-cta__subtitle">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}

      <div class="about-cta__buttons">
        {%- if section.settings.primary_btn_text != blank -%}
          <a href="{{ section.settings.primary_btn_url | default: '/collections/all' }}" class="about-cta__btn about-cta__btn--primary">
            <span>{{ section.settings.primary_btn_text }}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_btn_text != blank -%}
          <a href="{{ section.settings.secondary_btn_url | default: '/pages/contact' }}" class="about-cta__btn about-cta__btn--secondary">
            <span>{{ section.settings.secondary_btn_text }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .about-cta {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--cta-bg, #111111);
    color: var(--cta-text, #ffffff);
    padding-top: var(--cta-pt, 90px);
    padding-bottom: var(--cta-pb, 90px);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-cta__bg-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .about-cta__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.02);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-cta:hover .about-cta__bg-img {
    transform: scale(1.05);
  }

  .about-cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10,10,10,0.65) 0%, rgba(10,10,10,0.85) 100%);
  }

  .about-cta__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 28px;
    text-align: center;
    box-sizing: border-box;
  }

  .about-cta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-cta__eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }

  .about-cta__eyebrow-line {
    display: block;
    width: 28px;
    height: 1px;
    background-color: var(--cta-accent, #c8a876);
  }

  .about-cta__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cta-accent, #c8a876);
  }

  .about-cta__heading {
    font-family: var(--font-heading-family, serif);
    font-size: clamp(26px, 3.8vw, 50px);
    font-weight: 300;
    line-height: 1.18;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 16px 0;
    max-width: 780px;
  }

  .about-cta__subtitle {
    font-family: var(--font-body-family, sans-serif);
    font-size: clamp(13px, 1.2vw, 15.5px);
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
    max-width: 620px;
    margin: 0 0 30px 0;
  }

  .about-cta__buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .about-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease, border-color 0.25s ease;
  }

  .about-cta__btn--primary {
    background-color: #ffffff;
    color: #111111;
    border: 1px solid #ffffff;
  }

  .about-cta__btn--primary:hover {
    background-color: var(--cta-accent, #c8a876);
    border-color: var(--cta-accent, #c8a876);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .about-cta__btn--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .about-cta__btn--secondary:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .about-cta {
      padding-top: 50px;
      padding-bottom: 50px;
    }
    .about-cta__container {
      padding: 0 16px;
    }
    .about-cta__heading {
      font-size: 24px;
      margin-bottom: 12px;
    }
    .about-cta__subtitle {
      font-size: 13px;
      margin-bottom: 24px;
    }
    .about-cta__buttons {
      width: 100%;
      flex-direction: column;
      gap: 10px;
    }
    .about-cta__btn {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
      padding: 12px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "About CTA Banner",
  "tag": "section",
  "class": "section-about-cta",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 75
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE CURATION AWAITS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "BEGIN YOUR CURATED JOURNEY"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore our latest collectible edits or schedule a private consultation at our flagship gallery spaces."
    },
    {
      "type": "header",
      "content": "Call-to-Action Buttons"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "EXPLORE ALL EDITS"
    },
    {
      "type": "url",
      "id": "primary_btn_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "SCHEDULE CONSULTATION"
    },
    {
      "type": "url",
      "id": "secondary_btn_url",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#c8a876"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 110
    }
  ],
  "presets": [
    {
      "name": "About CTA Banner"
    }
  ]
}
{% endschema %}
