{%- comment -%}
  Renders direct contact channel tiles with dynamic repeatable blocks.
  Allows adding, reordering, and customizing each contact tile (WhatsApp, Phone, Email, Trade Desk).
{%- endcomment -%}

<div
  id="ContactTiles-{{ section.id }}"
  class="contact-tiles-section"
  style="
    --ct-bg: {{ section.settings.background_color | default: '#faf9f6' }};
    --ct-tile-bg: {{ section.settings.tile_background | default: '#ffffff' }};
    --ct-tile-border: {{ section.settings.tile_border_color | default: '#ede8e0' }};
    --ct-tile-hover-border: {{ section.settings.tile_hover_border | default: '#111111' }};
    --ct-tile-radius: {{ section.settings.tile_radius | default: 4 }}px;
    --ct-label-color: {{ section.settings.label_color | default: '#8c8273' }};
    --ct-value-color: {{ section.settings.value_color | default: '#111111' }};
    --ct-icon-color: {{ section.settings.icon_color | default: '#111111' }};
    --ct-arrow-color: {{ section.settings.arrow_color | default: '#c5a059' }};
    --ct-label-size: {{ section.settings.label_size | default: 11 }}px;
    --ct-value-size: {{ section.settings.value_size | default: 14 }}px;
    --ct-gap: {{ section.settings.gap | default: 16 }}px;
    --ct-gap-m: {{ section.settings.gap_m | default: 12 }}px;
    --ct-pt: {{ section.settings.padding_top | default: 0 }}px;
    --ct-pb: {{ section.settings.padding_bottom | default: 40 }}px;
    --ct-pt-m: {{ section.settings.padding_top_m | default: 0 }}px;
    --ct-pb-m: {{ section.settings.padding_bottom_m | default: 28 }}px;
    --ct-max-w: {{ section.settings.max_width | default: 1040 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="contact-tiles__container">
    <div class="contact-tiles__grid contact-tiles__grid--cols-{{ section.settings.columns_desktop }} contact-tiles__grid--cols-m-{{ section.settings.columns_mobile }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign custom_tile_bg = block.settings.custom_bg
          assign custom_tile_border = block.settings.custom_border
          assign custom_icon_color = block.settings.custom_icon_color
          assign custom_value_color = block.settings.custom_value_color
        -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          {% if block.settings.open_in_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
          class="contact-tile contact-tile--{{ block.id }}"
          style="
            {% if custom_tile_bg != blank %}background-color: {{ custom_tile_bg }} !important;{% endif %}
            {% if custom_tile_border != blank %}border-color: {{ custom_tile_border }} !important;{% endif %}
          "
          {{ block.shopify_attributes }}
        >
          <div
            class="contact-tile__icon-wrap"
            style="{% if custom_icon_color != blank %}color: {{ custom_icon_color }} !important;{% endif %}"
          >
            {%- case block.settings.icon -%}
              {%- when 'whatsapp' -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              {%- when 'phone' -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              {%- when 'email' -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              {%- when 'calendar' -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              {%- when 'compass' -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
              {%- when 'map_pin' -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            {%- endcase -%}
          </div>

          <div class="contact-tile__content">
            <span class="contact-tile__label">{{ block.settings.label }}</span>
            <span
              class="contact-tile__value"
              style="{% if custom_value_color != blank %}color: {{ custom_value_color }} !important;{% endif %}"
            >
              {{ block.settings.value }}
            </span>
          </div>

          <span class="contact-tile__arrow">→</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .contact-tiles-section {
    width: 100%;
    background-color: var(--ct-bg);
    padding-top: var(--ct-pt);
    padding-bottom: var(--ct-pb);
    box-sizing: border-box;
  }

  .contact-tiles__container {
    max-width: var(--ct-max-w);
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 40px);
    padding-right: clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .contact-tiles__grid {
    display: grid;
    gap: var(--ct-gap);
  }

  .contact-tiles__grid--cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .contact-tiles__grid--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .contact-tiles__grid--cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .contact-tile {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 24px;
    background-color: var(--ct-tile-bg);
    border: 1px solid var(--ct-tile-border);
    border-radius: var(--ct-tile-radius);
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease,
                box-shadow 0.25s ease;
    box-sizing: border-box;
  }

  .contact-tile:hover {
    transform: translateY(-3px);
    border-color: var(--ct-tile-hover-border);
    box-shadow: 0 16px 32px -14px rgba(24, 18, 8, 0.22);
  }

  .contact-tile__icon-wrap {
    width: 46px;
    height: 46px;
    border: 1px solid var(--ct-tile-border);
    border-radius: 0;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ct-icon-color);
    flex-shrink: 0;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .contact-tile:hover .contact-tile__icon-wrap {
    background: var(--ct-icon-color);
    border-color: var(--ct-icon-color);
    color: #f4efe6;
  }

  .contact-tile__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .contact-tile__label {
    font-size: var(--ct-label-size);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ct-label-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .contact-tile__value {
    font-family: var(--font-heading--family, serif);
    font-size: var(--ct-value-size);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ct-value-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .contact-tile__arrow {
    font-size: 16px;
    color: var(--ct-arrow-color);
    transition: transform 0.2s ease;
  }

  .contact-tile:hover .contact-tile__arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .contact-tiles-section {
      padding-top: var(--ct-pt-m);
      padding-bottom: var(--ct-pb-m);
    }
    .contact-tiles__grid {
      gap: var(--ct-gap-m);
    }
    .contact-tiles__grid--cols-m-1 {
      grid-template-columns: 1fr;
    }
    .contact-tiles__grid--cols-m-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .contact-tile {
      padding: 16px 18px;
      gap: 14px;
    }
    .contact-tile__icon-wrap {
      width: 42px;
      height: 42px;
    }
  }
</style>

{% schema %}
