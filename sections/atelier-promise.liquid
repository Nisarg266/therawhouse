{%- comment -%}
  THE RAW HOUSE — ATELIER PROMISE BANNER (LUXP design system)
  Full-bleed image banner with overlay, statement, feature blocks (icon +
  label + text) and a button. Desktop and mobile background images.
  Completely static presentation.

  @module atelier-promise
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign overlay_color = s.overlay_color | default: '#000000'
  assign overlay_alpha = s.overlay_opacity | default: 55 | times: 0.01

  assign icon_color = s.icon_color
  if icon_color == blank or icon_color == 'rgba(0,0,0,0)'
    assign icon_color = 'var(--luxp-accent)'
  endif
  assign icon_bg = s.icon_bg
  if icon_bg == blank
    assign icon_bg = 'transparent'
  endif

  assign icon_radius = '999px'
  if s.icon_shape == 'square'
    assign icon_radius = '4px'
  endif

  assign valign = 'center'
  if s.content_valign == 'top'
    assign valign = 'flex-start'
  elsif s.content_valign == 'bottom'
    assign valign = 'flex-end'
  endif
-%}

{%- capture luxp_colors -%}
  {%- render 'luxp-scheme',
    preset: s.color_preset,
    bg: s.color_bg,
    heading: s.color_heading,
    text: s.color_text,
    accent: s.color_accent,
    muted: s.color_muted,
    border: s.color_border,
    btn_bg: s.btn_bg,
    btn_text: s.btn_text,
    btn_border: s.btn_border,
    btn_bg_hover: s.btn_bg_hover,
    btn_text_hover: s.btn_text_hover
  -%}
{%- endcapture -%}

{%- capture luxp_typo -%}{%- render 'luxp-typo', s: s -%}{%- endcapture -%}

<div
  class="luxp-banner {% if s.enable_animations %}luxp-anim{% endif %} {{ s.custom_class }}"
  style="
    {{ luxp_colors }}
    {{ luxp_typo }}
    --luxp-banner-mh: {{ s.min_height | default: 480 }}px;
    --luxp-banner-mh-m: {{ s.min_height_m | default: 420 }}px;
    --luxp-banner-fit: {{ s.image_fit | default: 'cover' }};
    --luxp-overlay-color: {{ overlay_color }};
    --luxp-overlay-opacity: {{ overlay_alpha }};
    --luxp-banner-valign: {{ valign }};
    --luxp-pt: {{ s.padding_top | default: 64 }}px;
    --luxp-pb: {{ s.padding_bottom | default: 64 }}px;
    --luxp-pt-m: {{ s.padding_top_m | default: 48 }}px;
    --luxp-pb-m: {{ s.padding_bottom_m | default: 48 }}px;
    --luxp-cw: {{ s.container_max | default: 1080 }}px;
    --luxp-px: {{ s.container_padding | default: 32 }}px;
    --luxp-px-m: {{ s.container_padding_m | default: 20 }}px;
    --luxp-content-track: {% if s.text_align == 'left' %}flex-start{% else %}center{% endif %};
    --luxp-text-align: {{ s.text_align | default: 'center' }};
    --luxp-content-gap: {{ s.content_gap | default: 18 }}px;
    --luxp-content-gap-m: {{ s.content_gap_m | default: 14 }}px;
    --luxp-heading-mw: {{ s.heading_max_width | default: 100 }}%;
    --luxp-body-mw: {{ s.body_max_width | default: 100 }}%;
    --luxp-ornament-color: var(--luxp-accent);
    --luxp-icon-size: {{ s.icon_size | default: 24 }}px;
    --luxp-icon-pad: {{ s.icon_padding | default: 11 }}px;
    --luxp-icon-bg: {{ icon_bg }};
    --luxp-icon-fg: {{ icon_color }};
    --luxp-icon-radius: {{ icon_radius }};
    --luxp-icon-bw: {{ s.icon_border_width | default: 0 }};
    --luxp-icon-border: var(--luxp-border);
    --luxp-metrics-cols: {{ s.feature_columns | default: 3 }};
    --luxp-metrics-cols-m: {{ s.feature_columns_m | default: 1 }};
    --luxp-metrics-gap: {{ s.feature_gap | default: 28 }}px;
    --luxp-metrics-gap-m: {{ s.feature_gap_m | default: 18 }}px;
    --luxp-metrics-divider-bw: 0px;
    --luxp-metrics-py: 0px;
    --luxp-footer-mt: {{ s.btn_margin_top | default: 12 }}px;
    --luxp-footer-justify: {% if s.text_align == 'left' %}flex-start{% else %}center{% endif %};
  "
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  data-art-motion="off"
  {{ section.shopify_attributes }}
>
  <div class="luxp-banner__media" aria-hidden="true">
    {% if s.image != blank or s.default_asset != blank %}
      {% render 'luxp-image',
        image: s.image,
        image_mobile: s.image_mobile,
        alt: s.heading,
        class: 'luxp-banner__img',
        loading: 'lazy',
        sizes: '100vw',
        fallback: s.default_asset
      %}
    {% endif %}
  </div>
  <div class="luxp-banner__overlay" aria-hidden="true"></div>

  <div class="luxp-container">
    <div class="luxp-banner__inner {% if s.text_align == 'left' %}luxp-banner__inner--left{% endif %}">
      {% if s.eyebrow != blank %}
        <p class="luxp-eyebrow">{{ s.eyebrow }}</p>
      {% endif %}

      {% if s.heading != blank %}
        <h2 class="luxp-heading">{{ s.heading }}</h2>
      {% endif %}

      {% if s.show_ornament %}
        <div class="luxp-ornament" aria-hidden="true">
          <span class="luxp-ornament__line"></span>
          <span class="luxp-ornament__gem">&#9670;</span>
          <span class="luxp-ornament__line"></span>
        </div>
      {% endif %}

      {% if s.statement != blank %}
        <div class="luxp-body">{{ s.statement }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="luxp-metrics" style="margin-top: {{ s.features_margin_top | default: 22 }}px;">
          {% for block in section.blocks %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="luxp-metric luxp-metric--link" style="text-decoration: none; color: inherit;" {{ block.shopify_attributes }}>
            {% else %}
              <div class="luxp-metric" {{ block.shopify_attributes }}>
            {% endif %}
              {% if block.settings.icon_image != blank %}
                <span class="luxp-icon {% if s.icon_shape != 'none' %}luxp-icon--chip{% endif %}">
                  {{
                    block.settings.icon_image
                    | image_url: width: 96
                    | image_tag:
                      alt: block.settings.label,
                      loading: 'lazy',
                      decoding: 'async',
                      widths: '48, 96'
                  }}
                </span>
              {% elsif block.settings.icon != 'none' %}
                <span class="luxp-icon {% if s.icon_shape != 'none' %}luxp-icon--chip{% endif %}">
                  {% render 'luxp-icon', icon: block.settings.icon %}
                </span>
              {% endif %}
              {% if block.settings.label != blank %}
                <h4 class="luxp-metric__title">{{ block.settings.label }}</h4>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="luxp-metric__desc">{{ block.settings.text }}</p>
              {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if s.btn_label != blank %}
        <div class="luxp-footer">
          <a
            href="{{ s.btn_link | default: routes.all_products_collection_url }}"
            class="luxp-btn {% if s.btn_style == 'outline' %}luxp-btn--outline{% endif %} {% if s.btn_width == 'full' %}luxp-btn--full{% endif %} {% if s.btn_mobile_full %}luxp-btn--mobile-full{% endif %}"
          >
            {{ s.btn_label }}
            {% if s.btn_arrow %}
              {% render 'luxp-icon', icon: 'arrow', class: 'luxp-btn__arrow' %}
            {% endif %}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  /* ============================================================
     THE RAW HOUSE — ATELIER PROMISE CONTRAST & LEGIBILITY SYSTEM
     ============================================================ */

  #AtelierPromise-{{ section.id }},
  .section-luxp-banner .luxp-banner {
    position: relative;
  }

  /* Multi-stop atmospheric luxury dark vignette overlay */
  #AtelierPromise-{{ section.id }} .luxp-banner__overlay,
  .section-luxp-banner .luxp-banner__overlay {
    background:
      radial-gradient(ellipse at 50% 45%, rgba(14, 12, 10, 0.72) 0%, rgba(6, 5, 4, 0.90) 100%),
      var(--luxp-overlay-color, #000000) !important;
    opacity: {{ s.overlay_opacity | default: 75 | times: 0.01 }} !important;
  }

  /* Eyebrow badge */
  #AtelierPromise-{{ section.id }} .luxp-eyebrow,
  .section-luxp-banner .luxp-eyebrow {
    color: var(--luxp-accent, #dfba7e) !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.28em !important;
    text-transform: uppercase !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95);
    margin-bottom: 2px;
  }

  /* Headline with crisp shadow */
  #AtelierPromise-{{ section.id }} .luxp-heading,
  .section-luxp-banner .luxp-heading {
    color: #ffffff !important;
    font-size: clamp(20px, 2.3vw, 26px) !important;
    font-weight: 500 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.95), 0 1px 4px rgba(0, 0, 0, 0.9);
    margin: 0;
  }

  /* Gem ornament */
  #AtelierPromise-{{ section.id }} .luxp-ornament__gem,
  .section-luxp-banner .luxp-ornament__gem {
    color: var(--luxp-accent, #dfba7e) !important;
    text-shadow: 0 0 12px rgba(223, 186, 126, 0.6);
  }

  #AtelierPromise-{{ section.id }} .luxp-ornament__line,
  .section-luxp-banner .luxp-ornament__line {
    background: linear-gradient(90deg, transparent, var(--luxp-accent, #dfba7e), transparent) !important;
    opacity: 0.7;
  }

  /* Main statement text */
  #AtelierPromise-{{ section.id }} .luxp-body,
  #AtelierPromise-{{ section.id }} .luxp-body p,
  .section-luxp-banner .luxp-body,
  .section-luxp-banner .luxp-body p {
    color: #f7f3eb !important;
    font-size: clamp(15px, 1.45vw, 17px) !important;
    font-weight: 400 !important;
    line-height: 1.75 !important;
    letter-spacing: 0.02em !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.95), 0 1px 4px rgba(0, 0, 0, 0.9);
    max-width: 840px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Feature cards grid */
  #AtelierPromise-{{ section.id }} .luxp-metrics,
  .section-luxp-banner .luxp-metrics {
    display: grid !important;
    grid-template-columns: repeat(var(--luxp-metrics-cols, 3), minmax(0, 1fr)) !important;
    gap: var(--luxp-metrics-gap, 24px) !important;
    width: 100% !important;
    max-width: 1040px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    border: none !important;
    padding: 0 !important;
  }

  @media screen and (max-width: 768px) {
    #AtelierPromise-{{ section.id }} .luxp-metrics,
    .section-luxp-banner .luxp-metrics {
      grid-template-columns: repeat(var(--luxp-metrics-cols-m, 1), minmax(0, 1fr)) !important;
      gap: var(--luxp-metrics-gap-m, 16px) !important;
    }
  }

  /* Frosted luxury glass card for each feature */
  #AtelierPromise-{{ section.id }} .luxp-metric,
  .section-luxp-banner .luxp-metric {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    padding: 24px 22px !important;
    background: rgba(18, 15, 12, 0.60) !important;
    border: 1px solid rgba(223, 186, 126, 0.22) !important;
    border-radius: 4px !important;
    backdrop-filter: blur(14px) !important;
    -webkit-backdrop-filter: blur(14px) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease !important;
    box-sizing: border-box !important;
    text-decoration: none !important;
  }

  #AtelierPromise-{{ section.id }} .luxp-metric:hover,
  .section-luxp-banner .luxp-metric:hover {
    background: rgba(26, 21, 17, 0.78) !important;
    border-color: rgba(223, 186, 126, 0.45) !important;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.6) !important;
    transform: translateY(-3px) !important;
  }

  #AtelierPromise-{{ section.id }} .luxp-metric .luxp-icon,
  .section-luxp-banner .luxp-metric .luxp-icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: var(--luxp-accent, #dfba7e) !important;
    margin-bottom: 12px !important;
    filter: drop-shadow(0 2px 8px rgba(223, 186, 126, 0.4)) !important;
  }

  #AtelierPromise-{{ section.id }} .luxp-metric .luxp-icon svg,
  .section-luxp-banner .luxp-metric .luxp-icon svg {
    width: var(--luxp-icon-size, 26px) !important;
    height: var(--luxp-icon-size, 26px) !important;
  }

  #AtelierPromise-{{ section.id }} .luxp-metric__title,
  .section-luxp-banner .luxp-metric__title {
    font-family: var(--font-body--family, "Inter", -apple-system, sans-serif) !important;
    font-size: {{ s.feature_label_size | default: 12 }}px !important;
    font-weight: 700 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin: 0 0 8px !important;
    line-height: 1.4 !important;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95) !important;
  }

  #AtelierPromise-{{ section.id }} .luxp-metric__desc,
  .section-luxp-banner .luxp-metric__desc {
    font-family: var(--font-body--family, "Inter", -apple-system, sans-serif) !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
    letter-spacing: 0.02em !important;
    color: rgba(244, 239, 230, 0.92) !important;
    margin: 0 !important;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.95) !important;
  }

  /* CTA Button */
  #AtelierPromise-{{ section.id }} .luxp-btn,
  .section-luxp-banner .luxp-btn {
    background: var(--luxp-btn-bg, #c5a880) !important;
    color: var(--luxp-btn-fg, #111111) !important;
    border-color: var(--luxp-btn-border, var(--luxp-btn-bg, #c5a880)) !important;
    font-weight: 700 !important;
    letter-spacing: 0.2em !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45) !important;
    transition: all 0.3s ease !important;
  }

  #AtelierPromise-{{ section.id }} .luxp-btn:hover,
  .section-luxp-banner .luxp-btn:hover {
    background: var(--luxp-btn-bg-h, #ffffff) !important;
    color: var(--luxp-btn-fg-h, #111111) !important;
    border-color: var(--luxp-btn-bg-h, #ffffff) !important;
    box-shadow: 0 8px 25px rgba(197, 168, 128, 0.4) !important;
    transform: translateY(-2px) !important;
  }
</style>

{% schema %}
{
  "name": "Promise Banner",
  "tag": "section",
  "class": "section-luxp-banner",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / subheading", "default": "the" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A T E L I E R   P R O M I S E" },
    { "type": "richtext", "id": "statement", "label": "Statement", "default": "<p>Every piece that reaches your home is hand-selected at the atelier, certified for provenance, and delivered with the same reverence the masters poured into making it.</p>" },
    { "type": "checkbox", "id": "show_ornament", "label": "Show ornament divider", "default": true },

    { "type": "header", "content": "Background Image" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional separate image shown below 750px." },
    { "type": "text", "id": "default_asset", "label": "Fallback asset filename", "default": "hero-lighting-art-3.jpg" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [
      { "value": "cover", "label": "Cover (fill, may crop)" },
      { "value": "contain", "label": "Contain (no crop)" }
    ], "default": "cover" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 55 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "min": 300, "max": 800, "step": 20, "unit": "px", "label": "Minimum height — desktop", "default": 480 },
    { "type": "range", "id": "min_height_m", "min": 280, "max": 700, "step": 20, "unit": "px", "label": "Minimum height — mobile", "default": 420 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" }
    ], "default": "center" },
    { "type": "select", "id": "content_valign", "label": "Vertical alignment", "options": [
      { "value": "center", "label": "Middle" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" }
    ], "default": "center" },
    { "type": "range", "id": "container_max", "min": 640, "max": 1400, "step": 20, "unit": "px", "label": "Content max width", "default": 1080 },
    { "type": "range", "id": "content_gap", "min": 6, "max": 32, "step": 2, "unit": "px", "label": "Content spacing — desktop", "default": 18 },
    { "type": "range", "id": "content_gap_m", "min": 6, "max": 26, "step": 2, "unit": "px", "label": "Content spacing — mobile", "default": 14 },

    { "type": "header", "content": "Feature Icons" },
    { "type": "range", "id": "feature_columns", "min": 1, "max": 4, "step": 1, "label": "Feature columns — desktop", "default": 3 },
    { "type": "select", "id": "feature_columns_m", "label": "Feature columns — mobile", "options": [
      { "value": "1", "label": "1 column" },
      { "value": "2", "label": "2 columns" },
      { "value": "3", "label": "3 columns" }
    ], "default": "1" },
    { "type": "range", "id": "feature_gap", "min": 12, "max": 48, "step": 2, "unit": "px", "label": "Feature gap — desktop", "default": 28 },
    { "type": "range", "id": "feature_gap_m", "min": 8, "max": 36, "step": 2, "unit": "px", "label": "Feature gap — mobile", "default": 18 },
    { "type": "range", "id": "features_margin_top", "min": 0, "max": 48, "step": 2, "unit": "px", "label": "Space above features", "default": 16 },
    { "type": "range", "id": "feature_label_size", "min": 9, "max": 14, "step": 0.5, "unit": "px", "label": "Feature label size", "default": 11 },
    { "type": "range", "id": "icon_size", "min": 16, "max": 40, "step": 2, "unit": "px", "label": "Icon size", "default": 24 },
    { "type": "select", "id": "icon_shape", "label": "Icon background shape", "options": [
      { "value": "none", "label": "None (icon only)" },
      { "value": "circle", "label": "Circle" },
      { "value": "square", "label": "Rounded square" }
    ], "default": "none" },
    { "type": "range", "id": "icon_padding", "min": 4, "max": 20, "step": 2, "unit": "px", "label": "Icon chip padding", "default": 10 },
    { "type": "color", "id": "icon_color", "label": "Icon color", "info": "Blank uses the accent color." },
    { "type": "color", "id": "icon_bg", "label": "Icon chip background" },
    { "type": "select", "id": "icon_border_width", "label": "Icon border width", "options": [
      { "value": "0", "label": "None" },
      { "value": "1", "label": "1px" },
      { "value": "2", "label": "2px" }
    ], "default": "0" },

    { "type": "header", "content": "Typography — Eyebrow" },
    { "type": "select", "id": "eyebrow_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
      { "value": "subheading", "label": "Theme subheading font" },
      { "value": "accent", "label": "Theme accent font" },
      { "value": "serif", "label": "Serif (Georgia)" }
    ], "default": "body" },
    { "type": "range", "id": "eyebrow_size", "min": 9, "max": 16, "step": 1, "unit": "px", "label": "Font size — desktop", "default": 11 },
    { "type": "range", "id": "eyebrow_size_m", "min": 9, "max": 16, "step": 1, "unit": "px", "label": "Font size — mobile", "default": 10 },
    { "type": "select", "id": "eyebrow_weight", "label": "Font weight", "options": [
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" },
      { "value": "700", "label": "Bold 700" }
    ], "default": "600" },
    { "type": "select", "id": "eyebrow_ls", "label": "Letter spacing", "options": [ { "value": "0em", "label": "None" }, { "value": "0.1em", "label": "0.1em" }, { "value": "0.18em", "label": "0.18em" }, { "value": "0.22em", "label": "0.22em" }, { "value": "0.3em", "label": "0.3em" } ], "default": "0.22em" },
    { "type": "select", "id": "eyebrow_transform", "label": "Text transform", "options": [
      { "value": "uppercase", "label": "Uppercase" },
      { "value": "none", "label": "None" }
    ], "default": "uppercase" },

    { "type": "header", "content": "Typography — Heading" },
    { "type": "select", "id": "heading_font", "label": "Font family", "options": [
      { "value": "heading", "label": "Theme heading font" },
      { "value": "body", "label": "Theme body font" },
      { "value": "subheading", "label": "Theme subheading font" },
      { "value": "accent", "label": "Theme accent font" },
      { "value": "serif", "label": "Serif (Georgia)" }
    ], "default": "body" },
    { "type": "range", "id": "heading_size", "min": 14, "max": 48, "step": 1, "unit": "px", "label": "Font size — desktop", "default": 20 },
    { "type": "range", "id": "heading_size_m", "min": 12, "max": 36, "step": 1, "unit": "px", "label": "Font size — mobile", "default": 17 },
    { "type": "select", "id": "heading_weight", "label": "Font weight", "options": [
      { "value": "300", "label": "Light 300" },
      { "value": "400", "label": "Regular 400" },
      { "value": "500", "label": "Medium 500" },
      { "value": "600", "label": "Semibold 600" }
    ], "default": "400" },
    { "type": "range", "id": "heading_lh", "min": 1, "max": 1.8, "step": 0.1, "label": "Line height", "default": 1.2 },
