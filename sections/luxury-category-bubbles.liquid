{%- comment -%}
  THE RAW HOUSE - ADVANCED CATEGORY BUBBLES / HIGHLIGHTS
  Instagram-style luxury circular highlights with dynamic blocks, advanced color schemes, and size controls.
{%- endcomment -%}

{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'warm'
  case scheme
    when 'light'
      assign bg_color = '#ffffff'
      assign text_color = '#111111'
      assign ring_color = 'linear-gradient(135deg, #c5a880 0%, #ecd8b8 50%, #c5a880 100%)'
    when 'dark'
      assign bg_color = '#141414'
      assign text_color = '#ffffff'
      assign ring_color = 'linear-gradient(135deg, #c5a880 0%, #ffffff 50%, #c5a880 100%)'
    when 'obsidian'
      assign bg_color = '#0b0b0b'
      assign text_color = '#ffffff'
      assign ring_color = 'linear-gradient(135deg, #c5a880 0%, #e2cca6 50%, #9e7f57 100%)'
    else
      assign bg_color = '#fcfbf9'
      assign text_color = '#111111'
      assign ring_color = 'linear-gradient(135deg, #c5a880 0%, #dfcaa5 50%, #c5a880 100%)'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_text_color != blank and section.settings.custom_text_color != 'rgba(0,0,0,0)'
    assign text_color = section.settings.custom_text_color
  endif
%}

<div
  id="LuxuryBubbles-{{ section.id }}"
  class="lux-bubbles-section lux-bubbles-scheme-{{ scheme }}"
  style="
    --bubbles-bg: {{ bg_color }};
    --bubbles-color: {{ text_color }};
    --bubbles-ring: {{ ring_color }};
    --bubbles-pt: {{ section.settings.padding_top | default: 22 }}px;
    --bubbles-pb: {{ section.settings.padding_bottom | default: 36 }}px;
    background: var(--bubbles-bg);
    color: var(--bubbles-color);
    padding-top: var(--bubbles-pt);
    padding-bottom: var(--bubbles-pb);
  "
  {{ section.shopify_attributes }}
>
  <div class="lux-bubbles-container">
    {% if section.settings.heading != blank %}
      <div class="lux-section-heading-wrap lux-reveal-fade-up">
        {% if section.settings.subheading != blank %}
          <span class="lux-section-subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 class="lux-section-heading" style="color: var(--bubbles-color);">{{ section.settings.heading }}</h2>
        <div class="lux-section-divider"></div>
      </div>
    {% endif %}

    <div class="lux-bubbles-track lux-stagger-parent lux-reveal-fade-up">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="lux-bubble-item lux-stagger-child"
          {{ block.shopify_attributes }}
        >
          <div class="lux-bubble-ring" style="background: var(--bubbles-ring);">
            <div class="lux-bubble-avatar">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 300
                  | image_tag:
                    class: 'lux-bubble-img',
                    loading: 'eager',
                    alt: block.settings.title
                }}
              {% elsif block.settings.default_asset != blank %}
                <img
                  src="{{ block.settings.default_asset | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  class="lux-bubble-img"
                  loading="eager"
                  onerror="this.onerror=null;this.src='{{ 'new-arrival-1.jpg' | asset_url }}';"
                  width="120"
                  height="120"
                >
              {% else %}
                <img
                  src="{{ 'new-arrival-1.jpg' | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  class="lux-bubble-img"
                  loading="eager"
                  width="120"
                  height="120"
                >
              {% endif %}
            </div>
          </div>
          <span class="lux-bubble-title" style="color: var(--bubbles-color);">{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Category Bubbles",
  "tag": "section",
  "class": "section-luxury-bubbles",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme & Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color Scheme Preset",
      "options": [
        { "value": "warm", "label": "Warm Atelier Ivory (#fcfbf9)" },
        { "value": "light", "label": "Light Clean (#ffffff)" },
        { "value": "dark", "label": "Contemporary Dark (#141414)" },
        { "value": "obsidian", "label": "Obsidian Gold (#0b0b0b)" }
      ],
      "default": "warm"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Text Color"
    },
    {
      "type": "header",
      "content": "Heading & Text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "EXPLORE BY WORLD"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CURATED CATEGORIES"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "bubble",
      "name": "Category Bubble Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Default Asset Fallback"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Living Room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Category Bubbles",
      "blocks": [
        {
          "type": "bubble",
          "settings": {
            "title": "ORIGINAL OILS",
            "default_asset": "art-painting-starry-night.jpg"
          }
        },
        {
          "type": "bubble",
          "settings": {
            "title": "BRONZE SCULPTURES",
            "default_asset": "art-sculpture-bronze-figure.jpg"
          }
        },
        {
          "type": "bubble",
          "settings": {
            "title": "3D ART MODELS",
            "default_asset": "art-sculpture-marble-bust.jpg"
          }
        },
        {
          "type": "bubble",
          "settings": {
            "title": "ABSTRACT GOLD LEAF",
            "default_asset": "art-painting-gold-canvas.jpg"
          }
        },
        {
          "type": "bubble",
          "settings": {
            "title": "EXPRESSIONIST FORMS",
            "default_asset": "maker-gallery-2.jpg"
          }
        },
        {
          "type": "bubble",
          "settings": {
            "title": "BESPOKE COMMISSIONS",
            "default_asset": "art-atelier-artist-studio.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
