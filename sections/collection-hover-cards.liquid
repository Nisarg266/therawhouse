{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'warm'

  case scheme
    when 'light'
      assign bg_color = '#ffffff'
      assign text_color = '#111111'
      assign muted_color = '#6b665c'
      assign card_bg = '#f7f4ee'
      assign border_color = '#ded8cc'
      assign accent_color = '#9f7e4b'
    when 'dark'
      assign bg_color = '#151413'
      assign text_color = '#ffffff'
      assign muted_color = '#c9c1b3'
      assign card_bg = '#201e1b'
      assign border_color = 'rgba(255, 255, 255, 0.14)'
      assign accent_color = '#c5a880'
    when 'obsidian'
      assign bg_color = '#090908'
      assign text_color = '#ffffff'
      assign muted_color = '#cfc6b7'
      assign card_bg = '#141210'
      assign border_color = 'rgba(197, 168, 128, 0.22)'
      assign accent_color = '#c5a880'
    else
      assign bg_color = '#f8f5ef'
      assign text_color = '#111111'
      assign muted_color = '#6c675d'
      assign card_bg = '#fffdf8'
      assign border_color = '#ded7cb'
      assign accent_color = '#9f7e4b'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_text_color != blank and section.settings.custom_text_color != 'rgba(0,0,0,0)'
    assign text_color = section.settings.custom_text_color
  endif
  if section.settings.custom_accent_color != blank and section.settings.custom_accent_color != 'rgba(0,0,0,0)'
    assign accent_color = section.settings.custom_accent_color
  endif
%}

<section
  id="CollectionHoverCards-{{ section.id }}"
  class="collection-hover-cards collection-hover-cards--{{ scheme }}"
  style="
    --chc-bg: {{ bg_color }};
    --chc-color: {{ text_color }};
    --chc-muted: {{ muted_color }};
    --chc-card: {{ card_bg }};
    --chc-border: {{ border_color }};
    --chc-accent: {{ accent_color }};
    --chc-pt: {{ section.settings.padding_top | default: 72 }}px;
    --chc-pb: {{ section.settings.padding_bottom | default: 78 }}px;
    --chc-gap: {{ section.settings.card_gap | default: 24 }}px;
    --chc-heading-size: {{ section.settings.heading_size | default: 46 }}px;
    --chc-card-title-size: {{ section.settings.card_title_size | default: 38 }}px;
    --chc-text-size: {{ section.settings.text_size | default: 14 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="collection-hover-cards__inner">
    <header class="collection-hover-cards__header lux-reveal-fade-up">
      {% if section.settings.top_label != blank %}
        <div class="collection-hover-cards__top-label">{{ section.settings.top_label }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="collection-hover-cards__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="collection-hover-cards__intro">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div class="collection-hover-cards__grid lux-stagger-parent lux-reveal-fade-up">
      {% for block in section.blocks %}
        {% liquid
          assign selected_collection = block.settings.collection
          assign selected_title = block.settings.title
          assign selected_url = block.settings.link
          assign selected_description = block.settings.description
          assign selected_image = block.settings.image

          if selected_title == blank and selected_collection != blank
            assign selected_title = selected_collection.title
          endif

          if selected_url == blank and selected_collection != blank
            assign selected_url = selected_collection.url
          endif

          if selected_url == blank
            assign selected_url = routes.all_products_collection_url
          endif

          if selected_description == blank and selected_collection != blank
            assign selected_description = selected_collection.description | strip_html
          endif

          if selected_image == blank and selected_collection != blank
            if selected_collection.featured_image != blank
              assign selected_image = selected_collection.featured_image
            elsif selected_collection.products_count > 0 and selected_collection.products.first.featured_image != blank
              assign selected_image = selected_collection.products.first.featured_image
            endif
          endif

          if selected_title == blank
            assign selected_title = 'Curated collection'
          endif

          if selected_description == blank
            assign selected_description = 'A focused edit of pieces chosen for material presence, quiet detail, and rooms that feel deeply collected.'
          endif
        %}

        <a
          href="{{ selected_url }}"
          class="collection-hover-card lux-stagger-child"
          {{ block.shopify_attributes }}
        >
          <div class="collection-hover-card__media">
            {% if selected_image != blank %}
              {{
                selected_image
                | image_url: width: 1100
                | image_tag:
                  class: 'collection-hover-card__image',
                  loading: 'lazy',
                  widths: '360, 540, 720, 900, 1100',
                  sizes: '(max-width: 749px) 92vw, (max-width: 989px) 45vw, 30vw',
                  alt: selected_title
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-hover-card__placeholder' }}
            {% endif %}
          </div>

          <div class="collection-hover-card__shade" aria-hidden="true"></div>

          <div class="collection-hover-card__content">
            {% if block.settings.kicker != blank %}
              <span class="collection-hover-card__kicker">{{ block.settings.kicker }}</span>
            {% endif %}

            <h3 class="collection-hover-card__title">{{ selected_title }}</h3>

            <div class="collection-hover-card__default-decor">
              <span class="collection-hover-card__line"></span>
            </div>

            <div class="collection-hover-card__circle-btn" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </div>

            <div class="collection-hover-card__reveal">
              <p class="collection-hover-card__description">{{ selected_description | newline_to_br }}</p>
              <span class="collection-hover-card__button">
                <span>{{ block.settings.button_label | default: section.settings.button_label }}</span>
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .collection-hover-cards {
    width: 100%;
    overflow: clip;
    background: var(--chc-bg);
    color: var(--chc-color);
    padding: var(--chc-pt) 0 var(--chc-pb);
  }

  .collection-hover-cards__inner {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
  }

  .collection-hover-cards__header {
    max-width: 620px;
    margin: 0 auto clamp(40px, 5vw, 64px);
    text-align: center;
  }

  .collection-hover-cards__top-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 24px;
    color: var(--chc-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.24em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .collection-hover-cards__top-label::before,
  .collection-hover-cards__top-label::after {
    content: '';
    display: block;
    width: 48px;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }

  .collection-hover-cards__heading {
    margin: 0 0 16px;
    color: var(--chc-color);
    font-family: var(--font-heading-family, serif);
    font-size: clamp(34px, 4.5vw, var(--chc-heading-size, 52px));
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .collection-hover-cards__intro {
    max-width: 540px;
    margin: 0 auto;
    color: var(--chc-muted);
    font-size: var(--chc-text-size, 15px);
    line-height: 1.65;
  }

  .collection-hover-cards__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--chc-gap);
  }

  .collection-hover-card {
    grid-column: span 2;
    position: relative;
    display: block;
    min-height: 460px;
    overflow: hidden;
    background: var(--chc-card);
    color: #ffffff;
    text-decoration: none;
    isolation: isolate;
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Make items 7 and 8 wider if they exist */
  .collection-hover-card:nth-child(7),
  .collection-hover-card:nth-child(8) {
    grid-column: span 3;
  }

  .collection-hover-card:hover,
  .collection-hover-card:focus-visible {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.3);
    z-index: 10;
    outline: none;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .collection-hover-card__media,
  .collection-hover-card__shade {
    position: absolute;
    inset: 0;
  }

  .collection-hover-card__media {
    z-index: -2;
    background: #2a251e;
  }

  .collection-hover-card__image,
  .collection-hover-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .collection-hover-card__image {
    object-fit: cover;
    object-position: center;
    filter: saturate(0.85) contrast(1.1);
    transform: scale(1.01);
    transition:
      transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
      filter 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-hover-card__placeholder {
    background: #2a251e;
    fill: rgba(255, 255, 255, 0.1);
  }

  .collection-hover-card:hover .collection-hover-card__image,
  .collection-hover-card:focus-visible .collection-hover-card__image {
    filter: saturate(1.1) contrast(1.15);
    transform: scale(1.08);
  }

  .collection-hover-card__shade {
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.2) 40%, rgba(0, 0, 0, 0.85) 100%);
    transition: background 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-hover-card:hover .collection-hover-card__shade,
  .collection-hover-card:focus-visible .collection-hover-card__shade {
    background: linear-gradient(180deg, rgba(30, 20, 10, 0.4) 0%, rgba(20, 10, 5, 0.9) 100%);
  }

  .collection-hover-card__content {
    position: absolute;
    inset: auto 0 0;
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .collection-hover-card__kicker {
    display: block;
    margin-bottom: 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .collection-hover-card__title {
    max-width: 90%;
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading-family, serif);
    font-size: clamp(28px, 3vw, var(--chc-card-title-size, 40px));
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .collection-hover-card__default-decor {
    margin-top: 18px;
    transition: opacity 0.4s ease;
  }

  .collection-hover-card__line {
    display: block;
    width: 38px;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
  }

  .collection-hover-card__circle-btn {
    position: absolute;
    bottom: clamp(24px, 3vw, 40px);
    right: clamp(24px, 3vw, 40px);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.3s ease;
  }

  .collection-hover-card:hover .collection-hover-card__default-decor,
  .collection-hover-card:focus-visible .collection-hover-card__default-decor,
  .collection-hover-card:hover .collection-hover-card__circle-btn,
  .collection-hover-card:focus-visible .collection-hover-card__circle-btn {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.9);
  }

  .collection-hover-card__reveal {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px);
    transition:
      max-height 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-hover-card:hover .collection-hover-card__reveal,
  .collection-hover-card:focus-visible .collection-hover-card__reveal {
    max-height: 400px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 16px;
  }

  .collection-hover-card__description {
    min-height: 0;
    max-width: 95%;
    margin: 0 0 24px;
    color: rgba(255, 255, 255, 0.85);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    font-size: var(--chc-text-size, 14px);
    line-height: 1.6;
  }

  .collection-hover-card__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .collection-hover-card__button:hover {
    background: #ffffff;
    color: #000000;
  }

  @media screen and (max-width: 1024px) {
    .collection-hover-cards__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .collection-hover-card {
      grid-column: span 2;
    }
    .collection-hover-card:nth-child(7),
    .collection-hover-card:nth-child(8) {
      grid-column: span 2;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-hover-cards {
      padding-top: calc(var(--chc-pt) * 0.7);
      padding-bottom: calc(var(--chc-pb) * 0.7);
    }

    .collection-hover-cards__inner {
      width: 100%;
      padding: 0 16px;
    }

    .collection-hover-cards__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .collection-hover-card {
      grid-column: span 1;
      min-height: 400px;
    }
    
    .collection-hover-card:nth-child(7),
    .collection-hover-card:nth-child(8) {
      grid-column: span 1;
    }

    .collection-hover-card__circle-btn,
    .collection-hover-card__default-decor {
      display: none;
    }

    .collection-hover-card__reveal {
      max-height: 400px;
      opacity: 1;
      transform: none;
      margin-top: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-hover-card,
    .collection-hover-card__image,
    .collection-hover-card__shade,
    .collection-hover-card__reveal,
    .collection-hover-card__button,
    .collection-hover-card__circle-btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Hover Cards",
  "tag": "section",
  "class": "section-collection-hover-cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 24,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top label",
      "default": "THE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLLECTIONS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose up to eight featured edits or keep adding more curated collection cards."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Default button label",
      "default": "Explore edit"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color scheme",
      "options": [
        { "value": "warm", "label": "Warm ivory" },
        { "value": "light", "label": "White gallery" },
        { "value": "dark", "label": "Dark editorial" },
        { "value": "obsidian", "label": "Obsidian luxury" }
      ],
      "default": "warm"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom background color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom text color"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Custom accent color"
    },
    {
      "type": "header",
      "content": "Typography Options"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Section heading size",
      "default": 46
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Card title size",
      "default": 38
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Paragraph text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Card gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 30,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 30,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 78
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Small label",
          "default": "CURATED EDIT"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Hover description",
          "default": "Add three to four lines describing the collection, the materials, the mood, and why this edit belongs in a layered home."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Hover Cards",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
