{% liquid
  assign scheme = section.settings.color_scheme_preset | default: 'warm'
  case scheme
    when 'light'
      assign bg_color = '#ffffff'
      assign text_color = '#111111'
      assign muted_color = '#6f6a60'
      assign card_bg = '#fffefa'
      assign border_color = '#ded8cc'
      assign accent_color = '#9f7e4b'
    when 'dark'
      assign bg_color = '#151413'
      assign text_color = '#ffffff'
      assign muted_color = '#c9c1b3'
      assign card_bg = '#201e1b'
      assign border_color = 'rgba(255, 255, 255, 0.14)'
      assign accent_color = '#c5a880'
    else
      assign bg_color = '#f8f5ef'
      assign text_color = '#111111'
      assign muted_color = '#6c675d'
      assign card_bg = '#fffdf8'
      assign border_color = '#ded7cb'
      assign accent_color = '#9f7e4b'
  endcase

  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)'
    assign bg_color = section.settings.custom_bg_color
  endif
  if section.settings.custom_text_color != blank and section.settings.custom_text_color != 'rgba(0,0,0,0)'
    assign text_color = section.settings.custom_text_color
  endif
  if section.settings.custom_accent_color != blank and section.settings.custom_accent_color != 'rgba(0,0,0,0)'
    assign accent_color = section.settings.custom_accent_color
  endif
%}

<section
  id="AboutFounders-{{ section.id }}"
  class="about-founders about-founders--{{ scheme }}"
  style="
    --founders-bg: {{ bg_color }};
    --founders-color: {{ text_color }};
    --founders-muted: {{ muted_color }};
    --founders-card: {{ card_bg }};
    --founders-border: {{ border_color }};
    --founders-accent: {{ accent_color }};
    --founders-pt: {{ section.settings.padding_top | default: 74 }}px;
    --founders-pb: {{ section.settings.padding_bottom | default: 66 }}px;
    --founders-small-text-size: {{ section.settings.small_text_size | default: 11 }}px;
    --founders-small-text-size-mobile: {{ section.settings.small_text_size_mobile | default: 9 }}px;
    --founders-heading-size: {{ section.settings.heading_size | default: 32 }}px;
    --founders-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 28 }}px;
    --founders-intro-size: {{ section.settings.intro_size | default: 16 }}px;
    --founders-intro-size-mobile: {{ section.settings.intro_size_mobile | default: 15 }}px;
    --founders-name-size: {{ section.settings.name_size | default: 49 }}px;
    --founders-name-size-mobile: {{ section.settings.name_size_mobile | default: 30 }}px;
    --founders-card-text-size: {{ section.settings.card_text_size | default: 21 }}px;
    --founders-card-text-size-mobile: {{ section.settings.card_text_size_mobile | default: 14 }}px;
    --founders-bio-size: {{ section.settings.bio_size | default: 13 }}px;
    --founders-link-size: {{ section.settings.link_size | default: 11 }}px;
    --founders-bottom-size: {{ section.settings.bottom_text_size | default: 11 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="about-founders__inner">
    <header class="about-founders__header lux-reveal-fade-up">
      {% if section.settings.top_label != blank %}
        <span class="about-founders__top-label">{{ section.settings.top_label }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="about-founders__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="about-founders__subheading-wrap">
          <span class="about-founders__line about-founders__line--short"></span>
          <span class="about-founders__subheading">{{ section.settings.subheading }}</span>
          <span class="about-founders__line about-founders__line--short"></span>
        </div>
      {% endif %}

      {% if section.settings.intro != blank %}
        <p class="about-founders__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </header>

    <div class="about-founders__grid lux-stagger-parent lux-reveal-fade-up">
      {% for block in section.blocks %}
        {% liquid
          assign fallback_asset = block.settings.default_asset
          if fallback_asset == blank
            if forloop.index == 1
              assign fallback_asset = 'maker-portrait-1.jpg'
            else
              assign fallback_asset = 'maker-portrait-2.jpg'
            endif
          endif
        %}

        <article class="about-founders__card lux-stagger-child" {{ block.shopify_attributes }}>
          <div class="about-founders__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  class: 'about-founders__image',
                  loading: 'lazy',
                  widths: '320, 480, 640, 800, 1000',
                  sizes: '(max-width: 749px) 38vw, (max-width: 1180px) 36vw, 18vw',
                  alt: block.settings.name
              }}
            {% else %}
              <img
                src="{{ fallback_asset | asset_url }}"
                alt="{{ block.settings.name | default: 'The Raw House founder' | escape }}"
                class="about-founders__image"
                loading="lazy"
                width="640"
                height="820"
              >
            {% endif %}
          </div>

          <div class="about-founders__content">
            {% if block.settings.role != blank %}
              <span class="about-founders__role">{{ block.settings.role }}</span>
            {% endif %}

            <span class="about-founders__rule"></span>

            {% if block.settings.name != blank %}
              <h3 class="about-founders__name">{{ block.settings.name }}</h3>
            {% endif %}

            {% if block.settings.quote != blank %}
              <p class="about-founders__quote">{{ block.settings.quote }}</p>
            {% endif %}

            {% if section.settings.show_bio and block.settings.bio != blank %}
              <p class="about-founders__bio">{{ block.settings.bio }}</p>
            {% endif %}

            {% if block.settings.link_label != blank %}
              {% if block.settings.link != blank %}
                <a class="about-founders__link" href="{{ block.settings.link }}">
                  <span>{{ block.settings.link_label }}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              {% else %}
                <span class="about-founders__link about-founders__link--static">
                  <span>{{ block.settings.link_label }}</span>
                  <span aria-hidden="true">&rarr;</span>
                </span>
              {% endif %}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.bottom_text != blank %}
      <div class="about-founders__bottom lux-reveal-fade-up">
        <span class="about-founders__bottom-line"></span>
        <span class="about-founders__bottom-text">{{ section.settings.bottom_text }}</span>
        <span class="about-founders__bottom-line"></span>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .about-founders {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--founders-accent) 10%, transparent), transparent 34%),
      linear-gradient(180deg, color-mix(in srgb, var(--founders-bg) 92%, #ffffff), var(--founders-bg));
    color: var(--founders-color);
    padding: var(--founders-pt) 0 var(--founders-pb);
  }

  .about-founders__inner {
    width: min(1260px, calc(100% - 48px));
    margin: 0 auto;
  }

  .about-founders__header {
    max-width: 760px;
    margin: 0 auto clamp(34px, 4vw, 56px);
    text-align: center;
  }

  .about-founders__top-label {
    display: block;
    margin-bottom: 8px;
    color: var(--founders-accent);
    font-size: var(--founders-small-text-size);
    font-weight: 600;
    letter-spacing: 0.28em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .about-founders__subheading-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 6px 0 12px;
  }

  .about-founders__line,
  .about-founders__bottom-line,
  .about-founders__rule {
    display: block;
    height: 1px;
    background: var(--founders-accent);
  }

  .about-founders__line {
    width: clamp(34px, 5vw, 62px);
  }

  .about-founders__line--short {
    width: clamp(42px, 7vw, 86px);
    background: color-mix(in srgb, var(--founders-accent) 62%, transparent);
  }

  .about-founders__subheading,
  .about-founders__role,
  .about-founders__link,
  .about-founders__bottom-text {
    color: var(--founders-color);
    font-size: var(--founders-small-text-size);
    font-weight: 500;
    letter-spacing: 0.34em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .about-founders__title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, 0.32fr);
    gap: clamp(26px, 4.5vw, 58px);
    align-items: center;
    text-align: left;
  }

  .about-founders__heading {
    margin: 0;
    color: var(--founders-color);
    font-family: var(--font-heading-family, serif);
    font-size: clamp(28px, 4vw, var(--founders-heading-size));
    font-weight: 400;
    letter-spacing: 0.38em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .about-founders__intro {
    max-width: 460px;
    margin: 0;
    margin-left: auto;
    margin-right: auto;
    padding-left: 0;
    border-left: 0;
    color: var(--founders-muted);
    font-size: clamp(13px, 1.1vw, var(--founders-intro-size));
    line-height: 1.5;
  }

  .about-founders__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 34px);
  }

  .about-founders__card {
    display: grid;
    grid-template-columns: minmax(210px, 0.88fr) minmax(0, 1fr);
    min-height: clamp(430px, 36vw, 560px);
    border: 1px solid var(--founders-border);
    background: color-mix(in srgb, var(--founders-card) 94%, transparent);
    overflow: hidden;
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-founders__card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--founders-accent) 72%, var(--founders-border));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.12);
  }

  .about-founders__media {
    min-height: 100%;
    background: #d6d1c8;
    overflow: hidden;
  }

  .about-founders__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transform: scale(1.01);
    transition:
      transform 1s cubic-bezier(0.22, 1, 0.36, 1),
      filter 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-founders__card:hover .about-founders__image {
    filter: grayscale(1) contrast(1.14);
    transform: scale(1.055);
  }

  .about-founders__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 3.8vw, 46px);
  }

  .about-founders__role {
    max-width: 250px;
    color: var(--founders-color);
  }

  .about-founders__rule {
    width: 44px;
    margin: 24px 0 clamp(24px, 3vw, 38px);
  }

  .about-founders__name {
    margin: 0 0 clamp(16px, 2vw, 24px);
    color: var(--founders-color);
    font-family: var(--font-heading-family, serif);
    font-size: clamp(31px, 3.1vw, var(--founders-name-size));
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .about-founders__quote,
  .about-founders__bio {
    max-width: 330px;
    margin: 0;
    color: var(--founders-color);
    font-family: var(--font-heading-family, serif);
    font-size: clamp(16px, 1.22vw, var(--founders-card-text-size));
    line-height: 1.52;
  }

  .about-founders__bio {
    margin-top: 12px;
    color: var(--founders-muted);
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--founders-bio-size);
    line-height: 1.68;
  }

  .about-founders__link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 12px;
    margin-top: clamp(28px, 4vw, 48px);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--founders-accent);
    color: var(--founders-color);
    font-size: var(--founders-link-size);
    text-decoration: none;
    transition:
      gap 0.25s ease,
      color 0.25s ease;
  }

  .about-founders__link:hover {
    gap: 18px;
    color: var(--founders-accent);
  }

  .about-founders__link--static {
    pointer-events: none;
  }

  .about-founders__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(18px, 3vw, 42px);
    align-items: center;
    margin-top: clamp(42px, 5vw, 76px);
  }

  .about-founders__bottom-line {
    opacity: 0.75;
  }

  .about-founders__bottom-text {
    color: var(--founders-muted);
    font-size: var(--founders-bottom-size);
    text-align: center;
    white-space: nowrap;
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .about-founders__card,
    .about-founders__image,
    .about-founders__link {
      transition: none;
    }
  }

  @media screen and (max-width: 1180px) {
    .about-founders__grid {
      grid-template-columns: 1fr;
    }

    .about-founders__card {
      min-height: 460px;
    }
  }

  @media screen and (max-width: 749px) {
    .about-founders {
      padding-top: calc(var(--founders-pt) * 0.68);
      padding-bottom: calc(var(--founders-pb) * 0.72);
    }

    .about-founders__inner {
      width: 100%;
      padding: 0 18px;
    }

    .about-founders__header {
      margin-bottom: 30px;
    }

    .about-founders__subheading-wrap {
      gap: 14px;
      margin: 6px 0 12px;
    }

    .about-founders__line {
      width: 34px;
    }

    .about-founders__subheading,
    .about-founders__role,
    .about-founders__link,
    .about-founders__bottom-text {
      font-size: var(--founders-small-text-size-mobile);
      letter-spacing: 0.28em;
    }

    .about-founders__title-row {
      display: block;
      text-align: center;
    }

    .about-founders__heading {
      font-size: clamp(24px, 8vw, var(--founders-heading-size-mobile));
      letter-spacing: 0.34em;
      line-height: 1.1;
    }

    .about-founders__intro {
      max-width: 330px;
      margin: 0 auto;
      padding-left: 0;
      border-left: 0;
      font-size: var(--founders-intro-size-mobile);
      line-height: 1.45;
    }

    .about-founders__grid {
      gap: 14px;
    }

    .about-founders__card {
      grid-template-columns: 38% 62%;
      min-height: 268px;
    }

    .about-founders__media {
      min-height: 268px;
    }

    .about-founders__content {
      padding: 18px 18px 18px 20px;
    }

    .about-founders__rule {
      width: 30px;
      margin: 13px 0 16px;
    }

    .about-founders__name {
      margin-bottom: 12px;
      font-size: clamp(22px, 7vw, var(--founders-name-size-mobile));
    }

    .about-founders__quote {
      font-size: var(--founders-card-text-size-mobile);
      line-height: 1.42;
    }

    .about-founders__bio {
      display: none;
    }

    .about-founders__link {
      gap: 8px;
      margin-top: 18px;
      padding-bottom: 5px;
    }

    .about-founders__bottom {
      gap: 14px;
      margin-top: 34px;
    }

    .about-founders__bottom-text {
      white-space: normal;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Founders Cards",
  "tag": "section",
  "class": "section-about-founders-cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 2,
  "settings": [
    {
      "type": "header",
      "content": "Heading text"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top label",
      "default": "THE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small divider text",
      "default": "MEET THE FOUNDERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "FOUNDERS"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "A shared instinct for honest materials, considered interiors, and spaces that feel like home."
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom line text",
      "default": "PEOPLE  -  SPACES  -  A BETTER TOMORROW"
    },
    {
      "type": "checkbox",
      "id": "show_bio",
      "label": "Show founder bio text",
      "default": false
    },
    {
      "type": "header",
      "content": "Text sizes"
    },
    {
      "type": "range",
      "id": "small_text_size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Small heading / role size",
      "default": 11
    },
    {
      "type": "range",
      "id": "small_text_size_mobile",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Small heading / role size mobile",
      "default": 9
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Main heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Main heading size mobile",
      "default": 28
    },
    {
      "type": "range",
      "id": "intro_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Intro text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "intro_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Intro text size mobile",
      "default": 15
    },
    {
      "type": "range",
      "id": "name_size",
      "min": 26,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Founder name size",
      "default": 49
    },
    {
      "type": "range",
      "id": "name_size_mobile",
      "min": 20,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Founder name size mobile",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 13,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Founder card text size",
      "default": 21
    },
    {
      "type": "range",
      "id": "card_text_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Founder card text size mobile",
      "default": 14
    },
    {
      "type": "range",
      "id": "bio_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Bio text size",
      "default": 13
    },
    {
      "type": "range",
      "id": "link_size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Link text size",
      "default": 11
    },
    {
      "type": "range",
      "id": "bottom_text_size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Bottom line text size",
      "default": 11
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color scheme",
      "options": [
        { "value": "warm", "label": "Warm ivory" },
        { "value": "light", "label": "White gallery" },
        { "value": "dark", "label": "Dark editorial" }
      ],
      "default": "warm"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom background color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom text color"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Custom line/accent color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 30,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 30,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 66
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Founder image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Fallback asset filename",
          "default": "maker-portrait-1.jpg"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "CO-FOUNDER & CREATIVE CURATOR"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Founder One"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Card text",
          "default": "We look for objects with restraint, texture and soul pieces that feel calm at first glance and deeper the longer you live with them."
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Optional bio",
          "default": "Leads visual curation, material direction and the editorial eye behind The Raw House collections."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "MEET FOUNDER"
        },
        {
