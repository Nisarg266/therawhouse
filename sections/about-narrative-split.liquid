      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "About Heritage Story",
      "settings": {
        "eyebrow": "THE HERITAGE & GENESIS",
        "heading": "BORN FROM A PASSION FOR TIMELESS BEAUTY",
        "lead_text": "Founded with a vision to bridge timeless Indian craft heritage with contemporary international living.",
        "body_text": "<p>The House of Things is an experiential luxury portal where exquisite design meets discerning tastemakers. We scout master craftsmen, independent studios, and heritage ateliers across India and around the world, curating heirlooms that evoke emotion and architectural serenity.</p><p>Every collectible piece in our collection is chosen for its authenticity, uncompromising materiality, and poetic narrative—turning living spaces into soulful sanctuaries.</p>",
