{%- comment -%}
  THE RAW HOUSE - LUXURY HERO SHOWCASE SLIDER
  Cinematic full-bleed slider with Ken Burns zoom, progress timer, glassmorphic badges, dual luxury buttons.
{%- endcomment -%}

{% liquid
  assign image_only = true
  for block in section.blocks
    if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank
      assign image_only = false
      break
    endif
  endfor
%}

<div
  id="LuxuryHero-{{ section.id }}"
  class="lux-hero{% if image_only %} lux-hero--image-only{% endif %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="
    --hero-desktop-height: {{ section.settings.desktop_height }}vh;
    --hero-mobile-height: {{ section.settings.mobile_height }}vh;
  "
  {{ section.shopify_attributes }}
>
  <div class="lux-hero__slider">
    {% for block in section.blocks %}
      {% liquid
        assign img_priority = 'auto'
        if forloop.first
          assign img_priority = 'high'
        endif

        assign align = block.settings.content_alignment | default: 'center'
        if align == 'center'
          assign margin_style = 'margin-inline: auto;'
        elsif align == 'right'
          assign margin_style = 'margin-left: auto; margin-right: 0;'
        else
          assign margin_style = 'margin-right: auto; margin-left: 0;'
        endif
      %}
      <div
        class="lux-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <div class="lux-hero__media-wrap">
          {% if block.settings.button_link != blank and block.settings.heading == blank and block.settings.button_label == blank %}
            <a href="{{ block.settings.button_link }}" style="display: block; width: 100%; height: 100%;" aria-label="Explore Curation">
          {% endif %}
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 2560
              | image_tag:
                class: 'lux-hero__image',
                loading: 'eager',
                fetchpriority: img_priority,
                widths: '750, 1100, 1500, 1920, 2560',
                sizes: '100vw'
            }}
          {% elsif block.settings.default_asset != blank %}
            <img
              src="{{ block.settings.default_asset | asset_url }}"
              alt="{{ block.settings.heading | default: 'The House of Things' | escape }}"
              class="lux-hero__image"
              loading="eager"
              fetchpriority="{{ img_priority }}"
              onerror="this.onerror=null;this.src='{{ 'maker-gallery-1.jpg' | asset_url }}';"
              width="1920"
              height="900"
            >
          {% else %}
            <img
              src="{{ 'maker-gallery-1.jpg' | asset_url }}"
              alt="Luxury Fine Art Gallery"
              class="lux-hero__image"
              loading="eager"
              fetchpriority="{{ img_priority }}"
              width="1920"
              height="900"
            >
          {% endif %}

          {% if section.settings.overlay_opacity > 0 %}
            <div
              class="lux-hero__overlay"
              style="background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity }}%;"
            ></div>
          {% endif %}
          {% if block.settings.button_link != blank and block.settings.heading == blank and block.settings.button_label == blank %}
            </a>
          {% endif %}
        </div>

        {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank %}
          <div class="lux-hero__content-container">
            <div class="lux-hero__content-box" style="text-align: {{ align }}; {{ margin_style }}">

              {% if block.settings.subheading != blank %}
                <span class="lux-hero__pre-title">{{ block.settings.subheading }}</span>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h1 class="lux-hero__heading">{{ block.settings.heading }}</h1>
              {% endif %}

              <div class="lux-hero__actions" style="justify-content: center;">
                {% if block.settings.button_label != blank %}
                  <a
                    href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                    class="lux-btn-primary"
                  >
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}

    {% if section.blocks.size > 1 %}
      <!-- Side Arrows (mid-screen) -->
      <div class="lux-hero__arrows">
        <button
          type="button"
          class="lux-hero__arrow-btn lux-hero__arrow-btn--prev"
          aria-label="Previous Slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="lux-hero__arrow-btn lux-hero__arrow-btn--next"
          aria-label="Next Slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Bottom Pagination Dots -->
      <div class="lux-hero__controls">
        <div class="lux-hero__pagination">
          {% for block in section.blocks %}
            <button
              type="button"
              class="lux-hero__dot{% if forloop.first %} is-active{% endif %}"
              aria-label="Go to slide {{ forloop.index }}"
            >
              <div class="lux-hero__dot-progress"></div>
            </button>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Luxury Hero Slider",
  "tag": "section",
  "class": "section-luxury-hero",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme & Style"
    },
    {
      "type": "select",
      "id": "color_scheme_preset",
      "label": "Color Scheme Preset",
      "options": [
        { "value": "dark", "label": "Classic Dark (#111111)" },
        { "value": "obsidian", "label": "Obsidian Gold (#0b0b0b)" },
        { "value": "gold", "label": "Champagne Bronze" },
        { "value": "warm", "label": "Warm Atelier" }
      ],
      "default": "dark"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Custom Gold / Accent Color"
    },
    {
      "type": "header",
      "content": "Slider Sizing & Autoplay"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "label": "Desktop Height",
      "default": 92
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 50,
      "max": 90,
      "step": 2,
      "unit": "vh",
      "label": "Mobile Height",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 6
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Default Asset Fallback",
          "default": "hero-fine-art-2.jpg"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Badge / Subheading",
          "default": "ATELIER EXHIBITION 2026"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "ORIGINAL OIL PAINTINGS & CANVAS ART"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Monumental textured linen canvases, gold leaf impasto, and evocative masterworks by acclaimed contemporary painters."
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary Button Label",
          "default": "EXPLORE PAINTINGS"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Secondary Button Label",
          "default": "VIEW EXHIBITION"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "default_asset": "hero-fine-art-2.jpg",
            "subheading": "Presenting",
            "heading": "Icons of Contemporary Luxury",
            "content_alignment": "center",
            "button_label": "Discover New Arrivals"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_asset": "art-sculpture-rodin-thinker.jpg",
            "subheading": "Presenting",
            "heading": "Bronze & Marble 3D Art Models",
            "content_alignment": "center",
            "button_label": "Collect Sculptures"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_asset": "hero-museum-exhibition-3.jpg",
            "subheading": "Presenting",
            "heading": "Museum Masterpieces & Fine Editions",
            "content_alignment": "center",
            "button_label": "View Masterpieces"
          }
        }
      ]
    }
  ]
}
{% endschema %}
