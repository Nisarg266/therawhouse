{%- comment -%}
  Renders a full-screen luxury hero slideshow banner with smooth auto-slide, arrows, dots, and touch swipe.
{%- endcomment -%}

<div
  id="LuxuryHeroSlider-{{ section.id }}"
  class="luxury-hero-slider-section"
  style="--slider-height-desktop: calc({{ section.settings.slider_height_desktop }}vh + 20px); --slider-height-mobile: calc({{ section.settings.slider_height_mobile }}vh + 20px);"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="luxury-hero-slider-wrapper">
    <div class="luxury-hero-slider-track">
      {% for block in section.blocks %}
        <div
          class="luxury-hero-slide{% if forloop.first %} is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="luxury-hero-slide__media-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 2560
                | image_tag:
                  class: 'luxury-hero-slide__image',
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '750, 1100, 1500, 1920, 2560',
                  sizes: '100vw'
              }}
            {% elsif block.settings.default_asset != blank %}
              <img
                src="{{ block.settings.default_asset | asset_url }}"
                alt="{{ block.settings.heading | escape }}"
                class="luxury-hero-slide__image"
                loading="eager"
                fetchpriority="high"
                width="1920"
                height="800"
              >
            {% else %}
              <div class="luxury-hero-slide__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}

            {% if section.settings.show_overlay %}
              <div
                class="luxury-hero-slide__overlay"
                style="background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity }}%;"
              ></div>
            {% endif %}
          </div>

          {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank %}
            <div class="luxury-hero-slide__content-container luxury-hero-slide__content--{{ block.settings.content_alignment }}">
              <div class="luxury-hero-slide__content-box">
                {% if block.settings.subheading != blank %}
                  <p class="luxury-hero-slide__subheading">{{ block.settings.subheading }}</p>
                {% endif %}
                {% if block.settings.heading != blank %}
                  <h2 class="luxury-hero-slide__heading">{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <a
                    href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                    class="luxury-hero-slide__btn"
                  >
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <!-- Navigation Arrows -->
      <button
        type="button"
        class="luxury-hero-slider__arrow luxury-hero-slider__arrow--prev"
        aria-label="Previous Slide"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        type="button"
        class="luxury-hero-slider__arrow luxury-hero-slider__arrow--next"
        aria-label="Next Slide"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Dot Indicators -->
      <div class="luxury-hero-slider__dots" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="luxury-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
            role="tab"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function initLuxuryHeroSlider() {
    function setupSlider() {
      const container = document.getElementById('LuxuryHeroSlider-{{ section.id }}');
      if (!container) return;

      const track = container.querySelector('.luxury-hero-slider-track');
      const slides = container.querySelectorAll('.luxury-hero-slide');
      const dots = container.querySelectorAll('.luxury-hero-slider__dot');
      const prevBtn = container.querySelector('.luxury-hero-slider__arrow--prev');
      const nextBtn = container.querySelector('.luxury-hero-slider__arrow--next');

      if (!track || slides.length <= 1) return;

      const totalSlides = slides.length;
      track.style.width = (totalSlides * 100) + '%';

      let currentIndex = 0;
      let autoplayTimer = null;
      const isAutoplay = container.dataset.autoplay === 'true';
      const autoplaySpeed = parseInt(container.dataset.autoplaySpeed, 10) || 5000;

      function goToSlide(index) {
        if (index < 0) index = totalSlides - 1;
        if (index >= totalSlides) index = 0;
        currentIndex = index;

        const offsetPercent = currentIndex * (100 / totalSlides);
        track.style.transform = 'translateX(-' + offsetPercent + '%)';

        slides.forEach((slide, idx) => {
          slide.classList.toggle('is-active', idx === currentIndex);
        });

        dots.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === currentIndex);
        });
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      function startAutoplay() {
        if (!isAutoplay) return;
        stopAutoplay();
        autoplayTimer = setInterval(nextSlide, autoplaySpeed);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          startAutoplay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          startAutoplay();
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.dataset.index, 10);
          goToSlide(idx);
          startAutoplay();
        });
      });

      // Pause on hover
      container.addEventListener('mouseenter', stopAutoplay);
      container.addEventListener('mouseleave', startAutoplay);

      // Touch swipe support
      let touchStartX = 0;
      let touchEndX = 0;

      container.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      container.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) nextSlide();
          else prevSlide();
          startAutoplay();
        }
      }, { passive: true });

      // Initial state
      goToSlide(0);
      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupSlider);
    } else {
      setupSlider();
    }
  })();
</script>

{% stylesheet %}
  .luxury-hero-slider-section {
    width: 100% !important;
    position: relative !important;
    overflow: hidden !important;
    background-color: #000000;
  }

  .luxury-hero-slider-wrapper {
    position: relative !important;
    width: 100% !important;
    height: var(--slider-height-desktop, calc(86vh + 20px)) !important;
    min-height: 590px !important;
    overflow: hidden !important;
  }

  @media screen and (max-width: 749px) {
    .luxury-hero-slider-wrapper {
      height: var(--slider-height-mobile, calc(70vh + 20px)) !important;
      min-height: 420px !important;
    }
  }

  .luxury-hero-slider-track {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    height: 100% !important;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) !important;
    will-change: transform !important;
  }

  .luxury-hero-slide {
    position: relative !important;
    flex: 1 0 0% !important;
    min-width: 0 !important;
    height: 100% !important;
    overflow: hidden !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .luxury-hero-slide__media-wrapper {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
  }

  .luxury-hero-slide__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
  }

  .luxury-hero-slide__overlay {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 2;
  }

  .luxury-hero-slide__content-container {
    position: relative !important;
    z-index: 3 !important;
    height: 100% !important;
    max-width: 1400px !important;
    margin: 0 auto !important;
    padding: 40px 32px 60px !important;
    display: flex !important;
    box-sizing: border-box !important;
  }

  .luxury-hero-slide__content--center {
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
  }

  .luxury-hero-slide__content--left {
    align-items: flex-end !important;
    justify-content: flex-start !important;
    text-align: left !important;
  }

  .luxury-hero-slide__content--right {
    align-items: flex-end !important;
    justify-content: flex-end !important;
    text-align: right !important;
  }

  .luxury-hero-slide__content-box {
    max-width: 680px;
    color: #ffffff;
  }

  .luxury-hero-slide__subheading {
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.3em !important;
    text-transform: uppercase !important;
    margin: 0 0 12px 0 !important;
    color: rgba(255, 255, 255, 0.95) !important;
  }

  .luxury-hero-slide__heading {
    font-size: clamp(26px, 4.2vw, 48px) !important;
    font-weight: 400 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    margin: 0 0 26px 0 !important;
    line-height: 1.18 !important;
    color: #ffffff !important;
    font-family: inherit !important;
  }

  .luxury-hero-slide__btn {
    display: inline-block !important;
    padding: 13px 32px !important;
    background-color: transparent !important;
    color: #ffffff !important;
    border: 1.5px solid #ffffff !important;
    border-radius: 9999px !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.2em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    transition: all 0.3s ease !important;
  }

  .luxury-hero-slide__btn:hover {
    background-color: #ffffff !important;
    color: #111111 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
  }

  /* Slider Arrows */
  .luxury-hero-slider__arrow {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    z-index: 10 !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    background: rgba(0, 0, 0, 0.3) !important;
    backdrop-filter: blur(8px) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    color: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
  }

  .luxury-hero-slider__arrow:hover {
    background: rgba(255, 255, 255, 0.9) !important;
    color: #111111 !important;
    transform: translateY(-50%) scale(1.1) !important;
  }

  .luxury-hero-slider__arrow--prev {
    left: 24px !important;
  }

  .luxury-hero-slider__arrow--next {
    right: 24px !important;
  }

  @media screen and (max-width: 749px) {
    .luxury-hero-slider__arrow {
      width: 36px !important;
      height: 36px !important;
    }
    .luxury-hero-slider__arrow--prev {
      left: 12px !important;
    }
    .luxury-hero-slider__arrow--next {
      right: 12px !important;
    }
  }

  /* Dot Indicators */
  .luxury-hero-slider__dots {
    position: absolute !important;
    bottom: 24px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 10 !important;
    display: flex !important;
    gap: 10px !important;
    align-items: center !important;
  }

  .luxury-hero-slider__dot {
    width: 28px !important;
    height: 3px !important;
    border-radius: 2px !important;
    background: rgba(255, 255, 255, 0.4) !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
  }

  .luxury-hero-slider__dot.is-active {
    width: 42px !important;
    background: #ffffff !important;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.6) !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Hero Slider",
  "tag": "section",
  "class": "section-luxury-hero-slider",
  "settings": [
    {
      "type": "range",
      "id": "slider_height_desktop",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "vh",
      "label": "Desktop Slider Height",
      "default": 85
    },
    {
      "type": "range",
      "id": "slider_height_mobile",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "vh",
      "label": "Mobile Slider Height",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Auto Slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slide Change Interval",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Dark Tint Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Theme Asset File Name (Fallback)",
          "default": "maker-gallery-1.jpg"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "EICHHOLTZ LUXURY COLLECTION"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "MODERN ARCHITECTURAL LIVING"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content Alignment",
          "options": [
            { "value": "left", "label": "Bottom Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Bottom Right" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "EXPLORE COLLECTION"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "default_asset": "maker-gallery-1.jpg",
            "subheading": "EICHHOLTZ LUXURY LIVING",
            "heading": "ARCHITECTURAL INTERIORS",
            "content_alignment": "center",
            "button_label": "EXPLORE DESIGNS"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_asset": "maker-gallery-2.jpg",
            "subheading": "CURATED EXCELLENCE",
            "heading": "TIMELESS ARTISAN DESIGNS",
            "content_alignment": "center",
            "button_label": "SHOP INTERIORS"
          }
        },
        {
          "type": "slide",
          "settings": {
            "default_asset": "maker-gallery-3.jpg",
            "subheading": "HAUTE LIVING",
            "heading": "BESPOKE ACCENTS & LIGHTING",
            "content_alignment": "center",
            "button_label": "VIEW CATALOGUE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
