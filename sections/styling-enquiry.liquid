{{ 'styling-page.css' | asset_url | stylesheet_tag }}
{% assign styling_form_id = 'StylingForm-' | append: section.id %}
<section id="styling-enquiry" class="styling-enquiry" aria-labelledby="StylingEnquiryHeading-{{ section.id }}">
  <div class="styling-enquiry__inner styling-shell">
    <div class="styling-enquiry__copy">
      <p class="styling-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="StylingEnquiryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p class="styling-enquiry__intro">{{ section.settings.intro | escape }}</p>
      {% if section.settings.note != blank %}<p class="styling-enquiry__note">{{ section.settings.note | escape }}</p>{% endif %}
      {% if section.settings.secondary_link != blank and section.settings.secondary_label != blank %}
        <a class="styling-text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">↗</span></a>
      {% endif %}
    </div>
    {% form 'contact', id: styling_form_id, class: 'styling-form' %}
      <input type="hidden" name="contact[Subject]" value="Styling enquiry">
      {% if form.posted_successfully? %}
        <p class="styling-form__feedback" role="status" tabindex="-1" autofocus>{{ 'blocks.contact_form.post_success' | t }}</p>
      {% else %}
        {% if form.errors %}
          <div class="styling-form__feedback styling-form__feedback--error" role="alert" tabindex="-1" autofocus><p>{{ 'blocks.contact_form.error_heading' | t }}</p>{{ form.errors | default_errors }}</div>
        {% endif %}
        <p class="styling-form__required">{{ section.settings.required_note | escape }}</p>
        <div class="styling-form__grid">
          <div class="styling-form__field">
            <label for="StylingName-{{ section.id }}">{{ 'blocks.contact_form.name' | t }} <span aria-hidden="true">*</span></label>
            <input id="StylingName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name | default: customer.name | escape }}" autocomplete="name" required>
          </div>
          <div class="styling-form__field">
            <label for="StylingEmail-{{ section.id }}">{{ 'blocks.contact_form.email' | t }} <span aria-hidden="true">*</span></label>
            <input id="StylingEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | default: customer.email | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="StylingEmailError-{{ section.id }}"{% endif %}>
            {% if form.errors contains 'email' %}<span id="StylingEmailError-{{ section.id }}">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>{% endif %}
          </div>
          <div class="styling-form__field">
            <label for="StylingPhone-{{ section.id }}">{{ 'blocks.contact_form.phone' | t }} {{ section.settings.optional_label | escape }}</label>
            <input id="StylingPhone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone | default: customer.phone | escape }}" autocomplete="tel">
          </div>
          <div class="styling-form__field">
            <label for="StylingInterest-{{ section.id }}">{{ section.settings.interest_label | escape }}</label>
            <select id="StylingInterest-{{ section.id }}" name="contact[Styling interest]">
              <option value="Guidance">{{ section.settings.interest_guidance | escape }}</option>
              <option value="Area rugs">{{ section.settings.interest_rugs | escape }}</option>
              <option value="Art and object placement">{{ section.settings.interest_art | escape }}</option>
              <option value="Home styling">{{ section.settings.interest_home | escape }}</option>
              <option value="Styling for an occasion">{{ section.settings.interest_occasion | escape }}</option>
            </select>
          </div>
          <div class="styling-form__field styling-form__field--full">
            <label for="StylingMessage-{{ section.id }}">{{ section.settings.message_label | escape }} <span aria-hidden="true">*</span></label>
            <textarea id="StylingMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="{{ section.settings.message_placeholder | escape }}" required>{{ form.body | escape }}</textarea>
          </div>
        </div>
        <div class="styling-form__footer">
          <button class="art-button styling-button" type="submit">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></button>
          {% if shop.privacy_policy.url != blank %}<a class="styling-form__privacy" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>{% endif %}
        </div>
      {% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Styling enquiry", "limit": 1, "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR SPACE, YOUR STORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What would you like to bring together?" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Tell us a little about your home, the piece you have in mind, or the occasion you are planning. We can explore the styling possibilities with you." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Already found something at The Raw House? Include its name or link in your enquiry." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send styling enquiry" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Visit the gallery" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Form labels" },
    { "type": "text", "id": "optional_label", "label": "Optional field text", "default": "(optional)" },
    { "type": "text", "id": "required_note", "label": "Required fields note", "default": "Fields marked * are required." },
    { "type": "text", "id": "interest_label", "label": "Interest field label", "default": "What is on your mind?" },
    { "type": "text", "id": "message_label", "label": "Message field label", "default": "Your space or occasion" },
    { "type": "textarea", "id": "message_placeholder", "label": "Message placeholder", "default": "Tell us about your room, a piece you love, or the occasion. You can include dimensions, a date, or links to references." },
    { "type": "text", "id": "interest_guidance", "label": "Guidance option", "default": "I'd like some guidance" },
    { "type": "text", "id": "interest_rugs", "label": "Rugs option", "default": "Area rugs & layers" },
    { "type": "text", "id": "interest_art", "label": "Art option", "default": "Art & object placement" },
    { "type": "text", "id": "interest_home", "label": "Home option", "default": "Home styling" },
    { "type": "text", "id": "interest_occasion", "label": "Occasion option", "default": "Styling for an occasion" }
  ],
  "presets": [{ "name": "Styling enquiry" }]
}
{% endschema %}
