{%- comment -%}
  Renders the editorial "THE RECOMMENDATIONS" 2-column feature section.
  Left Column: Curated Design Edits
  Right Column: Artist Journals & Interviews
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign subheading = section.settings.subheading | default: 'the'
  assign heading = section.settings.heading | default: 'R E C O M M E N D A T I O N S'
  assign show_underline = section.settings.show_underline
  assign gap = section.settings.gap | default: 36
  assign max_width = section.settings.max_width | default: 1080
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 72
  assign enable_hover_zoom = section.settings.enable_hover_zoom

  assign card_1_title = section.settings.card_1_title | default: 'SEASON OF THE SUN'
  assign card_1_img = section.settings.card_1_image
  assign card_1_text = section.settings.card_1_text | default: "The art of leisure finds its rhythm in the sweetness of summer. Rugs gather the day's warmth, linens fall easy, and every corner feels more open, less hurried."
  assign card_1_link = section.settings.card_1_link | default: '/collections/all'
  assign card_1_btn_text = section.settings.card_1_btn_text | default: 'SHOP THIS EDIT'

  assign card_2_title = section.settings.card_2_title | default: 'ARTIST IN RESIDENCE WITH BETTINA KRIEG'
  assign card_2_img = section.settings.card_2_image
  assign card_2_text = section.settings.card_2_text | default: 'In conversation with The House of Things, German artist Bettina Krieg reflects on rhythm in drawing, time, and the tension that defines her art.'
  assign card_2_link = section.settings.card_2_link | default: '/blogs/news'
  assign card_2_btn_text = section.settings.card_2_btn_text | default: 'READ THIS JOURNAL'

  assign card_3_title = section.settings.card_3_title | default: 'THE ART OF FINE LIVING'
  assign card_3_img = section.settings.card_3_image
  assign card_3_text = section.settings.card_3_text | default: 'Built over time and inspired by authenticity, this edit embraces the beauty of layered living - brought to life through thoughtfully curated furniture, art, and accessories.'
  assign card_3_link = section.settings.card_3_link | default: '/collections/all'
  assign card_3_btn_text = section.settings.card_3_btn_text | default: 'SHOP THIS EDIT'

  assign card_4_title = section.settings.card_4_title | default: 'A LIFE, COLLECTED WITH EINA AHLUWALIA'
  assign card_4_img = section.settings.card_4_image
  assign card_4_text = section.settings.card_4_text | default: "Step inside modern-day collector Eina Ahluwalia's space graced with memorable finds and antiques, and discover what makes her collect."
  assign card_4_link = section.settings.card_4_link | default: '/blogs/news'
  assign card_4_btn_text = section.settings.card_4_btn_text | default: 'READ THIS JOURNAL'

  assign left_col_btn_label = section.settings.left_col_btn_label | default: 'VIEW ALL EDITS'
  assign left_col_btn_link = section.settings.left_col_btn_link | default: '/collections/all'

  assign right_col_btn_label = section.settings.right_col_btn_label | default: 'VIEW ALL JOURNAL'
  assign right_col_btn_link = section.settings.right_col_btn_link | default: '/blogs/news'
%}

<div
  id="Recommendations-{{ section_id }}"
  class="recommendations-editorial section-{{ section_id }}"
  style="
    --rec-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --rec-heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --rec-max-width: {{ max_width }}px;
    --rec-gap: {{ gap }}px;
    --rec-padding-top: {{ padding_top }}px;
    --rec-padding-bottom: {{ padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="recommendations-editorial__container">
    
    {%- comment -%} Header Title with Script Subheading & Underline {%- endcomment -%}
    <div class="recommendations-editorial__header">
      {% if subheading != blank %}
        <span class="recommendations-editorial__subheading">{{ subheading }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2 class="recommendations-editorial__heading">{{ heading }}</h2>
      {% endif %}
      {% if show_underline %}
        <div class="recommendations-editorial__underline" aria-hidden="true"></div>
      {% endif %}
    </div>

    {%- comment -%} 2-Column Editorial Grid with Unified Rows {%- endcomment -%}
    <div class="recommendations-editorial__grid">
      
      <!-- ROW 1 - LEFT: Card 1 (Season of the Sun) -->
      <article class="recommendations-editorial__card">
        {% if card_1_title != blank %}
          <h3 class="recommendations-editorial__card-title">{{ card_1_title }}</h3>
        {% endif %}

        <div class="recommendations-editorial__media-wrap{% if enable_hover_zoom %} recommendations-editorial__media--zoom{% endif %}">
          <a href="{{ card_1_link }}" class="recommendations-editorial__media-link" aria-label="{{ card_1_title | escape }}">
            {% if card_1_img != blank %}
              {{ card_1_img | image_url: width: 1200 | image_tag: class: 'recommendations-editorial__img', loading: 'lazy', alt: card_1_title }}
            {% else %}
              <img src="{{ 'recommendation-1.jpg' | asset_url }}" alt="{{ card_1_title | escape }}" class="recommendations-editorial__img" loading="eager" width="1200" height="750">
            {% endif %}
          </a>
        </div>

        {% if card_1_text != blank %}
          <p class="recommendations-editorial__card-desc">{{ card_1_text }}</p>
        {% endif %}

        {% if card_1_btn_text != blank %}
          <div class="recommendations-editorial__card-action">
            <a href="{{ card_1_link }}" class="recommendations-editorial__card-cta">
              {{ card_1_btn_text }}
            </a>
          </div>
        {% endif %}
      </article>

      <!-- ROW 1 - RIGHT: Card 2 (Artist in Residence) -->
      <article class="recommendations-editorial__card">
        {% if card_2_title != blank %}
          <h3 class="recommendations-editorial__card-title">{{ card_2_title }}</h3>
        {% endif %}

        <div class="recommendations-editorial__media-wrap{% if enable_hover_zoom %} recommendations-editorial__media--zoom{% endif %}">
          <a href="{{ card_2_link }}" class="recommendations-editorial__media-link" aria-label="{{ card_2_title | escape }}">
            {% if card_2_img != blank %}
              {{ card_2_img | image_url: width: 1200 | image_tag: class: 'recommendations-editorial__img', loading: 'lazy', alt: card_2_title }}
            {% else %}
              <img src="{{ 'recommendation-2.jpg' | asset_url }}" alt="{{ card_2_title | escape }}" class="recommendations-editorial__img" loading="eager" width="1200" height="750">
            {% endif %}
          </a>
        </div>

        {% if card_2_text != blank %}
          <p class="recommendations-editorial__card-desc">{{ card_2_text }}</p>
        {% endif %}

        {% if card_2_btn_text != blank %}
          <div class="recommendations-editorial__card-action">
            <a href="{{ card_2_link }}" class="recommendations-editorial__card-cta">
              {{ card_2_btn_text }}
            </a>
          </div>
        {% endif %}
      </article>

      <!-- ROW 2 - LEFT: Card 3 (The Art of Fine Living) -->
      <article class="recommendations-editorial__card">
        {% if card_3_title != blank %}
          <h3 class="recommendations-editorial__card-title">{{ card_3_title }}</h3>
        {% endif %}

        <div class="recommendations-editorial__media-wrap{% if enable_hover_zoom %} recommendations-editorial__media--zoom{% endif %}">
          <a href="{{ card_3_link }}" class="recommendations-editorial__media-link" aria-label="{{ card_3_title | escape }}">
            {% if card_3_img != blank %}
              {{ card_3_img | image_url: width: 1200 | image_tag: class: 'recommendations-editorial__img', loading: 'lazy', alt: card_3_title }}
            {% else %}
              <img src="{{ 'recommendation-3.jpg' | asset_url }}" alt="{{ card_3_title | escape }}" class="recommendations-editorial__img" loading="eager" width="1200" height="750">
            {% endif %}
          </a>
        </div>

        {% if card_3_text != blank %}
          <p class="recommendations-editorial__card-desc">{{ card_3_text }}</p>
        {% endif %}

        {% if card_3_btn_text != blank %}
          <div class="recommendations-editorial__card-action">
            <a href="{{ card_3_link }}" class="recommendations-editorial__card-cta">
              {{ card_3_btn_text }}
            </a>
          </div>
        {% endif %}
      </article>

      <!-- ROW 2 - RIGHT: Card 4 (A Life, Collected) -->
      <article class="recommendations-editorial__card">
        {% if card_4_title != blank %}
          <h3 class="recommendations-editorial__card-title">{{ card_4_title }}</h3>
        {% endif %}

        <div class="recommendations-editorial__media-wrap{% if enable_hover_zoom %} recommendations-editorial__media--zoom{% endif %}">
          <a href="{{ card_4_link }}" class="recommendations-editorial__media-link" aria-label="{{ card_4_title | escape }}">
            {% if card_4_img != blank %}
              {{ card_4_img | image_url: width: 1200 | image_tag: class: 'recommendations-editorial__img', loading: 'lazy', alt: card_4_title }}
            {% else %}
              <img src="{{ 'recommendation-4.jpg' | asset_url }}" alt="{{ card_4_title | escape }}" class="recommendations-editorial__img" loading="eager" width="1200" height="750">
            {% endif %}
          </a>
        </div>

        {% if card_4_text != blank %}
          <p class="recommendations-editorial__card-desc">{{ card_4_text }}</p>
        {% endif %}

        {% if card_4_btn_text != blank %}
          <div class="recommendations-editorial__card-action">
            <a href="{{ card_4_link }}" class="recommendations-editorial__card-cta">
              {{ card_4_btn_text }}
            </a>
          </div>
        {% endif %}
      </article>

      <!-- ROW 3 - LEFT: Button View All Edits -->
      <div class="recommendations-editorial__col-footer">
        {% if left_col_btn_label != blank %}
          <a href="{{ left_col_btn_link }}" class="recommendations-editorial__solid-btn">
            {{ left_col_btn_label }}
          </a>
        {% endif %}
      </div>

      <!-- ROW 3 - RIGHT: Button View All Journal -->
      <div class="recommendations-editorial__col-footer">
        {% if right_col_btn_label != blank %}
          <a href="{{ right_col_btn_link }}" class="recommendations-editorial__solid-btn">
            {{ right_col_btn_label }}
          </a>
        {% endif %}
      </div>

    </div>

  </div>
</div>

{% stylesheet %}
  .recommendations-editorial {
    background-color: var(--rec-bg, #ffffff);
    width: 100%;
    padding-block-start: var(--rec-padding-top, 60px);
    padding-block-end: var(--rec-padding-bottom, 72px);
    box-sizing: border-box;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .recommendations-editorial__container {
    max-width: var(--rec-max-width, 1080px);
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  /* Header Section */
  .recommendations-editorial__header {
    text-align: center;
    margin-block-end: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .recommendations-editorial__subheading {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 14.5px;
    color: var(--rec-heading-color, #111111);
    margin-bottom: 2px;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  .recommendations-editorial__heading {
    font-size: 19px;
    letter-spacing: 0.32em;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--rec-heading-color, #111111);
    margin: 0;
    line-height: 1.2;
  }

  .recommendations-editorial__underline {
    width: 40px;
    height: 1.5px;
    background-color: var(--rec-heading-color, #111111);
    margin-top: 8px;
  }

  /* 2-Column Unified Grid */
  .recommendations-editorial__grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 32px;
    column-gap: var(--rec-gap, 48px);
    width: 100%;
    align-items: stretch;
  }

  @media screen and (min-width: 768px) {
    .recommendations-editorial__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 48px;
    }
  }

  /* Card Styles */
  .recommendations-editorial__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    height: 100%;
  }

  .recommendations-editorial__card-title {
    font-size: 13.5px;
    letter-spacing: 0.22em;
    font-weight: 500;
    text-transform: uppercase;
    color: #111111;
    margin: 0 0 16px 0;
    line-height: 1.35;
    text-align: center;
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recommendations-editorial__media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10.5;
    overflow: hidden;
    background-color: #f5f5f5;
    margin-bottom: 18px;
  }

  .recommendations-editorial__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .recommendations-editorial__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .recommendations-editorial__media--zoom:hover .recommendations-editorial__img {
    transform: scale(1.04);
  }

  .recommendations-editorial__card-desc {
    font-size: 12px;
    line-height: 1.6;
    color: #555555;
    max-width: 440px;
    margin: 0 0 14px 0;
    font-weight: 400;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .recommendations-editorial__card-action {
    margin-top: auto;
    padding-top: 4px;
  }

  .recommendations-editorial__card-cta {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease, color 0.2s ease;
    display: inline-block;
  }

  .recommendations-editorial__card-cta:hover {
    opacity: 0.7;
  }

  /* Column Bottom Solid Button */
  .recommendations-editorial__col-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: -12px;
    width: 100%;
  }

  .recommendations-editorial__solid-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #242b33;
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 13px 28px;
    min-width: 180px;
    box-sizing: border-box;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }

  .recommendations-editorial__solid-btn:hover {
    background-color: #0f141a;
    color: #ffffff;
    transform: translateY(-1px);
  }
{% endstylesheet %}

