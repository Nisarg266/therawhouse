{%- comment -%}
  THE RAW HOUSE — EDITORIAL RECOMMENDATIONS (LUXP design system)
  Editorial card blocks: image with desktop/mobile variants, title, text,
  badge and a text button. Fully configurable grid — no hover effects.

  @module recommendations-editorial
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign ratio_css = '4 / 5'
  if s.image_ratio == '1/1'
    assign ratio_css = '1 / 1'
  elsif s.image_ratio == '3/4'
    assign ratio_css = '3 / 4'
  elsif s.image_ratio == '4/3'
    assign ratio_css = '4 / 3'
  elsif s.image_ratio == '16/10'
    assign ratio_css = '16 / 10'
  endif

  assign card_border = s.card_border_color
  if card_border == blank or card_border == 'rgba(0,0,0,0)'
    assign card_border = 'var(--luxp-border)'
  endif

  assign header_track = 'center'
  if s.header_align == 'left'
    assign header_track = 'flex-start'
  endif
-%}

{%- capture luxp_colors -%}
  {%- render 'luxp-scheme',
    preset: s.color_preset,
    bg: s.color_bg,
    heading: s.color_heading,
    text: s.color_text,
    accent: s.color_accent,
    muted: s.color_muted,
    border: s.color_border
  -%}
{%- endcapture -%}

{%- capture luxp_typo -%}{%- render 'luxp-typo', s: s -%}{%- endcapture -%}

<style>
  .section-luxp-editorial,
  #shopify-section-{{ section.id }} {
    background-color: {{ s.color_bg | default: '#ffffff' }};
  }

  .section-luxp-editorial .luxp-editorial,
  #shopify-section-{{ section.id }} .luxp-editorial {
    padding-top: {{ s.padding_top | default: 64 }}px;
    padding-bottom: {{ s.padding_bottom | default: 80 }}px;
  }

  @media screen and (max-width: 749px) {
    .section-luxp-editorial .luxp-editorial,
    #shopify-section-{{ section.id }} .luxp-editorial {
      padding-top: {{ s.padding_top_m | default: 40 }}px;
      padding-bottom: {{ s.padding_bottom_m | default: 48 }}px;
    }
  }

  .section-luxp-editorial .luxp-container,
  #shopify-section-{{ section.id }} .luxp-container {
    max-width: {{ s.container_max | default: 1220 }}px;
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(12px, 3.5vw, 40px);
    padding-right: clamp(12px, 3.5vw, 40px);
    box-sizing: border-box;
  }

  .section-luxp-editorial .luxp-header,
  #shopify-section-{{ section.id }} .luxp-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(24px, 4vw, 44px);
    gap: 0;
  }

  .section-luxp-editorial .luxp-eyebrow,
  #shopify-section-{{ section.id }} .luxp-eyebrow {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: clamp(10px, 0.9vw, 11px);
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: {{ s.color_accent | default: '#a98344' }};
    margin: 0 0 6px 0;
    line-height: 1.2;
  }

  .section-luxp-editorial .luxp-heading,
  #shopify-section-{{ section.id }} .luxp-heading {
    font-family: var(--font-heading--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, serif);
    font-size: clamp(14px, 2vw, 22px);
    font-weight: 400;
    letter-spacing: clamp(0.18em, 1.8vw, 0.35em);
    text-transform: uppercase;
    color: {{ s.color_heading | default: '#1a1a1a' }};
    margin: 0 0 8px 0;
    line-height: 1.25;
  }

  .section-luxp-editorial .luxp-ornament,
  #shopify-section-{{ section.id }} .luxp-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: clamp(90px, 12vw, 120px);
    margin: 2px auto 0;
  }

  .section-luxp-editorial .luxp-ornament__line,
  #shopify-section-{{ section.id }} .luxp-ornament__line {
    flex: 1;
    height: 1px;
    background-color: {{ s.color_accent | default: '#a98344' }};
  }

  .section-luxp-editorial .luxp-ornament__gem,
  #shopify-section-{{ section.id }} .luxp-ornament__gem {
    color: {{ s.color_accent | default: '#a98344' }};
    font-size: 7px;
    line-height: 1;
    display: inline-block;
  }

  .section-luxp-editorial .luxp-grid,
  #shopify-section-{{ section.id }} .luxp-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    column-gap: clamp(12px, 3.2vw, 44px) !important;
    row-gap: clamp(24px, 4.5vw, 60px) !important;
    width: 100% !important;
  }

  @media screen and (max-width: 639px) {
    .section-luxp-editorial .luxp-grid,
    #shopify-section-{{ section.id }} .luxp-grid {
      {% if s.columns_mobile == '1' %}
        grid-template-columns: 1fr !important;
        row-gap: 36px !important;
      {% else %}
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        column-gap: 12px !important;
        row-gap: 24px !important;
      {% endif %}
    }
  }

  .section-luxp-editorial .luxp-card,
  #shopify-section-{{ section.id }} .luxp-card {
    display: flex !important;
    flex-direction: column !important;
    text-decoration: none !important;
    color: inherit !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    overflow: visible !important;
  }

  .section-luxp-editorial .luxp-media,
  #shopify-section-{{ section.id }} .luxp-media {
    position: relative !important;
    display: block !important;
    width: 100% !important;
    aspect-ratio: {{ ratio_css }} !important;
    overflow: hidden !important;
    border-radius: 0 !important;
    background-color: #f4f1eb !important;
  }

  .section-luxp-editorial .luxp-media img,
  #shopify-section-{{ section.id }} .luxp-media img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    border-radius: 0 !important;
    display: block !important;
    transition: opacity 0.3s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .section-luxp-editorial .luxp-card:hover .luxp-media img,
  #shopify-section-{{ section.id }} .luxp-card:hover .luxp-media img {
    opacity: 0.96 !important;
    transform: scale(1.02) !important;
  }

  .section-luxp-editorial .luxp-editcard__body,
  #shopify-section-{{ section.id }} .luxp-editcard__body {
    padding-top: clamp(10px, 1.6vw, 18px) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    text-align: left !important;
    gap: 0 !important;
  }

  .section-luxp-editorial .luxp-editcard__title,
  #shopify-section-{{ section.id }} .luxp-editcard__title {
    font-family: var(--font-heading--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: clamp(12px, 1.25vw, 15.5px) !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: #1f2224 !important;
    margin: 0 0 clamp(4px, 0.8vw, 8px) 0 !important;
  }

  .section-luxp-editorial .luxp-editcard__curator,
  #shopify-section-{{ section.id }} .luxp-editcard__curator {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: clamp(10px, 0.9vw, 11px) !important;
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: {{ s.color_accent | default: '#a98344' }} !important;
    margin: 0 0 4px 0 !important;
  }

  .section-luxp-editorial .luxp-editcard__text,
  #shopify-section-{{ section.id }} .luxp-editcard__text {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: clamp(10.5px, 1.05vw, 13px) !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
    letter-spacing: 0.01em !important;
    color: #6e7377 !important;
    margin: 0 0 clamp(6px, 1vw, 12px) 0 !important;
    -webkit-font-smoothing: antialiased !important;
  }

  .section-luxp-editorial .luxp-card__cta,
  #shopify-section-{{ section.id }} .luxp-card__cta {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: clamp(9.5px, 0.95vw, 11.5px) !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: {{ s.color_accent | default: '#a98344' }} !important;
    margin-top: 2px !important;
    text-decoration: none !important;
    transition: color 0.25s ease !important;
  }

  .section-luxp-editorial .luxp-card__cta-arrow,
  #shopify-section-{{ section.id }} .luxp-card__cta-arrow {
    display: inline-block !important;
    font-size: 1.15em !important;
    line-height: 1 !important;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .section-luxp-editorial .luxp-card:hover .luxp-card__cta-arrow,
  #shopify-section-{{ section.id }} .luxp-card:hover .luxp-card__cta-arrow {
    transform: translateX(4px) !important;
  }

  /* ============================================================
     SPLIT LAYOUT — sticky heading rail (left) + stacked card deck (right).
     Each card pins below the previous one; the next card slides up OVER it
     (previous recedes behind), and after the last card the section scrolls away.
     ============================================================ */
  #shopify-section-{{ section.id }} {
    --split-rail-top: clamp(145px, 16.5vh, 175px);
    --deck-offset: 16px;
  }

  #shopify-section-{{ section.id }} .luxp-split {
    display: grid;
    grid-template-columns: minmax(300px, 1.15fr) minmax(0, 1.85fr);
    gap: clamp(28px, 4vw, 56px);
    width: 100%;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .luxp-split__aside {
    align-self: stretch;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .luxp-split__sticky {
    position: sticky;
    top: var(--split-rail-top);
    padding-top: clamp(8px, 1vh, 14px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    max-width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .luxp-split__eyebrow {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-style: normal !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: {{ s.color_accent | default: '#a98344' }} !important;
    margin: 0 0 8px 0 !important;
    line-height: 1.2 !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__heading {
    font-size: clamp(20px, 2vw, 26px) !important;
    letter-spacing: clamp(0.16em, 0.24vw, 0.28em) !important;
    font-weight: 500 !important;
    text-align: left !important;
    margin: 0 0 14px 0 !important;
    max-width: 100% !important;
    overflow-wrap: break-word !important;
    word-break: normal !important;
    line-height: 1.3 !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__sticky .luxp-ornament {
    width: 120px;
    margin: 2px 0 0 0;
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .luxp-split__intro {
    margin-top: 16px;
    max-width: 40ch;
    font-size: clamp(14.5px, 1.15vw, 16px);
    line-height: 1.75;
    color: #555149;
    letter-spacing: 0.01em;
  }

  #shopify-section-{{ section.id }} .luxp-split__intro-mobile {
    display: none !important;
  }

  /* Rail footer: edit index (mini table of contents) + collection link */
  #shopify-section-{{ section.id }} .luxp-split__railfoot {
    margin-top: clamp(22px, 2.4vw, 30px);
    padding-top: clamp(16px, 1.8vw, 22px);
    border-top: 1px solid #e9e3d7;
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-label {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    letter-spacing: 0.3em !important;
    text-transform: uppercase !important;
    color: {{ s.color_accent | default: '#a98344' }} !important;
    margin: 0 0 4px 0 !important;
    line-height: 1.4 !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-item {
    display: flex !important;
    align-items: baseline !important;
    gap: 12px !important;
    width: 100% !important;
    box-sizing: border-box !important;
    padding: 8px 0 !important;
    border-bottom: 1px solid #f0ebdf !important;
    text-decoration: none !important;
    color: inherit !important;
    transition: padding-left 0.25s ease !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-item:last-of-type {
    border-bottom: none !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-item:hover {
    padding-left: 6px !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-dot {
    flex: none !important;
    align-self: center !important;
    width: 5px !important;
    height: 5px !important;
    border-radius: 50% !important;
    background-color: #d8d1c2 !important;
    transition: background-color 0.25s ease, transform 0.25s ease !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-item:hover .luxp-split__toc-dot,
  #shopify-section-{{ section.id }} .luxp-split__toc-item.is-active .luxp-split__toc-dot {
    background-color: {{ s.color_accent | default: '#a98344' }} !important;
    transform: scale(1.35) !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-title {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: #57534a !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    transition: color 0.25s ease !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-item:hover .luxp-split__toc-title {
    color: #1a1a1a !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__toc-item.is-active .luxp-split__toc-title {
    color: {{ s.color_accent | default: '#a98344' }} !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__curation-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(26, 26, 26, 0.4);
    transition: color 0.25s ease, border-color 0.25s ease, gap 0.25s ease;
  }

  #shopify-section-{{ section.id }} .luxp-split__curation-link:hover {
    color: {{ s.color_accent | default: '#a98344' }};
    border-bottom-color: {{ s.color_accent | default: '#a98344' }};
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .luxp-split__curation-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.25s ease;
  }

  #shopify-section-{{ section.id }} .luxp-split__curation-link:hover svg {
    transform: translateX(3px);
  }

  #shopify-section-{{ section.id }} .luxp-split__cards {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.2vw, 32px);
    width: 100%;
    min-width: 0;
    position: relative;
  }

  /* Split layout card: gallery-frame look — black hairline border, white mat,
     black-bordered image with the title overlaid on a soft dark scrim */
  #shopify-section-{{ section.id }} .luxp-split__card {
    position: sticky;
    top: calc(var(--split-rail-top) + var(--card-i, 0) * var(--deck-offset));
    z-index: calc(1 + var(--card-i, 0));
    background: #ffffff !important;
    border: 1px solid #16130e !important;
    border-radius: 0 !important;
    padding: clamp(10px, 1.1vw, 14px) !important;
    box-shadow: 0 18px 44px -12px rgba(24, 18, 8, 0.14), 0 3px 12px rgba(0, 0, 0, 0.04) !important;
    overflow: hidden !important;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.6s ease;
    will-change: transform, filter, opacity;
  }

  /* Covered card recedes behind the one stacked over it with smooth blur and dimming */
  #shopify-section-{{ section.id }} .luxp-split__card.is-covered {
    transform: scale(0.96) translateY(8px);
    filter: blur(5px) brightness(0.88) saturate(0.92) !important;
    opacity: 0.65 !important;
    box-shadow: 0 8px 20px rgba(24, 18, 8, 0.05) !important;
    pointer-events: none;
  }

  /* Media container: black-bordered image with subtle zoom on card hover */
  #shopify-section-{{ section.id }} .luxp-split__card .luxp-media {
    aspect-ratio: 16 / 10.5 !important;
    background-color: #f7f5f0 !important;
    border: 1px solid #16130e !important;
    overflow: hidden !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__card:hover .luxp-media img {
    transform: scale(1.025) !important;
  }

  /* Card body overlays the image — anchored to the bottom over a dark scrim */
  #shopify-section-{{ section.id }} .luxp-split__card .luxp-editcard__body {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    z-index: 2 !important;
    padding: clamp(64px, 7vw, 96px) clamp(18px, 2.4vw, 32px) clamp(18px, 2vw, 26px) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    text-align: left !important;
    gap: 0 !important;
    background: linear-gradient(to bottom, rgba(12, 9, 5, 0) 0%, rgba(12, 9, 5, 0.42) 45%, rgba(12, 9, 5, 0.8) 100%) !important;
  }

  /* Card title */
  #shopify-section-{{ section.id }} .luxp-split__card .luxp-editcard__title {
    font-family: var(--font-heading--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: clamp(18px, 1.6vw, 22px) !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    color: #f8f4ea !important;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4) !important;
    margin: 0 0 clamp(8px, 1vw, 12px) 0 !important;
  }

  /* Card descriptive text */
  #shopify-section-{{ section.id }} .luxp-split__card .luxp-editcard__text {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: clamp(13.5px, 1.1vw, 15px) !important;
    font-weight: 400 !important;
    line-height: 1.7 !important;
    letter-spacing: 0.01em !important;
    color: rgba(255, 255, 255, 0.84) !important;
    margin: 0 0 clamp(12px, 1.2vw, 18px) 0 !important;
    max-width: 62ch !important;
    -webkit-font-smoothing: antialiased !important;
  }

  /* Card CTA link */
  #shopify-section-{{ section.id }} .luxp-split__card .luxp-card__cta {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: #f4efe4 !important;
    margin-top: 2px !important;
    padding-bottom: 4px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4) !important;
    text-decoration: none !important;
    transition: border-color 0.25s ease, color 0.25s ease, gap 0.25s ease !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__card:hover .luxp-card__cta {
    border-bottom-color: {{ s.color_accent | default: '#a98344' }} !important;
    gap: 12px !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__card .luxp-card__cta-arrow {
    display: inline-flex !important;
    align-items: center !important;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  #shopify-section-{{ section.id }} .luxp-split__card:hover .luxp-card__cta-arrow {
    transform: translateX(4px) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .luxp-split__card {
      transition: none !important;
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --split-rail-top: 0px;
      --deck-offset: 0px;
    }

    #shopify-section-{{ section.id }} .luxp-split {
      display: block !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__railfoot {
      display: flex !important;
      align-items: center !important;
      margin: 14px auto 0 !important;
      padding-top: 0 !important;
      border-top: none !important;
      max-width: 320px !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__toc {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__intro-desktop {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__intro-mobile {
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__sticky {
      position: static !important;
      align-items: center !important;
      text-align: center !important;
      margin-bottom: 28px !important;
      padding-top: 0 !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__eyebrow {
      font-size: 11.5px !important;
      letter-spacing: 0.22em !important;
      text-transform: uppercase !important;
      font-style: normal !important;
      color: {{ s.color_accent | default: '#a98344' }} !important;
      margin-bottom: 6px !important;
      line-height: 1.2 !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__heading {
      font-size: clamp(18px, 4.8vw, 24px) !important;
      letter-spacing: clamp(0.14em, 0.22vw, 0.26em) !important;
      text-align: center !important;
      margin-bottom: 8px !important;
      max-width: 100% !important;
      overflow-wrap: break-word !important;
      line-height: 1.25 !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__sticky .luxp-ornament {
      justify-content: center !important;
      margin-inline: auto !important;
      width: 90px !important;
      margin-bottom: 12px !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__intro {
      margin: 0 auto !important;
      text-align: center !important;
      max-width: 44ch !important;
      font-size: 13.5px !important;
      line-height: 1.68 !important;
      color: #635f58 !important;
      letter-spacing: 0.01em !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__cards {
      display: flex !important;
      flex-direction: column !important;
      gap: 0 !important;
      width: 100% !important;
      position: relative !important;
    }

    /* Elegant hardware-accelerated mobile card deck stacking animation */
    #shopify-section-{{ section.id }} .luxp-split__card {
      position: sticky !important;
      top: clamp(68px, 9.5vh, 82px) !important;
      z-index: calc(1 + var(--card-i, 0)) !important;
      margin-bottom: clamp(28px, 5.5vh, 44px) !important;
      background: #ffffff !important;
      border: 1px solid #16130e !important;
      border-radius: 0 !important;
      box-shadow: 0 12px 32px -8px rgba(24, 18, 8, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04) !important;
      overflow: hidden !important;
      transition:
        transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
        filter 0.45s cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 0.45s ease !important;
      will-change: transform, opacity;
      pointer-events: auto !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__card:last-child {
      margin-bottom: 0 !important;
    }

    /* Covered card recedes backward smoothly with subtle depth and clean contrast (no heavy blur) */
    #shopify-section-{{ section.id }} .luxp-split__card.is-covered {
      transform: scale(0.95) translateY(-8px) !important;
      opacity: 0.58 !important;
      filter: brightness(0.9) !important;
      box-shadow: 0 4px 14px rgba(24, 18, 8, 0.05) !important;
      pointer-events: none !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__card .luxp-media {
      aspect-ratio: 16 / 10.5 !important;
      overflow: hidden !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__card:active .luxp-media img {
      transform: scale(1.02) !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__card .luxp-editcard__body {
      padding: clamp(52px, 10vw, 72px) clamp(16px, 4vw, 24px) clamp(16px, 4vw, 22px) !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__card .luxp-editcard__title {
      font-size: clamp(16px, 4.2vw, 19px) !important;
      margin-bottom: 8px !important;
      line-height: 1.3 !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__card .luxp-editcard__text {
      font-size: clamp(12.5px, 3.2vw, 14px) !important;
      line-height: 1.6 !important;
      margin-bottom: 14px !important;
    }

    #shopify-section-{{ section.id }} .luxp-split__card:active .luxp-card__cta-arrow {
      transform: translateX(4px) !important;
    }
  }
</style>

<div
  class="luxp-section luxp-editorial {% if s.container_mode == 'full' %}luxp-section--full{% endif %} {% if s.enable_animations %}luxp-anim{% endif %} {{ s.custom_class }}"
  style="
    {{ luxp_colors }}
    {{ luxp_typo }}
    --luxp-pt: {{ s.padding_top | default: 64 }}px;
    --luxp-pb: {{ s.padding_bottom | default: 80 }}px;
    --luxp-pt-m: {{ s.padding_top_m | default: 44 }}px;
    --luxp-pb-m: {{ s.padding_bottom_m | default: 52 }}px;
    --luxp-cw: {{ s.container_max | default: 1220 }}px;
    --luxp-px: {{ s.container_padding | default: 32 }}px;
    --luxp-px-m: {{ s.container_padding_m | default: 16 }}px;
    --luxp-header-track: {{ header_track }};
    --luxp-header-align: {{ s.header_align | default: 'center' }};
    --luxp-header-gap: {{ s.header_gap | default: 10 }}px;
    --luxp-header-mb: {{ s.header_mb | default: 32 }}px;
    --luxp-cols: {{ s.columns | default: 2 }};
    --luxp-cols-t: {{ s.columns_tablet | default: 2 }};
    --luxp-cols-m: {{ s.columns_mobile | default: 1 }};
    --luxp-cgap: {{ s.col_gap | default: 40 }}px;
    --luxp-rgap: {{ s.row_gap | default: 56 }}px;
    --luxp-cgap-m: {{ s.col_gap_m | default: 16 }}px;
    --luxp-rgap-m: {{ s.row_gap_m | default: 36 }}px;
    --luxp-media-ratio: {{ ratio_css }};
    --luxp-media-fit: {{ s.image_fit | default: 'cover' }};
    --luxp-media-radius: 0px;
    --luxp-media-bg: var(--luxp-border);
    --luxp-card-bg: transparent;
    --luxp-card-border: var(--luxp-border);
    --luxp-card-bw: 0px;
    --luxp-card-radius: 0px;
    --luxp-card-shadow: none;
    --luxp-card-body-pt: {{ s.card_body_pt | default: 18 }}px;
    --luxp-card-align: {{ s.card_align | default: 'left' }};
    --luxp-card-gap: {{ s.card_gap | default: 8 }}px;
    --luxp-cardtitle-size: {{ s.cardtitle_size | default: 15.5 }}px;
    --luxp-cardtitle-size-m: {{ s.cardtitle_size_m | default: 14 }}px;
    --luxp-cardmeta-size: {{ s.cardtext_size | default: 13 }}px;
    --luxp-card-cta-color: var(--luxp-accent);
    --luxp-pill-bg: var(--luxp-accent);
    --luxp-pill-fg: #ffffff;
    --luxp-footer-mt: {{ s.footer_mt | default: 36 }}px;
  "
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  data-art-motion="off"
  {{ section.shopify_attributes }}
>
  <div class="luxp-container">
    {% assign current_layout = s.layout_style | default: 'split' %}
    {% if current_layout == 'split' %}

      {%- comment -%} Split layout: static heading rail (left) + scrolling cards (right) {%- endcomment -%}
      <div class="luxp-split">
        <aside class="luxp-split__aside">
          <div class="luxp-split__sticky">
            {% if s.eyebrow != blank %}
              <p class="luxp-eyebrow luxp-split__eyebrow">{{ s.eyebrow | default: 'THE' | upcase }}</p>
            {% endif %}
            {% if s.heading != blank %}
              {%- assign clean_heading = s.heading -%}
              {%- if clean_heading == 'R E C O M M E N D A T I O N S' -%}
                {%- assign clean_heading = 'RECOMMENDATIONS' -%}
              {%- endif -%}
              <h2 class="luxp-heading luxp-split__heading">{{ clean_heading }}</h2>
            {% endif %}
            {% if s.show_ornament %}
              <div class="luxp-ornament" aria-hidden="true">
                <span class="luxp-ornament__line"></span>
                <span class="luxp-ornament__gem">&#9670;</span>
                <span class="luxp-ornament__line"></span>
              </div>
            {% endif %}
            <div class="luxp-body luxp-split__intro">
              <div class="luxp-split__intro-desktop">
                {% if s.intro != blank %}
                  {{ s.intro }}
                {% else %}
                  <p>Furniture and objects made by hand in small workshops across India — wood, stone, brass, and cane. We add to this edit slowly; a piece has to earn its place.</p>
                {% endif %}
              </div>
              <p class="luxp-split__intro-mobile">
                {%- if s.intro != blank -%}
                  {{ s.intro | strip_html }}
                {%- else -%}
                  Furniture and objects made by hand in small workshops across India.
                {%- endif -%}
              </p>
            </div>

            <div class="luxp-split__railfoot">
              {% if section.blocks.size > 0 %}
                <nav class="luxp-split__toc" aria-label="{{ s.toc_label | default: 'In this edit' }}">
                  <p class="luxp-split__toc-label">{{ s.toc_label | default: 'In this edit' }}</p>
                  {% for block in section.blocks %}
                    <a
                      href="#{{ section.id }}-card-{{ forloop.index0 }}"
                      class="luxp-split__toc-item"
                      data-card-index="{{ forloop.index0 }}"
                    >
                      <span class="luxp-split__toc-dot" aria-hidden="true"></span>
                      <span class="luxp-split__toc-title">{{ block.settings.title | default: 'Untitled piece' }}</span>
                    </a>
                  {% endfor %}
                </nav>
              {% endif %}
              <a href="{{ s.rail_link | default: routes.all_products_collection_url }}" class="luxp-split__curation-link">
                <span>{{ s.rail_link_label | default: 'View all pieces' }}</span>
                <svg class="luxp-btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        </aside>

        <div class="luxp-split__cards">
          {% for block in section.blocks %}
            <a
              href="{{ block.settings.link | default: routes.all_products_collection_url }}"
              id="{{ section.id }}-card-{{ forloop.index0 }}"
              class="luxp-card luxp-split__card"
              style="--card-i: {{ forloop.index0 }};"
              {{ block.shopify_attributes }}
            >
              <div class="luxp-media {% if s.image_fit == 'contain' %}luxp-media--contain{% endif %}">
                {% if block.settings.badge != blank %}
                  <span
                    class="luxp-colcard__pill luxp-pill"
                    style="{% if block.settings.badge_bg != blank %}background: {{ block.settings.badge_bg }} !important;{% endif %}{% if block.settings.badge_color != blank %}color: {{ block.settings.badge_color }} !important;{% endif %}"
                  >
                    {{- block.settings.badge -}}
                  </span>
                {% endif %}
                {%- assign editorial_alt = block.settings.title | default: 'Editorial feature' -%}
                {% render 'luxp-image',
                  image: block.settings.image,
                  image_mobile: block.settings.image_mobile,
                  alt: editorial_alt,
                  class: 'luxp-editorial__img',
                  loading: 'lazy',
                  sizes: '(min-width: 1024px) 55vw, 100vw',
                  fallback: block.settings.default_asset
                %}
                <div class="luxp-editcard__body {% if s.card_align == 'center' %}luxp-editcard__body--center{% endif %}">
                  {% if block.settings.curator != blank %}
                    <span class="luxp-editcard__curator">{{ block.settings.curator }}</span>
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <h3 class="luxp-editcard__title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="luxp-editcard__text">{{ block.settings.text }}</p>
                  {% endif %}
                  {% if block.settings.btn_text != blank %}
                    <span class="luxp-card__cta">
                      <span class="luxp-card__cta-label">{{ block.settings.btn_text }}</span>
                      <span class="luxp-card__cta-arrow" aria-hidden="true">
                        {% render 'luxp-icon', icon: 'arrow', class: 'luxp-btn__arrow' %}
                      </span>
                    </span>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>

    {% else %}

      {% if s.eyebrow != blank or s.heading != blank or s.intro != blank or s.show_ornament %}
      <header class="luxp-header luxp-header--{{ s.header_align | default: 'center' }}">
        {% if s.eyebrow != blank %}
          <p class="luxp-eyebrow">{{ s.eyebrow | default: 'THE' | upcase }}</p>
        {% endif %}
        {% if s.heading != blank %}
          <h2 class="luxp-heading">{{ s.heading }}</h2>
        {% endif %}
        {% if s.show_ornament %}
          <div class="luxp-ornament" aria-hidden="true">
            <span class="luxp-ornament__line"></span>
            <span class="luxp-ornament__gem">&#9670;</span>
            <span class="luxp-ornament__line"></span>
          </div>
        {% endif %}
        {% if s.intro != blank %}
          <div class="luxp-body luxp-header__intro">{{ s.intro }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="luxp-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="luxp-card" {{ block.shopify_attributes }}>
          <div class="luxp-media {% if s.image_fit == 'contain' %}luxp-media--contain{% endif %}">
            {% if block.settings.badge != blank %}
              <span
                class="luxp-colcard__pill luxp-pill"
                style="{% if block.settings.badge_bg != blank %}background: {{ block.settings.badge_bg }} !important;{% endif %}{% if block.settings.badge_color != blank %}color: {{ block.settings.badge_color }} !important;{% endif %}"
              >
                {{- block.settings.badge -}}
              </span>
            {% endif %}
            {%- assign editorial_alt = block.settings.title | default: 'Editorial feature' -%}
            {% render 'luxp-image',
              image: block.settings.image,
              image_mobile: block.settings.image_mobile,
              alt: editorial_alt,
              class: 'luxp-editorial__img',
              loading: 'lazy',
              sizes: '(min-width: 1024px) 50vw, 100vw',
              fallback: block.settings.default_asset
            %}
          </div>
          <div class="luxp-editcard__body {% if s.card_align == 'center' %}luxp-editcard__body--center{% endif %}">
            {% if block.settings.curator != blank %}
              <span class="luxp-editcard__curator">{{ block.settings.curator }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="luxp-editcard__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="luxp-editcard__text">{{ block.settings.text }}</p>
            {% endif %}
            {% if block.settings.btn_text != blank %}
              <span class="luxp-card__cta">
                <span class="luxp-card__cta-label">{{ block.settings.btn_text }}</span>
                <span class="luxp-card__cta-arrow" aria-hidden="true">&rarr;</span>
              </span>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
    {% endif %}

    {% if s.btn_label != blank %}
      <div class="luxp-footer">
        <a
          href="{{ s.btn_link | default: routes.all_products_collection_url }}"
          class="luxp-btn {% if s.btn_style == 'outline' %}luxp-btn--outline{% endif %} {% if s.btn_width == 'full' %}luxp-btn--full{% endif %} {% if s.btn_mobile_full %}luxp-btn--mobile-full{% endif %}"
        >
          {{ s.btn_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}') || (document.currentScript ? (document.currentScript.closest('.shopify-section') || document.currentScript.closest('.luxp-editorial')) : null);
    if (!root) return;
    var cards = Array.prototype.slice.call(root.querySelectorAll('.luxp-split__card'));
    if (!cards.length) return;
    var wrap = root.querySelector('.luxp-split__cards');
    var tocItems = Array.prototype.slice.call(root.querySelectorAll('.luxp-split__toc-item'));
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Find the element that actually scrolls: .page-wrapper on desktop,
       the document/window on mobile. */
    function scrollerOf(el) {
      for (var n = el.parentElement; n && n !== document.body; n = n.parentElement) {
        var oy = window.getComputedStyle(n).overflowY;
        if ((oy === 'auto' || oy === 'scroll') && n.scrollHeight > n.clientHeight + 4) return n;
      }
      return window;
    }

    /* Scroll so the card's FLOW position reaches its sticky offset — offsetTop
       is relative to .luxp-split__cards (position: relative), so it is immune
       to the card currently being stuck. */
    function scrollToCard(idx) {
      var card = cards[idx];
      if (!card || !wrap) return;
      var sc = scrollerOf(card);
      var isWin = sc === window;
      var portTop = isWin ? 0 : sc.getBoundingClientRect().top;
      var pos = isWin ? (window.pageYOffset || document.documentElement.scrollTop || 0) : sc.scrollTop;
      var flowTop = wrap.getBoundingClientRect().top - portTop + pos + card.offsetTop;
      var stick = parseFloat(window.getComputedStyle(card).top);
      if (isNaN(stick)) stick = 0;
      var target = Math.max(0, flowTop - stick + 2);
      var opts = { top: target, left: 0, behavior: reduceMotion ? 'auto' : 'smooth' };
      if (isWin) window.scrollTo(opts); else sc.scrollTo(opts);
    }

    for (var t = 0; t < tocItems.length; t++) {
      (function (item) {
        item.addEventListener('click', function (e) {
          e.preventDefault();
          scrollToCard(parseInt(item.getAttribute('data-card-index'), 10) || 0);
        });
      })(tocItems[t]);
    }

    /* Deck behaviour: mark a card as covered the moment the next card's top
       reaches it, so it recedes behind. Works whichever container scrolls
       (window or .page-wrapper) via scroll capture. */
    var ticking = false;
    function update() {
      ticking = false;
      var isMobile = window.innerWidth < 990;
      var threshold = isMobile ? 18 : 26;
      for (var i = 0; i < cards.length - 1; i++) {
        var top = cards[i].getBoundingClientRect().top;
        var nextTop = cards[i + 1].getBoundingClientRect().top;
        cards[i].classList.toggle('is-covered', nextTop <= top + threshold);
      }
      /* Highlight the front-most (first uncovered) card in the rail index */
      var active = cards.length - 1;
      for (var j = 0; j < cards.length; j++) {
        if (!cards[j].classList.contains('is-covered')) { active = j; break; }
      }
      for (var k = 0; k < tocItems.length; k++) {
        tocItems[k].classList.toggle('is-active', k === active);
      }
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true, capture: true });
    window.addEventListener('resize', onScroll, { passive: true });
    document.addEventListener('DOMContentLoaded', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Editorial Recommendations",
  "tag": "section",
  "class": "section-luxp-editorial",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "select", "id": "layout_style", "label": "Layout style", "options": [
      { "value": "split", "label": "Sticky heading + scrolling cards" },
      { "value": "grid", "label": "Classic centered grid" }
    ], "default": "split", "info": "Split: heading stays fixed on left with scrolling stacked cards animation. Grid: centered 2-column luxury editorial collage." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / subheading", "default": "the" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "RECOMMENDATIONS" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "checkbox", "id": "show_ornament", "label": "Show ornament divider", "default": true },
    { "type": "select", "id": "header_align", "label": "Header alignment", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" }
    ], "default": "center" },
    { "type": "range", "id": "header_mb", "min": 8, "max": 72, "step": 2, "unit": "px", "label": "Space below header — desktop", "default": 32 },
    { "type": "range", "id": "header_gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Header element spacing", "default": 10 },

    { "type": "header", "content": "Sticky rail — split layout" },
    { "type": "text", "id": "toc_label", "label": "Index label", "default": "In this edit" },
    { "type": "text", "id": "rail_link_label", "label": "Rail link label", "default": "View all pieces" },
    { "type": "url", "id": "rail_link", "label": "Rail link", "info": "Blank links to the all-products collection." },

    { "type": "header", "content": "Layout — Grid" },
    { "type": "select", "id": "container_mode", "label": "Container mode", "options": [
      { "value": "fixed", "label": "Container (max width)" },
      { "value": "full", "label": "Full width" }
    ], "default": "fixed" },
    { "type": "range", "id": "container_max", "min": 800, "max": 1600, "step": 20, "unit": "px", "label": "Container max width", "default": 1220 },
    { "type": "range", "id": "columns", "min": 1, "max": 4, "step": 1, "label": "Columns — desktop", "default": 2 },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 4, "step": 1, "label": "Columns — tablet", "default": 2 },
    { "type": "select", "id": "columns_mobile", "label": "Columns — mobile", "options": [
      { "value": "1", "label": "1 column" },
      { "value": "2", "label": "2 columns" }
    ], "default": "1" },
    { "type": "range", "id": "col_gap", "min": 8, "max": 64, "step": 2, "unit": "px", "label": "Column gap — desktop", "default": 40 },
    { "type": "range", "id": "row_gap", "min": 8, "max": 80, "step": 2, "unit": "px", "label": "Row gap — desktop", "default": 56 },
    { "type": "range", "id": "col_gap_m", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Column gap — mobile", "default": 16 },
    { "type": "range", "id": "row_gap_m", "min": 8, "max": 56, "step": 2, "unit": "px", "label": "Row gap — mobile", "default": 36 },

    { "type": "header", "content": "Cards" },
    { "type": "select", "id": "image_ratio", "label": "Card image ratio", "options": [
      { "value": "4/5", "label": "Portrait 4:5" },
      { "value": "1/1", "label": "Square 1:1" },
      { "value": "3/4", "label": "Portrait 3:4" },
      { "value": "4/3", "label": "Landscape 4:3" },
      { "value": "16/10", "label": "Wide 16:10" }
    ], "default": "4/5" },
