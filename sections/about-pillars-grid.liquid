<div
  class="about-pillars about-pillars--{{ section.id }}"
  style="
    --pillars-pt: {{ section.settings.padding_top }}px;
    --pillars-pb: {{ section.settings.padding_bottom }}px;
    --pillars-bg: {{ section.settings.bg_color }};
    --pillars-card-bg: {{ section.settings.card_bg_color }};
    --pillars-heading: {{ section.settings.heading_color }};
    --pillars-text: {{ section.settings.text_color }};
    --pillars-accent: {{ section.settings.accent_color }};
  "
>
  <div class="about-pillars__container about-slider-wrapper">
    
    <div class="about-pillars__header" data-about-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <div class="about-pillars__eyebrow-wrap">
          <span class="about-pillars__eyebrow-line"></span>
          <span class="about-pillars__eyebrow">{{ section.settings.eyebrow }}</span>
          <span class="about-pillars__eyebrow-line"></span>
        </div>
      {%- endif -%}

      <h2 class="about-pillars__heading">
        {{ section.settings.heading }}
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="about-pillars__subtitle">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
    </div>

    <div class="about-pillars__grid about-mobile-slider">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="about-pillars__card" data-about-reveal {{ block.shopify_attributes }}>
            <div class="about-pillars__card-top">
              <span class="about-pillars__num">0{{ forloop.index }}</span>
              <div class="about-pillars__icon-wrap">
                {%- case block.settings.icon -%}
                  {%- when 'globe' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                  {%- when 'craft' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                      <polyline points="2 17 12 22 22 17"></polyline>
                      <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                  {%- when 'concierge' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {%- when 'sustainability' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                {%- endcase -%}
              </div>
            </div>

            <h3 class="about-pillars__card-title">{{ block.settings.title }}</h3>
            <p class="about-pillars__card-desc">{{ block.settings.description }}</p>

            <div class="about-pillars__card-line"></div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 4 Luxury Pillars Fallback {%- endcomment -%}
        {% liquid
          assign default_titles = 'CURATION WITHOUT BOUNDARIES,HEIRLOOM CRAFTSMANSHIP,BESPOKE CONCIERGE,SUSTAINED ELEGANCE' | split: ','
          assign default_descs = 'Sourcing across 200+ artisan workshops and international design ateliers with uncompromising discerning standards.,Preserving ancestral artisanal traditions through refined contemporary silhouettes and noble materials.,Dedicated white-glove curation, custom commissions, and private interior architectural advisory for collectors.,Conscious, ethical creation built with longevity in mind—curated to be passed on to future generations.' | split: ','
          assign default_icons = 'globe,craft,concierge,sustainability' | split: ','
        %}
        {% for title in default_titles %}
          <div class="about-pillars__card" data-about-reveal>
            <div class="about-pillars__card-top">
              <span class="about-pillars__num">0{{ forloop.index }}</span>
              <div class="about-pillars__icon-wrap">
                {%- assign icon_type = default_icons[forloop.index0] -%}
                {%- case icon_type -%}
                  {%- when 'globe' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                  {%- when 'craft' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                  {%- when 'concierge' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {%- when 'sustainability' -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {%- endcase -%}
              </div>
            </div>
            <h3 class="about-pillars__card-title">{{ title }}</h3>
            <p class="about-pillars__card-desc">{{ default_descs[forloop.index0] }}</p>
            <div class="about-pillars__card-line"></div>
          </div>
        {% endfor %}
      {%- endif -%}
    </div>

    {%- comment -%} Mobile Slider Dots Indicator {%- endcomment -%}
    <div class="about-slider-dots">
      <span class="about-slider-dot is-active"></span>
      <span class="about-slider-dot"></span>
      <span class="about-slider-dot"></span>
      <span class="about-slider-dot"></span>
    </div>

  </div>
</div>

<style>
  .about-pillars {
    width: 100%;
    background-color: var(--pillars-bg, #ffffff);
    padding-top: var(--pillars-pt, 85px);
    padding-bottom: var(--pillars-pb, 85px);
    box-sizing: border-box;
  }

  .about-pillars__container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 28px;
    box-sizing: border-box;
  }

  .about-pillars__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 48px auto;
  }

  .about-pillars__eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .about-pillars__eyebrow-line {
    display: block;
    width: 28px;
    height: 1px;
    background-color: var(--pillars-accent, #c8a876);
  }

  .about-pillars__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pillars-accent, #c8a876);
  }

  .about-pillars__heading {
    font-family: var(--font-heading-family, serif);
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--pillars-heading, #111111);
    margin: 0 0 14px 0;
  }

  .about-pillars__subtitle {
    font-family: var(--font-body-family, sans-serif);
    font-size: 13.5px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--pillars-text, #666666);
    margin: 0;
  }

  .about-pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .about-pillars__card {
    position: relative;
    background-color: var(--pillars-card-bg, #faf8f5);
    border: 1px solid #ede8e1;
    padding: 32px 24px 28px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.3s ease;
  }

  .about-pillars__card:nth-child(1) { transition-delay: 0.08s; }
  .about-pillars__card:nth-child(2) { transition-delay: 0.16s; }
  .about-pillars__card:nth-child(3) { transition-delay: 0.24s; }
  .about-pillars__card:nth-child(4) { transition-delay: 0.32s; }

  .about-pillars__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
    border-color: var(--pillars-accent, #c8a876);
  }

  .about-pillars__card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .about-pillars__num {
    font-family: var(--font-heading-family, serif);
    font-size: 19px;
    font-weight: 400;
    color: var(--pillars-accent, #c8a876);
    letter-spacing: 0.08em;
  }

  .about-pillars__icon-wrap {
    color: #222222;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .about-pillars__card:hover .about-pillars__icon-wrap {
    color: var(--pillars-accent, #c8a876);
    transform: scale(1.1);
  }

  .about-pillars__card-title {
    font-family: var(--font-heading-family, serif);
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pillars-heading, #111111);
    margin: 0 0 12px 0;
    line-height: 1.35;
  }

  .about-pillars__card-desc {
    font-family: var(--font-body-family, sans-serif);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--pillars-text, #666666);
    margin: 0 0 18px 0;
    flex-grow: 1;
  }

  .about-pillars__card-line {
    width: 0;
    height: 2px;
    background-color: var(--pillars-accent, #c8a876);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-pillars__card:hover .about-pillars__card-line {
    width: 100%;
  }

  .about-slider-dots {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
  }

  .about-slider-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #d8d8d8;
    transition: background-color 0.25s ease, width 0.25s ease;
  }

  .about-slider-dot.is-active {
    width: 18px;
    border-radius: 4px;
    background-color: var(--pillars-accent, #c8a876);
  }

  @media screen and (max-width: 1080px) {
    .about-pillars__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .about-pillars {
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .about-pillars__container {
      padding: 0 16px;
    }
    .about-pillars__header {
      margin-bottom: 28px;
    }
    .about-pillars__heading {
      font-size: 22px;
    }
    .about-pillars__grid.about-mobile-slider {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 14px;
      padding: 4px 4px 16px 4px;
      margin: 0 -16px;
      padding-left: 16px;
      padding-right: 16px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .about-pillars__grid.about-mobile-slider::-webkit-scrollbar {
      display: none;
    }
    .about-pillars__card {
      flex: 0 0 78vw;
      max-width: 290px;
      scroll-snap-align: start;
      padding: 24px 20px 22px;
    }
    .about-slider-dots {
      display: flex;
    }
  }
</style>

{% schema %}
{
  "name": "About Pillars",
  "tag": "section",
  "class": "section-about-pillars",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "THE PILLARS OF OUR CURATION"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Every collectible, artwork, and design object is governed by four timeless tenets of excellence."
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#c8a876"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 90
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "globe", "label": "Globe / Global Sourcing" },
            { "value": "craft", "label": "Craft / Geometric Diamond" },
            { "value": "concierge", "label": "Concierge / Star" },
            { "value": "sustainability", "label": "Sustainability / Shield" }
          ],
          "default": "globe"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "CURATION WITHOUT BOUNDARIES"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Pillar Description",
          "default": "Sourcing across 200+ artisan workshops and international design ateliers with uncompromising discerning standards."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "globe",
            "title": "CURATION WITHOUT BOUNDARIES",
            "description": "Sourcing across 200+ artisan workshops and international design ateliers with uncompromising discerning standards."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "craft",
            "title": "HEIRLOOM CRAFTSMANSHIP",
            "description": "Preserving ancestral artisanal traditions through refined contemporary silhouettes and noble materials."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "concierge",
            "title": "BESPOKE CONCIERGE",
            "description": "Dedicated white-glove curation, custom commissions, and private interior architectural advisory for collectors."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "sustainability",
            "title": "SUSTAINED ELEGANCE",
            "description": "Conscious, ethical creation built with longevity in mind—curated to be passed on to future generations."
          }
        }
      ]
    }
  ]
}
{% endschema %}
