{%- comment -%}
  Renders the "A little bit of us" brand statement section with social media icons.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign heading = section.settings.heading | default: 'A little bit of us'
  assign text = section.settings.text | default: 'The House of Things is a destination for design, artistry and craftsmanship, curated for a life artfully lived.'
  assign max_width = section.settings.max_width | default: 680
  assign padding_top = section.settings.padding_top | default: 56
  assign padding_bottom = section.settings.padding_bottom | default: 64

  assign facebook_url = section.settings.facebook_url | default: 'https://facebook.com'
  assign instagram_url = section.settings.instagram_url | default: 'https://instagram.com'
  assign pinterest_url = section.settings.pinterest_url | default: 'https://pinterest.com'
  assign twitter_url = section.settings.twitter_url
%}

<div
  id="BrandManifesto-{{ section_id }}"
  class="brand-manifesto section-{{ section_id }}"
  style="
    --bm-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --bm-heading-color: {{ section.settings.heading_color | default: '#1a1a1a' }};
    --bm-text-color: {{ section.settings.text_color | default: '#4a4a4a' }};
    --bm-icon-bg: {{ section.settings.icon_bg_color | default: '#2b2b2b' }};
    --bm-icon-color: {{ section.settings.icon_color | default: '#ffffff' }};
    --bm-max-width: {{ max_width }}px;
    --bm-padding-top: {{ padding_top }}px;
    --bm-padding-bottom: {{ padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="brand-manifesto__container">
    
    {% if heading != blank %}
      <h2 class="brand-manifesto__heading">{{ heading }}</h2>
    {% endif %}

    {% if text != blank %}
      <div class="brand-manifesto__text">{{ text }}</div>
    {% endif %}

    <div class="brand-manifesto__socials">
      {% if facebook_url != blank %}
        <a href="{{ facebook_url }}" class="brand-manifesto__social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg class="brand-manifesto__icon" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
          </svg>
        </a>
      {% endif %}

      {% if instagram_url != blank %}
        <a href="{{ instagram_url }}" class="brand-manifesto__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg class="brand-manifesto__icon" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      {% endif %}

      {% if pinterest_url != blank %}
        <a href="{{ pinterest_url }}" class="brand-manifesto__social-link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
          <svg class="brand-manifesto__icon" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
            <path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.357-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
          </svg>
        </a>
      {% endif %}

      {% if twitter_url != blank %}
        <a href="{{ twitter_url }}" class="brand-manifesto__social-link" target="_blank" rel="noopener noreferrer" aria-label="X">
          <svg class="brand-manifesto__icon" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      {% endif %}
    </div>

  </div>
</div>

{% stylesheet %}
  .brand-manifesto {
    background-color: var(--bm-bg, #ffffff);
    width: 100%;
    padding-block-start: var(--bm-padding-top, 24px);
    padding-block-end: var(--bm-padding-bottom, 48px);
    box-sizing: border-box;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .brand-manifesto__container {
    max-width: var(--bm-max-width, 680px);
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .brand-manifesto__heading {
    font-family: Georgia, 'Playfair Display', 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 400;
    color: var(--bm-heading-color, #1a1a1a);
    margin: 0 0 10px 0;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  @media screen and (min-width: 750px) {
    .brand-manifesto__heading {
      font-size: 32px;
    }
  }

  .brand-manifesto__text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--bm-text-color, #4a4a4a);
    max-width: 620px;
    margin: 0 0 18px 0;
    font-weight: 400;
    letter-spacing: 0.015em;
  }

  .brand-manifesto__socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .brand-manifesto__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--bm-icon-bg, #2b2b2b);
    color: var(--bm-icon-color, #ffffff);
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-manifesto__social-link:hover {
    transform: scale(1.1);
    opacity: 0.85;
  }

  .brand-manifesto__icon {
    display: block;
    width: 14px;
    height: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Manifesto",
  "tag": "section",
  "class": "section-brand-manifesto",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little bit of us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Statement Text",
      "default": "The House of Things is a destination for design, artistry and craftsmanship, curated for a life artfully lived."
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter / X URL"
    },
    {
      "type": "header",
      "content": "Styling & Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Circle Color",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Symbol Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Text Max Width",
      "default": 680
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Brand Manifesto",
      "settings": {
        "heading": "A little bit of us",
        "text": "The House of Things is a destination for design, artistry and craftsmanship, curated for a life artfully lived."
      }
    }
  ]
}
{% endschema %}
