            "default_asset": "art-atelier-artist-studio.jpg",
            "kicker": "Atelier",
            "caption": "Objects selected with a curator's eye"
          }
        },
        {
          "type": "image",
          "settings": {
            "default_asset": "fine-print-2.jpg",
            "kicker": "Art",
            "caption": "Limited works and quiet wall moments"
          }
        },
        {
          "type": "image",
          "settings": {
            "default_asset": "maker-gallery-3.jpg",
            "kicker": "Craft",
            "caption": "Quiet details from the maker's hand"
          }
        },
        {
