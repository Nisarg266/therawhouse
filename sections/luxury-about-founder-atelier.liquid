{%- comment -%}
  THE RAW HOUSE - LUXURY FOUNDER & ATELIER STORY
  Split editorial layout showcasing studio craft, pigment grinding, bronze foundry, and museum metrics.
{%- endcomment -%}

<section
  id="LuxuryAboutFounder-{{ section.id }}"
  class="lux-founder-section"
  style="background: {{ section.settings.background_color | default: '#0d0d0d' }}; color: #ffffff;"
  {{ section.shopify_attributes }}
>
  <div class="lux-founder-container">
    <div class="lux-founder-grid">
      <!-- Left Media Column -->
      <div class="lux-founder-media-wrap lux-reveal-fade-up">
        <div class="lux-founder-media-frame">
          <img
            src="{{ section.settings.image | image_url: width: 1400 | default: 'art-atelier-artist-studio.jpg' | asset_url }}"
            alt="{{ section.settings.heading | default: 'The Raw House Atelier Studio' }}"
            class="lux-founder-img"
            loading="lazy"
            width="700"
            height="850"
          >
          <div class="lux-founder-image-glow"></div>
        </div>

        <!-- Floating Glass Provenance Badge -->
        <div class="lux-founder-floating-badge">
          <span class="lux-founder-badge-gold">✦ ATELIER CERTIFIED</span>
          <p class="lux-founder-badge-text">Hand-Authored Fine Art & Cast Models</p>
        </div>
      </div>

      <!-- Right Editorial Content Column -->
      <div class="lux-founder-content lux-reveal-fade-up">
        <span class="lux-founder-subheading">{{ section.settings.subheading | default: 'BEHIND THE CANVAS & FOUNDRY' }}</span>
        <h2 class="lux-founder-heading">{{ section.settings.heading | default: 'HONORING THE WEIGHT OF CREATION' }}</h2>

        <div class="lux-founder-text-body">
          <p>
            {{ section.settings.paragraph_1 | default: 'At The Raw House, we believe that an art piece is not merely an ornament—it is a tangible focal point that alters the energy and spatial geometry of an interior. Every oil painting begins with unhurried canvas stretching and mineral pigment blending, capturing luminous depth through dozens of textured impasto layers.' }}
          </p>
          <p>
            {{ section.settings.paragraph_2 | default: 'Our 3D sculptural models and bronze figures undergo traditional lost-wax foundry casting. Heated to over 1,200°C and hand-chiseled by master sculptors, each piece achieves a weighted presence and rich patina that mass machinery could never replicate.' }}
          </p>
        </div>

        <!-- Metrics Grid (4 Stats) -->
        <div class="lux-founder-metrics">
          <div class="lux-founder-metric-item">
            <span class="lux-founder-metric-val">100%</span>
            <span class="lux-founder-metric-lbl">Hand-Authored</span>
          </div>
          <div class="lux-founder-metric-item">
            <span class="lux-founder-metric-val">15+</span>
            <span class="lux-founder-metric-lbl">Impasto Glazes</span>
          </div>
          <div class="lux-founder-metric-item">
            <span class="lux-founder-metric-val">1200°C</span>
            <span class="lux-founder-metric-lbl">Bronze Casting</span>
          </div>
          <div class="lux-founder-metric-item">
            <span class="lux-founder-metric-val">100 Yrs+</span>
            <span class="lux-founder-metric-lbl">Archival Guarantee</span>
          </div>
        </div>

        <!-- Signature Block -->
        <div class="lux-founder-signature-wrap">
          <div class="lux-founder-signature-mark">The Raw House Atelier</div>
          <p class="lux-founder-signature-title">Master Artisan & Curator of Acquisitions</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury Founder & Atelier",
  "tag": "section",
  "class": "section-luxury-founder-atelier",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier Studio Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "BEHIND THE CANVAS & FOUNDRY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "HONORING THE WEIGHT OF CREATION"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "At The Raw House, we believe that an art piece is not merely an ornament—it is a tangible focal point that alters the energy and spatial geometry of an interior. Every oil painting begins with unhurried canvas stretching and mineral pigment blending, capturing luminous depth through dozens of textured impasto layers."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Our 3D sculptural models and bronze figures undergo traditional lost-wax foundry casting. Heated to over 1,200°C and hand-chiseled by master sculptors, each piece achieves a weighted presence and rich patina that mass machinery could never replicate."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0d0d0d"
    }
  ],
  "presets": [
    {
      "name": "Luxury Founder & Atelier"
    }
  ]
}
{% endschema %}
