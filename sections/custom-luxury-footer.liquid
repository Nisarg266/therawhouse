{%- comment -%}
  THE RAW HOUSE — ULTRA-LUXURY ATELIER ADVANCED FOOTER
  World-class architectural footer supporting:
  - Multi-palette luxury aesthetics (Atelier Noir, Museum Linen, Minimal White, Bespoke Custom)
  - Custom brand logo or monogram emblem with curatorial ornament
  - Modular blocks: Navigation Menus (1 or 2 cols), Editorial Text, VIP Newsletter, Concierge, Trust Assurances, Social
  - Interactive smooth mobile accordions
  - Verified SSL security & payment badges (Visa, Mastercard, Amex, UPI, PayPal, Apple Pay, Net Banking)
  - Curated social media presence with WhatsApp Concierge hotline
  - Localization country/currency and language selectors
  - Dynamic legal policy links and smooth back-to-top
{%- endcomment -%}

{% liquid
  assign color_scheme = section.settings.color_scheme | default: 'parchment'
%}

<footer
  id="CustomFooter-{{ section.id }}"
  class="custom-luxury-footer custom-luxury-footer--{{ color_scheme }} color-custom-{{ section.id }}"
  style="
    --footer-padding-top: {{ section.settings.padding_top | default: 48 }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom | default: 28 }}px;
    --footer-padding-top-m: {{ section.settings.padding_top_m | default: 32 }}px;
    --footer-padding-bottom-m: {{ section.settings.padding_bottom_m | default: 20 }}px;
    --footer-max-width: {{ section.settings.max_width | default: 1240 }}px;
    {% if color_scheme == 'custom' %}
      {% if section.settings.custom_bg != blank %}--flx-bg: {{ section.settings.custom_bg }} !important;{% endif %}
      {% if section.settings.custom_card_bg != blank %}--flx-card-bg: {{ section.settings.custom_card_bg }} !important;{% endif %}
      {% if section.settings.custom_text != blank %}--flx-text: {{ section.settings.custom_text }} !important;{% endif %}
      {% if section.settings.custom_heading != blank %}--flx-heading: {{ section.settings.custom_heading }} !important;{% endif %}
      {% if section.settings.custom_gold != blank %}--flx-gold: {{ section.settings.custom_gold }} !important; --flx-border-accent: {{ section.settings.custom_gold }} !important;{% endif %}
      {% if section.settings.custom_border != blank %}--flx-border: {{ section.settings.custom_border }} !important;{% endif %}
      {% if section.settings.custom_link != blank %}--flx-link: {{ section.settings.custom_link }} !important;{% endif %}
      {% if section.settings.custom_link_hover != blank %}--flx-link-hover: {{ section.settings.custom_link_hover }} !important;{% endif %}
      {% if section.settings.custom_btn_bg != blank %}--flx-btn-bg: {{ section.settings.custom_btn_bg }} !important;{% endif %}
      {% if section.settings.custom_btn_text != blank %}--flx-btn-text: {{ section.settings.custom_btn_text }} !important;{% endif %}
    {% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-footer__container">
    {% if section.settings.show_brand_header %}
      <!-- Brand Prestige Header -->
      <div class="custom-footer__brand-header">
        {% if section.settings.show_emblem %}
          {% assign e_size = section.settings.emblem_size | default: 38 %}
          <div
            class="custom-footer__emblem"
            aria-hidden="true"
            style="
              width: {{ e_size }}px;
              height: {{ e_size }}px;
              {% if section.settings.emblem_border_color != blank and section.settings.emblem_border_color != 'rgba(0,0,0,0)' %}border-color: {{ section.settings.emblem_border_color }} !important;{% endif %}
              {% if section.settings.emblem_bg_color != blank and section.settings.emblem_bg_color != 'rgba(0,0,0,0)' %}background-color: {{ section.settings.emblem_bg_color }} !important;{% endif %}
              {% if section.settings.emblem_text_color != blank and section.settings.emblem_text_color != 'rgba(0,0,0,0)' %}color: {{ section.settings.emblem_text_color }} !important;{% endif %}
            "
          >
            {% if section.settings.brand_emblem_image != blank %}
              <img
                src="{{ section.settings.brand_emblem_image | image_url: width: 160 }}"
                alt="{{ section.settings.brand_name | default: 'Emblem' | escape }}"
                class="custom-footer__emblem-img"
                width="{{ e_size }}"
                height="{{ e_size }}"
                loading="lazy"
              >
            {% else %}
              <span class="custom-footer__emblem-text" style="font-size: {{ e_size | times: 0.35 | round }}px;">{{ section.settings.brand_emblem_text | default: 'TRH' }}</span>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.brand_logo != blank %}
          <div class="custom-footer__brand-logo-wrap">
            <img
              src="{{ section.settings.brand_logo | image_url: width: 600 }}"
              alt="{{ section.settings.brand_logo.alt | default: section.settings.brand_name | default: shop.name | escape }}"
              class="custom-footer__brand-logo"
              loading="lazy"
              width="{{ section.settings.brand_logo.width }}"
              height="{{ section.settings.brand_logo.height }}"
              style="max-width: {{ section.settings.logo_width | default: 160 }}px; width: 100%; height: auto;"
            >
          </div>
        {% else %}
          <h3
            class="custom-footer__brand-title"
            style="
              {% if section.settings.brand_title_size != blank %}font-size: {{ section.settings.brand_title_size }}px;{% endif %}
              {% if section.settings.brand_title_color != blank and section.settings.brand_title_color != 'rgba(0,0,0,0)' %}color: {{ section.settings.brand_title_color }} !important;{% endif %}
            "
          >
            {{- section.settings.brand_name | default: 'THE RAW HOUSE' -}}
          </h3>
        {% endif %}

        {% if section.settings.brand_tagline != blank %}
          <p
            class="custom-footer__brand-tagline"
            style="
              {% if section.settings.brand_tagline_size != blank %}font-size: {{ section.settings.brand_tagline_size }}px;{% endif %}
              {% if section.settings.brand_tagline_color != blank and section.settings.brand_tagline_color != 'rgba(0,0,0,0)' %}color: {{ section.settings.brand_tagline_color }} !important;{% endif %}
            "
          >
            {{ section.settings.brand_tagline }}
          </p>
        {% endif %}

        {% assign ornament = section.settings.ornament_symbol | default: 'diamond' %}
        {% if ornament != 'none' %}
          <div
            class="custom-footer__brand-ornament"
            aria-hidden="true"
            style="
              max-width: {{ section.settings.ornament_max_width | default: 240 }}px;
              {% if section.settings.ornament_color != blank and section.settings.ornament_color != 'rgba(0,0,0,0)' %}--flx-gold: {{ section.settings.ornament_color }};{% endif %}
            "
          >
            <span class="custom-footer__ornament-line"></span>
            {% if ornament == 'diamond' %}
              <span class="custom-footer__ornament-diamond">◆</span>
            {% elsif ornament == 'star' %}
              <span class="custom-footer__ornament-diamond">✦</span>
            {% elsif ornament == 'bar' %}
              <span class="custom-footer__ornament-diamond">—</span>
            {% elsif ornament == 'circle' %}
              <span class="custom-footer__ornament-diamond">•</span>
            {% elsif ornament == 'crest' %}
              <span class="custom-footer__ornament-diamond">⚜</span>
            {% endif %}
            <span class="custom-footer__ornament-line"></span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- Main Content Columns / Dynamic Blocks -->
    <div class="custom-footer__top-row">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu' %}
              {% liquid
                assign b_sym = block.settings.bullet_symbol | default: 'chevron'
                case b_sym
                  when 'chevron'
                    assign bullet_char = '›'
                  when 'dot'
                    assign bullet_char = '•'
                  when 'dash'
                    assign bullet_char = '—'
                  when 'star'
                    assign bullet_char = '✦'
                  when 'arrow'
                    assign bullet_char = '→'
                  else
                    assign bullet_char = '›'
                endcase
              %}
              <div
                class="custom-footer__col custom-footer__col--menu {% if block.settings.columns == '2' %}custom-footer__col--menu-double{% endif %}"
                style="
                  {% if block.settings.heading_color != blank and block.settings.heading_color != 'rgba(0,0,0,0)' %}--flx-heading: {{ block.settings.heading_color }} !important;{% endif %}
                  {% if block.settings.link_color != blank and block.settings.link_color != 'rgba(0,0,0,0)' %}--flx-link: {{ block.settings.link_color }} !important;{% endif %}
                  {% if block.settings.link_hover_color != blank and block.settings.link_hover_color != 'rgba(0,0,0,0)' %}--flx-link-hover: {{ block.settings.link_hover_color }} !important;{% endif %}
                "
                {{ block.shopify_attributes }}
              >
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'EXPLORE' }}
                  </span>
                  <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <ul class="custom-footer__links-list {% if block.settings.columns == '2' %}custom-footer__links-list--2cols{% endif %}" role="list">
                    {% if block.settings.menu != blank %}
                      {% for link in block.settings.menu.links %}
                        <li>
                          <a href="{{ link.url }}" class="custom-footer__link">
                            {% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}
                            <span>{{ link.title }}</span>
                          </a>
                        </li>
                      {% endfor %}
                    {% else %}
                      {% assign h_upper = block.settings.heading | upcase %}
                      {% if h_upper contains 'ABOUT' %}
                        <li><a href="/pages/about-us" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>OUR STORY</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>MAKERS & ATELIER</span></a></li>
                        <li><a href="/blogs/news" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>THE JOURNAL</span></a></li>
                        <li><a href="/pages/contact" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>PRESS & EXHIBITIONS</span></a></li>
                        <li><a href="/policies/privacy-policy" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>PRIVACY POLICY</span></a></li>
                        <li><a href="/pages/contact" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>CONTACT ATELIER</span></a></li>
                      {% elsif h_upper contains 'SERVICE' %}
                        <li><a href="/pages/contact" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>PRIVATE CONCIERGE</span></a></li>
                        <li><a href="/pages/contact" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>TRADE & ARCHITECTS (B2B)</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>BESPOKE INTERIORS</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>WHITE GLOVE COMMISSIONS</span></a></li>
                        <li><a href="/policies/shipping-policy" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>SHIPPING & TRANSIT</span></a></li>
                        <li><a href="/policies/terms-of-service" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>TERMS & AUTHENTICITY</span></a></li>
                      {% else %}
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>Original Oil Paintings</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>Bronze & Marble Sculptures</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>3D Sajawat Art Models</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">{% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">{{ bullet_char }}</span>{% endif %}<span>Archival Fine Prints</span></a></li>
                      {% endif %}
                    {% endif %}
                  </ul>
                </div>
              </div>

            {% when 'text' %}
              <div class="custom-footer__col custom-footer__col--text" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'ABOUT THE ATELIER' }}
                  </span>
                  <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <div class="custom-footer__text-content">
                    {{ block.settings.text | default: 'Dedicated to museum-grade original canvas paintings, hand-cast bronze statuettes, and architectural decorative models crafted with singular intention.' }}
                  </div>
                  {% if block.settings.author_title != blank %}
                    <p class="custom-footer__author-sign">{{ block.settings.author_title }}</p>
                  {% endif %}
                </div>
              </div>

            {% when 'newsletter' %}
              <div class="custom-footer__col custom-footer__col--newsletter" {{ block.shopify_attributes }}>
                <div
                  class="custom-footer__newsletter-card"
                  style="
                    {% if block.settings.card_bg_color != blank and block.settings.card_bg_color != 'rgba(0,0,0,0)' %}--flx-card-bg: {{ block.settings.card_bg_color }} !important; background: {{ block.settings.card_bg_color }} !important;{% endif %}
                    {% if block.settings.card_border_color != blank and block.settings.card_border_color != 'rgba(0,0,0,0)' %}--flx-card-border: {{ block.settings.card_border_color }} !important; border-color: {{ block.settings.card_border_color }} !important;{% endif %}
                  "
                >
                  {% if block.settings.show_badge != false and block.settings.badge_text != blank %}
                    <div class="custom-footer__vip-pill">
                      {% assign b_icon = block.settings.badge_icon | default: 'sparkle' %}
                      {% if b_icon == 'sparkle' %}
                        <span class="custom-footer__vip-sparkle">✦</span>
                      {% elsif b_icon == 'star' %}
                        <span class="custom-footer__vip-sparkle">★</span>
                      {% elsif b_icon == 'diamond' %}
                        <span class="custom-footer__vip-sparkle">◆</span>
                      {% elsif b_icon == 'shield' %}
                        <span class="custom-footer__vip-sparkle">🛡</span>
                      {% endif %}
                      <span>{{ block.settings.badge_text }}</span>
                    </div>
                  {% endif %}
                  <h4 class="custom-footer__col-heading custom-footer__col-heading--newsletter">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'BE THE FIRST TO KNOW' }}
                  </h4>
                  <p class="custom-footer__newsletter-desc">
                    {{ block.settings.subtext | default: 'Sign up for privileged access to rare salon collections, exhibition previews, and bespoke atelier releases.' }}
                  </p>
                  {% assign newsletter_id = 'FooterNewsletter-' | append: section.id | append: block.id %}
                  {% form 'customer', id: newsletter_id, class: 'custom-footer__newsletter-form' %}
                    <input type="hidden" name="contact[tags]" value="newsletter, footer-vip">
                    <div class="custom-footer__newsletter-field-wrapper">
                      <input
                        type="email"
                        name="contact[email]"
                        aria-label="{{ 'blocks.email_signup.label' | t }}"
                        class="custom-footer__newsletter-input"
                        placeholder="{{ block.settings.placeholder | default: 'Enter your email address...' }}"
                        required
                        autocomplete="email"
                      >
                      <button
                        type="submit"
                        class="custom-footer__newsletter-btn"
                        style="
                          {% if block.settings.button_bg_color != blank and block.settings.button_bg_color != 'rgba(0,0,0,0)' %}background: {{ block.settings.button_bg_color }} !important; border-color: {{ block.settings.button_bg_color }} !important;{% endif %}
                          {% if block.settings.button_text_color != blank and block.settings.button_text_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.button_text_color }} !important;{% endif %}
                        "
                      >
                        <span>{{ block.settings.button_text | default: 'SUBSCRIBE' }}</span>
                        {% assign btn_icon = block.settings.button_icon | default: 'arrow' %}
                        {% if btn_icon == 'arrow' %}
                          <svg class="custom-footer__btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                          </svg>
                        {% elsif btn_icon == 'chevron' %}
                          <svg class="custom-footer__btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        {% elsif btn_icon == 'envelope' %}
                          <svg class="custom-footer__btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                          </svg>
                        {% endif %}
                      </button>
                    </div>
                    {% if form.errors %}
                      <div class="custom-footer__form-message custom-footer__form-message--error" role="alert">
                        {{ form.errors | default_errors }}
                      </div>
                    {% endif %}
                    {% if form.posted_successfully? %}
                      <p class="custom-footer__form-message custom-footer__form-message--success">
                        ✓ Welcome to The Raw House. Your invitation is confirmed.
                      </p>
                    {% endif %}
                  {% endform %}
                  <p class="custom-footer__privacy-note">{{ block.settings.privacy_note | default: 'Strictly confidential. No spam, ever.' }}</p>
                </div>
              </div>

            {% when 'concierge' %}
              <div class="custom-footer__col custom-footer__col--concierge" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'PRIVATE ART CONCIERGE' }}
                  </span>
                  <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <div class="custom-footer__concierge-info">
                    {% if block.settings.hours != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Advisory Hours:</strong>
                        <span>{{ block.settings.hours }}</span>
                      </p>
                    {% endif %}
                    {% if block.settings.phone_display != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Direct Hotline:</strong>
                        <a href="tel:{{ block.settings.phone | default: block.settings.phone_display | replace: ' ', '' }}">{{ block.settings.phone_display }}</a>
                      </p>
                    {% endif %}
                    {% if block.settings.email != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Inquiries:</strong>
                        <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                      </p>
                    {% endif %}
                    {% if block.settings.address != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Atelier Salon:</strong>
                        <span>{{ block.settings.address }}</span>
                      </p>
                    {% endif %}
                    {% if block.settings.show_whatsapp != false and block.settings.whatsapp_url != blank %}
                      <div class="custom-footer__whatsapp-wrap custom-footer__whatsapp-wrap--block">
                        <a href="{{ block.settings.whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__whatsapp-btn">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                          </svg>
                          <span>{{ block.settings.whatsapp_label | default: 'Chat with Private Concierge' }}</span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>

            {% when 'trust_badges' %}
              <div class="custom-footer__col custom-footer__col--trust" {{ block.shopify_attributes }}>
                <h4 class="custom-footer__col-heading">
                  <span class="custom-footer__heading-accent"></span>
                  {{ block.settings.heading | default: 'ATELIER PROMISES' }}
                </h4>
                {% assign trust_sym = block.settings.badge_icon | default: 'sparkle' %}
                {% liquid
                  case trust_sym
                    when 'diamond'
                      assign t_icon = '◆'
                    when 'star'
                      assign t_icon = '★'
                    when 'check'
                      assign t_icon = '✓'
                    when 'shield'
                      assign t_icon = '🛡'
                    else
                      assign t_icon = '✦'
                  endcase
                %}
                <div class="custom-footer__trust-list">
                  {% if block.settings.badge_1_text != blank %}
                    <div class="custom-footer__trust-item">
