                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <!-- Back to Top Button -->
      {% if section.settings.show_back_to_top != false %}
        <div class="custom-footer__top-button-col">
          <button type="button" class="custom-footer__back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});" aria-label="{{ section.settings.back_to_top_text | default: 'BACK TO TOP' }}">
            <span>{{ section.settings.back_to_top_text | default: 'BACK TO TOP' }}</span>
            {% assign top_icon = section.settings.back_to_top_icon | default: 'chevron' %}
            {% if top_icon == 'chevron' %}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="18 15 12 9 6 15"></polyline>
              </svg>
            {% elsif top_icon == 'arrow' %}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="19" x2="12" y2="5"></line>
                <polyline points="5 12 12 5 19 12"></polyline>
              </svg>
            {% elsif top_icon == 'triangle' %}
              <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12 4 22 20 2 20"></polygon>
              </svg>
            {% endif %}
          </button>
        </div>
      {% endif %}
    </div>

    <!-- Bottom Row: Copyright, Policies, Localization & Credits -->
    <div class="custom-footer__bottom-row">
      <div class="custom-footer__bottom-content">
        <p class="custom-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'The Raw House Living Pvt Ltd. All rights reserved.' }}
        </p>

        {% if section.settings.show_policy_links != false %}
          <span class="custom-footer__bottom-divider" aria-hidden="true">&bull;</span>
          <div class="custom-footer__policy-links">
            <a href="{{ section.settings.privacy_policy_url | default: '/policies/privacy-policy' }}" class="custom-footer__policy-link">
              {{- section.settings.privacy_policy_label | default: 'Privacy Policy' -}}
            </a>
            <span class="custom-footer__policy-dot">&bull;</span>
            <a href="{{ section.settings.terms_policy_url | default: '/policies/terms-of-service' }}" class="custom-footer__policy-link">
              {{- section.settings.terms_policy_label | default: 'Terms of Service' -}}
            </a>
            <span class="custom-footer__policy-dot">&bull;</span>
            <a href="{{ section.settings.shipping_policy_url | default: '/policies/shipping-policy' }}" class="custom-footer__policy-link">
              {{- section.settings.shipping_policy_label | default: 'Shipping & Returns' -}}
            </a>
            {% if section.settings.custom_policy_url != blank and section.settings.custom_policy_label != blank %}
              <span class="custom-footer__policy-dot">&bull;</span>
              <a href="{{ section.settings.custom_policy_url }}" class="custom-footer__policy-link">
                {{- section.settings.custom_policy_label -}}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.show_credits != false %}
          <span class="custom-footer__bottom-divider" aria-hidden="true">&bull;</span>
          <p class="custom-footer__credits">
            {{ section.settings.credits_prefix | default: 'Mindfully made by' }}
            <a
              href="{{ section.settings.credits_url | default: 'https://scraft.studio/' }}"
              target="_blank"
              rel="noopener noreferrer"
              title="{{ section.settings.credits_title | default: 'SCRAFT - E-commerce growth, SEO & software studio' }}"
              aria-label="{{ section.settings.credits_title | default: 'SCRAFT - E-commerce growth, SEO & software studio' }}"
              class="custom-footer__credit-link"
            >
              {{- section.settings.credits_label | default: 'Scraft' -}}
            </a>
          </p>
        {% endif %}
      </div>

      {% if section.settings.show_country_selector or section.settings.show_language_selector %}
        <div class="custom-footer__localization-wrap">
          {% render 'localization-form',
            show_country: section.settings.show_country_selector,
            show_language: section.settings.show_language_selector,
            localization_style: 'dropdown',
            form_id: section.id
          %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

<style>
  /* ==========================================================================
     THE RAW HOUSE - ADVANCED LUXURY ARCHITECTURAL FOOTER DESIGN SYSTEM
     ========================================================================== */

  .custom-luxury-footer {
    position: relative;
    padding-top: var(--footer-padding-top, 48px);
    padding-bottom: var(--footer-padding-bottom, 28px);
    box-sizing: border-box;
    font-family: var(--lux-font-body, "Inter", -apple-system, sans-serif);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* --- ATELIER NOIR PALETTE (Deep Obsidian Luxury - Default) --- */
  .custom-luxury-footer--noir {
    --flx-bg: #11100e;
    --flx-card-bg: #191816;
    --flx-card-border: rgba(197, 168, 128, 0.2);
    --flx-border: rgba(255, 255, 255, 0.08);
    --flx-border-accent: rgba(197, 168, 128, 0.4);
    --flx-heading: #fcfbf9;
    --flx-text: #eae5dc;
    --flx-muted: #9e978c;
    --flx-gold: #c5a880;
    --flx-gold-hover: #dfc49e;
    --flx-link: #b5afa4;
    --flx-link-hover: #ffffff;
    --flx-input-bg: rgba(255, 255, 255, 0.05);
    --flx-input-border: rgba(255, 255, 255, 0.16);
    --flx-input-text: #ffffff;
    --flx-input-placeholder: #7c766d;
    --flx-btn-bg: #c5a880;
    --flx-btn-text: #11100e;
    --flx-btn-hover: #dfc49e;
    --flx-badge-bg: rgba(255, 255, 255, 0.06);
    --flx-badge-border: rgba(255, 255, 255, 0.12);
    --flx-badge-text: #eae5dc;
    background: var(--flx-bg) !important;
    color: var(--flx-text) !important;
    border-top: 1px solid var(--flx-border-accent) !important;
  }

  /* --- MUSEUM PARCHMENT PALETTE (Warm Alabaster Light) --- */
  .custom-luxury-footer--parchment {
    --flx-bg: #f9f8f5;
    --flx-card-bg: #ffffff;
    --flx-card-border: #ede8df;
    --flx-border: #eae6de;
    --flx-border-accent: #c5a880;
    --flx-heading: #121110;
    --flx-text: #242220;
    --flx-muted: #726b60;
    --flx-gold: #b38b4d;
    --flx-gold-hover: #967035;
    --flx-link: #524d45;
    --flx-link-hover: #000000;
    --flx-input-bg: #ffffff;
    --flx-input-border: #dcd7ce;
    --flx-input-text: #121110;
    --flx-input-placeholder: #8c857a;
    --flx-btn-bg: #121110;
    --flx-btn-text: #ffffff;
    --flx-btn-hover: #b38b4d;
    --flx-badge-bg: #ffffff;
    --flx-badge-border: #dedad0;
    --flx-badge-text: #121110;
    background: var(--flx-bg) !important;
    color: var(--flx-text) !important;
    border-top: 1px solid var(--flx-border) !important;
  }

  /* --- GALLERY MINIMAL WHITE PALETTE --- */
  .custom-luxury-footer--minimal_white {
    --flx-bg: #ffffff;
    --flx-card-bg: #fafafa;
    --flx-card-border: #eaeaea;
    --flx-border: #f0f0f0;
    --flx-border-accent: #c5a880;
    --flx-heading: #111111;
    --flx-text: #333333;
    --flx-muted: #777777;
    --flx-gold: #c5a880;
    --flx-gold-hover: #b38b4d;
    --flx-link: #555555;
    --flx-link-hover: #000000;
    --flx-input-bg: #ffffff;
    --flx-input-border: #e0e0e0;
    --flx-input-text: #111111;
    --flx-input-placeholder: #888888;
    --flx-btn-bg: #111111;
    --flx-btn-text: #ffffff;
    --flx-btn-hover: #c5a880;
    --flx-badge-bg: #f5f5f5;
    --flx-badge-border: #e8e8e8;
    --flx-badge-text: #111111;
    background: var(--flx-bg) !important;
    color: var(--flx-text) !important;
    border-top: 1px solid var(--flx-border) !important;
  }

  /* --- CUSTOM PALETTE --- */
  .custom-luxury-footer--custom {
    --flx-card-bg: rgba(255, 255, 255, 0.05);
    --flx-card-border: rgba(197, 168, 128, 0.25);
    --flx-muted: rgba(120, 120, 120, 0.9);
    --flx-gold-hover: #dfc49e;
    --flx-link: inherit;
    --flx-link-hover: var(--flx-gold, #c5a880);
    --flx-input-bg: rgba(255, 255, 255, 0.06);
    --flx-input-border: rgba(255, 255, 255, 0.2);
    --flx-input-text: inherit;
    --flx-input-placeholder: #888888;
    --flx-btn-bg: var(--flx-gold, #c5a880);
    --flx-btn-text: #111111;
    --flx-btn-hover: #ffffff;
    --flx-badge-bg: rgba(255, 255, 255, 0.08);
    --flx-badge-border: rgba(255, 255, 255, 0.15);
    --flx-badge-text: inherit;
    background: var(--flx-bg, #11100e) !important;
    color: var(--flx-text, #eae5dc) !important;
    border-top: 1px solid var(--flx-border, rgba(255, 255, 255, 0.1)) !important;
  }

  .custom-footer__container {
    max-width: var(--footer-max-width, 1240px);
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
  }

  /* --- 1. BRAND PRESTIGE HEADER --- */
  .custom-footer__brand-header {
    text-align: center;
    padding-bottom: 22px;
    margin-bottom: 24px;
    position: relative;
  }

  .custom-footer__emblem {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--flx-gold);
    color: var(--flx-gold);
    margin-bottom: 10px;
    box-shadow: 0 0 16px rgba(197, 168, 128, 0.15);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .custom-footer__emblem:hover {
    transform: scale(1.06);
    border-color: var(--flx-gold-hover);
  }

  .custom-footer__emblem-text {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    padding-left: 2px;
  }

  .custom-footer__emblem-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
    display: block;
  }

  .custom-footer__brand-logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
  }

  .custom-footer__brand-logo {
    object-fit: contain;
    display: block;
  }

  .custom-footer__brand-title {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--flx-heading);
    margin: 0 0 5px;
  }

  .custom-footer__brand-tagline {
    font-size: 12.5px;
    color: var(--flx-muted);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 0 0 12px;
  }

  .custom-footer__brand-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: 240px;
    margin: 0 auto;
  }

  .custom-footer__ornament-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--flx-gold), transparent);
    opacity: 0.5;
  }

  .custom-footer__ornament-diamond {
    color: var(--flx-gold);
    font-size: 8px;
    line-height: 1;
    opacity: 0.8;
  }

  /* --- 2. TOP COLUMNS GRID --- */
  .custom-footer__top-row {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(24px, 3.5vw, 44px);
    padding-bottom: 28px;
    border-bottom: 1px solid var(--flx-border) !important;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .custom-footer__top-row:has(.custom-footer__col:nth-child(3):last-child) {
      grid-template-columns: 1fr 1fr 1.35fr;
    }
    .custom-footer__top-row:has(.custom-footer__col:nth-child(4):last-child) {
      grid-template-columns: 1fr 1fr 1.15fr 1.35fr;
    }
    .custom-footer__top-row:has(.custom-footer__col--menu-double) {
      grid-template-columns: 1.6fr 1fr 1.35fr;
    }
  }

  .custom-footer__col-heading {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flx-heading);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .custom-footer__heading-accent {
    display: none !important;
  }

  .custom-footer__accordion-trigger {
    display: none;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .custom-footer__accordion-icon {
    display: none;
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--flx-gold, #b38b4d);
  }

  .custom-footer__links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .custom-footer__links-list--2cols {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
  }

  .custom-footer__link {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flx-link);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .custom-footer__link-bullet {
    color: var(--flx-gold);
    font-size: 14px;
    line-height: 1;
    opacity: 0.7;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .custom-footer__link:hover {
    color: var(--flx-link-hover);
    transform: translateX(3px);
  }

  .custom-footer__link:hover .custom-footer__link-bullet {
    opacity: 1;
    transform: translateX(2px);
  }

  .custom-footer__text-content {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--flx-muted);
    margin: 0 0 12px;
  }

  .custom-footer__author-sign {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 12px;
    font-style: italic;
    color: var(--flx-gold);
    letter-spacing: 0.06em;
    margin: 0;
  }

  /* --- VIP NEWSLETTER CARD --- */
  .custom-footer__newsletter-card {
    background: var(--flx-card-bg);
    border: 1px solid var(--flx-card-border);
    padding: 22px 24px;
    border-radius: 4px;
    box-sizing: border-box;
    position: relative;
  }

  .custom-footer__vip-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(197, 168, 128, 0.12);
    border: 1px solid rgba(197, 168, 128, 0.28);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flx-gold);
    margin-bottom: 12px;
  }

  .custom-footer__vip-sparkle {
    font-size: 9px;
    line-height: 1;
  }

  .custom-footer__newsletter-desc {
    font-size: 12px;
    line-height: 1.6;
    color: var(--flx-muted);
    margin: 0 0 16px;
  }

  .custom-footer__newsletter-field-wrapper {
    display: flex;
    align-items: stretch;
    gap: 0;
    width: 100%;
    margin-bottom: 10px;
  }

  .custom-footer__newsletter-input {
    flex: 1;
    min-width: 0;
    height: 42px;
    background: var(--flx-input-bg);
    border: 1px solid var(--flx-input-border);
    border-right: none;
    border-radius: 2px 0 0 2px;
    padding: 0 14px;
    font-size: 12px;
    color: var(--flx-input-text);
    font-family: inherit;
    outline: none;
    transition: border-color 0.25s ease, background 0.25s ease;
    box-sizing: border-box;
  }

  .custom-footer__newsletter-input::placeholder {
    color: var(--flx-input-placeholder);
  }

  .custom-footer__newsletter-input:focus {
    border-color: var(--flx-gold);
    background: rgba(255, 255, 255, 0.08);
  }

  .custom-footer__newsletter-btn {
    height: 42px;
    background: var(--flx-btn-bg);
    color: var(--flx-btn-text);
    border: 1px solid var(--flx-btn-bg);
    border-radius: 0 2px 2px 0;
    padding: 0 18px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .custom-footer__newsletter-btn:hover {
    background: var(--flx-btn-hover);
    border-color: var(--flx-btn-hover);
  }

  .custom-footer__privacy-note {
    font-size: 10.5px;
    color: var(--flx-muted);
    letter-spacing: 0.04em;
    margin: 0;
    opacity: 0.8;
  }

  .custom-footer__form-message {
    font-size: 12px;
    margin: 8px 0 0;
    padding: 8px 12px;
    border-radius: 2px;
  }

  .custom-footer__form-message--success {
    background: rgba(46, 125, 50, 0.15);
    color: #81c784;
    border: 1px solid rgba(129, 199, 132, 0.3);
  }

  .custom-footer__form-message--error {
    background: rgba(211, 47, 47, 0.15);
    color: #e57373;
    border: 1px solid rgba(229, 115, 115, 0.3);
  }

  /* --- CONCIERGE & TRUST BLOCKS --- */
  .custom-footer__concierge-info {
    font-size: 12px;
    line-height: 1.8;
    color: var(--flx-muted);
  }

  .custom-footer__concierge-row {
    margin: 0 0 6px;
  }

  .custom-footer__concierge-row strong {
    color: var(--flx-heading);
    margin-right: 4px;
  }

  .custom-footer__concierge-row a {
    color: var(--flx-gold);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .custom-footer__concierge-row a:hover {
    color: var(--flx-gold-hover);
    text-decoration: underline;
  }

  .custom-footer__whatsapp-wrap {
    margin-top: 14px;
  }

  .custom-footer__whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 3px;
    background: #1f5e39;
    color: #ffffff !important;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }

  .custom-footer__whatsapp-btn:hover {
    background: #277949;
  }

  .custom-footer__trust-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 14px;
  }

  .custom-footer__trust-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 11.5px;
    color: var(--flx-muted);
    line-height: 1.5;
  }

  .custom-footer__trust-icon {
    color: var(--flx-gold);
    font-size: 11px;
    line-height: 1.5;
    flex-shrink: 0;
  }

  /* --- 3. MIDDLE ROW: PAYMENT, SOCIAL & BACK TO TOP --- */
  .custom-footer__middle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px 32px;
    padding: 22px 0;
