{%- comment -%}
  THE RAW HOUSE - LUXURY ATELIER FOOTER
  Fully customizable OS 2.0 block architecture with interactive mobile accordions,
  VIP newsletter subscription, concierge contacts, payment badges, and social links.
{%- endcomment -%}

<footer
  id="CustomFooter-{{ section.id }}"
  class="custom-luxury-footer color-custom-{{ section.id }}"
  style="
    --footer-padding-top: {{ section.settings.padding_top | default: 64 }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom | default: 36 }}px;
    --footer-max-width: {{ section.settings.max_width | default: 1240 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-footer__container">
    {% if section.settings.show_brand_header %}
      <div class="custom-footer__brand-header">
        <div class="custom-footer__monogram">TRH</div>
        <h3 class="custom-footer__brand-title">{{ section.settings.brand_name | default: 'THE RAW HOUSE' }}</h3>
        <p class="custom-footer__brand-tagline">{{ section.settings.brand_tagline | default: 'Contemporary Fine Art Paintings, 3D Sculptural Models & Museum Curations' }}</p>
      </div>
    {% endif %}

    <!-- Main Content Columns / Dynamic Blocks -->
    <div class="custom-footer__top-row">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu' %}
              <div class="custom-footer__col custom-footer__col--menu" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">{{ block.settings.heading | default: 'EXPLORE' }}</span>
                  <svg class="custom-footer__accordion-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <ul class="custom-footer__links-list" role="list">
                    {% if block.settings.menu != blank %}
                      {% for link in block.settings.menu.links %}
                        <li>
                          <a href="{{ link.url }}" class="custom-footer__link">{{ link.title }}</a>
                        </li>
                      {% endfor %}
                    {% else %}
                      {% assign h_upper = block.settings.heading | upcase %}
                      {% if h_upper contains 'ABOUT' %}
                        <li><a href="/pages/about-us" class="custom-footer__link">OUR STORY</a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">MAKERS</a></li>
                        <li><a href="/blogs/news" class="custom-footer__link">JOURNAL</a></li>
                        <li><a href="/pages/contact" class="custom-footer__link">PRESS & EVENTS</a></li>
                        <li><a href="/policies/privacy-policy" class="custom-footer__link">PRIVACY POLICY</a></li>
                        <li><a href="/pages/contact" class="custom-footer__link">CONTACT US</a></li>
                      {% elsif h_upper contains 'SERVICE' %}
                        <li><a href="/pages/contact" class="custom-footer__link">CONCIERGE</a></li>
                        <li><a href="/pages/contact" class="custom-footer__link">THOT B2B</a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">INTERIORS</a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">GIFTING SERVICES</a></li>
                        <li><a href="/policies/shipping-policy" class="custom-footer__link">SHIPPING & RETURNS</a></li>
                        <li><a href="/policies/terms-of-service" class="custom-footer__link">TERMS & CONDITIONS</a></li>
                      {% else %}
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">Original Oil Paintings</a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">Bronze & Marble Sculptures</a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">3D Sajawat Art Models</a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">Archival Fine Prints</a></li>
                      {% endif %}
                    {% endif %}
                  </ul>
                </div>
              </div>

            {% when 'text' %}
              <div class="custom-footer__col custom-footer__col--text" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">{{ block.settings.heading | default: 'ABOUT' }}</span>
                  <svg class="custom-footer__accordion-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <p class="custom-footer__text-content">
                    {{ block.settings.text | default: 'Dedicated to museum-grade original canvas paintings, hand-cast bronze statuettes, and architectural decorative models.' }}
                  </p>
                </div>
              </div>

            {% when 'newsletter' %}
              <div class="custom-footer__col custom-footer__col--newsletter" {{ block.shopify_attributes }}>
                <h4 class="custom-footer__col-heading">{{ block.settings.heading | default: 'BE THE FIRST TO KNOW' }}</h4>
                {% if block.settings.subtext != blank %}
                  <p class="custom-footer__newsletter-desc">
                    {{ block.settings.subtext }}
                  </p>
                {% endif %}
                {% assign newsletter_id = 'FooterNewsletter-' | append: section.id | append: block.id %}
                {% form 'customer', id: newsletter_id, class: 'custom-footer__newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter, footer-vip">
                  <div class="custom-footer__newsletter-field-wrapper">
                    <input
                      type="email"
                      name="contact[email]"
                      aria-label="{{ 'blocks.email_signup.label' | t }}"
                      class="custom-footer__newsletter-input"
                      placeholder="{{ block.settings.placeholder | default: 'Enter your email ID' }}"
                      required
                      autocomplete="email"
                    >
                    <button type="submit" class="custom-footer__newsletter-btn">
                      {{ block.settings.button_text | default: 'SUBSCRIBE' }}
                    </button>
                  </div>
                  {% if form.errors %}
                    <div class="custom-footer__form-message" role="alert">{{ form.errors | default_errors }}</div>
                  {% endif %}
                  {% if form.posted_successfully? %}
                    <p class="custom-footer__form-message custom-footer__form-message--success">
                      ✓ Welcome to The Raw House.
                    </p>
                  {% endif %}
                {% endform %}

                <div class="custom-footer__concierge-block">
                  <h5 class="custom-footer__col-heading custom-footer__col-heading--concierge">{{ section.settings.concierge_heading | default: 'CONCIERGE' }}</h5>
                  <p class="custom-footer__concierge-text">
                    {{ section.settings.concierge_text | default: '+91 80030 11110 / concierge@thehouseofthings.com' }}
                  </p>
                </div>
              </div>

            {% when 'concierge' %}
              <div class="custom-footer__col custom-footer__col--concierge" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">{{ block.settings.heading | default: 'PRIVATE ART CONCIERGE' }}</span>
                  <svg class="custom-footer__accordion-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <div class="custom-footer__concierge-info">
                    <p><strong>Advisory Hours:</strong> {{ block.settings.hours | default: 'Mon - Sat: 9am - 7pm EST' }}</p>
                    <p><strong>Direct Hotline:</strong> <a href="tel:{{ block.settings.phone | default: '+18007294687' }}">{{ block.settings.phone_display | default: '+1 (800) 729-4687' }}</a></p>
                    <p><strong>Inquiries:</strong> <a href="mailto:{{ block.settings.email | default: 'concierge@therawhouse.com' }}">{{ block.settings.email | default: 'concierge@therawhouse.com' }}</a></p>
                  </div>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      {% else %}
        <!-- Default Presets when No Blocks Added in Customizer -->
        <!-- Column 1: The Atelier Menu -->
        <div class="custom-footer__col custom-footer__col--menu">
          <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
            <span class="custom-footer__col-heading">{{ section.settings.about_heading | default: 'THE ATELIER' }}</span>
            <svg class="custom-footer__accordion-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="custom-footer__accordion-content">
            <ul class="custom-footer__links-list" role="list">
              {% if section.settings.about_menu != blank %}
                {% for link in section.settings.about_menu.links %}
                  <li><a href="{{ link.url }}" class="custom-footer__link">{{ link.title }}</a></li>
                {% endfor %}
              {% else %}
                <li><a href="/pages/about-us" class="custom-footer__link">OUR STORY & PHILOSOPHY</a></li>
                <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">ORIGINAL OIL PAINTINGS</a></li>
                <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">BRONZE & MARBLE SCULPTURES</a></li>
                <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link">3D SAJAWAT ART MODELS</a></li>
                <li><a href="/blogs/news" class="custom-footer__link">COLLECTORS JOURNAL</a></li>
                <li><a href="/pages/contact" class="custom-footer__link">CONTACT & ATELIER</a></li>
              {% endif %}
            </ul>
          </div>
        </div>

        <!-- Column 2: Client Services Menu -->
        <div class="custom-footer__col custom-footer__col--menu">
          <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
            <span class="custom-footer__col-heading">{{ section.settings.services_heading | default: 'CLIENT SERVICES' }}</span>
            <svg class="custom-footer__accordion-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="custom-footer__accordion-content">
            <ul class="custom-footer__links-list" role="list">
              {% if section.settings.services_menu != blank %}
                {% for link in section.settings.services_menu.links %}
                  <li><a href="{{ link.url }}" class="custom-footer__link">{{ link.title }}</a></li>
                {% endfor %}
              {% else %}
                <li><a href="/pages/concierge" class="custom-footer__link">PRIVATE ART ADVISORY</a></li>
                <li><a href="/pages/b2b" class="custom-footer__link">TRADE & ARCHITECTS (B2B)</a></li>
                <li><a href="/pages/commissions" class="custom-footer__link">BESPOKE COMMISSIONS</a></li>
                <li><a href="/policies/shipping-policy" class="custom-footer__link">WHITE GLOVE CRATING & TRANSIT</a></li>
                <li><a href="/policies/terms-of-service" class="custom-footer__link">AUTHENTICITY & PROVENANCE</a></li>
                <li><a href="/policies/privacy-policy" class="custom-footer__link">PRIVACY POLICY</a></li>
              {% endif %}
            </ul>
          </div>
        </div>

        <!-- Column 3: Newsletter & Concierge -->
        <div class="custom-footer__col custom-footer__col--newsletter">
          <h4 class="custom-footer__col-heading">{{ section.settings.newsletter_heading | default: 'THE COLLECTORS CIRCLE' }}</h4>
          <p class="custom-footer__newsletter-desc">
            Subscribe for confidential previews of newly acquired original canvases, rare bronze sculptures, and private exhibition vernissages.
          </p>

          {% assign newsletter_id = 'FooterNewsletter-' | append: section.id %}
          {% form 'customer', id: newsletter_id, class: 'custom-footer__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter, footer-vip">
            <div class="custom-footer__newsletter-field-wrapper">
              <input
                type="email"
                name="contact[email]"
                aria-label="{{ 'blocks.email_signup.label' | t }}"
                class="custom-footer__newsletter-input"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address...' }}"
                required
                autocomplete="email"
              >
              <button type="submit" class="custom-footer__newsletter-btn">
                {{ section.settings.newsletter_button_text | default: 'JOIN' }}
              </button>
            </div>
            {% if form.errors %}
              <div class="custom-footer__form-message" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}
            {% if form.posted_successfully? %}
              <p class="custom-footer__form-message custom-footer__form-message--success">
                ✓ Thank you for subscribing to The Raw House.
              </p>
            {% endif %}
          {% endform %}

          <div class="custom-footer__concierge-block">
            <h5 class="custom-footer__concierge-heading">{{ section.settings.concierge_heading | default: 'PRIVATE CONCIERGE' }}</h5>
            <p class="custom-footer__concierge-text">{{ section.settings.concierge_text | default: '+1 (800) 729-4687 / concierge@therawhouse.com' }}</p>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Middle Row: Payment Badges, Socials & Back to Top -->
    <div class="custom-footer__middle-row">
      <!-- Payment Badges -->
      <div class="custom-footer__payment-col">
        <h4 class="custom-footer__sub-heading">{{ section.settings.payment_heading | default: 'PAYMENT METHODS' }}</h4>
        <div class="custom-footer__payment-icons">
          <span class="custom-footer__payment-item" title="PayPal">
            <svg class="payment-icon" viewBox="0 0 64 24" fill="none" style="width: 48px; height: 18px;">
              <text x="2" y="17" font-family="'Helvetica Neue', Arial, sans-serif" font-size="14" font-style="italic" font-weight="700" fill="#003087">Pay<tspan fill="#0079C1">Pal</tspan></text>
            </svg>
          </span>
          <span class="custom-footer__payment-item" title="Visa">
            <svg class="payment-icon" viewBox="0 0 54 24" fill="none" style="width: 44px; height: 18px;">
              <text x="2" y="17" font-family="'Helvetica Neue', Arial, sans-serif" font-size="14" font-style="italic" font-weight="800" fill="#1A1F71" letter-spacing="1">VISA</text>
            </svg>
          </span>
          <span class="custom-footer__payment-item" title="Mastercard">
            <svg class="payment-icon" viewBox="0 0 38 24" fill="none" style="width: 32px; height: 18px;">
              <circle cx="13" cy="12" r="9" fill="#EB001B"/>
              <circle cx="23" cy="12" r="9" fill="#F79E1B" fill-opacity="0.88"/>
            </svg>
          </span>
          <span class="custom-footer__payment-item" title="Amex">
            <svg class="payment-icon" viewBox="0 0 50 24" fill="none" style="width: 42px; height: 18px;">
              <rect width="48" height="20" rx="3" fill="#006FCF"/>
              <text x="6" y="14" font-family="'Helvetica Neue', Arial, sans-serif" font-size="10" font-weight="700" fill="#ffffff">AMEX</text>
            </svg>
          </span>
        </div>
      </div>

      <!-- Social Icons -->
      <div class="custom-footer__social-col">
        <h4 class="custom-footer__sub-heading">{{ section.settings.social_heading | default: 'CONNECT & EXHIBITIONS' }}</h4>
        <div class="custom-footer__social-icons">
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" class="custom-footer__social-badge" aria-label="Facebook">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="custom-footer__social-badge" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank or section.settings.twitter_url != blank %}
            {% assign x_url = section.settings.twitter_url | default: section.settings.pinterest_url %}
            <a href="{{ x_url }}" target="_blank" rel="noopener" class="custom-footer__social-badge" aria-label="X">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Back to Top Button -->
      <div class="custom-footer__top-button-col">
        <button type="button" class="custom-footer__back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});">
          <span>Back to Top</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal -->
    <div class="custom-footer__bottom-row">
      <p class="custom-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'The Raw House Atelier Pvt Ltd. All rights reserved.' }}
      </p>
    </div>
  </div>
</footer>

<style>
  .custom-luxury-footer {
    background: #f7f7f7 !important;
    color: #111111 !important;
    padding-top: var(--footer-padding-top, 48px);
    padding-bottom: var(--footer-padding-bottom, 36px);
    border-top: 1px solid #e5e5e5 !important;
    position: relative;
  }

  .custom-footer__container {
    max-width: var(--footer-max-width, 1140px);
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Brand Header (Hidden by default to match THOT) */
  .custom-footer__brand-header {
    text-align: center;
    padding-bottom: 28px;
    margin-bottom: 28px;
    border-bottom: 1px solid #e5e5e5;
  }

  .custom-footer__monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #111111;
    color: #111111;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    margin-bottom: 10px;
  }

  .custom-footer__brand-title {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #111111;
    margin: 0 0 4px;
  }

  .custom-footer__brand-tagline {
    font-size: 11.5px;
    color: #555555;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* Top Columns Grid: 3 columns matching THOT */
  .custom-footer__top-row {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 5vw, 64px);
    padding-bottom: 36px;
    border-bottom: 1px solid #e5e5e5 !important;
  }

  .custom-footer__col-heading {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: #111111 !important;
    margin: 0 0 16px !important;
    display: block !important;
  }

  .custom-footer__accordion-trigger {
    background: transparent;
    border: none;
    padding: 0;
    color: #111111 !important;
    text-align: left;
    width: 100%;
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .custom-footer__accordion-icon {
    display: none;
    color: #111111 !important;
  }

  .custom-footer__links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .custom-footer__link {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: #555555 !important;
    text-decoration: none !important;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .custom-footer__link:hover {
    color: #000000 !important;
    transform: translateX(2px);
  }

  .custom-footer__text-content {
    overflow-wrap: anywhere;
    font-size: 12px;
    line-height: 1.6;
    color: #555555 !important;
    margin: 0;
  }

  /* Newsletter Block */
  .custom-footer__newsletter-desc {
    font-size: 11.5px;
    line-height: 1.5;
    color: #555555 !important;
    margin: 0 0 12px;
  }

  .custom-footer__newsletter-field-wrapper {
    display: flex !important;
    align-items: center !important;
    background: transparent !important;
    border: none !important;
    border-bottom: 1px solid #111111 !important;
    border-radius: 0 !important;
    overflow: visible !important;
    margin-bottom: 18px !important;
    transition: border-color 0.25s ease;
  }

  .custom-footer__newsletter-field-wrapper:focus-within {
    border-bottom-color: #000000 !important;
    box-shadow: none !important;
  }

  .custom-footer__newsletter-input {
    flex: 1 !important;
    min-width: 0;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    padding: 6px 0 !important;
    font-size: 11.5px !important;
    color: #111111 !important;
    font-family: inherit !important;
    letter-spacing: 0.02em !important;
  }

  .custom-footer__newsletter-input::placeholder {
    color: #888888 !important;
  }

  .custom-footer__newsletter-btn {
    background: transparent !important;
    color: #111111 !important;
    border: none !important;
    padding: 6px 0 !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    text-decoration: underline !important;
    text-underline-offset: 4px !important;
    cursor: pointer !important;
    transition: opacity 0.2s ease !important;
  }

  .custom-footer__newsletter-btn:hover {
    background: transparent !important;
    color: #111111 !important;
    opacity: 0.6 !important;
  }

  .custom-footer__form-message--success {
    color: #111111 !important;
    font-size: 11px;
    margin-top: 6px;
    font-weight: 500;
  }

  /* Concierge under Newsletter */
  .custom-footer__concierge-block {
    padding-top: 14px;
    border-top: none !important;
  }

  .custom-footer__col-heading--concierge {
    font-size: 11px !important;
    margin-bottom: 6px !important;
  }

  .custom-footer__concierge-text {
    font-size: 11px !important;
    line-height: 1.5 !important;
    color: #555555 !important;
    letter-spacing: 0.04em !important;
    margin: 0 !important;
  }

  /* Middle Row: Payment Methods & Socials */
  .custom-footer__middle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    border-bottom: 1px solid #e5e5e5 !important;
    flex-wrap: wrap;
    gap: 20px;
  }

  .custom-footer__sub-heading {
    font-size: 10.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: #111111 !important;
    margin: 0 0 10px !important;
  }

  .custom-footer__payment-icons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .custom-footer__payment-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 2px 8px;
    background: #ffffff !important;
    border: 1px solid #e0e0e0 !important;
    border-radius: 3px;
  }

  .custom-footer__social-icons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .custom-footer__social-badge {
    width: 28px !important;
    height: 28px !important;
    border-radius: 50% !important;
    background: #1a1a1a !important;
    border: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #ffffff !important;
    text-decoration: none !important;
    transition: transform 0.2s ease, opacity 0.2s ease !important;
  }

  .custom-footer__social-badge:hover {
    transform: scale(1.1) !important;
    opacity: 0.8 !important;
  }

  .custom-footer__back-to-top {
    display: none !important;
  }

  .custom-footer__bottom-row {
    padding-top: 18px;
    text-align: center;
  }

  .custom-footer__copyright {
    font-size: 10.5px !important;
    letter-spacing: 0.04em !important;
    color: #777777 !important;
    margin: 0;
  }

  /* ==========================================================================
     MOBILE (PHONE) PERFECTION & INTERACTIVE ACCORDIONS
     ========================================================================== */

  @media screen and (max-width: 768px) {
    .custom-luxury-footer {
      padding-top: 36px;
      padding-bottom: 24px;
    }

    .custom-footer__container {
      padding: 0 16px;
    }

    .custom-footer__brand-header {
      padding-bottom: 24px;
      margin-bottom: 24px;
    }

    .custom-footer__top-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-bottom: 24px;
    }

    .custom-footer__col {
      border-bottom: 1px solid #e5e5e5;
    }

    .custom-footer__col:last-child {
      border-bottom: none;
    }

    /* Accordion Interactive Trigger */
    .custom-footer__accordion-trigger {
      padding: 16px 0;
      cursor: pointer;
    }

    .custom-footer__col-heading {
      font-size: 13.5px;
      letter-spacing: 0.14em;
      margin: 0;
    }

    .custom-footer__accordion-icon {
      display: block;
    }

    /* Collapsible Content */
    .custom-footer__accordion-content {
      display: block;
    }

    .custom-footer__col.is-collapsible:not(.is-open) .custom-footer__accordion-content {
      display: none;
    }

    .custom-footer__col.is-open .custom-footer__accordion-content {
      padding-bottom: 16px;
    }

    .custom-footer__col.is-open .custom-footer__accordion-icon {
      transform: rotate(180deg);
    }

    .custom-footer__links-list {
      gap: 10px;
    }

    .custom-footer__link {
      font-size: 11px;
      padding: 2px 0;
    }

    /* Newsletter On Mobile (Always Expanded for Conversion) */
    .custom-footer__col--newsletter {
      padding: 20px 0 10px;
      border-bottom: none;
    }

    .custom-footer__col--newsletter .custom-footer__col-heading {
      margin-bottom: 10px;
    }

    .custom-footer__middle-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 18px;
      padding: 20px 0;
    }

    .custom-footer__payment-col,
    .custom-footer__social-col,
    .custom-footer__top-button-col {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .custom-footer__payment-icons {
      justify-content: center;
      flex-wrap: wrap;
    }

    .custom-footer__social-icons {
      justify-content: center;
    }
  }
</style>

<script>
  (function() {
    if (window.__rawHouseFooterInitialized) return;
    window.__rawHouseFooterInitialized = true;
    function initFooterAccordions() {
      document.querySelectorAll('.custom-footer__accordion-trigger').forEach(function(btn) {
        var col = btn.closest('.custom-footer__col');
        if (!col) return;
        col.classList.add('is-collapsible');
        btn.setAttribute('aria-expanded', String(window.innerWidth > 768 || col.classList.contains('is-open')));
        if (btn.dataset.accordionInit) return;
        btn.dataset.accordionInit = 'true';
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          if (window.innerWidth > 768) return;
          var col = this.closest('.custom-footer__col');
          if (!col) return;
          var isExpanded = this.getAttribute('aria-expanded') === 'true';
          this.setAttribute('aria-expanded', !isExpanded);
          col.classList.toggle('is-open', !isExpanded);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterAccordions);
    } else {
      initFooterAccordions();
    }
    window.addEventListener('resize', initFooterAccordions);
    document.addEventListener('shopify:section:load', initFooterAccordions);
  })();
</script>

