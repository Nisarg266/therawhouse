<script>
  (function() {
    function initFooterAccordions() {
      var triggers = document.querySelectorAll('.custom-footer__accordion-trigger');
      triggers.forEach(function(btn) {
        var col = btn.closest('.custom-footer__col');
        if (!col) return;
        col.classList.add('is-collapsible');
        var isDesktop = window.innerWidth > 989;
        btn.setAttribute('aria-expanded', String(isDesktop || col.classList.contains('is-open')));

        if (btn.dataset.accordionInit) return;
        btn.dataset.accordionInit = 'true';

        btn.addEventListener('click', function(e) {
          if (window.innerWidth > 989) return;
          e.preventDefault();
          var col = this.closest('.custom-footer__col');
          if (!col) return;
          var isExpanded = this.getAttribute('aria-expanded') === 'true';
          this.setAttribute('aria-expanded', !isExpanded);
          col.classList.toggle('is-open', !isExpanded);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterAccordions);
    } else {
      initFooterAccordions();
    }

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(initFooterAccordions, 150);
    });

    document.addEventListener('shopify:section:load', initFooterAccordions);
  })();
</script>

