{%- comment -%}
  THE RAW HOUSE — ULTRA-LUXURY ATELIER ADVANCED FOOTER
  World-class architectural footer supporting:
  - Multi-palette luxury aesthetics (Atelier Noir, Museum Linen, Minimal White, Bespoke Custom)
  - Custom brand logo or monogram emblem with curatorial ornament
  - Modular blocks: Navigation Menus (1 or 2 cols), Editorial Text, VIP Newsletter, Concierge, Trust Assurances, Social
  - Interactive smooth mobile accordions
  - Verified SSL security & payment badges (Visa, Mastercard, Amex, UPI, PayPal, Apple Pay, Net Banking)
  - Curated social media presence with WhatsApp Concierge hotline
  - Localization country/currency and language selectors
  - Dynamic legal policy links and smooth back-to-top
{%- endcomment -%}

{% liquid
  assign color_scheme = section.settings.color_scheme | default: 'noir'
%}

<footer
  id="CustomFooter-{{ section.id }}"
  class="custom-luxury-footer custom-luxury-footer--{{ color_scheme }} color-custom-{{ section.id }}"
  style="
    --footer-padding-top: {{ section.settings.padding_top | default: 48 }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom | default: 28 }}px;
    --footer-padding-top-m: {{ section.settings.padding_top_m | default: 32 }}px;
    --footer-padding-bottom-m: {{ section.settings.padding_bottom_m | default: 20 }}px;
    --footer-max-width: {{ section.settings.max_width | default: 1240 }}px;
    {% if color_scheme == 'custom' %}
      {% if section.settings.custom_bg != blank %}--flx-bg: {{ section.settings.custom_bg }} !important;{% endif %}
      {% if section.settings.custom_text != blank %}--flx-text: {{ section.settings.custom_text }} !important;{% endif %}
      {% if section.settings.custom_heading != blank %}--flx-heading: {{ section.settings.custom_heading }} !important;{% endif %}
      {% if section.settings.custom_gold != blank %}--flx-gold: {{ section.settings.custom_gold }} !important; --flx-border-accent: {{ section.settings.custom_gold }} !important;{% endif %}
      {% if section.settings.custom_border != blank %}--flx-border: {{ section.settings.custom_border }} !important;{% endif %}
    {% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="custom-footer__container">
    {% if section.settings.show_brand_header %}
      <!-- Brand Prestige Header -->
      <div class="custom-footer__brand-header">
        {% if section.settings.show_emblem %}
          <div class="custom-footer__emblem" aria-hidden="true">
            <span class="custom-footer__emblem-text">{{ section.settings.brand_emblem_text | default: 'TRH' }}</span>
          </div>
        {% endif %}

        {% if section.settings.brand_logo != blank %}
          <div class="custom-footer__brand-logo-wrap">
            <img
              src="{{ section.settings.brand_logo | image_url: width: 600 }}"
              alt="{{ section.settings.brand_logo.alt | default: section.settings.brand_name | default: shop.name | escape }}"
              class="custom-footer__brand-logo"
              loading="lazy"
              width="{{ section.settings.brand_logo.width }}"
              height="{{ section.settings.brand_logo.height }}"
              style="max-width: {{ section.settings.logo_width | default: 160 }}px; width: 100%; height: auto;"
            >
          </div>
        {% else %}
          <h3 class="custom-footer__brand-title">{{ section.settings.brand_name | default: 'THE RAW HOUSE' }}</h3>
        {% endif %}

        {% if section.settings.brand_tagline != blank %}
          <p class="custom-footer__brand-tagline">
            {{ section.settings.brand_tagline }}
          </p>
        {% endif %}

        {% assign ornament = section.settings.ornament_symbol | default: 'diamond' %}
        {% if ornament != 'none' %}
          <div class="custom-footer__brand-ornament" aria-hidden="true">
            <span class="custom-footer__ornament-line"></span>
            {% if ornament == 'diamond' %}
              <span class="custom-footer__ornament-diamond">◆</span>
            {% elsif ornament == 'star' %}
              <span class="custom-footer__ornament-diamond">✦</span>
            {% elsif ornament == 'bar' %}
              <span class="custom-footer__ornament-diamond">—</span>
            {% endif %}
            <span class="custom-footer__ornament-line"></span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- Main Content Columns / Dynamic Blocks -->
    <div class="custom-footer__top-row">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu' %}
              <div class="custom-footer__col custom-footer__col--menu {% if block.settings.columns == '2' %}custom-footer__col--menu-double{% endif %}" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'EXPLORE' }}
                  </span>
                  <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <ul class="custom-footer__links-list {% if block.settings.columns == '2' %}custom-footer__links-list--2cols{% endif %}" role="list">
                    {% if block.settings.menu != blank %}
                      {% for link in block.settings.menu.links %}
                        <li>
                          <a href="{{ link.url }}" class="custom-footer__link">
                            {% if block.settings.show_bullets != false %}<span class="custom-footer__link-bullet">›</span>{% endif %}
                            <span>{{ link.title }}</span>
                          </a>
                        </li>
                      {% endfor %}
                    {% else %}
                      {% assign h_upper = block.settings.heading | upcase %}
                      {% if h_upper contains 'ABOUT' %}
                        <li><a href="/pages/about-us" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>OUR STORY</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>MAKERS & ATELIER</span></a></li>
                        <li><a href="/blogs/news" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>THE JOURNAL</span></a></li>
                        <li><a href="/pages/contact" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>PRESS & EXHIBITIONS</span></a></li>
                        <li><a href="/policies/privacy-policy" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>PRIVACY POLICY</span></a></li>
                        <li><a href="/pages/contact" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>CONTACT ATELIER</span></a></li>
                      {% elsif h_upper contains 'SERVICE' %}
                        <li><a href="/pages/contact" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>PRIVATE CONCIERGE</span></a></li>
                        <li><a href="/pages/contact" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>TRADE & ARCHITECTS (B2B)</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>BESPOKE INTERIORS</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>WHITE GLOVE COMMISSIONS</span></a></li>
                        <li><a href="/policies/shipping-policy" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>SHIPPING & TRANSIT</span></a></li>
                        <li><a href="/policies/terms-of-service" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>TERMS & AUTHENTICITY</span></a></li>
                      {% else %}
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>Original Oil Paintings</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>Bronze & Marble Sculptures</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>3D Sajawat Art Models</span></a></li>
                        <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>Archival Fine Prints</span></a></li>
                      {% endif %}
                    {% endif %}
                  </ul>
                </div>
              </div>

            {% when 'text' %}
              <div class="custom-footer__col custom-footer__col--text" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'ABOUT THE ATELIER' }}
                  </span>
                  <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <div class="custom-footer__text-content">
                    {{ block.settings.text | default: 'Dedicated to museum-grade original canvas paintings, hand-cast bronze statuettes, and architectural decorative models crafted with singular intention.' }}
                  </div>
                  {% if block.settings.author_title != blank %}
                    <p class="custom-footer__author-sign">{{ block.settings.author_title }}</p>
                  {% endif %}
                </div>
              </div>

            {% when 'newsletter' %}
              <div class="custom-footer__col custom-footer__col--newsletter" {{ block.shopify_attributes }}>
                <div class="custom-footer__newsletter-card">
                  {% if block.settings.badge_text != blank %}
                    <div class="custom-footer__vip-pill">
                      <span class="custom-footer__vip-sparkle">✦</span>
                      <span>{{ block.settings.badge_text }}</span>
                    </div>
                  {% endif %}
                  <h4 class="custom-footer__col-heading custom-footer__col-heading--newsletter">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'BE THE FIRST TO KNOW' }}
                  </h4>
                  <p class="custom-footer__newsletter-desc">
                    {{ block.settings.subtext | default: 'Sign up for privileged access to rare salon collections, exhibition previews, and bespoke atelier releases.' }}
                  </p>
                  {% assign newsletter_id = 'FooterNewsletter-' | append: section.id | append: block.id %}
                  {% form 'customer', id: newsletter_id, class: 'custom-footer__newsletter-form' %}
                    <input type="hidden" name="contact[tags]" value="newsletter, footer-vip">
                    <div class="custom-footer__newsletter-field-wrapper">
                      <input
                        type="email"
                        name="contact[email]"
                        aria-label="{{ 'blocks.email_signup.label' | t }}"
                        class="custom-footer__newsletter-input"
                        placeholder="{{ block.settings.placeholder | default: 'Enter your email address...' }}"
                        required
                        autocomplete="email"
                      >
                      <button type="submit" class="custom-footer__newsletter-btn">
                        <span>{{ block.settings.button_text | default: 'SUBSCRIBE' }}</span>
                        <svg class="custom-footer__btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </button>
                    </div>
                    {% if form.errors %}
                      <div class="custom-footer__form-message custom-footer__form-message--error" role="alert">
                        {{ form.errors | default_errors }}
                      </div>
                    {% endif %}
                    {% if form.posted_successfully? %}
                      <p class="custom-footer__form-message custom-footer__form-message--success">
                        ✓ Welcome to The Raw House. Your invitation is confirmed.
                      </p>
                    {% endif %}
                  {% endform %}
                  <p class="custom-footer__privacy-note">{{ block.settings.privacy_note | default: 'Strictly confidential. No spam, ever.' }}</p>
                </div>
              </div>

            {% when 'concierge' %}
              <div class="custom-footer__col custom-footer__col--concierge" {{ block.shopify_attributes }}>
                <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
                  <span class="custom-footer__col-heading">
                    <span class="custom-footer__heading-accent"></span>
                    {{ block.settings.heading | default: 'PRIVATE ART CONCIERGE' }}
                  </span>
                  <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="custom-footer__accordion-content">
                  <div class="custom-footer__concierge-info">
                    {% if block.settings.hours != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Advisory Hours:</strong>
                        <span>{{ block.settings.hours }}</span>
                      </p>
                    {% endif %}
                    {% if block.settings.phone_display != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Direct Hotline:</strong>
                        <a href="tel:{{ block.settings.phone | default: block.settings.phone_display | replace: ' ', '' }}">{{ block.settings.phone_display }}</a>
                      </p>
                    {% endif %}
                    {% if block.settings.email != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Inquiries:</strong>
                        <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                      </p>
                    {% endif %}
                    {% if block.settings.address != blank %}
                      <p class="custom-footer__concierge-row">
                        <strong>Atelier Salon:</strong>
                        <span>{{ block.settings.address }}</span>
                      </p>
                    {% endif %}
                    {% if block.settings.whatsapp_url != blank %}
                      <div class="custom-footer__whatsapp-wrap custom-footer__whatsapp-wrap--block">
                        <a href="{{ block.settings.whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__whatsapp-btn">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                          </svg>
                          <span>{{ block.settings.whatsapp_label | default: 'Chat with Private Concierge' }}</span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>

            {% when 'trust_badges' %}
              <div class="custom-footer__col custom-footer__col--trust" {{ block.shopify_attributes }}>
                <h4 class="custom-footer__col-heading">
                  <span class="custom-footer__heading-accent"></span>
                  {{ block.settings.heading | default: 'ATELIER PROMISES' }}
                </h4>
                <div class="custom-footer__trust-list">
                  {% if block.settings.badge_1_text != blank %}
                    <div class="custom-footer__trust-item">
                      <span class="custom-footer__trust-icon">✦</span>
                      <span class="custom-footer__trust-text">{{ block.settings.badge_1_text }}</span>
                    </div>
                  {% endif %}
                  {% if block.settings.badge_2_text != blank %}
                    <div class="custom-footer__trust-item">
                      <span class="custom-footer__trust-icon">✦</span>
                      <span class="custom-footer__trust-text">{{ block.settings.badge_2_text }}</span>
                    </div>
                  {% endif %}
                  {% if block.settings.badge_3_text != blank %}
                    <div class="custom-footer__trust-item">
                      <span class="custom-footer__trust-icon">✦</span>
                      <span class="custom-footer__trust-text">{{ block.settings.badge_3_text }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>

            {% when 'social_block' %}
              <div class="custom-footer__col custom-footer__col--social" {{ block.shopify_attributes }}>
                <h4 class="custom-footer__col-heading">
                  <span class="custom-footer__heading-accent"></span>
                  {{ block.settings.heading | default: 'CONNECT & FOLLOW' }}
                </h4>
                {% if block.settings.subtext != blank %}
                  <p class="custom-footer__social-desc">{{ block.settings.subtext }}</p>
                {% endif %}
                <div class="custom-footer__social-icons custom-footer__social-icons--block">
                  {% if block.settings.instagram_url != blank %}
                    <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__social-badge" aria-label="Instagram">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                      </svg>
                    </a>
                  {% endif %}
                  {% if block.settings.facebook_url != blank %}
                    <a href="{{ block.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__social-badge" aria-label="Facebook">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                      </svg>
                    </a>
                  {% endif %}
                  {% if block.settings.pinterest_url != blank %}
                    <a href="{{ block.settings.pinterest_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__social-badge" aria-label="Pinterest">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                        <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      {% else %}
        <!-- Default Presets when No Blocks Added -->
        <div class="custom-footer__col custom-footer__col--menu">
          <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
            <span class="custom-footer__col-heading">
              <span class="custom-footer__heading-accent"></span>
              THE ATELIER
            </span>
            <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="custom-footer__accordion-content">
            <ul class="custom-footer__links-list" role="list">
              <li><a href="/pages/about-us" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>OUR STORY & PHILOSOPHY</span></a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>ORIGINAL OIL PAINTINGS</span></a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>BRONZE & MARBLE SCULPTURES</span></a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>3D SAJAWAT ART MODELS</span></a></li>
              <li><a href="/blogs/news" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>COLLECTORS JOURNAL</span></a></li>
              <li><a href="/pages/contact" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>CONTACT & ATELIER</span></a></li>
            </ul>
          </div>
        </div>

        <div class="custom-footer__col custom-footer__col--menu">
          <button type="button" class="custom-footer__accordion-trigger" aria-expanded="false">
            <span class="custom-footer__col-heading">
              <span class="custom-footer__heading-accent"></span>
              CLIENT SERVICES
            </span>
            <svg class="custom-footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="custom-footer__accordion-content">
            <ul class="custom-footer__links-list" role="list">
              <li><a href="/pages/contact" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>PRIVATE ART ADVISORY</span></a></li>
              <li><a href="/pages/contact" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>TRADE & ARCHITECTS (B2B)</span></a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>BESPOKE COMMISSIONS</span></a></li>
              <li><a href="/policies/shipping-policy" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>WHITE GLOVE CRATING & TRANSIT</span></a></li>
              <li><a href="/policies/terms-of-service" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>AUTHENTICITY & PROVENANCE</span></a></li>
              <li><a href="/policies/privacy-policy" class="custom-footer__link"><span class="custom-footer__link-bullet">›</span><span>PRIVACY POLICY</span></a></li>
            </ul>
          </div>
        </div>

        <div class="custom-footer__col custom-footer__col--newsletter">
          <div class="custom-footer__newsletter-card">
            <div class="custom-footer__vip-pill">
              <span class="custom-footer__vip-sparkle">✦</span>
              <span>VIP COLLECTORS CIRCLE</span>
            </div>
            <h4 class="custom-footer__col-heading custom-footer__col-heading--newsletter">
              <span class="custom-footer__heading-accent"></span>
              BE THE FIRST TO KNOW
            </h4>
            <p class="custom-footer__newsletter-desc">
              Subscribe for confidential previews of newly acquired original canvases, rare bronze sculptures, and private exhibition vernissages.
            </p>
            {% assign newsletter_id = 'FooterNewsletter-' | append: section.id %}
            {% form 'customer', id: newsletter_id, class: 'custom-footer__newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter, footer-vip">
              <div class="custom-footer__newsletter-field-wrapper">
                <input
                  type="email"
                  name="contact[email]"
                  aria-label="{{ 'blocks.email_signup.label' | t }}"
                  class="custom-footer__newsletter-input"
                  placeholder="Enter your email address..."
                  required
                  autocomplete="email"
                >
                <button type="submit" class="custom-footer__newsletter-btn">
                  <span>JOIN</span>
                  <svg class="custom-footer__btn-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>
              {% if form.posted_successfully? %}
                <p class="custom-footer__form-message custom-footer__form-message--success">
                  ✓ Welcome to The Raw House. Your invitation is confirmed.
                </p>
              {% endif %}
            {% endform %}
            <p class="custom-footer__privacy-note">Strictly confidential. No spam, ever.</p>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Middle Row: Payment Badges, Socials & Back to Top -->
    <div class="custom-footer__middle-row">
      <!-- Payment Badges & Trust -->
      {% if section.settings.show_payment_methods != false %}
        <div class="custom-footer__payment-col">
          <div class="custom-footer__sub-heading-wrap">
            <h4 class="custom-footer__sub-heading">{{ section.settings.payment_heading | default: 'PAYMENT METHODS' }}</h4>
            {% if section.settings.show_ssl_badge != false %}
              <span class="custom-footer__ssl-badge">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C9.243 2 7 4.243 7 7v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7c0-2.757-2.243-5-5-5zM9 7c0-1.654 1.346-3 3-3s3 1.346 3 3v3H9V7zm3 10a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                </svg>
                <span>256-BIT SSL ENCRYPTED</span>
              </span>
            {% endif %}
          </div>

          {% if section.settings.payment_custom_image != blank %}
            <div class="custom-footer__payment-custom-wrap">
              <img
                src="{{ section.settings.payment_custom_image | image_url: width: 600 }}"
                alt="Payment Methods"
                class="custom-footer__payment-custom-img"
                loading="lazy"
                width="{{ section.settings.payment_custom_image.width }}"
                height="{{ section.settings.payment_custom_image.height }}"
              >
            </div>
          {% else %}
            <div class="custom-footer__payment-icons">
              <span class="custom-footer__payment-item" title="Visa">
                <svg viewBox="0 0 54 24" fill="none" style="width: 42px; height: 16px;">
                  <text x="2" y="17" font-family="'Inter', -apple-system, sans-serif" font-size="14" font-style="italic" font-weight="800" fill="currentColor" letter-spacing="1">VISA</text>
                </svg>
              </span>
              <span class="custom-footer__payment-item" title="Mastercard">
                <svg viewBox="0 0 38 24" fill="none" style="width: 32px; height: 18px;">
                  <circle cx="13" cy="12" r="9" fill="#EB001B"/>
                  <circle cx="23" cy="12" r="9" fill="#F79E1B" fill-opacity="0.88"/>
                </svg>
              </span>
              <span class="custom-footer__payment-item" title="American Express">
                <svg viewBox="0 0 50 24" fill="none" style="width: 40px; height: 18px;">
                  <rect width="48" height="20" rx="3" fill="#006FCF"/>
                  <text x="6" y="14" font-family="'Inter', -apple-system, sans-serif" font-size="10" font-weight="700" fill="#ffffff">AMEX</text>
                </svg>
              </span>
              <span class="custom-footer__payment-item" title="UPI & Net Banking">
                <span class="custom-footer__text-badge">UPI</span>
              </span>
              <span class="custom-footer__payment-item" title="PayPal">
                <svg viewBox="0 0 64 24" fill="none" style="width: 46px; height: 16px;">
                  <text x="2" y="17" font-family="'Inter', -apple-system, sans-serif" font-size="13" font-style="italic" font-weight="700" fill="currentColor">Pay<tspan fill="#0079C1">Pal</tspan></text>
                </svg>
              </span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      <!-- Social Icons -->
      {% if section.settings.show_social_icons != false %}
        <div class="custom-footer__social-col">
          <h4 class="custom-footer__sub-heading">{{ section.settings.social_heading | default: 'FIND US ONLINE' }}</h4>
          <div class="custom-footer__social-icons">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__social-badge" aria-label="Instagram">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__social-badge" aria-label="Facebook">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.pinterest_url != blank or section.settings.twitter_url != blank %}
              {% assign x_url = section.settings.twitter_url | default: section.settings.pinterest_url %}
              <a href="{{ x_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__social-badge" aria-label="X">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.whatsapp_url != blank %}
              <a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__social-badge custom-footer__social-badge--whatsapp" aria-label="WhatsApp Concierge">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <!-- Back to Top Button -->
      {% if section.settings.show_back_to_top != false %}
        <div class="custom-footer__top-button-col">
          <button type="button" class="custom-footer__back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});" aria-label="Back to Top">
            <span>{{ section.settings.back_to_top_text | default: 'BACK TO TOP' }}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    <!-- Bottom Row: Copyright, Policies, Localization & Credits -->
    <div class="custom-footer__bottom-row">
      <div class="custom-footer__bottom-content">
        <p class="custom-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'The Raw House Living Pvt Ltd. All rights reserved.' }}
        </p>

        {% if section.settings.show_policy_links != false %}
          <span class="custom-footer__bottom-divider" aria-hidden="true">&bull;</span>
          <div class="custom-footer__policy-links">
            <a href="/policies/privacy-policy" class="custom-footer__policy-link">Privacy Policy</a>
            <span class="custom-footer__policy-dot">&bull;</span>
            <a href="/policies/terms-of-service" class="custom-footer__policy-link">Terms of Service</a>
            <span class="custom-footer__policy-dot">&bull;</span>
            <a href="/policies/shipping-policy" class="custom-footer__policy-link">Shipping & Returns</a>
          </div>
        {% endif %}

        {% if section.settings.show_credits != false %}
          <span class="custom-footer__bottom-divider" aria-hidden="true">&bull;</span>
          <p class="custom-footer__credits">
            {{ section.settings.credits_prefix | default: 'Mindfully made by' }}
            <a
              href="{{ section.settings.credits_url | default: 'https://scraft.studio/' }}"
              target="_blank"
              rel="noopener noreferrer"
              title="{{ section.settings.credits_title | default: 'SCRAFT - E-commerce growth, SEO & software studio' }}"
              aria-label="{{ section.settings.credits_title | default: 'SCRAFT - E-commerce growth, SEO & software studio' }}"
              class="custom-footer__credit-link"
            >
              {{- section.settings.credits_label | default: 'Scraft' -}}
            </a>
          </p>
        {% endif %}
      </div>

      {% if section.settings.show_country_selector or section.settings.show_language_selector %}
        <div class="custom-footer__localization-wrap">
          {% render 'localization-form',
            show_country: section.settings.show_country_selector,
            show_language: section.settings.show_language_selector,
            localization_style: 'dropdown',
            form_id: section.id
          %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

<style>
  /* ==========================================================================
     THE RAW HOUSE - ADVANCED LUXURY ARCHITECTURAL FOOTER DESIGN SYSTEM
     ========================================================================== */

  .custom-luxury-footer {
    position: relative;
    padding-top: var(--footer-padding-top, 48px);
    padding-bottom: var(--footer-padding-bottom, 28px);
    box-sizing: border-box;
    font-family: var(--lux-font-body, "Inter", -apple-system, sans-serif);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* --- ATELIER NOIR PALETTE (Deep Obsidian Luxury - Default) --- */
  .custom-luxury-footer--noir {
    --flx-bg: #11100e;
    --flx-card-bg: #191816;
    --flx-card-border: rgba(197, 168, 128, 0.2);
    --flx-border: rgba(255, 255, 255, 0.08);
    --flx-border-accent: rgba(197, 168, 128, 0.4);
    --flx-heading: #fcfbf9;
    --flx-text: #eae5dc;
    --flx-muted: #9e978c;
    --flx-gold: #c5a880;
    --flx-gold-hover: #dfc49e;
    --flx-link: #b5afa4;
    --flx-link-hover: #ffffff;
    --flx-input-bg: rgba(255, 255, 255, 0.05);
    --flx-input-border: rgba(255, 255, 255, 0.16);
    --flx-input-text: #ffffff;
    --flx-input-placeholder: #7c766d;
    --flx-btn-bg: #c5a880;
    --flx-btn-text: #11100e;
    --flx-btn-hover: #dfc49e;
    --flx-badge-bg: rgba(255, 255, 255, 0.06);
    --flx-badge-border: rgba(255, 255, 255, 0.12);
    --flx-badge-text: #eae5dc;
    background: var(--flx-bg) !important;
    color: var(--flx-text) !important;
    border-top: 1px solid var(--flx-border-accent) !important;
  }

  /* --- MUSEUM PARCHMENT PALETTE (Warm Alabaster Light) --- */
  .custom-luxury-footer--parchment {
    --flx-bg: #f9f8f5;
    --flx-card-bg: #ffffff;
    --flx-card-border: #ede8df;
    --flx-border: #eae6de;
    --flx-border-accent: #c5a880;
    --flx-heading: #121110;
    --flx-text: #242220;
    --flx-muted: #726b60;
    --flx-gold: #b38b4d;
    --flx-gold-hover: #967035;
    --flx-link: #524d45;
    --flx-link-hover: #000000;
    --flx-input-bg: #ffffff;
    --flx-input-border: #dcd7ce;
    --flx-input-text: #121110;
    --flx-input-placeholder: #8c857a;
    --flx-btn-bg: #121110;
    --flx-btn-text: #ffffff;
    --flx-btn-hover: #b38b4d;
    --flx-badge-bg: #ffffff;
    --flx-badge-border: #dedad0;
    --flx-badge-text: #121110;
    background: var(--flx-bg) !important;
    color: var(--flx-text) !important;
    border-top: 1px solid var(--flx-border) !important;
  }

  /* --- GALLERY MINIMAL WHITE PALETTE --- */
  .custom-luxury-footer--minimal_white {
    --flx-bg: #ffffff;
    --flx-card-bg: #fafafa;
    --flx-card-border: #eaeaea;
    --flx-border: #f0f0f0;
    --flx-border-accent: #c5a880;
    --flx-heading: #111111;
    --flx-text: #333333;
    --flx-muted: #777777;
    --flx-gold: #c5a880;
    --flx-gold-hover: #b38b4d;
    --flx-link: #555555;
    --flx-link-hover: #000000;
    --flx-input-bg: #ffffff;
    --flx-input-border: #e0e0e0;
    --flx-input-text: #111111;
    --flx-input-placeholder: #888888;
    --flx-btn-bg: #111111;
    --flx-btn-text: #ffffff;
    --flx-btn-hover: #c5a880;
    --flx-badge-bg: #f5f5f5;
    --flx-badge-border: #e8e8e8;
    --flx-badge-text: #111111;
    background: var(--flx-bg) !important;
    color: var(--flx-text) !important;
    border-top: 1px solid var(--flx-border) !important;
  }

  /* --- CUSTOM PALETTE --- */
  .custom-luxury-footer--custom {
    --flx-card-bg: rgba(255, 255, 255, 0.05);
    --flx-card-border: rgba(197, 168, 128, 0.25);
    --flx-muted: rgba(120, 120, 120, 0.9);
    --flx-gold-hover: #dfc49e;
    --flx-link: inherit;
    --flx-link-hover: var(--flx-gold, #c5a880);
    --flx-input-bg: rgba(255, 255, 255, 0.06);
    --flx-input-border: rgba(255, 255, 255, 0.2);
    --flx-input-text: inherit;
    --flx-input-placeholder: #888888;
    --flx-btn-bg: var(--flx-gold, #c5a880);
    --flx-btn-text: #111111;
    --flx-btn-hover: #ffffff;
    --flx-badge-bg: rgba(255, 255, 255, 0.08);
    --flx-badge-border: rgba(255, 255, 255, 0.15);
    --flx-badge-text: inherit;
    background: var(--flx-bg, #11100e) !important;
    color: var(--flx-text, #eae5dc) !important;
    border-top: 1px solid var(--flx-border, rgba(255, 255, 255, 0.1)) !important;
  }

  .custom-footer__container {
    max-width: var(--footer-max-width, 1240px);
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
  }

  /* --- 1. BRAND PRESTIGE HEADER --- */
  .custom-footer__brand-header {
    text-align: center;
    padding-bottom: 22px;
    margin-bottom: 24px;
    position: relative;
  }

  .custom-footer__emblem {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--flx-gold);
    color: var(--flx-gold);
    margin-bottom: 10px;
    box-shadow: 0 0 16px rgba(197, 168, 128, 0.15);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .custom-footer__emblem:hover {
    transform: scale(1.06);
    border-color: var(--flx-gold-hover);
  }

  .custom-footer__emblem-text {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    padding-left: 2px;
  }

  .custom-footer__brand-logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
  }

  .custom-footer__brand-logo {
    object-fit: contain;
    display: block;
  }

  .custom-footer__brand-title {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--flx-heading);
    margin: 0 0 5px;
  }

  .custom-footer__brand-tagline {
    font-size: 12.5px;
    color: var(--flx-muted);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 0 0 12px;
  }

  .custom-footer__brand-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: 240px;
    margin: 0 auto;
  }

  .custom-footer__ornament-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--flx-gold), transparent);
    opacity: 0.5;
  }

  .custom-footer__ornament-diamond {
    color: var(--flx-gold);
    font-size: 8px;
    line-height: 1;
    opacity: 0.8;
  }

  /* --- 2. TOP COLUMNS GRID --- */
  .custom-footer__top-row {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(24px, 3.5vw, 44px);
    padding-bottom: 28px;
    border-bottom: 1px solid var(--flx-border) !important;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .custom-footer__top-row:has(.custom-footer__col:nth-child(3):last-child) {
      grid-template-columns: 1fr 1fr 1.35fr;
    }
    .custom-footer__top-row:has(.custom-footer__col:nth-child(4):last-child) {
      grid-template-columns: 1fr 1fr 1.15fr 1.35fr;
    }
    .custom-footer__top-row:has(.custom-footer__col--menu-double) {
      grid-template-columns: 1.6fr 1fr 1.35fr;
    }
  }

  .custom-footer__col-heading {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flx-heading);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .custom-footer__heading-accent {
    width: 3px;
    height: 12px;
    background: var(--flx-gold);
    display: inline-block;
    border-radius: 1px;
    flex-shrink: 0;
  }

  .custom-footer__accordion-trigger {
    display: none;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .custom-footer__accordion-icon {
    display: none;
    transition: transform 0.3s ease;
    color: var(--flx-gold);
  }

  .custom-footer__links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .custom-footer__links-list--2cols {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
  }

  .custom-footer__link {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flx-link);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .custom-footer__link-bullet {
    color: var(--flx-gold);
    font-size: 14px;
    line-height: 1;
    opacity: 0.7;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .custom-footer__link:hover {
    color: var(--flx-link-hover);
    transform: translateX(3px);
  }

  .custom-footer__link:hover .custom-footer__link-bullet {
    opacity: 1;
    transform: translateX(2px);
  }

  .custom-footer__text-content {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--flx-muted);
    margin: 0 0 12px;
  }

  .custom-footer__author-sign {
    font-family: var(--lux-font-heading, "Playfair Display", Georgia, serif);
    font-size: 12px;
    font-style: italic;
    color: var(--flx-gold);
    letter-spacing: 0.06em;
    margin: 0;
  }

  /* --- VIP NEWSLETTER CARD --- */
