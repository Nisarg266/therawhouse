{% doc %}
  Renders a product enquiry button that opens the product enquiry modal.

  @example
  {% content_for 'block', type: 'product-enquiry', id: 'product-enquiry' %}
{% enddoc %}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product | default: product

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = product.selected_or_first_available_variant
  assign drawer_id = 'LuxProductEnquiryDrawer-' | append: section.id | append: '-' | append: block.id
-%}

{%- if product != blank -%}
  <div
    class="product-enquiry-block spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      class="product-enquiry-block__button button art-button"
      onclick="if (window.openProductEnquiryDrawer) { window.openProductEnquiryDrawer('{{ drawer_id }}'); }"
    >
      <span class="product-enquiry-block__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </span>
      <span>{{ block_settings.button_label | escape }}</span>
    </button>
  </div>

  {% render 'product-enquiry-drawer',
    product: product,
    variant: variant,
    drawer_id: drawer_id,
    mode: 'modal'
  %}
{%- endif -%}

{% stylesheet %}
  .product-enquiry-block {
    width: 100%;
  }

  .product-enquiry-block__button {
    width: 100%;
    min-height: var(--height-buy-buttons);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .product-enquiry-block__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product enquiry",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enquire about this piece"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product enquiry",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
