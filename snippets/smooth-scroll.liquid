{%- comment -%}
  Universal High-Performance Smooth Scrolling Engine for The House of Things
  Ensures 100% smooth, natural scrolling across Desktop, Tablet, and Mobile devices.
{%- endcomment -%}

<style>
  html {
    scroll-behavior: smooth !important;
    scrollbar-width: thin !important;
  }

  body {
    scroll-behavior: smooth !important;
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
  }

  .page-wrapper {
    scroll-behavior: smooth !important;
    -webkit-overflow-scrolling: touch !important;
  }

  @media (prefers-reduced-motion: reduce) {
    html, body, .page-wrapper {
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  (function initUniversalSmoothScroll() {
    if (window.__luxurySmoothScrollLoaded) return;
    window.__luxurySmoothScrollLoaded = true;

    function getScrollContainer() {
      if (window.innerWidth >= 990) {
        const pw = document.querySelector('.page-wrapper');
        if (pw && pw.scrollHeight > pw.clientHeight) {
          return pw;
        }
      }
      return window;
    }

    // Smooth Anchor and Internal Link Navigation
    document.addEventListener('click', function(e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const anchor = e.target.closest('a[href^="#"]');
      if (!anchor) return;
      const href = anchor.getAttribute('href');
      if (!href || href === '#') return;

      let targetId;
      try {
        targetId = decodeURIComponent(href.slice(1));
      } catch {
        return;
      }
      const targetElem = document.getElementById(targetId);
      if (targetElem) {
        e.preventDefault();
        const headerOffset = parseInt(getComputedStyle(document.body).getPropertyValue('--header-height')) || 120;
        const container = getScrollContainer();
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';

        if (container === window) {
          const targetPosition = targetElem.getBoundingClientRect().top + window.pageYOffset - headerOffset;
          window.scrollTo({
            top: targetPosition,
            behavior
          });
        } else {
          const targetPosition = targetElem.getBoundingClientRect().top - container.getBoundingClientRect().top + container.scrollTop - headerOffset;
          container.scrollTo({
            top: targetPosition,
            behavior
          });
        }
        if (!targetElem.hasAttribute('tabindex')) targetElem.setAttribute('tabindex', '-1');
        targetElem.focus({ preventScroll: true });
      }
    });

    // Ensure smooth scroll-to-top function is globally accessible
    window.scrollToTopSmooth = function() {
      const container = getScrollContainer();
      const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
      if (container === window) {
        window.scrollTo({ top: 0, behavior });
      } else {
        container.scrollTo({ top: 0, behavior });
      }
    };
  })();
</script>
