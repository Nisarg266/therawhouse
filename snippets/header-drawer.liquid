{%- doc -%}
  Renders the Ultra-Luxury Header Slide Drawer Navigation.
{%- enddoc -%}

<header-drawer class="header-drawer {{ class }}">
  <details
    id="Details-menu-drawer-container"
    data-skip-node-update="true"
    class="menu-drawer-container"
    ref="details"
  >
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'accessibility.menu' | t }}"
    >
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--open">
        {{- 'icon-menu.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="menu-drawer__backdrop" aria-hidden="true"></div>

    <div ref="menuDrawer" class="menu-drawer">
      <!-- Drawer Header -->
      <div class="menu-drawer__head">
        <div class="menu-drawer__brand">
          <span class="menu-drawer__brand-title">THE RAW HOUSE</span>
          <span class="menu-drawer__brand-sub">FINE ART & BESPOKE ATELIER</span>
        </div>
        <button
          type="button"
          class="menu-drawer__close-btn"
          aria-label="Close Navigation"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Drawer Spotlight Card -->
      <div class="menu-drawer__spotlight">
        <div class="menu-drawer__spotlight-media">
          <img
            src="{{ 'maker-gallery-1.jpg' | asset_url }}"
            alt="The Raw House Gallery Exhibition"
            class="menu-drawer__spotlight-img"
            loading="lazy"
            width="500"
            height="300"
          >
          <div class="menu-drawer__spotlight-overlay"></div>
          <div class="menu-drawer__spotlight-content">
            <span class="menu-drawer__spotlight-badge">✦ ATELIER EXHIBITION</span>
            <h3 class="menu-drawer__spotlight-title">ARCHITECTURAL LIVING & FINE ART</h3>
            <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__spotlight-link">
              EXPLORE EXHIBITION
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Main Navigation Menu -->
      <nav class="menu-drawer__nav" aria-label="Main Navigation">
        <div class="menu-drawer__nav-heading">GALLERY COLLECTIONS</div>
        <ul class="menu-drawer__list" role="list">
          <li class="menu-drawer__item">
            <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__link">
              <span>ORIGINAL OIL PAINTINGS & CANVAS</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__link">
              <span>BESPOKE SCULPTURAL FURNITURE</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__link">
              <span>BRONZE & MARBLE SCULPTURES</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__link">
              <span>ARCHITECTURAL BRASS LIGHTING</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__link">
              <span>LIMITED ARCHIVAL FINE PRINTS</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__link">
              <span>HAND-KNOTTED ORGANIC RUGS</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="/blogs/news" class="menu-drawer__link">
              <span>COLLECTORS JOURNAL</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="/pages/about-us" class="menu-drawer__link">
              <span>THE ATELIER & ARTISANS</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
          <li class="menu-drawer__item">
            <a href="/pages/contact" class="menu-drawer__link">
              <span>PRIVATE ART ADVISORY & CONTACT</span>
              <svg class="menu-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Drawer Footer & Concierge -->
      <div class="menu-drawer__footer">
        <div class="menu-drawer__concierge-box">
          <div class="menu-drawer__concierge-title">✦ PRIVATE ART CONCIERGE</div>
          <p class="menu-drawer__concierge-desc">
            Bespoke commissions, private viewings & interior advising.
          </p>
          <a href="mailto:concierge@therawhouse.com" class="menu-drawer__concierge-contact">
            concierge@therawhouse.com
          </a>
        </div>

        <div class="menu-drawer__socials">
          <a href="https://instagram.com" target="_blank" rel="noopener" class="menu-drawer__social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://pinterest.com" target="_blank" rel="noopener" class="menu-drawer__social-link" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.194-.333 1.36-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
            </svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener" class="menu-drawer__social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<style>
  /* Drawer Container & Details */
  .menu-drawer-container {
    display: inline-block;
  }

  .menu-drawer-container summary {
    list-style: none;
    outline: none;
  }

  .menu-drawer-container summary::-webkit-details-marker {
    display: none;
  }

  /* Backdrop */
  .menu-drawer__backdrop {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    z-index: 99998;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    cursor: pointer;
  }

  .menu-drawer-container.menu-open .menu-drawer__backdrop,
  .menu-drawer-container[open] .menu-drawer__backdrop {
    opacity: 1;
    visibility: visible;
  }

  /* Main Slide Drawer Panel */
  .menu-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: clamp(320px, 86vw, 420px);
    height: 100vh;
    background: #ffffff;
    z-index: 99999;
    transform: translateX(-100%);
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 8px 0 36px rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0;
    box-sizing: border-box;
  }

  .menu-drawer-container.menu-open .menu-drawer,
  .menu-drawer-container[open] .menu-drawer {
    transform: translateX(0);
  }

  /* Drawer Head */
  .menu-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 24px 20px;
    border-bottom: 1px solid #f0eee9;
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .menu-drawer__brand {
    display: flex;
    flex-direction: column;
  }

  .menu-drawer__brand-title {
    font-family: "Playfair Display", "Didot", "Cinzel", Georgia, serif;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #111111;
  }

  .menu-drawer__brand-sub {
    font-family: "Inter", sans-serif;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c5a880;
    margin-top: 3px;
  }

  .menu-drawer__close-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f8f7f5;
    border: 1px solid #e8e5e0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #111111;
    transition: all 0.25s ease;
  }

  .menu-drawer__close-btn:hover {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
    transform: rotate(90deg);
  }

  /* Spotlight Card */
  .menu-drawer__spotlight {
    padding: 20px 24px 16px;
  }

  .menu-drawer__spotlight-media {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    height: 160px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .menu-drawer__spotlight-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-drawer__spotlight-media:hover .menu-drawer__spotlight-img {
    transform: scale(1.05);
  }

  .menu-drawer__spotlight-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%);
  }

  .menu-drawer__spotlight-content {
    position: absolute;
    bottom: 14px;
    left: 16px;
    right: 16px;
    z-index: 2;
  }

  .menu-drawer__spotlight-badge {
    font-family: "Inter", sans-serif;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #c5a880;
    display: block;
    margin-bottom: 4px;
  }

  .menu-drawer__spotlight-title {
    font-family: "Playfair Display", serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #ffffff;
    margin: 0 0 6px;
    line-height: 1.25;
  }

  .menu-drawer__spotlight-link {
    font-family: "Inter", sans-serif;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: #c5a880;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: gap 0.25s ease, color 0.25s ease;
  }

  .menu-drawer__spotlight-link:hover {
    color: #ffffff;
    gap: 8px;
  }

  /* Navigation Links */
  .menu-drawer__nav {
    padding: 8px 24px 20px;
    flex: 1;
  }

  .menu-drawer__nav-heading {
    font-family: "Inter", sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #999999;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid #f0eee9;
  }

  .menu-drawer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .menu-drawer__item {
    border-bottom: 1px solid #f6f5f2;
  }

  .menu-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 4px;
    font-family: "Inter", sans-serif;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #222222;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .menu-drawer__chevron {
    color: #bbbbbb;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .menu-drawer__link:hover {
    color: #c5a880;
    transform: translateX(4px);
  }

  .menu-drawer__link:hover .menu-drawer__chevron {
    color: #c5a880;
    transform: translateX(3px);
  }

  /* Drawer Footer */
  .menu-drawer__footer {
    padding: 20px 24px 28px;
    background: #fbfaf8;
    border-top: 1px solid #f0eee9;
  }

  .menu-drawer__concierge-box {
    background: #ffffff;
    border: 1px solid #e8e5e0;
    border-radius: 6px;
    padding: 14px 16px;
    margin-bottom: 18px;
  }

  .menu-drawer__concierge-title {
    font-family: "Inter", sans-serif;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #c5a880;
    margin-bottom: 4px;
  }

  .menu-drawer__concierge-desc {
    font-size: 11px;
    line-height: 1.45;
    color: #666666;
    margin: 0 0 8px;
  }

  .menu-drawer__concierge-contact {
    font-size: 11.5px;
    font-weight: 600;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .menu-drawer__socials {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
  }

  .menu-drawer__social-link {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e8e5e0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #333333;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .menu-drawer__social-link:hover {
    background: #c5a880;
    border-color: #c5a880;
    color: #ffffff;
    transform: translateY(-2px);
  }
</style>

<script>
  (function initLuxuryMenuDrawer() {
    function setupDrawer() {
      const details = document.getElementById('Details-menu-drawer-container');
      if (!details) return;

      const summary = details.querySelector('summary');
      const closeBtn = details.querySelector('.menu-drawer__close-btn');
      const backdrop = details.querySelector('.menu-drawer__backdrop');
      const links = details.querySelectorAll('.menu-drawer__link, .menu-drawer__spotlight-link');

      function openDrawer(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        details.classList.remove('is-closing');
        details.setAttribute('open', '');
        void details.offsetWidth;
        requestAnimationFrame(() => {
          details.classList.add('menu-open');
          if (summary) summary.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        });
      }

      function closeDrawer(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        if (!details.hasAttribute('open')) return;
        details.classList.remove('menu-open');
        details.classList.add('is-closing');
        if (summary) summary.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';

        setTimeout(() => {
          if (details.classList.contains('is-closing')) {
            details.removeAttribute('open');
            details.classList.remove('is-closing');
          }
        }, 360);
      }

      if (summary) {
        summary.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (details.hasAttribute('open') && details.classList.contains('menu-open')) {
            closeDrawer(e);
          } else {
            openDrawer(e);
          }
        };
      }

      if (closeBtn) {
        closeBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          closeDrawer(e);
        };
      }

      if (backdrop) {
        backdrop.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          closeDrawer(e);
        };
      }

      links.forEach((link) => {
        link.addEventListener('click', () => {
          closeDrawer();
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && details.hasAttribute('open')) {
          closeDrawer();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDrawer);
    } else {
      setupDrawer();
    }
  })();
</script>
