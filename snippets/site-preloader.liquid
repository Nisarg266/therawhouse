<style>
  html.site-preloader-lock,
  html.site-preloader-lock body {
    overflow: hidden;
  }

  .site-preloader {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    background: #f9f8f5;
    color: #0a0a0a;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease, visibility 0s linear 0s;
  }

  .site-preloader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.6s ease, visibility 0s linear 0.6s;
  }

  .site-preloader__panel {
    display: grid;
    justify-items: center;
    width: min(74vw, 400px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-preloader.is-hidden .site-preloader__panel {
    opacity: 0;
    transform: translateY(-10px);
  }

  .site-preloader__logo {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: currentColor;
    shape-rendering: geometricPrecision;
  }

  /* The cube is revealed by a thick "pen" stroke travelling along its edges. */
  .site-preloader__pen {
    fill: none;
    stroke: #fff;
    stroke-width: 12;
    stroke-linecap: square;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  .site-preloader__pen--outline {
    animation: sitePreloaderDraw 0.95s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards;
  }

  .site-preloader__pen--diagonal {
    animation: sitePreloaderDraw 0.4s cubic-bezier(0.65, 0, 0.35, 1) 0.85s forwards;
  }

  /* Once drawn, the mask opens fully so the cube lands exactly as designed. */
  .site-preloader__finish {
    opacity: 0;
    animation: sitePreloaderFinish 0.2s linear 1.3s forwards;
  }

  /* The wordmark slides up out of its own clipped line. */
  .site-preloader__rise {
    transform-box: fill-box;
    transform: translateY(135%);
    animation: sitePreloaderRise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .site-preloader__rise--the { animation-delay: 1.15s; }
  .site-preloader__rise--r { animation-delay: 1.26s; }
  .site-preloader__rise--a { animation-delay: 1.33s; }
  .site-preloader__rise--w { animation-delay: 1.4s; }
  .site-preloader__rise--house { animation-delay: 1.52s; }

  @keyframes sitePreloaderDraw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes sitePreloaderFinish {
    to {
      opacity: 1;
    }
  }

  @keyframes sitePreloaderRise {
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-preloader {
      transition-duration: 0.15s;
    }

    .site-preloader__panel {
      transition: none;
    }

    .site-preloader__pen {
      stroke-dashoffset: 0;
      animation: none;
    }

    .site-preloader__finish {
      opacity: 1;
      animation: none;
    }

    .site-preloader__rise {
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var preloader = document.getElementById('SitePreloader');
    if (!preloader) return;

    var seen = null;
    try {
      seen = window.sessionStorage.getItem('trh:preloader:seen');
    } catch (error) {
      seen = null;
    }

    if (seen) {
      if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
      return;
    }

    try {
      window.sessionStorage.setItem('trh:preloader:seen', '1');
    } catch (error) {}

    var root = document.documentElement;
    root.classList.add('site-preloader-lock');

    var startedAt = Date.now();
    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The animation runs for about 2.2s; hold the finished logo briefly before fading out.
    var minimumVisibleMs = reducedMotion ? 900 : 2800;
    var maximumVisibleMs = reducedMotion ? 1500 : 3500;

    function hidePreloader() {
      if (preloader.classList.contains('is-hidden')) return;
      var elapsed = Date.now() - startedAt;
      var delay = Math.max(0, minimumVisibleMs - elapsed);

      window.setTimeout(function () {
        preloader.classList.add('is-hidden');
        root.classList.remove('site-preloader-lock');
        window.setTimeout(function () {
          if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
        }, 700);
      }, delay);
    }

    if (document.readyState === 'complete') {
      hidePreloader();
    } else {
      window.addEventListener('load', hidePreloader, { once: true });
      window.setTimeout(hidePreloader, maximumVisibleMs);
    }
  })();
</script>

<noscript>
  <style>
    .site-preloader {
      display: none !important;
    }
  </style>
</noscript>
