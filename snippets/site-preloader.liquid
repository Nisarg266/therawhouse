{% doc %}
  Renders the site preloader.

  Shows the header's standard logo SVG once per browsing session with a soft
  entrance and a short underline reveal before the overlay fades.
  Repeat pageviews in the same session skip it entirely.

  @example
  {% render 'site-preloader' %}
{% enddoc %}

<div
  id="SitePreloader"
  class="site-preloader"
  role="status"
  aria-live="polite"
  aria-label="Loading {{ shop.name | escape }}"
>
  <div class="site-preloader__panel">
    <div class="site-preloader__reveal">
      <img
        src="https://cdn.shopify.com/s/files/1/0851/3044/5056/files/logo_standard.svg?v=1790146723"
        alt=""
        aria-hidden="true"
        class="site-preloader__logo"
        loading="eager"
        width="420"
        height="120"
      >
      <span class="site-preloader__rule" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  html.site-preloader-lock,
  html.site-preloader-lock body {
    overflow: hidden;
  }

  .site-preloader {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    background: #f9f8f5;
    color: #1c1712;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.55s ease, visibility 0s linear 0s;
  }

  .site-preloader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.55s ease, visibility 0s linear 0.55s;
  }

  .site-preloader__panel {
    display: grid;
    justify-items: center;
    text-align: center;
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-preloader.is-hidden .site-preloader__panel {
    opacity: 0;
    transform: translateY(-10px);
  }

  .site-preloader__reveal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: min(62vw, 250px);
  }

  .site-preloader__logo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transform: translateY(14px) scale(0.97);
    filter: blur(8px);
    animation: sitePreloaderLogoIn 1.15s cubic-bezier(0.22, 1, 0.36, 1) 0.12s forwards;
  }

  .site-preloader__rule {
    display: block;
    width: 64px;
    height: 1px;
    background: #a88c67;
    opacity: 0;
    transform: scaleX(0);
    animation: sitePreloaderRuleIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.62s forwards;
  }

  @keyframes sitePreloaderLogoIn {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes sitePreloaderRuleIn {
    to {
      opacity: 0.7;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-preloader {
      transition-duration: 0.15s;
    }

    .site-preloader__panel {
      transition: none;
    }

    .site-preloader__logo {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
    }

    .site-preloader__rule {
      opacity: 0.7;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var preloader = document.getElementById('SitePreloader');
    if (!preloader) return;

    var seen = null;
    try {
      seen = window.sessionStorage.getItem('trh:preloader:seen');
    } catch (error) {
      seen = null;
    }

    if (seen) {
      if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
      return;
    }

    try {
      window.sessionStorage.setItem('trh:preloader:seen', '1');
    } catch (error) {}

    var root = document.documentElement;
    root.classList.add('site-preloader-lock');

    var startedAt = Date.now();
    var minimumVisibleMs = 1800;
    var maximumVisibleMs = 2500;

    function hidePreloader() {
      if (preloader.classList.contains('is-hidden')) return;
      var elapsed = Date.now() - startedAt;
      var delay = Math.max(0, minimumVisibleMs - elapsed);

      window.setTimeout(function () {
        preloader.classList.add('is-hidden');
        root.classList.remove('site-preloader-lock');
        window.setTimeout(function () {
          if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
        }, 600);
      }, delay);
    }

    if (document.readyState === 'complete') {
      hidePreloader();
    } else {
      window.addEventListener('load', hidePreloader, { once: true });
      window.setTimeout(hidePreloader, maximumVisibleMs);
    }
  })();
</script>

<noscript>
  <style>
    .site-preloader {
      display: none !important;
    }
  </style>
</noscript>
