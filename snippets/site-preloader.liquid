{% doc %}
  Renders the site preloader.

  Shows once per browsing session: two hairline strokes sweep outward from
  center to unveil the logo SVG, hold briefly, then the overlay fades.
  Repeat pageviews in the same session skip it entirely.

  @example
  {% render 'site-preloader' %}
{% enddoc %}

<div
  id="SitePreloader"
  class="site-preloader"
  role="status"
  aria-live="polite"
  aria-label="Loading {{ shop.name | escape }}"
>
  <div class="site-preloader__panel">
    <div class="site-preloader__reveal">
      <span class="site-preloader__line site-preloader__line--left" aria-hidden="true"></span>
      <span class="site-preloader__line site-preloader__line--right" aria-hidden="true"></span>
      <img
        src="https://cdn.shopify.com/s/files/1/0851/3044/5056/files/logo_standard.svg?v=1790146723"
        alt="{{ shop.name | escape }}"
        class="site-preloader__logo"
        loading="eager"
        width="420"
        height="120"
      >
    </div>
  </div>
</div>

<style>
  html.site-preloader-lock,
  html.site-preloader-lock body {
    overflow: hidden;
  }

  .site-preloader {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 42%, rgba(179, 139, 77, 0.12), transparent 32%),
      linear-gradient(135deg, #f8f3ea 0%, #eee4d5 52%, #e4d7c4 100%);
    color: #1c1712;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease, visibility 0s linear 0s;
  }

  .site-preloader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.6s ease, visibility 0s linear 0.6s;
  }

  .site-preloader__panel {
    display: grid;
    justify-items: center;
    text-align: center;
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-preloader.is-hidden .site-preloader__panel {
    opacity: 0.4;
    transform: translateY(-16px);
  }

  .site-preloader__reveal {
    position: relative;
    display: grid;
    place-items: center;
    width: min(70vw, 340px);
  }

  .site-preloader__logo {
    display: block;
    width: 100%;
    height: auto;
    max-height: 120px;
    object-fit: contain;
    clip-path: inset(0 50% 0 50%);
    animation: sitePreloaderReveal 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards;
  }

  .site-preloader__line {
    position: absolute;
    top: 50%;
    display: block;
    height: 1.5px;
    width: 0;
    opacity: 0.95;
  }

  .site-preloader__line--left {
    right: 50%;
    transform: translateY(-50%);
    background: linear-gradient(270deg, #b38b4d, rgba(179, 139, 77, 0));
    animation:
      sitePreloaderLineLeft 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards,
      sitePreloaderLineFade 0.5s ease 1.5s forwards;
  }

  .site-preloader__line--right {
    left: 50%;
    transform: translateY(-50%);
    background: linear-gradient(90deg, #b38b4d, rgba(179, 139, 77, 0));
    animation:
      sitePreloaderLineRight 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards,
      sitePreloaderLineFade 0.5s ease 1.5s forwards;
  }

  @keyframes sitePreloaderLineFade {
    to {
      opacity: 0;
    }
  }

  @keyframes sitePreloaderReveal {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes sitePreloaderLineLeft {
    to {
      width: 56%;
    }
  }

  @keyframes sitePreloaderLineRight {
    to {
      width: 56%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-preloader {
      transition-duration: 0.15s;
    }

    .site-preloader__panel {
      transition: none;
    }

    .site-preloader__logo {
      clip-path: none;
      animation: none;
    }

    .site-preloader__line {
      width: 56%;
      opacity: 0;
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var preloader = document.getElementById('SitePreloader');
    if (!preloader) return;

    var seen = null;
    try {
      seen = window.sessionStorage.getItem('trh:preloader:seen');
    } catch (error) {
      seen = null;
    }

    if (seen) {
      if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
      return;
    }

    try {
      window.sessionStorage.setItem('trh:preloader:seen', '1');
    } catch (error) {}

    var root = document.documentElement;
    root.classList.add('site-preloader-lock');

    var startedAt = Date.now();
    var minimumVisibleMs = 1800;
    var maximumVisibleMs = 2500;

    function hidePreloader() {
      if (preloader.classList.contains('is-hidden')) return;
      var elapsed = Date.now() - startedAt;
      var delay = Math.max(0, minimumVisibleMs - elapsed);

      window.setTimeout(function () {
        preloader.classList.add('is-hidden');
        root.classList.remove('site-preloader-lock');
        window.setTimeout(function () {
          if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
        }, 700);
      }, delay);
    }

    if (document.readyState === 'complete') {
      hidePreloader();
    } else {
      window.addEventListener('load', hidePreloader, { once: true });
      window.setTimeout(hidePreloader, maximumVisibleMs);
    }
  })();
</script>

<noscript>
  <style>
    .site-preloader {
      display: none !important;
    }
  </style>
</noscript>
