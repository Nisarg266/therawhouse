</style>

<script>
  (function() {
    function initEnquiryDrawer() {
      const drawer = document.getElementById('{{ drawer_dom_id }}');
      if (!drawer) return;

      // Close handlers
      const closeButtons = drawer.querySelectorAll('[data-close-enquiry]');
      closeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          closeDrawer(drawer);
        });
      });

      // ESC key handler
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
          closeDrawer(drawer);
        }
      });

      // Check if URL has posted form hash or param
      if (window.location.search.indexOf('contact_posted=true') !== -1 || window.location.hash === '#contact_form' || drawer.querySelector('.lux-enquiry-form__success')) {
        openDrawer(drawer);
      }
    }

    function openDrawer(drawer) {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const firstInput = drawer.querySelector('input[name="contact[name]"]');
      if (firstInput) {
        setTimeout(() => firstInput.focus(), 300);
      }
    }

    function closeDrawer(drawer) {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Expose global open helper
    window.openProductEnquiryDrawer = function(drawerId) {
      const targetId = drawerId || '{{ drawer_dom_id }}';
      const targetDrawer = document.getElementById(targetId);
      if (targetDrawer) {
        openDrawer(targetDrawer);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEnquiryDrawer);
    } else {
      initEnquiryDrawer();
    }
  })();
</script>
