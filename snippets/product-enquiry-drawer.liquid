  @media screen and (max-width: 550px) {
    .lux-enquiry-drawer--modal {
      --lux-enquiry-modal-header-offset: 60px;

      padding: calc(var(--lux-enquiry-modal-header-offset) + 12px) 12px 12px;
    }

    .lux-enquiry-drawer--modal .lux-enquiry-drawer__panel {
      width: 100%;
      max-width: 100%;
      max-height: calc(100dvh - var(--lux-enquiry-modal-header-offset) - 24px);
    }
