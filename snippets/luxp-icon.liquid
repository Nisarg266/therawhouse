{%- comment -%}
  LUXP — Inline SVG icon set (currentColor, no external libraries).

  Accepts:
  - icon: {String} Icon name
  - class: {String} Extra class

  Available icons:
  none, star, gem, shield, truck, leaf, award, heart, crown, sparkle,
  certificate, globe, palette, clock, ruler, arrow

  Usage:
  {% render 'luxp-icon', icon: block.settings.icon, class: 'luxp-icon__glyph' %}

  @module luxp-icon
{%- endcomment -%}

{%- liquid
  assign i = icon | default: 'none'
-%}
{%- if i != 'none' -%}
  {%- case i -%}
    {%- when 'star' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.57l-5.9 3.11 1.13-6.58L2.45 9.44l6.6-.96L12 2.5z"/></svg>
    {%- when 'gem' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 3h10l4 6-9 12L3 9l4-6z"/><path d="M3 9h18"/><path d="M9.5 3L8 9l4 12M14.5 3L16 9l-4 12"/></svg>
    {%- when 'shield' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.5l7.5 3v6c0 4.8-3.2 8.4-7.5 10-4.3-1.6-7.5-5.2-7.5-10v-6l7.5-3z"/><path d="M8.8 12l2.2 2.2 4.2-4.4"/></svg>
    {%- when 'truck' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1.5 5.5h13v11h-13z"/><path d="M14.5 9.5h4l3 3.5v3.5h-7"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg>
    {%- when 'leaf' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20C4 10 10 4 21 3c0 11-6 17-16 17"/><path d="M4 20c3-6 7-10 12-12"/></svg>
    {%- when 'award' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 22l5-2.6L17 22l-1.5-8"/></svg>
    {%- when 'heart' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21S3 14.5 3 8.6C3 5.5 5.4 3 8.4 3c1.5 0 2.9.7 3.6 1.8C12.7 3.7 14.1 3 15.6 3 18.6 3 21 5.5 21 8.6 21 14.5 12 21 12 21z"/></svg>
    {%- when 'crown' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 8l4 4 5.5-7 5.5 7 4-4-1.5 11H4L2.5 8z"/></svg>
    {%- when 'sparkle' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
    {%- when 'certificate' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="5.5"/><path d="M9.5 13.5L8 22l4-2 4 2-1.5-8.5"/><path d="M10 9l1.5 1.5L14.5 7"/></svg>
    {%- when 'globe' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19"/><path d="M12 2.5c2.7 2.7 4 5.9 4 9.5s-1.3 6.8-4 9.5c-2.7-2.7-4-5.9-4-9.5s1.3-6.8 4-9.5z"/></svg>
    {%- when 'palette' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.5C6.5 2.5 2.5 6.5 2.5 11.5c0 5 4 9 9 9 1.6 0 2.5-1 2.5-2.2 0-1.6-1.3-2-1.3-3.3 0-1.1.9-2 2-2h2.3c2.5 0 4.5-2 4.5-4.5 0-3.6-4-6-9.5-6z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="11" cy="7" r="1"/><circle cx="15.5" cy="8" r="1"/></svg>
    {%- when 'clock' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.5"/><path d="M12 6.5V12l3.5 2"/></svg>
    {%- when 'ruler' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="1.5" y="8.5" width="21" height="7" rx="1"/><path d="M6 8.5v3M10 8.5v3M14 8.5v3M18 8.5v3"/></svg>
    {%- when 'arrow' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
    {%- when 'hand' -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 12V5.5a1.5 1.5 0 013 0V11"/><path d="M11 11V4.5a1.5 1.5 0 013 0V11"/><path d="M14 11V6.5a1.5 1.5 0 013 0V13c0 4.5-2.5 8-6.5 8S4 17.5 4 13.5V11a1.5 1.5 0 013 0"/></svg>
    {%- else -%}
      <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.57l-5.9 3.11 1.13-6.58L2.45 9.44l6.6-.96L12 2.5z"/></svg>
  {%- endcase -%}
{%- endif -%}
