{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <span class="cart-drawer__empty-icon" aria-hidden="true">
        {{- 'icon-cart.svg' | inline_asset_content -}}
      </span>
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    overlay
    no-persist
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
  #cart-drawer {
    --theme-drawer-width: 460px;
  }

  #cart-drawer .theme-drawer__dialog {
    --theme-drawer-padding: 28px;
    --color-background: #faf9f6;
    --color-foreground: #25231f;
    --color-foreground-rgb: 37 35 31;
    --color-foreground-subdued: #716b63;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: -12px 0 48px rgb(0 0 0 / 8%);
    overflow: hidden;
  }

  #cart-drawer .theme-drawer__dialog::backdrop {
    background: rgb(25 23 20 / 38%);
  }

  #cart-drawer .theme-drawer__header {
    min-height: 84px;
    padding-block: 18px;
    border-bottom: 1px solid #e4e0d9;
  }

  #cart-drawer .theme-drawer__title {
    font: 400 26px/1.2 var(--font-heading--family, Georgia, serif);
    letter-spacing: 0;
    text-transform: none;
    gap: 12px;
  }

  #cart-drawer .theme-drawer__badge {
    background: #ede9e2;
    font: 500 11px/1 var(--font-body--family, sans-serif);
    border-radius: 50%;
  }

  #cart-drawer .theme-drawer__close-button {
    --private-button-size: 44px;
    border: none;
    border-radius: 2px;
    background: transparent;
    color: #25231f;
    box-shadow: none;
  }

  #cart-drawer .theme-drawer__close-button:hover { background: #ede9e2; }

  #cart-drawer .cart-drawer__content {
    height: 100%;
    min-height: 0;
    overscroll-behavior: contain;
  }

  #cart-drawer .cart-drawer__items {
    flex: 1 1 auto;
    padding-block: 24px;
    scrollbar-width: thin;
    overscroll-behavior: contain;
  }

  #cart-drawer .cart-items__table-row {
    grid-template-columns: 84px minmax(0, 1fr);
    grid-template-areas: 'media details' 'media price' 'media quantity' 'error error';
    gap: 10px 18px;
    padding-bottom: 24px;
    margin-bottom: 24px;
    border-color: #e4e0d9;
  }

  #cart-drawer .cart-items__table-row--full-width-variants {
    grid-template-rows: auto;
    grid-template-areas: 'media details' 'media price' 'media quantity' 'error error';
  }

  #cart-drawer .cart-items__table-row--full-width-variants .cart-items__details { display: block; }

  #cart-drawer .cart-items__title {
    font: 400 14px/1.5 var(--font-body--family, sans-serif);
    letter-spacing: 0;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  #cart-drawer .cart-items__media-container {
    aspect-ratio: 1;
    background: #f0eee8;
    border-radius: 2px;
  }

  #cart-drawer .cart-items__media-placeholder {
    display: grid;
    place-items: center;
    color: #716b63;
    font: 400 10px/1.4 var(--font-body--family, sans-serif);
  }

  #cart-drawer .cart-items__price {
    min-width: 0;
    width: auto;
    text-align: left;
    font: 500 13px/1.5 var(--font-body--family, sans-serif);
  }

  #cart-drawer .cart-items__variants-wrapper,
  #cart-drawer .cart-items__unit-price-wrapper { font-size: 12px; line-height: 1.5; color: #716b63; }
  #cart-drawer .cart-items__quantity { margin-top: 2px; }
  #cart-drawer .quantity-selector { border: 1px solid #d8d2c9; border-radius: 2px; background: transparent; }
  #cart-drawer .quantity-selector :is(button, input) { min-height: 44px; }
  #cart-drawer .cart-items__remove { min-width: 44px; min-height: 44px; }

  #cart-drawer .cart-drawer__summary {
    flex-shrink: 0;
    padding: 20px var(--theme-drawer-padding) max(24px, env(safe-area-inset-bottom));
    gap: 20px;
    border-top: 1px solid #e4e0d9;
    background: #faf9f6;
    mask-image: none;
  }

  #cart-drawer .cart-totals { gap: 16px; margin: 0; padding: 0; border: 0; }
  #cart-drawer .cart-totals__total { gap: 16px; flex-wrap: wrap; }
  #cart-drawer .cart-totals__total-label { font-size: 13px; font-weight: 400; }
  #cart-drawer .cart-totals__total-value { font: 500 18px/1.4 var(--font-body--family, sans-serif); }
  #cart-drawer .cart-totals__tax-note { line-height: 1.5; }
  #cart-drawer .cart-actions { margin: 0; border-top: 0; }
  #cart-drawer .cart-actions summary { font-size: 12px; }
  #cart-drawer .cart__ctas { width: 100%; gap: 12px; }
  #cart-drawer .cart__checkout-button { width: 100%; }

  #cart-drawer .cart-drawer--empty .theme-drawer__header { border: 0; }
  #cart-drawer .cart-drawer--empty .cart-drawer__content { padding: 24px 28px 84px; gap: 20px; }
  #cart-drawer .cart-drawer--empty .cart-drawer__items { flex: 0 0 auto; padding: 0; overflow: visible; }
  #cart-drawer .cart-drawer__empty-icon { display: grid; place-items: center; width: 64px; height: 64px; color: #8e8578; }
  #cart-drawer .cart-drawer__empty-icon svg { width: 44px; height: 44px; }
  #cart-drawer .cart-items__wrapper--drawer-empty p { font-size: 13px; line-height: 1.6; color: #716b63; }
  #cart-drawer .cart-items__empty-button { margin-top: 24px; }

  @media (max-width: 499px) {
    #cart-drawer { --theme-drawer-width: 100vw; }
    #cart-drawer .theme-drawer__dialog { --theme-drawer-padding: 20px; }
    #cart-drawer .theme-drawer__header { min-height: 72px; padding-block: 12px; }
    #cart-drawer .cart-items__table-row { grid-template-columns: 64px minmax(0, 1fr); column-gap: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #cart-drawer .theme-drawer__dialog { animation: none; }
  }
{% endstylesheet %}
