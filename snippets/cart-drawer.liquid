{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <span class="cart-drawer__empty-icon" aria-hidden="true">
        {{- 'icon-cart.svg' | inline_asset_content -}}
      </span>
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    overlay
    no-persist
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
  #cart-drawer {
    --theme-drawer-width: 480px;
  }

  /* ---------- Drawer shell ---------- */
  #cart-drawer .theme-drawer__dialog {
    --theme-drawer-padding: 28px;
    --color-background: #faf9f6;
    --color-foreground: #25231f;
    --color-foreground-rgb: 37 35 31;
    --color-foreground-subdued: #716b63;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: -16px 0 56px rgb(0 0 0 / 10%);
    overflow: hidden;
  }

  /* Desktop: clean dim backdrop only — no blur/effects */
  #cart-drawer .theme-drawer__dialog::backdrop {
    background: rgb(25 23 20 / 42%);
  }

  /* ---------- Header: letterspaced luxury label ---------- */
  #cart-drawer .theme-drawer__header {
    position: relative;
    min-height: 76px;
    padding-block: 16px;
    border-bottom: 1px solid #e7e3db;
    background: #faf9f6;
  }

  /* Gold diamond seated on the header hairline — the house motif */
  #cart-drawer .theme-drawer__header::after {
    content: '\25C6';
    position: absolute;
    left: 50%;
    bottom: -4px;
    transform: translateX(-50%);
    font-size: 6.5px;
    line-height: 8px;
    color: #a98344;
    background: #faf9f6;
    padding-inline: 12px;
  }

  #cart-drawer .theme-drawer__title {
    font: 500 13px/1.2 var(--font-body--family, sans-serif) !important;
    letter-spacing: 0.3em !important;
    text-transform: uppercase !important;
    margin-inline-end: -0.3em !important;
    gap: 12px;
  }

  #cart-drawer .theme-drawer__badge {
    background: #1d1b18 !important;
    color: #faf9f6 !important;
    font: 500 10px/1 var(--font-body--family, sans-serif) !important;
    letter-spacing: 0.04em;
    border-radius: 999px !important;
    min-width: 20px;
    height: 20px;
    padding-inline: 6px;
  }

  #cart-drawer .theme-drawer__close-button {
    --private-button-size: 42px;
    border: none;
    border-radius: 2px;
    background: transparent;
    color: #25231f;
    box-shadow: none;
    transition: background 0.25s ease;
  }

  #cart-drawer .theme-drawer__close-button:hover { background: #ede9e2; }

  #cart-drawer .cart-drawer__content {
    height: 100%;
    min-height: 0;
    overscroll-behavior: contain;
  }

  #cart-drawer .cart-drawer__items {
    flex: 1 1 auto;
    padding-block: 20px 24px;
    scrollbar-width: thin;
    overscroll-behavior: contain;
  }

  /* Concierge promise strip above the items */
  #cart-drawer .cart-drawer__inner:not(.cart-drawer--empty) .cart-drawer__content > .cart-drawer__items:first-child {
    padding-block-start: 5px;
  }

  #cart-drawer .cart-drawer__inner:not(.cart-drawer--empty) .cart-drawer__content::before {
    content: 'Complimentary white-glove delivery on every order';
    display: block;
    flex-shrink: 0;
    text-align: center;
    font: 500 9.5px/1.4 var(--font-body--family, sans-serif);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #96805c;
    background: #f5f1e8;
    border-bottom: 1px solid #ebe5d8;
    padding: 11px 18px;
  }

  /* ---------- Item rows: refined editorial grid ---------- */
  #cart-drawer .cart-items__table-row {
    grid-template-columns: 88px minmax(0, 1fr);
    grid-template-areas: 'media details' 'media price' 'media quantity' 'error error';
    gap: 8px 18px;
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-color: #e9e5dd;
  }

  #cart-drawer .cart-items__table-row--full-width-variants {
    grid-template-rows: auto;
    grid-template-areas: 'media details' 'media price' 'media quantity' 'error error';
  }

  #cart-drawer .cart-items__table-row--full-width-variants .cart-items__details { display: block; }

  #cart-drawer .cart-items__title {
    font: 400 13px/1.55 var(--font-body--family, sans-serif) !important;
    letter-spacing: 0.01em;
    text-transform: none;
    color: #2b2823 !important;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #cart-drawer .cart-items__media-container {
    aspect-ratio: 1;
    background: #f0eee8;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px #e7e2d7;
  }

  #cart-drawer .cart-items__media-placeholder {
    display: grid;
    place-items: center;
    color: #a29a8d;
    font: 400 9.5px/1.4 var(--font-body--family, sans-serif);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #cart-drawer .cart-items__price {
    min-width: 0;
    width: auto;
    text-align: left;
    font: 500 12.5px/1.5 var(--font-body--family, sans-serif) !important;
    color: #57524a;
  }

  #cart-drawer .cart-items__variants-wrapper,
  #cart-drawer .cart-items__unit-price-wrapper {
    font-size: 11.5px;
    line-height: 1.5;
    color: #8b857a;
  }

  /* Slim elegant quantity selector */
  #cart-drawer .cart-items__quantity { margin-top: 4px; }
  #cart-drawer .quantity-selector {
    border: 1px solid #dcd7cd !important;
    border-radius: 2px !important;
    background: #ffffff !important;
    min-height: 38px !important;
    width: 112px;
  }
  #cart-drawer .quantity-selector :is(button, input) {
    min-height: 38px !important;
    font-size: 13px !important;
  }
  #cart-drawer .quantity-selector button:hover { background: #f2efe8 !important; }

  /* Quiet uppercase remove link */
  #cart-drawer .cart-items__remove {
    min-width: 40px;
    min-height: 34px;
    font-size: 10.5px !important;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9a948a !important;
    transition: color 0.25s ease;
  }
  #cart-drawer .cart-items__remove:hover { color: #a98344 !important; }

  /* ---------- Summary: quiet totals + hero checkout ---------- */
  #cart-drawer .cart-drawer__summary {
    flex-shrink: 0;
    padding: 18px var(--theme-drawer-padding) max(22px, env(safe-area-inset-bottom));
    gap: 16px;
    border-top: 1px solid #e7e3db;
    background: #f6f3ec;
    mask-image: none;
  }

  /* Gold rule above the checkout actions */
  #cart-drawer .cart__ctas {
    position: relative;
    width: 100%;
    gap: 10px;
    padding-top: 14px;
  }

  #cart-drawer .cart__ctas::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 46px;
    height: 1px;
    background: #d5c5a2;
  }

  /* Quiet trust line beneath checkout */
  #cart-drawer .cart__ctas::after {
    content: 'Secure checkout \00B7  Duties & taxes included';
    display: block;
    width: 100%;
    text-align: center;
    margin-top: 2px;
    font: 400 9.5px/1.5 var(--font-body--family, sans-serif);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a89f90;
  }

  #cart-drawer .cart-totals { gap: 12px; margin: 0; padding: 0; border: 0; }
  #cart-drawer .cart-totals__total { gap: 16px; flex-wrap: wrap; }
  #cart-drawer .cart-totals__total-label {
    font-size: 10.5px !important;
    font-weight: 500 !important;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8b857a !important;
  }
  #cart-drawer .cart-totals__total-value {
    font: 500 19px/1.3 var(--font-body--family, sans-serif) !important;
    color: #1d1b18;
  }
  #cart-drawer .cart-totals__tax-note {
    font-size: 10.5px !important;
    line-height: 1.6;
    color: #a09a8f !important;
    text-align: center;
    letter-spacing: 0.02em;
  }

  #cart-drawer .cart-actions { margin: 0; border-top: 0; }
  #cart-drawer .cart-actions summary {
    font-size: 11px !important;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8b857a;
  }
  #cart-drawer .cart-actions summary:hover { color: #a98344; }

  /* Gold focus ring on quantity controls */
  #cart-drawer .quantity-selector:focus-within {
    border-color: #a98344 !important;
    box-shadow: 0 0 0 1px #a98344 !important;
  }

  /* Checkout: the centerpiece */
  #cart-drawer .cart__checkout-button {
    width: 100%;
    min-height: 54px !important;
    background: #1d1b18 !important;
    color: #faf9f6 !important;
    font: 500 12.5px/1 var(--font-body--family, sans-serif) !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    border-radius: 2px !important;
    border: 1px solid #1d1b18 !important;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  #cart-drawer .cart__checkout-button:hover,
  #cart-drawer .cart__checkout-button:focus-visible {
    background: #a98344 !important;
    border-color: #a98344 !important;
    color: #ffffff !important;
  }

  /* Secondary buttons (discount apply etc.) stay quiet */
  #cart-drawer .button-secondary {
    border-radius: 2px !important;
    letter-spacing: 0.12em;
  }

  /* ---------- Empty state ---------- */
  #cart-drawer .cart-drawer--empty .theme-drawer__header { border: 0; }
  #cart-drawer .cart-drawer--empty .theme-drawer__header::after { display: none; }
  #cart-drawer .cart-drawer--empty .cart-drawer__content { padding: 24px 28px 84px; gap: 18px; }
  #cart-drawer .cart-drawer--empty .cart-drawer__items { flex: 0 0 auto; padding: 0; overflow: visible; }
  #cart-drawer .cart-drawer__empty-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    color: #b3ab9e;
  }
  #cart-drawer .cart-drawer__empty-icon svg { width: 42px; height: 42px; }
  #cart-drawer .cart-drawer--empty .theme-drawer__title {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
    font-style: italic !important;
    font-size: 22px !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em !important;
    text-transform: none !important;
    margin-inline-end: 0 !important;
  }
  #cart-drawer .cart-items__wrapper--drawer-empty p { font-size: 12.5px; line-height: 1.7; color: #8b857a; }
  #cart-drawer .cart-items__empty-button {
    margin-top: 20px;
    border: 1px solid #a98344 !important;
    color: #a98344 !important;
    background: transparent !important;
    letter-spacing: 0.2em;
    transition: background 0.3s ease, color 0.3s ease;
  }
  #cart-drawer .cart-items__empty-button:hover {
    background: #a98344 !important;
    color: #ffffff !important;
  }

  /* ---------- Phone only: bigger products, roomier rows, softer dim + blur ---------- */
  @media (max-width: 499px) {
    #cart-drawer { --theme-drawer-width: 100vw; }
    #cart-drawer .theme-drawer__dialog { --theme-drawer-padding: 20px; }

    #cart-drawer .theme-drawer__dialog::backdrop {
      background: rgb(25 23 20 / 46%);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
    }

    #cart-drawer .theme-drawer__header {
      min-height: 68px;
      padding-block: 12px;
    }

    /* Large product images so items actually read on a phone */
    #cart-drawer .cart-items__table-row {
      grid-template-columns: 96px minmax(0, 1fr);
      column-gap: 16px;
      gap: 8px 16px;
      padding-bottom: 20px;
      margin-bottom: 20px;
    }

    #cart-drawer .cart-items__title { font-size: 13.5px !important; }
    #cart-drawer .cart-items__price { font-size: 13px !important; }
    #cart-drawer .quantity-selector { width: 118px; }
    #cart-drawer .cart-items__remove { min-height: 36px; }

    #cart-drawer .cart-drawer__summary {
      padding: 16px 20px max(20px, env(safe-area-inset-bottom));
      gap: 14px;
    }

    #cart-drawer .cart__checkout-button { min-height: 56px !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    #cart-drawer .theme-drawer__dialog { animation: none; }
    #cart-drawer .cart__checkout-button { transition: none; }
  }
{% endstylesheet %}
