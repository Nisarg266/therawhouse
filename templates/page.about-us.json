          "settings": {
            "step_number": "01",
            "stage_label": "STAGE I • DISCOVERY",
            "title": "Material-Led Sourcing",
            "description": "We begin with material character: wood grain, patina, proportion, joinery, finish, and the tactile quality that makes a piece worth living with.",
            "default_asset": "art-atelier-artist-studio.jpg",
            "link": ""
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "step_number": "02",
            "stage_label": "STAGE II • CURATION",
            "title": "Edited for Real Rooms",
            "description": "Every collection is composed with balance in mind: scale, warmth, contrast, and how each object will sit beside the pieces you already own.",
            "default_asset": "art-sculpture-bronze-figure.jpg",
            "link": ""
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "step_number": "03",
            "stage_label": "STAGE III • FINISHING",
            "title": "Detail, Finish & Care",
            "description": "Before a piece leaves us, we review the finish, surface, fittings, and care guidance so it arrives ready for daily use and long-term keeping.",
            "default_asset": "art-painting-gold-canvas.jpg",
            "link": ""
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "step_number": "04",
