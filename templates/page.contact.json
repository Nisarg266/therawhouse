          "type": "faq_item",
          "settings": {
            "question": "How does the private acquisition & viewing process work?",
            "answer": "<p>Every acquisition begins with a personal conversation. You can contact our curation desk via WhatsApp, telephone, or our private inquiry form. We provide bespoke valuations, high-resolution condition reports, and private viewing appointments.</p>",
            "open_by_default": true
          }
        },
        "faq_custom": {
          "type": "faq_item",
          "settings": {
            "question": "Can I commission custom dimensions or artisanal finishes?",
            "answer": "<p>Yes. Many of our architectural and sculptural pieces can be customized in collaboration with our master artisans. We accommodate custom dimensions, seasoned natural woods, marble selections, and bespoke metal finishes.</p>",
            "open_by_default": false
          }
        },
        "faq_transit": {
          "type": "faq_item",
          "settings": {
            "question": "What is included with insured White Glove transit?",
            "answer": "<p>Our white-glove transit service includes custom protective crating, comprehensive door-to-door transit insurance, scheduled appointment delivery, and inside room-of-choice placement across India and international destinations.</p>",
